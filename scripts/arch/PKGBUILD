# Built from a checked-out, pinned source revision by build.sh.
pkgname=okilum
pkgver=0.1.0
pkgrel=1
pkgdesc='Local-first Markdown reader and knowledge environment'
arch=('x86_64')
url='https://git.oklabs.uk/BeFeast/okilum'
license=('MIT')
depends=('gcc-libs' 'glibc' 'fontconfig' 'freetype2' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader')
optdepends=('syncthing: sync between devices')
makedepends=('git' 'cmake' 'pkgconf' 'clang' 'mold' 'librsvg')
options=('!debug' '!lto' '!strip')
install=okilum.install

build() {
    # build.sh verified the required-CI receipt and ELF before makepkg.
    test -f "$OKILUM_PREBUILT_DIR/payload/okilum"
    test -f "$OKILUM_PREBUILT_DIR/receipt.json"
}

package() {
    cd "$OKILUM_SOURCE"
    install -Dm755 "$OKILUM_PREBUILT_DIR/payload/okilum" "$pkgdir/usr/bin/okilum"
    install -Dm644 "$OKILUM_PREBUILT_DIR/receipt.json" "$pkgdir/usr/share/okilum/production-receipt.json"
    install -Dm644 scripts/arch/okilum.desktop "$pkgdir/usr/share/applications/okilum.desktop"
    local icon=crates/okilum-shell/assets/brand/app-icon-light.svg
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/scalable/apps/okilum.svg"
    # Raster sizes too: launchers that skip SVG or a stale scalable lookup still
    # find a themed okilum icon (#985).
    local size
    for size in 16 22 24 32 48 64 128 256 512; do
        install -d "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
        rsvg-convert --width "$size" --height "$size" "$icon" \
            --output "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/okilum.png"
    done
    python3 scripts/third-party-notices.py --stage "$pkgdir/usr/share/licenses/okilum"
}
