# pacman install scriptlet (#974). pacman runs this as root and cannot reach
# each user's home, so per-user data is removed by the user, not by pacman.
# The message only appears once the package is going: by then `okilum
# --uninstall-data` is gone too, so it lists the folders instead.

post_remove() {
    cat <<'MSG'
==> Okilum was removed. Your notes were not touched.
    If you did not run `okilum --uninstall-data` before, your per-user
    Okilum data is still in (default locations):
        ~/.local/state/okilum   ~/.config/okilum   ~/.cache/okilum
    Remove those folders to finish. If Sync was set up, remove this computer
    from Sync in Okilum first; its user service is okilum-syncthing-*.service.
MSG
}

# Pacman transition notice (#1564), also present before the final release.
post_install() {
    cat <<'MSG'
==> Okilum Linux is transitioning to the signed AppImage.
    Pacman freeze and AppImage Stable availability are announced separately.
    Notes and application state stay in their current locations.
    Download and signature-verification instructions: https://git.oklabs.uk/BeFeast/okilum/src/branch/main/docs/linux-releases.md
    After Linux Stable is announced, download without running it:
    mkdir -p "$HOME/.local/share/okilum" && curl -fL https://updates.befeast.com/okilum/linux/stable/Okilum-x86_64.AppImage -o "$HOME/.local/share/okilum/Okilum.AppImage" && chmod +x "$HOME/.local/share/okilum/Okilum.AppImage"
    Follow the linked signature-verification instructions before opening it.
MSG
}
post_upgrade() { post_install; }
