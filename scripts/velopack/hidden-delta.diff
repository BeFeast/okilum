+    /// Filesystem fault seam, compiled only by the dedicated native test feature.
+    #[cfg(feature = "helper-replacement-tests")]
+    #[derive(Clone, Copy, Debug)]
+    pub enum Fault {
+        /// Simulated ReplaceFileW 1175: both files keep their names.
+        RemoveReplaced,
+        /// Simulated ReplaceFileW 1176 with a backup name: both keep their names.
+        MoveReplacement,
+        /// Simulated ReplaceFileW 1177: original renamed to the backup, stage kept.
+        MoveReplacement2,
+        /// 1177 followed by every promotion being refused.
+        PromotionBlocked,
+        /// Process death after staging, before ReplaceFileW.
+        LeaveBeforeSwap,
+        /// Process death between ReplaceFileW's two renames.
+        LeaveAfterBackupMove,
+        /// Process death after a real ReplaceFileW, before cleanup.
+        LeaveAfterSwap,
+        /// The real ReplaceFileW, optionally with the stage held without
+        /// FILE_SHARE_DELETE or the backup name occupied by a held file.
+        Real { hold_stage: bool, occupy_backup: bool },
+        /// Real operations; at the named phase, write and flush a marker next to
+        /// the helper and block forever so a power cut can be applied there.
+        Pause(&'static str),
+    }
+    #[cfg(feature = "helper-replacement-tests")]
+    impl Operations for Fault {
+        fn replace(&self, p: &Paths) -> io::Result<()> {
+            match *self {
+                Self::RemoveReplaced => Err(io::Error::from_raw_os_error(REMOVE_REPLACED)),
+                Self::MoveReplacement => Err(io::Error::from_raw_os_error(MOVE_REPLACEMENT)),
+                Self::MoveReplacement2 | Self::PromotionBlocked | Self::LeaveAfterBackupMove => {
+                    rename_new(&p.destination, &p.backup)?;
+                    Err(io::Error::from_raw_os_error(MOVE_REPLACEMENT_2))
+                }
+                Self::LeaveBeforeSwap => Err(other("interrupted before swap")),
+                Self::LeaveAfterSwap => {
+                    Windows.replace(p)?;
+                    Err(other("interrupted after swap"))
+                }
+                Self::Real { hold_stage, occupy_backup } => {
+                    let _stage = if hold_stage {
+                        Some(fs::OpenOptions::new().read(true).share_mode(FILE_SHARE_READ).open(&p.stage)?)
+                    } else {
+                        None
+                    };
+                    let _backup = if occupy_backup {
+                        fs::write(&p.backup, b"file occupying the backup name")?;
+                        Some(fs::OpenOptions::new().read(true).share_mode(FILE_SHARE_READ).open(&p.backup)?)
+                    } else {
+                        None
+                    };
+                    Windows.replace(p)
+                }
+                Self::Pause(_) => Windows.replace(p),
+            }
+        }
+        fn checkpoint(&self, p: &Paths, phase: &str) -> io::Result<()> {
+            if let Self::Pause(at) = self {
+                if *at == phase {
+                    let marker = p.destination.with_file_name("power-cut-ready");
+                    let mut file = fs::File::create(&marker)?;
+                    file.write_all(phase.as_bytes())?;
+                    file.sync_all()?;
+                    loop {
+                        std::thread::sleep(std::time::Duration::from_secs(3600));
+                    }
+                }
+            }
+            Ok(())
+        }
+        fn promote(&self, file: &fs::File, from: &Path, to: &Path) -> io::Result<()> {
+            if matches!(self, Self::PromotionBlocked) {
+                return Err(io::Error::from_raw_os_error(32));
+            }
+            Windows.promote(file, from, to)
+        }
+        fn leave_interrupted(&self) -> bool {
+            matches!(self, Self::LeaveBeforeSwap | Self::LeaveAfterBackupMove | Self::LeaveAfterSwap)
+        }
+    }
