+    pub fn zip_idx_matches_path<T: AsRef<Path>>(&self, index: usize, path: T) -> Result<bool, Error> {
+        let mut actual = match File::open(path) {
+            Ok(file) => file,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(false),
+            Err(error) => return Err(error.into()),
+        };
+        let mut archive = self.zip.borrow_mut();
+        let mut expected = archive.by_index(index)?;
+        let size = expected.size();
+        if actual.metadata()?.len() != size {
+            return Ok(false);
+        }
+        let mut expected_buffer = [0u8; 64000];
+        let mut actual_buffer = [0u8; 64000];
+        let mut count = 0u64;
+        loop {
+            let len = expected.read(&mut expected_buffer)?;
+            if len == 0 { break; }
+            if len as u64 > size.saturating_sub(count) { return Ok(false); }
+            actual.read_exact(&mut actual_buffer[..len])?;
+            if expected_buffer[..len] != actual_buffer[..len] { return Ok(false); }
+            count += len as u64;
+        }
+        Ok(count == size && actual.read(&mut actual_buffer[..1])? == 0)
+    }
