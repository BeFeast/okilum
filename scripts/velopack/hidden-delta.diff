+    /// Machine installs: copy the root helper into the per-user fallback only
+    /// as a locked, verified publication, and never while an earlier
+    /// transaction there is unresolved (creating the staging recovers first).
+    pub(crate) fn bootstrap(source: &Path, destination: &Path) -> Result<(), Error> {
+        let mut staging = Staging::new(destination)?;
+        if present(destination)? {
+            return Ok(());
+        }
+        let mut input = open_plain(source, GENERIC_READ)?.ok_or_else(|| other("root update helper missing"))?;
