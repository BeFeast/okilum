+//! Recoverable publication of fully verified helper/stub bytes. ZIP version independent.
+use crate::Error;
+use std::path::Path;
+
+#[cfg(not(windows))]
+pub(crate) fn publish(staged: tempfile::NamedTempFile, destination: &Path) -> Result<(), Error> {
+    staged.persist(destination).map_err(|e| e.error)?;
+    Ok(())
+}
+
+#[cfg(windows)]
+pub(crate) use native::publish;
+#[cfg(windows)]
+pub use native::recover;
+#[cfg(all(windows, feature = "helper-replacement-tests"))]
+pub use native::{native_path_for_test, publish_fault, Fault};
+
+#[cfg(windows)]
+mod native {
+    use super::*;
+    use std::{
+        fs,
+        io::{self, Write},
+        path::PathBuf,
+    };
+    use windows::{
+        core::PCWSTR,
+        Win32::Storage::FileSystem::{
+            GetFileAttributesW, MoveFileExW, ReplaceFileW, SetFileAttributesW,
+            FILE_ATTRIBUTE_NORMAL, FILE_FLAGS_AND_ATTRIBUTES, INVALID_FILE_ATTRIBUTES,
+            MOVEFILE_WRITE_THROUGH, REPLACE_FILE_FLAGS,
+        },
+    };
+    const READY: &[u8] = b"velopack-verified-helper-v1\n";
+    const REMOVE_REPLACED: i32 = 1175;
+    const MOVE_REPLACEMENT: i32 = 1176;
+    const MOVE_REPLACEMENT_2: i32 = 1177;
+
+    struct Paths {
+        destination: PathBuf,
+        stage: PathBuf,
+        backup: PathBuf,
+        ready: PathBuf,
+        lock: PathBuf,
+    }
+    impl Paths {
+        fn new(destination: &Path) -> Self {
+            let sibling = |suffix: &str| {
+                let mut name = destination
+                    .file_name()
+                    .expect("file destination")
+                    .to_os_string();
+                name.push(suffix);
+                destination.with_file_name(name)
+            };
+            Self {
+                destination: destination.to_owned(),
+                stage: sibling(".vpk-stage"),
+                backup: sibling(".vpk-backup"),
+                ready: sibling(".vpk-ready"),
+                lock: sibling(".vpk-lock"),
+            }
+        }
+        fn has_artifacts(&self) -> io::Result<bool> {
+            Ok(self.stage.try_exists()? || self.backup.try_exists()? || self.ready.try_exists()?)
+        }
+    }
+
+    // Explicit extended-length paths work independently of the executable's
+    // longPathAware manifest and the host's LongPathsEnabled policy.
+    fn wide(path: &Path) -> io::Result<Vec<u16>> {
+        use std::os::windows::ffi::OsStrExt;
+        let path = std::path::absolute(path)?;
+        let units: Vec<u16> = path.as_os_str().encode_wide().collect();
+        let extended: Vec<u16> = if units.starts_with(&[92, 92, 63, 92]) {
+            units
+        } else if units.starts_with(&[92, 92]) {
+            "\\\\?\\UNC\\"
+                .encode_utf16()
+                .chain(units.into_iter().skip(2))
+                .collect()
+        } else {
+            "\\\\?\\".encode_utf16().chain(units).collect()
+        };
+        Ok(extended.into_iter().chain(Some(0)).collect())
+    }
+    fn remove_owned(path: &Path) -> io::Result<()> {
+        if !path.try_exists()? {
+            return Ok(());
+        }
+        // Only obsolete transaction files; never clear destination attributes.
+        unsafe { SetFileAttributesW(PCWSTR(wide(path)?.as_ptr()), FILE_ATTRIBUTE_NORMAL) }
+            .map_err(io::Error::from)?;
+        fs::remove_file(path)
+    }
+
+    trait Operations {
+        fn replace(&self, paths: &Paths) -> io::Result<()>;
+        fn restore(&self, source: &Path, destination: &Path) -> io::Result<()> {
+            // Destination must be absent: never overwrite another recovery copy.
+            if destination.try_exists()? {
+                return Err(io::ErrorKind::AlreadyExists.into());
+            }
+            let source = wide(source)?;
+            let destination = wide(destination)?;
+            unsafe {
+                MoveFileExW(
+                    PCWSTR(source.as_ptr()),
+                    PCWSTR(destination.as_ptr()),
+                    MOVEFILE_WRITE_THROUGH,
+                )
+            }
+            .map_err(io::Error::from)
+        }
+        fn leave_interrupted(&self) -> bool {
+            false
+        }
+    }
+    struct Windows;
+    impl Operations for Windows {
+        fn replace(&self, p: &Paths) -> io::Result<()> {
+            let destination = wide(&p.destination)?;
+            let stage = wide(&p.stage)?;
+            let backup = wide(&p.backup)?;
+            // Backup is mandatory. In particular, never pass NULL: error 1176
+            // without it may delete the only original. Ignore no merge errors.
+            unsafe {
+                ReplaceFileW(
+                    PCWSTR(destination.as_ptr()),
+                    PCWSTR(stage.as_ptr()),
+                    PCWSTR(backup.as_ptr()),
+                    REPLACE_FILE_FLAGS(0),
+                    None,
+                    None,
+                )
+            }
+            .map_err(io::Error::from)
+        }
+    }
+
+    fn recover_locked(p: &Paths, operations: &impl Operations) -> io::Result<()> {
+        let exists = p.destination.try_exists()?;
+        if !exists {
+            if p.backup.try_exists()? {
+                // 1177 / interruption after the original was renamed. Preserve
+                // the security descriptor/attributes by renaming the original.
+                operations.restore(&p.backup, &p.destination)?;
+            } else if p.stage.try_exists()? && fs::read(&p.ready).ok().as_deref() == Some(READY) {
+                // Last-resort verified replacement; an incomplete stage is never
+                // executable. Keep it on disk if this rename is refused too.
+                operations.restore(&p.stage, &p.destination)?;
+            } else if p.has_artifacts()? {
+                return Err(io::Error::other(
+                    "helper missing; no verified recovery source; preserving transaction files",
+                ));
+            } else {
+                return Ok(());
+            }
+        }
+        if !p.destination.is_file() {
+            return Err(io::Error::other(
+                "helper destination is not a file; preserving transaction files",
+            ));
+        }
+        if p.backup.try_exists()? && p.stage.try_exists()? {
+            return Err(io::Error::other(
+                "ambiguous helper transaction; preserving all three files",
+            ));
+        }
+        // Hold the admitted destination against deletion/write throughout cleanup;
+        // a presence check alone would race another process removing the helper.
+        use std::os::windows::fs::OpenOptionsExt;
+        let _admitted = fs::OpenOptions::new()
+            .read(true)
+            .share_mode(windows::Win32::Storage::FileSystem::FILE_SHARE_READ.0)
+            .open(&p.destination)?;
+        // Only after a destination exists. A post-swap crash leaves destination
+        // + backup; a pre-swap failure leaves destination + stage. Both are safe.
+        remove_owned(&p.stage)?;
+        remove_owned(&p.backup)?;
+        remove_owned(&p.ready)?;
+        Ok(())
+    }
+
+    /// Recover a previous process interruption before locator existence checks.
+    pub fn recover(destination: &Path) -> Result<(), Error> {
+        let p = Paths::new(destination);
+        if !p.has_artifacts()? {
+            return Ok(());
+        }
+        let _lock = crate::lockfile::LockFile::try_acquire_lock(p.lock.clone())?;
+        recover_locked(&p, &Windows)?;
+        Ok(())
+    }
+    pub(crate) fn publish(
+        staged: tempfile::NamedTempFile,
+        destination: &Path,
+    ) -> Result<(), Error> {
+        publish_with(staged, destination, &Windows)
+    }
+    fn publish_with(
+        staged: tempfile::NamedTempFile,
+        destination: &Path,
+        operations: &impl Operations,
+    ) -> Result<(), Error> {
+        let p = Paths::new(destination);
+        let _lock = crate::lockfile::LockFile::try_acquire_lock(p.lock.clone())?;
+        recover_locked(&p, operations)?;
+        // Close the staged write handle before ReplaceFileW opens it. Transfer
+        // ownership to a deterministic recovery name; no RAII deletion afterwards.
+        let temporary = staged.into_temp_path();
+        let temporary_wide = wide(&temporary)?;
+        unsafe { SetFileAttributesW(PCWSTR(temporary_wide.as_ptr()), FILE_ATTRIBUTE_NORMAL) }
+            .map_err(io::Error::from)?;
+        // tempfile's Windows persist uses raw, non-extended paths. Use the same
+        // explicit long-path/no-clobber primitive as recovery instead.
+        Windows.restore(&temporary, &p.stage)?;
+        drop(temporary);
+        let transaction = || -> io::Result<()> {
+            if p.destination.try_exists()? {
+                let attributes =
+                    unsafe { GetFileAttributesW(PCWSTR(wide(&p.destination)?.as_ptr())) };
+                if attributes == INVALID_FILE_ATTRIBUTES {
+                    return Err(io::Error::last_os_error());
+                }
+                unsafe {
+                    SetFileAttributesW(
+                        PCWSTR(wide(&p.stage)?.as_ptr()),
+                        FILE_FLAGS_AND_ATTRIBUTES(attributes),
+                    )
+                }
+                .map_err(io::Error::from)?;
+            }
+            let mut ready = fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&p.ready)?;
+            ready.write_all(READY)?;
+            ready.sync_all()?;
+            drop(ready);
+            if p.destination.try_exists()? {
+                operations.replace(&p)
+            } else {
+                operations.restore(&p.stage, &p.destination)
+            }
+        };
+        match transaction() {
+            Ok(()) => {
+                recover_locked(&p, operations)?;
+                Ok(())
+            }
+            Err(error) => {
+                if operations.leave_interrupted() {
+                    return Err(error.into());
+                }
+                match error.raw_os_error() {
+                    Some(REMOVE_REPLACED) => warn!(
+                        "ReplaceFileW 1175: original and replacement retain names; recovering"
+                    ),
+                    Some(MOVE_REPLACEMENT) => {
+                        warn!("ReplaceFileW 1176: mandatory backup protects original; recovering")
+                    }
+                    Some(MOVE_REPLACEMENT_2) => {
+                        warn!("ReplaceFileW 1177: original renamed to backup; restoring")
+                    }
+                    _ => warn!("Helper publication failed; recovering: {}", error),
+                }
+                if let Err(recovery) = recover_locked(&p, operations) {
+                    // Deliberately keep backup, stage and marker. The next launch
+                    // retries recovery; missing destination NEVER licenses cleanup.
+                    return Err(io::Error::other(format!(
+                        "helper publication: {error}; recovery: {recovery}; transaction retained"
+                    ))
+                    .into());
+                }
+                Err(error.into())
+            }
+        }
+    }
+
+    /// Filesystem fault seam, compiled only by the dedicated native test feature.
+    #[cfg(feature = "helper-replacement-tests")]
+    #[derive(Clone, Copy)]
+    pub enum Fault {
+        RemoveReplaced,
+        MoveReplacement,
+        MoveReplacement2,
+        RollbackBlocked,
+        LeaveBeforeSwap,
+        LeaveAfterBackupMove,
+        LeaveAfterSwap,
+    }
+    #[cfg(feature = "helper-replacement-tests")]
+    impl Operations for Fault {
+        fn replace(&self, p: &Paths) -> io::Result<()> {
+            match self {
+                Self::RemoveReplaced => Err(io::Error::from_raw_os_error(REMOVE_REPLACED)),
+                Self::MoveReplacement => Err(io::Error::from_raw_os_error(MOVE_REPLACEMENT)),
+                Self::MoveReplacement2 | Self::RollbackBlocked | Self::LeaveAfterBackupMove => {
+                    fs::rename(&p.destination, &p.backup)?;
+                    Err(io::Error::from_raw_os_error(MOVE_REPLACEMENT_2))
+                }
+                Self::LeaveBeforeSwap => Err(io::Error::other("interrupted before swap")),
+                Self::LeaveAfterSwap => {
+                    Windows.replace(p)?;
+                    Err(io::Error::other("interrupted after swap"))
+                }
+            }
+        }
+        fn restore(&self, source: &Path, destination: &Path) -> io::Result<()> {
+            if matches!(self, Self::RollbackBlocked)
+                && source.extension().is_some_and(|v| v == "vpk-backup")
+            {
+                return Err(io::Error::from_raw_os_error(32));
+            }
+            Windows.restore(source, destination)
+        }
+        fn leave_interrupted(&self) -> bool {
+            matches!(
+                self,
+                Self::LeaveBeforeSwap | Self::LeaveAfterBackupMove | Self::LeaveAfterSwap
+            )
+        }
+    }
+    /// Inspect the exact native API path used by production, independent of host policy.
+    #[cfg(feature = "helper-replacement-tests")]
+    pub fn native_path_for_test(path: &Path) -> Result<Vec<u16>, Error> {
+        Ok(wide(path)?)
+    }
+
+    /// Invoke the production state machine with a filesystem failure seam.
+    #[cfg(feature = "helper-replacement-tests")]
+    pub fn publish_fault(
+        staged: tempfile::NamedTempFile,
+        destination: &Path,
+        fault: Fault,
+    ) -> Result<(), Error> {
+        staged.as_file().sync_all()?;
+        publish_with(staged, destination, &fault)
+    }
+}
