+// ReplaceFileW merges the existing destination's DACL rather than adopting the
+// temporary file's inherited grants. Do not ignore ACL/metadata merge failures.
+#[cfg(windows)]
+fn publish_staged_file(staged: tempfile::NamedTempFile, path: &Path) -> Result<(), Error> {
+    use std::os::windows::ffi::OsStrExt;
+    use windows::core::PCWSTR;
+    use windows::Win32::Storage::FileSystem::{
+        GetFileAttributesW, ReplaceFileW, SetFileAttributesW, FILE_ATTRIBUTE_NORMAL,
+        FILE_FLAGS_AND_ATTRIBUTES, INVALID_FILE_ATTRIBUTES, REPLACE_FILE_FLAGS,
+    };
+    let wide = |path: &Path| path.as_os_str().encode_wide().chain(Some(0)).collect::<Vec<_>>();
+    let target = wide(path);
+    let temporary = wide(staged.path());
+    let attributes = unsafe { GetFileAttributesW(PCWSTR(target.as_ptr())) };
+    if attributes == INVALID_FILE_ATTRIBUTES {
+        let error = std::io::Error::last_os_error();
+        if error.kind() != std::io::ErrorKind::NotFound { return Err(error.into()); }
+        // A racing new destination must not lose its metadata either.
+        staged.persist_noclobber(path).map_err(|e| e.error)?;
+    } else {
+        unsafe { SetFileAttributesW(PCWSTR(temporary.as_ptr()), FILE_FLAGS_AND_ATTRIBUTES(attributes)) }
+            .map_err(std::io::Error::from)?;
+        let result = unsafe {
+            ReplaceFileW(PCWSTR(target.as_ptr()), PCWSTR(temporary.as_ptr()), PCWSTR::null(),
+                REPLACE_FILE_FLAGS(0), None, None)
+        };
+        if let Err(error) = result {
+            // Permit RAII cleanup even when the destination carried READONLY.
+            let _ = unsafe { SetFileAttributesW(PCWSTR(temporary.as_ptr()), FILE_ATTRIBUTE_NORMAL) };
+            return Err(std::io::Error::from(error).into());
+        }
+    }
+    Ok(())
+}
+
+#[cfg(not(windows))]
+fn publish_staged_file(staged: tempfile::NamedTempFile, path: &Path) -> Result<(), Error> {
+    staged.persist(path).map_err(|e| e.error)?;
+    Ok(())
+}
