+//! Recoverable publication of fully verified helper/stub bytes. ZIP version independent.
+//!
+//! Invariant: a file only ever acquires the destination, `.vpk-stage` or
+//! `.vpk-backup` name by an atomic rename of a complete file. The stage is a
+//! fully read, CRC/size-checked and flushed extraction; the backup is the
+//! original destination renamed by ReplaceFileW. Recovery therefore never
+//! needs to trust a partially written file and never deletes the last copy.
+use crate::Error;
+use std::path::Path;
+
+#[cfg(not(windows))]
+pub(crate) fn publish(staged: tempfile::NamedTempFile, destination: &Path) -> Result<(), Error> {
+    staged.persist(destination).map_err(|e| e.error)?;
+    Ok(())
+}
+
+#[cfg(windows)]
+pub(crate) use native::publish;
+#[cfg(windows)]
+pub use native::recover;
+#[cfg(all(windows, feature = "helper-replacement-tests"))]
+pub use native::{native_path_for_test, publish_fault, Fault};
+
+#[cfg(windows)]
+mod native {
+    use super::*;
+    use std::{fs, io, path::PathBuf};
+    use windows::{
+        core::PCWSTR,
+        Win32::Storage::FileSystem::{
+            MoveFileExW, ReplaceFileW, SetFileAttributesW, FILE_ATTRIBUTE_NORMAL, MOVEFILE_WRITE_THROUGH, REPLACE_FILE_FLAGS,
+        },
+    };
+    const REMOVE_REPLACED: i32 = 1175;
+    const MOVE_REPLACEMENT: i32 = 1176;
+    const MOVE_REPLACEMENT_2: i32 = 1177;
+
+    struct Paths {
+        destination: PathBuf,
+        stage: PathBuf,
+        backup: PathBuf,
+        lock: PathBuf,
+    }
+    impl Paths {
+        fn new(destination: &Path) -> Self {
+            let sibling = |suffix: &str| {
+                let mut name = destination.file_name().expect("file destination").to_os_string();
+                name.push(suffix);
+                destination.with_file_name(name)
+            };
+            Self {
+                destination: destination.to_owned(),
+                stage: sibling(".vpk-stage"),
+                backup: sibling(".vpk-backup"),
+                lock: sibling(".vpk-lock"),
+            }
+        }
+        fn has_artifacts(&self) -> io::Result<bool> {
+            Ok(self.stage.try_exists()? || self.backup.try_exists()?)
+        }
+    }
+
+    // Explicit extended-length paths work independently of the executable's
+    // longPathAware manifest and the host's LongPathsEnabled policy.
+    fn wide(path: &Path) -> io::Result<Vec<u16>> {
+        use std::os::windows::ffi::OsStrExt;
+        let path = std::path::absolute(path)?;
+        let units: Vec<u16> = path.as_os_str().encode_wide().collect();
+        let extended: Vec<u16> = if units.starts_with(&[92, 92, 63, 92]) {
+            units
+        } else if units.starts_with(&[92, 92]) {
+            "\\\\?\\UNC\\".encode_utf16().chain(units.into_iter().skip(2)).collect()
+        } else {
+            "\\\\?\\".encode_utf16().chain(units).collect()
+        };
+        Ok(extended.into_iter().chain(Some(0)).collect())
+    }
+    fn remove_owned(path: &Path) -> io::Result<()> {
+        if !path.try_exists()? {
+            return Ok(());
+        }
+        // Only obsolete transaction files; never clear destination attributes.
+        unsafe { SetFileAttributesW(PCWSTR(wide(path)?.as_ptr()), FILE_ATTRIBUTE_NORMAL) }.map_err(io::Error::from)?;
+        fs::remove_file(path)
+    }
+    /// Atomic no-clobber rename: never overwrites another recovery copy.
+    fn rename_new(source: &Path, destination: &Path) -> io::Result<()> {
+        if destination.try_exists()? {
+            return Err(io::ErrorKind::AlreadyExists.into());
+        }
+        let source = wide(source)?;
+        let destination = wide(destination)?;
+        unsafe { MoveFileExW(PCWSTR(source.as_ptr()), PCWSTR(destination.as_ptr()), MOVEFILE_WRITE_THROUGH) }
+            .map_err(io::Error::from)
+    }
+
+    trait Operations {
+        fn replace(&self, paths: &Paths) -> io::Result<()>;
+        fn restore(&self, source: &Path, destination: &Path) -> io::Result<()> {
+            rename_new(source, destination)
+        }
+        fn leave_interrupted(&self) -> bool {
+            false
+        }
+    }
+    struct Windows;
+    impl Operations for Windows {
+        fn replace(&self, p: &Paths) -> io::Result<()> {
+            let destination = wide(&p.destination)?;
+            let stage = wide(&p.stage)?;
+            let backup = wide(&p.backup)?;
+            // Backup is mandatory. Never pass NULL: error 1176 without a backup
+            // name may delete the only original. Flags 0: ACL/merge errors fail.
+            unsafe {
+                ReplaceFileW(
+                    PCWSTR(destination.as_ptr()),
+                    PCWSTR(stage.as_ptr()),
+                    PCWSTR(backup.as_ptr()),
+                    REPLACE_FILE_FLAGS(0),
+                    None,
+                    None,
+                )
+            }
+            .map_err(io::Error::from)
+        }
+    }
+
+    /// Bring the destination back to exactly one complete helper.
+    ///
+    /// | destination | backup | stage | action                                   |
+    /// |-------------|--------|-------|------------------------------------------|
+    /// | missing     | yes    | any   | rename backup (the original) back        |
+    /// | missing     | no     | yes   | rename the verified stage into place     |
+    /// | missing     | no     | no    | nothing to recover                       |
+    /// | present     | any    | any   | keep destination, discard obsolete files |
+    ///
+    /// A refused rename returns an error and leaves every file in place, so a
+    /// later process retries; nothing is deleted while the destination is missing.
+    fn recover_locked(p: &Paths, operations: &impl Operations) -> io::Result<()> {
+        if !p.destination.try_exists()? {
+            if p.backup.try_exists()? {
+                // 1177, or an interruption between ReplaceFileW's two renames.
+                // Renaming the original back keeps its DACL and attributes.
+                operations.restore(&p.backup, &p.destination)?;
+            } else if p.stage.try_exists()? {
+                // First install, or the helper vanished after staging.
+                operations.restore(&p.stage, &p.destination)?;
+            } else {
+                return Ok(());
+            }
+        }
+        if !p.destination.is_file() {
+            return Err(io::Error::other("helper destination is not a file; preserving transaction files"));
+        }
+        // Hold the destination against deletion/write throughout cleanup; a
+        // presence check alone would race another process removing the helper.
+        use std::os::windows::fs::OpenOptionsExt;
+        let _held = fs::OpenOptions::new()
+            .read(true)
+            .share_mode(windows::Win32::Storage::FileSystem::FILE_SHARE_READ.0)
+            .open(&p.destination)?;
+        remove_owned(&p.stage)?;
+        remove_owned(&p.backup)?;
+        Ok(())
+    }
+
+    /// Recover an interrupted publication. Locators call this before checking
+    /// that Update.exe exists; their callers log failures and retry next launch.
+    pub fn recover(destination: &Path) -> Result<(), Error> {
+        let p = Paths::new(destination);
+        if !p.has_artifacts()? {
+            return Ok(());
+        }
+        let _lock = crate::lockfile::LockFile::try_acquire_lock(p.lock.clone())?;
+        recover_locked(&p, &Windows)?;
+        Ok(())
+    }
+    pub(crate) fn publish(staged: tempfile::NamedTempFile, destination: &Path) -> Result<(), Error> {
+        publish_with(staged, destination, &Windows)
+    }
+    fn publish_with(staged: tempfile::NamedTempFile, destination: &Path, operations: &impl Operations) -> Result<(), Error> {
+        let p = Paths::new(destination);
+        // A per-destination exclusive handle serializes publication and recovery.
+        let _lock = crate::lockfile::LockFile::try_acquire_lock(p.lock.clone())?;
+        recover_locked(&p, operations)?;
+        // Close the staged write handle before ReplaceFileW opens it, then move
+        // the complete, flushed file to the deterministic stage name. Until that
+        // rename succeeds the random temporary is dropped on any error.
+        let temporary = staged.into_temp_path();
+        unsafe { SetFileAttributesW(PCWSTR(wide(&temporary)?.as_ptr()), FILE_ATTRIBUTE_NORMAL) }.map_err(io::Error::from)?;
+        rename_new(&temporary, &p.stage)?;
+        let _ = temporary.keep();
+        let transaction = || -> io::Result<()> {
+            if p.destination.try_exists()? {
+                // ReplaceFileW gives the replacement the replaced file's DACL,
+                // owner, attributes and streams (native control: zip_compat).
+                operations.replace(&p)
+            } else {
+                operations.restore(&p.stage, &p.destination)
+            }
+        };
+        let error = match transaction() {
+            Ok(()) => return Ok(recover_locked(&p, operations)?),
+            Err(error) => error,
+        };
+        if operations.leave_interrupted() {
+            return Err(error.into());
+        }
+        match error.raw_os_error() {
+            Some(REMOVE_REPLACED) => warn!("ReplaceFileW 1175: original and replacement retain their names; recovering"),
+            Some(MOVE_REPLACEMENT) => warn!("ReplaceFileW 1176: the mandatory backup kept the original; recovering"),
+            Some(MOVE_REPLACEMENT_2) => warn!("ReplaceFileW 1177: original renamed to the backup; restoring it"),
+            _ => warn!("Helper publication failed; recovering: {}", error),
+        }
+        if let Err(recovery) = recover_locked(&p, operations) {
+            // Every remaining file stays for the next process; a missing
+            // destination never licenses cleanup.
+            return Err(io::Error::other(format!("helper publication: {error}; recovery: {recovery}; transaction retained")).into());
+        }
+        Err(error.into())
+    }
+
+    /// Filesystem fault seam, compiled only by the dedicated native test feature.
+    #[cfg(feature = "helper-replacement-tests")]
+    #[derive(Clone, Copy, Debug)]
+    pub enum Fault {
+        /// ReplaceFileW 1175: both files keep their names.
+        RemoveReplaced,
+        /// ReplaceFileW 1176 with a backup name: both files keep their names.
+        MoveReplacement,
+        /// ReplaceFileW 1177: original renamed to the backup, stage kept.
+        MoveReplacement2,
+        /// 1177 followed by a refused rename of the backup back into place.
+        RollbackBlocked,
+        /// Process death after staging, before ReplaceFileW.
+        LeaveBeforeSwap,
+        /// Process death between ReplaceFileW's two renames.
+        LeaveAfterBackupMove,
+        /// Process death after a real ReplaceFileW, before cleanup.
+        LeaveAfterSwap,
+    }
+    #[cfg(feature = "helper-replacement-tests")]
+    impl Operations for Fault {
+        fn replace(&self, p: &Paths) -> io::Result<()> {
+            match self {
+                Self::RemoveReplaced => Err(io::Error::from_raw_os_error(REMOVE_REPLACED)),
+                Self::MoveReplacement => Err(io::Error::from_raw_os_error(MOVE_REPLACEMENT)),
+                Self::MoveReplacement2 | Self::RollbackBlocked | Self::LeaveAfterBackupMove => {
+                    rename_new(&p.destination, &p.backup)?;
+                    Err(io::Error::from_raw_os_error(MOVE_REPLACEMENT_2))
+                }
+                Self::LeaveBeforeSwap => Err(io::Error::other("interrupted before swap")),
+                Self::LeaveAfterSwap => {
+                    Windows.replace(p)?;
+                    Err(io::Error::other("interrupted after swap"))
+                }
+            }
+        }
+        fn restore(&self, source: &Path, destination: &Path) -> io::Result<()> {
+            if matches!(self, Self::RollbackBlocked) && source.extension().is_some_and(|v| v == "vpk-backup") {
+                return Err(io::Error::from_raw_os_error(32));
+            }
+            Windows.restore(source, destination)
+        }
+        fn leave_interrupted(&self) -> bool {
+            matches!(self, Self::LeaveBeforeSwap | Self::LeaveAfterBackupMove | Self::LeaveAfterSwap)
+        }
+    }
+    /// Inspect the exact native API path used by production, independent of host policy.
+    #[cfg(feature = "helper-replacement-tests")]
+    pub fn native_path_for_test(path: &Path) -> Result<Vec<u16>, Error> {
+        Ok(wide(path)?)
+    }
+
+    /// Invoke the production state machine with a filesystem failure seam.
+    #[cfg(feature = "helper-replacement-tests")]
+    pub fn publish_fault(staged: tempfile::NamedTempFile, destination: &Path, fault: Fault) -> Result<(), Error> {
+        staged.as_file().sync_all()?;
+        publish_with(staged, destination, &fault)
+    }
+}
