+    /// Keep a leading UTF-8 BOM in place: an edit that would start inside or
+    /// before it starts after it, so typing at the very start of a BOM file
+    /// writes after the BOM and select-all replaces only the text (#1093).
+    pub fn keep_leading_bom(mut self, enabled: bool) -> Self {
+        self.keep_leading_bom = enabled;
+        self
+    }
+
+    /// `range` moved past a leading BOM when [`Self::keep_leading_bom`] is on.
+    fn after_leading_bom(&self, range: Range<usize>) -> Range<usize> {
+        const BOM: &[u8] = "\u{feff}".as_bytes();
+        if !self.keep_leading_bom
+            || range.start >= BOM.len()
+            || !self.text.bytes().take(BOM.len()).eq(BOM.iter().copied())
+        {
+            return range;
+        }
+        BOM.len()..range.end.max(BOM.len())
+    }
