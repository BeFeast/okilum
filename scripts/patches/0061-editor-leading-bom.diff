+    #[gpui::test]
+    fn edits_never_land_before_a_leading_bom(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        let text = "\u{feff}# T\r\n";
+        for keep in [true, false] {
+            let view = InputView::build_editor(cx, move |state| state.keep_leading_bom(keep));
+            let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+            v.update(|window, cx| {
+                view.input.update(cx, |state, cx| {
+                    state.set_value(text, window, cx);
+                    // Typing at byte zero (Ctrl+Home, then a key).
+                    state.replace_text_in_range(Some(0..0), "X", window, cx);
+                    if !keep {
+                        // Control: without the option the edit lands first.
+                        assert_eq!(state.value().as_ref(), "X\u{feff}# T\r\n");
+                        return;
+                    }
+                    assert_eq!(state.value().as_ref(), "\u{feff}X# T\r\n");
+                    assert_eq!(state.cursor(), "\u{feff}X".len());
+                    // Backspace right after the BOM removes nothing.
+                    state.replace_text_in_range(Some(0..1), "", window, cx);
+                    assert_eq!(state.value().as_ref(), "\u{feff}X# T\r\n");
+                    // Select all, then type: the BOM stays.
+                    let all = state.value().encode_utf16().count();
+                    state.replace_text_in_range(Some(0..all), "Y", window, cx);
+                    assert_eq!(state.value().as_ref(), "\u{feff}Y");
+                    // Undo restores the exact bytes.
+                    state.undo(&super::Undo, window, cx);
+                    state.undo(&super::Undo, window, cx);
+                    assert_eq!(state.value().as_ref(), text);
+                    // An exact replacement is applied as given: a reloaded file
+                    // without a BOM, or a restored version with one.
+                    state.replace_all("no bom", window, cx);
+                    assert_eq!(state.value().as_ref(), "no bom");
+                    state.replace_all(text, window, cx);
+                    assert_eq!(state.value().as_ref(), text);
+                })
+            });
+        }
+    }
