+    /// Parse this view's text the way rendering does, with its Markdown
+    /// extensions, and write the node tree as HTML (`text::render_model`).
+    /// For conformance tests; `None` without text or on a parse error.
+    #[doc(hidden)]
+    pub fn render_model_html(&self) -> Option<String> {
+        let text = self.text.as_ref()?;
+        let mut cx = crate::text::node::NodeContext {
+            markdown_extensions: self.markdown_extensions.clone(),
+            ..Default::default()
+        };
+        let document = match self.format.as_ref()? {
+            TextViewFormat::Markdown => crate::text::format::markdown::parse(text, &mut cx),
+            TextViewFormat::Html => crate::text::format::html::parse(text, &mut cx),
+        }
+        .ok()?;
+        Some(crate::text::render_model::document_html(&document, &cx))
+    }
+
     /// Replace the Markdown extension registry.
     pub fn markdown_extensions(mut self, extensions: MarkdownExtensions) -> Self {
         self.markdown_extensions = Arc::new(extensions);
