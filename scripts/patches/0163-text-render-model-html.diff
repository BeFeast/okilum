+//! The node tree a `TextView` draws, written out as plain HTML.
+//!
+//! For conformance tests: it shows what the view renders after Markdown
+//! parsing *and* the conversion into blocks and inline runs, with the custom
+//! parsers the view was configured with. It is not a display or export path,
+//! and its HTML is only as rich as the node model.
+
+use super::{
+    document::ParsedDocument,
+    node::{BlockNode, ColumnumnAlign, NodeContext, Paragraph, TextMark},
+};
+
+/// Write a parsed document's blocks as HTML; see the module docs.
+pub(crate) fn document_html(document: &ParsedDocument, cx: &NodeContext) -> String {
+    let mut out = String::new();
+    for block in document.blocks.iter() {
+        write_block(&mut out, block, cx, false);
+    }
+    out
+}
+
+fn escape(text: &str) -> String {
+    text.replace('&', "&amp;")
+        .replace('<', "&lt;")
+        .replace('>', "&gt;")
+        .replace('"', "&quot;")
+}
+
+fn write_block(out: &mut String, block: &BlockNode, cx: &NodeContext, tight: bool) {
+    match block {
+        BlockNode::Root { children, .. } => {
+            for child in children {
+                write_block(out, child, cx, tight);
+            }
+        }
+        BlockNode::Paragraph(paragraph) => {
+            if tight {
+                write_inline(out, paragraph, cx);
+                out.push('\n');
+            } else {
+                out.push_str("<p>");
+                write_inline(out, paragraph, cx);
+                out.push_str("</p>\n");
+            }
+        }
+        BlockNode::Heading {
+            level, children, ..
+        } => {
+            out.push_str(&format!("<h{level}>"));
+            write_inline(out, children, cx);
+            out.push_str(&format!("</h{level}>\n"));
+        }
+        BlockNode::Blockquote { children, .. } => {
+            out.push_str("<blockquote>\n");
+            for child in children {
+                write_block(out, child, cx, false);
+            }
+            out.push_str("</blockquote>\n");
+        }
+        BlockNode::List {
+            children, ordered, ..
+        } => {
+            // The node model keeps `spread` per item only; a list is loose
+            // when any of its items is.
+            let loose = children
+                .iter()
+                .any(|item| matches!(item, BlockNode::ListItem { spread: true, .. }));
+            out.push_str(if *ordered { "<ol>\n" } else { "<ul>\n" });
+            for child in children {
+                write_block(out, child, cx, !loose);
+            }
+            out.push_str(if *ordered { "</ol>\n" } else { "</ul>\n" });
+        }
+        BlockNode::ListItem {
+            children, checked, ..
+        } => {
+            out.push_str("<li>");
+            match checked {
+                Some(true) => out.push_str("<input checked=\"\" disabled=\"\" type=\"checkbox\" /> "),
+                Some(false) => out.push_str("<input disabled=\"\" type=\"checkbox\" /> "),
+                None => {}
+            }
+            for child in children {
+                write_block(out, child, cx, tight);
+            }
+            out.push_str("</li>\n");
+        }
+        BlockNode::CodeBlock(code) => {
+            match code.lang() {
+                Some(lang) if !lang.is_empty() => {
+                    out.push_str(&format!("<pre><code class=\"language-{}\">", escape(&lang)))
+                }
+                _ => out.push_str("<pre><code>"),
+            }
+            out.push_str(&escape(&code.code()));
+            out.push_str("</code></pre>\n");
+        }
+        BlockNode::Custom(node) => {
+            out.push_str(&format!("<x-{}>", node.name()));
+            if node.parts.is_empty() {
+                out.push_str(&escape(node.as_text()));
+            } else {
+                let mut node = node.clone();
+                node.prepare_parts(cx);
+                for part in &node.parts {
+                    for block in part.document.blocks.iter() {
+                        write_block(out, block, cx, false);
+                    }
+                }
+            }
+            out.push_str(&format!("</x-{}>\n", node.name()));
+        }
+        BlockNode::Table(table) => {
+            out.push_str("<table>\n");
+            for (row_ix, row) in table.children.iter().enumerate() {
+                let cell = if row_ix == 0 { "th" } else { "td" };
+                if row_ix == 0 {
+                    out.push_str("<thead>\n");
+                } else if row_ix == 1 {
+                    out.push_str("<tbody>\n");
+                }
+                out.push_str("<tr>\n");
+                for (column, value) in row.children.iter().enumerate() {
+                    let align = match table.column_aligns.get(column) {
+                        Some(ColumnumnAlign::Center) => " align=\"center\"",
+                        Some(ColumnumnAlign::Right) => " align=\"right\"",
+                        _ => "",
+                    };
+                    out.push_str(&format!("<{cell}{align}>"));
+                    write_inline(out, &value.children, cx);
+                    out.push_str(&format!("</{cell}>\n"));
+                }
+                out.push_str("</tr>\n");
+                if row_ix == 0 {
+                    out.push_str("</thead>\n");
+                }
+            }
+            if table.children.len() > 1 {
+                out.push_str("</tbody>\n");
+            }
+            out.push_str("</table>\n");
+        }
+        BlockNode::Break { .. } => out.push_str("<br />\n"),
+        BlockNode::HorizontalRule { .. } => out.push_str("<hr />\n"),
+        BlockNode::Definition { .. } => {}
+        BlockNode::Unknown => out.push_str("<x-unknown></x-unknown>\n"),
+    }
+}
+
+/// Inline runs as nested tags, one group per stretch of identical marks.
+fn write_inline(out: &mut String, paragraph: &Paragraph, cx: &NodeContext) {
+    for node in &paragraph.children {
+        if let Some(image) = &node.image {
+            if let Some(link) = &image.link {
+                out.push_str(&format!("<a href=\"{}\">", escape(&link.url)));
+            }
+            out.push_str(&format!(
+                "<img src=\"{}\" alt=\"{}\"",
+                escape(&image.url.to_string()),
+                escape(image.alt.as_deref().unwrap_or(""))
+            ));
+            if let Some(title) = &image.title {
+                out.push_str(&format!(" title=\"{}\"", escape(title)));
+            }
+            out.push_str(" />");
+            if image.link.is_some() {
+                out.push_str("</a>");
+            }
+            continue;
+        }
+        let text = node.text.as_ref();
+        let mut cuts = vec![0, text.len()];
+        for (range, _) in &node.marks {
+            cuts.push(range.start.min(text.len()));
+            cuts.push(range.end.min(text.len()));
+        }
+        cuts.sort_unstable();
+        cuts.dedup();
+        for pair in cuts.windows(2) {
+            let (start, end) = (pair[0], pair[1]);
+            let Some(segment) = text.get(start..end) else {
+                continue;
+            };
+            let mut mark = TextMark::default();
+            for (range, m) in &node.marks {
+                if range.start <= start && end <= range.end {
+                    mark.merge(m.clone());
+                }
+            }
+            let mut close = Vec::new();
+            if let Some(link) = &mark.link {
+                let link = link
+                    .identifier
+                    .as_ref()
+                    .and_then(|id| cx.link_refs.get(id))
+                    .unwrap_or(link);
+                out.push_str(&format!("<a href=\"{}\"", escape(&link.url)));
+                if let Some(title) = &link.title {
+                    out.push_str(&format!(" title=\"{}\"", escape(title)));
+                }
+                out.push('>');
+                close.push("</a>");
+            }
+            for (on, open, end_tag) in [
+                (mark.bold, "<strong>", "</strong>"),
+                (mark.italic, "<em>", "</em>"),
+                (mark.strikethrough, "<del>", "</del>"),
+                (mark.underline, "<u>", "</u>"),
+                (mark.highlight.is_some(), "<mark>", "</mark>"),
+                (mark.code, "<code>", "</code>"),
+            ] {
+                if on {
+                    out.push_str(open);
+                    close.push(end_tag);
+                }
+            }
+            // A line break run: the renderer breaks the line on a newline.
+            out.push_str(&escape(segment).replace('\n', "<br />\n"));
+            for tag in close.iter().rev() {
+                out.push_str(tag);
+            }
+        }
+    }
+}
