+/// One retained layout, sharing shaped lines with the last painted frame. No
+/// duplicate source string. Popup hover/caret blink must not shape a multi-MB
+/// unwrapped line again when source and paint inputs are unchanged.
+pub(super) struct SourceShapeCache {
+    pub layout: LastLayout,
+    pub runs: Vec<gpui::TextRun>,
+    pub longest_width: Pixels,
+}
+impl SourceShapeCache {
+    pub(super) fn matches(&self, next: &LastLayout, runs: &[gpui::TextRun]) -> bool {
+        let old = &self.layout;
+        old.source_stamp == next.source_stamp
+            && old.presentation_epoch == next.presentation_epoch
+            && old.font == next.font && old.font_size == next.font_size
+            && old.scale_factor == next.scale_factor
+            && old.visible_buffer_lines == next.visible_buffer_lines
+            && old.rows == next.rows && old.wrap_width == next.wrap_width
+            && old.wrapping_indent == next.wrapping_indent
+            && old.text_align == next.text_align && old.content_width == next.content_width
+            && self.runs == runs
+    }
+}
