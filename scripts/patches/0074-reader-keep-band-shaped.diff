+
+type RenderBlockFn = dyn Fn(usize, &mut Window, &mut App) -> AnyElement;
+
+/// How far below the viewport blocks are kept shaped. Matches the overdraw of
+/// the virtualized list (`TextViewState::prepare_list_for_document`).
+const KEEP_SHAPED_BELOW: Pixels = px(1000.);
+
+/// Keeps the text of the blocks the list measured below the viewport shaped
+/// until they scroll into view (#1312).
+///
+/// The list lays out a block once when it enters its overdraw band, to learn
+/// its height, and then does not render it again until it becomes visible.
+/// GPUI keeps a shaped line only for the frame after the one that used it, so
+/// by the time the block scrolls in its text is shaped a second time, in the
+/// frame that shows it. Laying the band out again in every frame keeps those
+/// lines in the cache: the frame that shows a block finds them shaped.
+///
+/// The work happens only in frames GPUI draws anyway; a view with nothing to
+/// redraw does no work here. Blocks above the scroll top are not kept: the
+/// list exposes no positions for them.
+struct KeepBandShaped {
+    list_state: ListState,
+    render_item: Rc<RenderBlockFn>,
+}
+
+impl IntoElement for KeepBandShaped {
+    type Element = Self;
+
+    fn into_element(self) -> Self::Element {
+        self
+    }
+}
+
+impl Element for KeepBandShaped {
+    type RequestLayoutState = ();
+    type PrepaintState = ();
+
+    fn id(&self) -> Option<ElementId> {
+        Some("keep-band-shaped".into())
+    }
+
+    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {
+        None
+    }
+
+    fn request_layout(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (LayoutId, Self::RequestLayoutState) {
+        let mut style = Style::default();
+        style.position = gpui::Position::Absolute;
+        (window.request_layout(style, [], cx), ())
+    }
+
+    fn prepaint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut Self::RequestLayoutState,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Self::PrepaintState {
+        // Runs after the list's prepaint (it is the list's next sibling), so the
+        // list has measured this frame's band already.
+        let viewport = self.list_state.viewport_bounds();
+        if viewport.size.width <= px(0.) {
+            return;
+        }
+        let band_end = viewport.bottom() + KEEP_SHAPED_BELOW;
+        let space = size(
+            AvailableSpace::Definite(viewport.size.width),
+            AvailableSpace::MinContent,
+        );
+        let count = self.list_state.item_count();
+        let mut ix = self.list_state.logical_scroll_top().item_ix;
+        while ix < count {
+            let Some(bounds) = self.list_state.bounds_for_item(ix) else {
+                break;
+            };
+            if bounds.top() >= band_end {
+                break;
+            }
+            if bounds.top() >= viewport.bottom() {
+                // Not painted this frame: lay it out at the list's width so the
+                // same lines are requested from the cache.
+                let mut element = (self.render_item)(ix, window, cx);
+                element.layout_as_root(space, window, cx);
+            }
+            ix += 1;
+        }
+    }
+
+    fn paint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut Self::RequestLayoutState,
+        _: &mut Self::PrepaintState,
+        _: &mut Window,
+        _: &mut App,
+    ) {
     }
 }
