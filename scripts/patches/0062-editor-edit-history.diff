+    /// Move this editor's edit history out: its undo and redo transactions and
+    /// selection, tied to the current text. The editor keeps its text and
+    /// starts a new, empty history. See [`Self::restore_edit_history`].
+    pub fn take_edit_history(&mut self) -> EditHistory {
+        self.undo_manager.commit_transaction();
+        self.undo_manager.break_transaction_coalescing();
+        EditHistory {
+            text: self.value(),
+            undo: std::mem::replace(&mut self.undo_manager, UndoManager::new()),
+            selected: self.selected_range.into(),
+            reversed: self.selection_reversed,
+        }
+    }
+
+    /// Adopt `history` taken from an editor that showed exactly this text:
+    /// Undo then continues with the edits made before, and the selection is
+    /// back. Returns false, and changes nothing, when the text differs (#1095).
+    pub fn restore_edit_history(&mut self, history: EditHistory, cx: &mut Context<Self>) -> bool {
+        if self.value() != history.text {
+            return false;
+        }
+        self.undo_manager = history.undo;
+        self.set_selected_range(history.selected, cx);
+        self.selection_reversed = history.reversed;
+        cx.notify();
+        true
+    }
+
