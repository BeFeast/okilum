+/// A secondary (right) press anywhere on a rendered Markdown table: the
+/// snapshot of the pressed table and the exact source bytes it was parsed from.
+#[derive(Debug, Clone)]
+pub struct TableSecondaryPress {
+    data: Arc<TableData>,
+    source: Option<SharedString>,
+}
+
+impl TableSecondaryPress {
+    pub(crate) fn new(data: Arc<TableData>, source: Option<SharedString>) -> Self {
+        Self { data, source }
+    }
+
+    /// The pressed table, with plain-text cells and its source span.
+    pub fn data(&self) -> &TableData {
+        &self.data
+    }
+
+    /// The table's Markdown exactly as written in the text the view parsed
+    /// (escapes, delimiter row, inline markup and line endings kept).
+    pub fn source(&self) -> Option<&str> {
+        self.source.as_deref()
+    }
+}
+
+pub(crate) type TableSecondaryPressFn =
+    dyn Fn(&TableSecondaryPress, &gpui::MouseDownEvent, &mut Window, &mut App) + Send + Sync;
