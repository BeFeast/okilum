+/// The secondary-press listener for a whole table, when a
+/// [`crate::text::TextView::on_table_secondary_press`] hook is installed.
+/// The snapshot is the table's cached frame data, so it costs nothing per frame.
+fn table_secondary_press(
+    table: &Table,
+    node_cx: &NodeContext,
+) -> Option<impl Fn(&gpui::MouseDownEvent, &mut Window, &mut App) + 'static> {
+    let f = node_cx.table_secondary_press.clone()?;
+    let press = super::text_view::TableSecondaryPress::new(
+        table.frame_data(false),
+        table.source.clone(),
+    );
+    Some(move |event: &gpui::MouseDownEvent, window: &mut Window, cx: &mut App| {
+        f(&press, event, window, cx)
+    })
+}
