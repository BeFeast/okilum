+#[cfg(test)]
+mod font_presentation_regressions {
+    use super::{InlineHighlight, text_runs};
+    use gpui::{
+        FontWeight, HighlightStyle, LineFragment, TextStyle, TextSystem, WindowTextSystem, px,
+    };
+    use std::sync::Arc;
+    use unicode_segmentation::UnicodeSegmentation;
+
+    fn system() -> WindowTextSystem {
+        // Both faces cover every code point, but Mono is twice as wide. A
+        // missing-glyph-only policy cannot accidentally pass these controls.
+        WindowTextSystem::new(Arc::new(TextSystem::new(Arc::new(
+            super::test_fonts::WideMonoTextSystem,
+        ))))
+    }
+
+    #[test]
+    fn code_block_emoji_gets_color_font_despite_primary_coverage() {
+        let text = "// ✅ ❌ ✔ ✅︎";
+        let style = TextStyle {
+            font_family: "Mono".into(),
+            ..Default::default()
+        };
+        let color = gpui::rgb(0x287a30);
+        let highlights = [(
+            0..text.len(),
+            InlineHighlight::from(HighlightStyle {
+                color: Some(color),
+                font_weight: Some(FontWeight::BOLD),
+                ..Default::default()
+            }),
+        )];
+        let runs = text_runs(text, &style, &highlights);
+        let mut offset = 0;
+        let mut colored = Vec::new();
+        for run in &runs {
+            let span = &text[offset..offset + run.len];
+            if run.font.family.as_ref() != "Mono" {
+                colored.push(span);
+                assert_eq!(run.font.weight, FontWeight::NORMAL);
+                let expected = if cfg!(target_os = "macos") {
+                    "Apple Color Emoji"
+                } else if cfg!(target_os = "windows") {
+                    "Segoe UI Emoji"
+                } else {
+                    "Noto Color Emoji"
+                };
+                assert_eq!(run.font.family.as_ref(), expected);
+            }
+            assert_eq!(run.color, color);
+            offset += run.len;
+        }
+        assert_eq!(
+            colored,
+            ["✅", "❌"],
+            "code emoji presentation must override primary glyph coverage"
+        );
+        assert_eq!(offset, text.len());
+        let system = system();
+        let actual = system.layout_line(text, px(20.), &runs, None).width;
+        let old = system
+            .layout_line(text, px(20.), &[style.to_run(text.len())], None)
+            .width;
+        assert!(
+            actual < old,
+            "positive control: chosen font changes real shaping metrics"
+        );
+    }
+
+    #[test]
+    fn emoji_wrap_width_matches_shaped_width_without_splitting_clusters() {
+        let text = "x👩🏽‍💻✅❌z";
+        let style = TextStyle {
+            font_family: "Mono".into(),
+            ..Default::default()
+        };
+        let system = system();
+        let size = px(20.);
+        let runs = text_runs(text, &style, &[]);
+        let drawn = system.layout_line(text, size, &runs, None).width;
+        let fragments =
+            crate::font_presentation::line_fragments(text, &style.font(), size, &system);
+        let measured = fragments
+            .iter()
+            .map(|f| match f {
+                LineFragment::Text { text } => {
+                    system
+                        .layout_line(text, size, &[style.to_run(text.len())], None)
+                        .width
+                }
+                LineFragment::Element { width, .. } => *width,
+            })
+            .sum::<gpui::Pixels>();
+        assert_eq!(
+            measured, drawn,
+            "wrapping and painting must resolve the same fonts"
+        );
+        assert_eq!(
+            fragments
+                .iter()
+                .filter(|f| matches!(f, LineFragment::Element { .. }))
+                .count(),
+            3
+        );
+        let mut wrapper = system.line_wrapper(style.font(), size);
+        let boundaries = wrapper
+            .wrap_line(&fragments, px(60.))
+            .map(|b| b.ix)
+            .collect::<Vec<_>>();
+        let valid = text
+            .grapheme_indices(true)
+            .map(|(i, _)| i)
+            .chain(std::iter::once(text.len()))
+            .collect::<Vec<_>>();
+        assert!(
+            !boundaries.is_empty(),
+            "positive control: narrow width must wrap"
+        );
+        assert!(
+            boundaries.iter().all(|b| valid.contains(b)),
+            "wrap must keep a complete emoji sequence"
+        );
+    }
+}
