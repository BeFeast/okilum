diff --git a/crates/base/src/font_presentation.rs b/crates/base/src/font_presentation.rs
new file mode 100644
--- /dev/null
+++ b/crates/base/src/font_presentation.rs
@@ -0,0 +1,185 @@
+//! Unicode emoji presentation is a font choice, not a missing-glyph fallback.
+use gpui::{
+    Font, FontFeatures, FontStyle, FontWeight, LineFragment, Pixels, TextRun, TextStyle,
+    WindowTextSystem,
+};
+use std::{borrow::Cow, ops::Range};
+use unicode_properties::{EmojiStatus, UnicodeEmoji};
+use unicode_segmentation::UnicodeSegmentation;
+
+fn family() -> &'static str {
+    if cfg!(target_os = "macos") {
+        "Apple Color Emoji"
+    } else if cfg!(target_os = "windows") {
+        "Segoe UI Emoji"
+    } else {
+        "Noto Color Emoji"
+    }
+}
+
+fn emoji(grapheme: &str) -> bool {
+    // Explicit text presentation takes precedence over the default property.
+    if grapheme.contains('\u{fe0e}') {
+        return false;
+    }
+    if grapheme.contains('\u{fe0f}') {
+        return true;
+    }
+    let first = grapheme.chars().next().unwrap_or('\0');
+    matches!(
+        first.emoji_status(),
+        EmojiStatus::EmojiPresentation
+            | EmojiStatus::EmojiPresentationAndModifierBase
+            | EmojiStatus::EmojiPresentationAndEmojiComponent
+            | EmojiStatus::EmojiPresentationAndModifierAndEmojiComponent
+    ) || (grapheme.contains('\u{200d}') && grapheme.chars().any(UnicodeEmoji::is_emoji_char))
+        || (grapheme.contains('\u{20e3}') && matches!(first, '0'..='9' | '#' | '*'))
+}
+
+fn ranges(text: &str) -> impl Iterator<Item = Range<usize>> + '_ {
+    text.grapheme_indices(true)
+        .filter_map(|(start, cluster)| emoji(cluster).then_some(start..start + cluster.len()))
+}
+
+pub(crate) fn has_emoji(text: &str) -> bool {
+    !text.is_ascii() && ranges(text).next().is_some()
+}
+
+fn emoji_font(original: &Font) -> Font {
+    Font {
+        family: family().into(),
+        weight: FontWeight::NORMAL,
+        style: FontStyle::Normal,
+        features: FontFeatures::default(),
+        ..original.clone()
+    }
+}
+
+/// Apply presentation before shaping, even if the authored font covers a glyph.
+/// Emoji clusters use the decoration at their start; a syntax/IME run boundary
+/// inside a ZWJ sequence must not split its font run. Text and byte offsets stay exact.
+pub(crate) fn font_runs<'a>(text: &str, runs: &'a [TextRun]) -> Cow<'a, [TextRun]> {
+    if text.is_ascii() {
+        return Cow::Borrowed(runs);
+    }
+    let mut emojis = ranges(text).peekable();
+    if emojis.peek().is_none() {
+        return Cow::Borrowed(runs);
+    }
+    debug_assert_eq!(runs.iter().map(|r| r.len).sum::<usize>(), text.len());
+    if runs.is_empty() || runs.iter().map(|r| r.len).sum::<usize>() != text.len() {
+        return Cow::Borrowed(runs);
+    }
+    let mut result = Vec::with_capacity(runs.len() + 2);
+    let (mut offset, mut index, mut end) = (0, 0, runs[0].len);
+    for range in emojis {
+        while offset < range.start {
+            while offset >= end {
+                index += 1;
+                end += runs[index].len;
+            }
+            let next = range.start.min(end);
+            result.push(TextRun {
+                len: next - offset,
+                ..runs[index].clone()
+            });
+            offset = next;
+        }
+        while offset >= end {
+            index += 1;
+            end += runs[index].len;
+        }
+        result.push(TextRun {
+            len: range.len(),
+            font: emoji_font(&runs[index].font),
+            ..runs[index].clone()
+        });
+        offset = range.end;
+    }
+    while offset < text.len() {
+        while offset >= end {
+            index += 1;
+            end += runs[index].len;
+        }
+        let next = text.len().min(end);
+        result.push(TextRun {
+            len: next - offset,
+            ..runs[index].clone()
+        });
+        offset = next;
+    }
+    Cow::Owned(result)
+}
+
+/// Measure each emoji as the same shaped cluster that will be painted. Feed it
+/// to GPUI's upstream wrapper as one atomic element, preserving UTF-8 lengths.
+pub(crate) fn line_fragments<'a>(
+    text: &'a str,
+    font: &Font,
+    size: Pixels,
+    system: &WindowTextSystem,
+) -> Vec<LineFragment<'a>> {
+    if text.is_ascii() {
+        return vec![LineFragment::text(text)];
+    }
+    let mut fragments = Vec::new();
+    let mut offset = 0;
+    for range in ranges(text) {
+        if offset < range.start {
+            fragments.push(LineFragment::text(&text[offset..range.start]));
+        }
+        let run = TextRun {
+            font: emoji_font(font),
+            ..TextStyle::default().to_run(range.len())
+        };
+        let width = system
+            .layout_line(&text[range.clone()], size, &[run], None)
+            .width;
+        fragments.push(LineFragment::element(width, range.len()));
+        offset = range.end;
+    }
+    if offset < text.len() || fragments.is_empty() {
+        fragments.push(LineFragment::text(&text[offset..]));
+    }
+    fragments
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use core::prelude::v1::test;
+
+    #[test]
+    fn unicode_presentation_overrides_coverage_but_respects_text_selectors() {
+        for text in ["✅", "❌", "⚠️", "✔️", "👍🏽", "👩🏽‍💻", "🇮🇱", "1️⃣", "1⃣"]
+        {
+            assert!(has_emoji(text), "{text}");
+        }
+        for text in ["✔", "⚠", "©", "1", "#", "✅︎", "A", "ב‍ב", "क्‍ष"] {
+            assert!(!has_emoji(text), "{text}");
+        }
+    }
+
+    #[test]
+    fn cluster_font_runs_keep_source_bytes_and_surrounding_decorations() {
+        let cluster = "👩🏽‍💻";
+        let text = format!("a{cluster}b");
+        let mut first = TextStyle::default().to_run(1 + '👩'.len_utf8());
+        first.font.family = "Mono".into();
+        let mut second = first.clone();
+        second.len = text.len() - first.len;
+        second.color = gpui::rgb(0xff0000);
+        let input = [first.clone(), second.clone()];
+        let actual = font_runs(&text, &input);
+        assert_eq!(
+            actual.iter().map(|r| r.len).collect::<Vec<_>>(),
+            [1, cluster.len(), 1]
+        );
+        assert_eq!(actual[0].font, first.font);
+        assert_eq!(actual[0].color, first.color);
+        assert_eq!(actual[1].font.family.as_ref(), family());
+        assert_eq!(actual[2].font, second.font);
+        assert_eq!(actual[2].color, second.color);
+        assert_eq!(actual.iter().map(|r| r.len).sum::<usize>(), text.len());
+    }
+}
