+    /// [`BlockProvider`], with the block left out (shown as source) while
+    /// the caret or selection touches it, as Live Preview does.
+    struct RevealingBlockProvider;
+    impl ProjectionProvider for RevealingBlockProvider {
+        fn compose(
+            &self,
+            source: &super::super::projection::SourceSnapshot,
+            active: &ActiveSource,
+        ) -> Option<Arc<dyn super::super::projection::SourceProjection>> {
+            let start = source.text.find('|')?;
+            let end = source.text.rfind('|')? + 1;
+            let (from, to) = (active.anchor.0.min(active.head.0), active.anchor.0.max(active.head.0));
+            let blocks = if from <= end && start <= to {
+                Vec::new()
+            } else {
+                vec![super::super::projection::ProjectionBlock {
+                    lines: 1..4,
+                    source: SourceByte(start)..SourceByte(end),
+                    key: 7,
+                }]
+            };
+            Some(Arc::new(RevealingBlockProjection(source.clone(), blocks)))
+        }
+    }
+    struct RevealingBlockProjection(
+        super::super::projection::SourceSnapshot,
+        Vec<super::super::projection::ProjectionBlock>,
+    );
+    impl super::super::projection::SourceProjection for RevealingBlockProjection {
+        fn blocks(&self) -> &[super::super::projection::ProjectionBlock] {
+            &self.1
+        }
+        fn source(&self) -> &super::super::projection::SourceSnapshot {
+            &self.0
+        }
+        fn text(&self) -> &str {
+            &self.0.text
+        }
+        fn styles(&self) -> &[super::super::projection::ProjectionStyle] {
+            &[]
+        }
+        fn to_projected(
+            &self,
+            source: SourceByte,
+            _: ConcealBias,
+        ) -> Option<super::super::projection::ProjectedByte> {
+            (source.0 <= self.0.text.len()).then_some(super::super::projection::ProjectedByte(source.0))
+        }
+        fn to_source(
+            &self,
+            display: super::super::projection::ProjectedByte,
+            _: ConcealBias,
+        ) -> Option<SourceByte> {
+            (display.0 <= self.0.text.len()).then_some(SourceByte(display.0))
+        }
+    }
+
+    /// #1642: a double-click on a rendered block opens its source with the
+    /// whole block selected, whether or not the first press's reveal was
+    /// painted before the second press. A plain double-click on text still
+    /// selects a word.
+    #[gpui::test]
+    fn double_click_on_a_rendered_block_selects_its_whole_source(cx: &mut TestAppContext) {
+        const TEXT: &str = "top word\n| a |\n|---|\n| b |\nbottom";
+        let block = TEXT.find('|').unwrap()..TEXT.rfind('|').unwrap() + 1;
+        for repaint_between in [true, false] {
+            cx.update(crate::init);
+            let view = InputView::build_editor(cx, |state| {
+                state
+                    .folding(false)
+                    .searchable(false)
+                    .line_number(false)
+                    .wrapping_indent(super::super::WrappingIndent::None)
+            });
+            let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+            v.update(|window, cx| {
+                view.input.update(cx, |state, cx| {
+                    state.set_value(TEXT, window, cx);
+                    state.set_block_renderer(Some(std::rc::Rc::new(|_, _, _, _, _| {
+                        div().h(px(100.)).w_full().into_any_element()
+                    })));
+                    state.set_projection_provider(Some(Arc::new(RevealingBlockProvider)), cx);
+                    window.activate_window();
+                    state.focus(window, cx);
+                    state.set_selected_range(0..0, cx);
+                })
+            });
+            v.run_until_parked();
+            let (inside, word) = v.update(|_, cx| {
+                let state = view.input.read(cx);
+                let painted = state.painted_blocks.borrow();
+                let (_, blocks) = painted.as_ref().expect("a painted frame");
+                // Positive control: the block is rendered, not source.
+                assert_eq!(blocks.len(), 1, "the block is rendered");
+                let layout = state.last_layout.as_ref().unwrap();
+                let origin = state.input_bounds.origin;
+                let word = point(origin.x + px(2.), origin.y + layout.line_height / 2.);
+                (blocks[0].1.center(), word)
+            });
+            let press = |v: &mut VisualTestContext, at, count| {
+                v.simulate_event(gpui::MouseDownEvent {
+                    position: at,
+                    button: MouseButton::Left,
+                    click_count: count,
+                    ..Default::default()
+                });
+                v.simulate_event(gpui::MouseUpEvent {
+                    position: at,
+                    button: MouseButton::Left,
+                    click_count: count,
+                    ..Default::default()
+                });
+            };
+            press(&mut v, inside, 1);
+            if repaint_between {
+                v.run_until_parked();
+                v.update(|_, cx| {
+                    let state = view.input.read(cx);
+                    assert!(block.contains(&state.cursor()), "one press reveals the block");
+                    let painted = state.painted_blocks.borrow();
+                    assert!(painted.as_ref().unwrap().1.is_empty(), "the block shows its source");
+                });
+            }
+            press(&mut v, inside, 2);
+            v.run_until_parked();
+            v.update(|_, cx| {
+                let state = view.input.read(cx);
+                assert_eq!(state.selected_range(), block, "repaint between presses: {repaint_between}");
+                assert_eq!(state.cursor(), block.start, "the caret stays at the block start");
+            });
+            // Positive control: a double-click on plain text selects a word.
+            press(&mut v, word, 1);
+            press(&mut v, word, 2);
+            v.run_until_parked();
+            v.update(|_, cx| assert_eq!(view.input.read(cx).selected_range(), 0..3));
+        }
+    }
