 impl LastLayout {
+    pub(super) fn source_for_anchor(&self, current: SourceStamp) -> Option<Cow<'_, str>> {
+        if self.source_stamp.document != current.document {
+            return None;
+        }
+        if let Some(pin) = &self.projection {
+            let source = pin.projection.source();
+            return (source.stamp == self.source_stamp)
+                .then(|| Cow::Borrowed(source.text.as_ref()));
+        }
+        self.anchor_source.as_ref().map(|source| Cow::Owned(source.to_string()))
+    }
