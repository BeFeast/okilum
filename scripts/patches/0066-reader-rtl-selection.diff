+    /// The hard lines with right-to-left text (computed once per layout).
+    pub(crate) fn rtl_lines(&self) -> std::rc::Rc<Vec<RtlLine>> {
+        self.rtl
+            .get_or_init(|| {
+                let bounds = self.layout.bounds();
+                let line_height = self.layout.line_height();
+                let text = self.layout.text();
+                let mut out = Vec::new();
+                let mut top = bounds.origin.y;
+                let mut start = 0;
+                for (line, line_text) in self.layout.line_layouts().iter().zip(text.split('\n')) {
