+                            layout.runs[b.run_ix].glyphs[b.glyph_ix].position.x
+                        };
+                        let mut rows = Vec::new();
+                        let mut x0 = gpui::px(0.);
+                        for x1 in line.wrap_boundaries.iter().map(x_at).chain([layout.width]) {
+                            let width = x1 - x0;
+                            let offset = match self.align {
+                                TextAlign::Right => bounds.size.width - width,
+                                TextAlign::Center => (bounds.size.width - width) / 2.,
+                                TextAlign::Left => gpui::px(0.),
+                            };
+                            rows.push((x0, x1, offset));
+                            x0 = x1;
+                        }
+                        out.push(RtlLine {
