+
+/// A hard line with right-to-left text: its grapheme cells in the unwrapped
+/// layout's x, and its wrapped rows. gpui's hit-testing and positions assume x
+/// grows with the byte index, which right-to-left runs reverse; these cells
+/// give each character its drawn span instead (#1208).
+pub(crate) struct RtlLine {
+    start: usize,
+    len: usize,
+    top: Pixels,
+    left: Pixels,
+    line_height: Pixels,
+    geometry: crate::input::bidi_geometry::Geometry,
+    /// `(first x, end x, alignment offset)` of each wrapped row.
+    rows: Vec<(Pixels, Pixels, Pixels)>,
+}
+
+impl RtlLine {
+    fn row_of_x(&self, x: Pixels) -> usize {
+        self.rows
+            .iter()
+            .position(|(x0, x1, _)| *x0 <= x && x < *x1)
+            .unwrap_or(self.rows.len().saturating_sub(1))
+    }
+
+    /// The window-space box `(left, top, width)` of the cell starting at
+    /// `local`, the line-relative byte offset of a grapheme.
+    fn cell_box(&self, local: usize) -> Option<(Pixels, Pixels, Pixels)> {
+        let cell = self.geometry.cells.iter().find(|c| c.source.start == local)?;
+        let row = self.row_of_x(cell.left);
+        let (x0, _, offset) = self.rows[row];
+        Some((
+            self.left + offset + cell.left - x0,
+            self.top + self.line_height * row,
+            cell.right - cell.left,
+        ))
+    }
+
+    fn contains_y(&self, y: Pixels) -> bool {
+        self.top <= y && y < self.top + self.line_height * self.rows.len()
+    }
+
+    /// The cell under a window-space point, as a line-relative byte offset.
+    fn index_at(&self, point: Point<Pixels>) -> usize {
+        let row = (((point.y - self.top) / self.line_height).floor().max(0.) as usize)
+            .min(self.rows.len().saturating_sub(1));
+        let (x0, x1, offset) = self.rows[row];
+        let x = (point.x - self.left - offset + x0).clamp(x0, x1);
+        self.geometry
+            .cells
+            .iter()
+            .filter(|c| self.row_of_x(c.left) == row)
+            .min_by(|a, b| {
+                let distance = |c: &&crate::input::bidi_geometry::Cell| {
+                    if c.left <= x && x < c.right {
+                        gpui::px(0.)
+                    } else {
+                        (c.left - x).abs().min((c.right - x).abs())
+                    }
+                };
+                distance(a)
+                    .partial_cmp(&distance(b))
+                    .unwrap_or(std::cmp::Ordering::Equal)
+            })
+            .map_or(0, |c| c.source.start)
+    }
 }
 
