+#[cfg(test)]
+mod boundary_work {
+    use std::cell::Cell;
+    thread_local! {
+        static WORK: Cell<(usize, usize)> = const { Cell::new((0, 0)) };
+    }
+    pub(super) fn cluster() {
+        WORK.with(|w| {
+            let (c, p) = w.get();
+            w.set((c + 1, p));
+        });
+    }
+    pub(super) fn comparison() {
+        WORK.with(|w| {
+            let (c, p) = w.get();
+            w.set((c, p + 1));
+        });
+    }
+    pub(super) fn take() -> (usize, usize) {
+        WORK.with(|w| w.replace((0, 0)))
+    }
+}
