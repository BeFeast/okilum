+
+    fn a11y_synthetic_children(
+        &mut self,
+        prepaint: &mut Self::PrepaintState,
+        builder: &mut gpui::A11ySubtreeBuilder,
+    ) {
+        // Use this frame's validated marker rows, never last frame's painted
+        // hit targets. Raw/revealed markers and block-replaced rows stay absent.
+        for (index, rows) in prepaint.marker_rows.iter().enumerate() {
+            let Some(line) = prepaint.last_layout.visible_buffer_lines.get(index) else {
+                continue;
+            };
+            if prepaint.block_lines.iter().any(|lines| lines.contains(line)) {
+                continue;
+            }
+            for row in rows.iter().flatten() {
+                for (range, node) in row.task_accessibility_nodes() {
+                    let id = builder.synthetic_node_id(("task", range.start, range.end));
+                    builder.push_child(id, node);
+                }
+            }
+        }
     }

