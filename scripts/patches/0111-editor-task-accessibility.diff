 pub(super) type PaintedTask = (Range<usize>, bool, Bounds<Pixels>);

 impl RowPaint {
+    /// Expose precisely the task shapes admitted by projection validation.
+    pub(super) fn task_accessibility_nodes(
+        &self,
+    ) -> impl Iterator<Item = (Range<usize>, gpui::accesskit::Node)> + '_ {
+        self.shapes.iter().filter_map(|shape| {
+            let MarkerKind::Task { checked } = &shape.kind else {
+                return None;
+            };
+            let mut node = gpui::accesskit::Node::new(gpui::accesskit::Role::CheckBox);
+            node.set_label("Task");
+            node.set_toggled(if *checked {
+                gpui::accesskit::Toggled::True
+            } else {
+                gpui::accesskit::Toggled::False
+            });
+            Some((shape.source.clone(), node))
+        })
+    }
