diff --git a/crates/base/src/input/base/layout.rs b/crates/base/src/input/base/layout.rs
index 50d02923..db5faf12 100644
--- a/crates/base/src/input/base/layout.rs
+++ b/crates/base/src/input/base/layout.rs
@@ -11,6 +11,77 @@ pub(crate) struct WhitespaceIndicators {
     pub(crate) tab: ShapedLine,
 }
 
+/// One source of truth for row geometry (S6a, #1034): where a display or wrap
+/// row starts, how tall rows are, and which row holds a y. Every row is
+/// `line_height` tall today, so callers never compute `row * line_height`.
+/// Callers pass two kinds of row: absolute display rows (visible range,
+/// scrolling) and wrap rows counted from 0 inside one buffer line
+/// (`LineLayout` size, paint, caret). Per-row heights (S6b) need the second
+/// kind offset by the line's first display row.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct RowMetrics {
+    line_height: Pixels,
+}
+
+impl RowMetrics {
+    pub(crate) fn uniform(line_height: Pixels) -> Self {
+        Self { line_height }
+    }
+
+    /// Content y of the top of `row`.
+    pub(crate) fn row_top(&self, row: usize) -> Pixels {
+        self.line_height * row
+    }
+
+    /// The height of `row`.
+    pub(crate) fn row_height(&self, _row: usize) -> Pixels {
+        self.line_height
+    }
+
+    /// The height of the first `rows` rows.
+    pub(crate) fn rows_height(&self, rows: usize) -> Pixels {
+        self.line_height * rows
+    }
+
+    /// The row that contains content y; rows above 0 clamp to 0.
+    pub(crate) fn row_at(&self, y: Pixels) -> usize {
+        (f32::from(y.max(px(0.))) / f32::from(self.line_height)).floor() as usize
+    }
+
+    /// The end (exclusive) of the rows a range ending at `y` touches.
+    pub(crate) fn row_end_at(&self, y: Pixels) -> usize {
+        (f32::from(y.max(px(0.))) / f32::from(self.line_height)).ceil() as usize
+    }
+
+    /// How many whole rows fit in `height`.
+    pub(crate) fn rows_in(&self, height: Pixels) -> usize {
+        (f32::from(height.max(px(0.))) / f32::from(self.line_height)) as usize
+    }
+}
+
+#[cfg(test)]
+mod row_metrics_tests {
+    use super::*;
+
+    #[test]
+    fn uniform_rows_match_the_line_height_arithmetic_they_replace() {
+        let rows = RowMetrics::uniform(px(20.));
+        assert_eq!(rows.row_top(0), px(0.));
+        assert_eq!(rows.row_top(7), px(140.));
+        assert_eq!(rows.rows_height(3), px(60.));
+        assert_eq!(rows.row_at(px(-5.)), 0);
+        assert_eq!(rows.row_at(px(39.9)), 1);
+        assert_eq!(rows.row_at(px(40.)), 2);
+        assert_eq!(rows.row_end_at(px(40.)), 2);
+        assert_eq!(rows.row_end_at(px(40.1)), 3);
+        assert_eq!(rows.rows_in(px(59.)), 2);
+        // Inverse: the top of a row maps back to it.
+        for row in 0..50 {
+            assert_eq!(rows.row_at(rows.row_top(row)), row);
+        }
+    }
+}
