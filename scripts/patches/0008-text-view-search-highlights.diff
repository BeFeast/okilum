+/// A match indexes rendered bytes in one text segment, never Markdown/HTML
+/// source. Segment identity follows the same Arc used by selection/rendering.
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct SearchMatch {
+    pub(super) segment: usize,
+    pub(super) range: Range<usize>,
+    pub(super) block: usize,
+}
+
+pub(super) fn search_matches(blocks: &[BlockNode], query: &str) -> Vec<SearchMatch> {
+    if query.is_empty() {
+        return Vec::new();
+    }
+    fn segment(
+        text: &str,
+        state: &Arc<Mutex<InlineState>>,
+        query: &str,
+        block: usize,
+        out: &mut Vec<SearchMatch>,
+    ) {
+        if query.is_empty() {
+            return;
+        }
+        let mut start = 0;
+        while start + query.len() <= text.len() {
+            let Some(relative) = text.as_bytes()[start..]
+                .windows(query.len())
+                .position(|candidate| candidate.eq_ignore_ascii_case(query.as_bytes()))
+            else {
+                break;
+            };
+            let position = start + relative;
+            let end = position + query.len();
+            if text.is_char_boundary(position) && text.is_char_boundary(end) {
+                out.push(SearchMatch {
+                    segment: Arc::as_ptr(state) as usize,
+                    range: position..end,
+                    block,
+                });
+            }
+            start = end;
+        }
+    }
+    fn paragraph(p: &Paragraph, query: &str, block: usize, out: &mut Vec<SearchMatch>) {
+        let mut text = String::new();
+        for child in &p.children {
+            text.push_str(&child.text);
+            if child.image.is_some() {
+                segment(&text, &child.state, query, block, out);
+                text.clear();
+            }
+        }
+        segment(&text, &p.state, query, block, out);
+    }
+    fn visit(node: &BlockNode, query: &str, block: usize, out: &mut Vec<SearchMatch>) {
+        match node {
+            BlockNode::Paragraph(p) | BlockNode::Heading { children: p, .. } => {
+                paragraph(p, query, block, out)
+            }
+            BlockNode::Root { children, .. }
+            | BlockNode::Blockquote { children, .. }
+            | BlockNode::List { children, .. }
+            | BlockNode::ListItem { children, .. } => {
+                for child in children {
+                    visit(child, query, block, out);
+                }
+            }
+            BlockNode::CodeBlock(code) => segment(&code.code(), &code.state, query, block, out),
+            BlockNode::Custom(node) => {
+                for part in &node.parts {
+                    for child in part.document.blocks.iter() {
+                        visit(child, query, block, out);
+                    }
+                }
+            }
+            BlockNode::Table(table) => {
+                for row in &table.children {
+                    for cell in &row.children {
+                        paragraph(&cell.children, query, block, out);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    let mut out = Vec::new();
+    for (block, node) in blocks.iter().enumerate() {
+        visit(node, query, block, &mut out);
+    }
+    out
+}
