+    /// Zero-based current match and total; current is zero when none match.
+    pub fn search_status(&self) -> (usize, usize) {
+        (self.search_current, self.search_matches.len())
+    }
+
+    /// Cycle through retained matches and reveal the containing rendered block.
+    pub fn step_search_match(&mut self, delta: isize, cx: &mut Context<Self>) {
+        if self.search_matches.is_empty() {
+            return;
+        }
+        self.search_current = (self.search_current as isize + delta)
+            .rem_euclid(self.search_matches.len() as isize) as usize;
+        self.search_reveal_pending = true;
+        self.search_geometry_pending = true;
+        self.search_geometry = None;
+        cx.notify();
+    }
+
+    fn refresh_search(&mut self) {
+        self.search_reveal_pending = !self.search_query.is_empty();
+        self.search_geometry_pending = self.search_reveal_pending;
+        self.search_geometry = None;
+        self.search_matches = Arc::new(node::search_matches(
+            &self.parsed_content.document.blocks,
+            &self.search_query,
+        ));
+        let mut segments = std::collections::HashMap::<usize, Vec<usize>>::new();
+        for (index, hit) in self.search_matches.iter().enumerate() {
+            segments.entry(hit.segment).or_default().push(index);
+        }
+        self.search_segments = Arc::new(segments);
+        self.search_current = self
+            .search_current
+            .min(self.search_matches.len().saturating_sub(1));
+    }
+
+    fn reveal_search_match(&self) {
+        if let Some(hit) = self.search_matches.get(self.search_current)
+            && hit.block < self.list_state.item_count()
+        {
+            self.list_state.scroll_to(gpui::ListOffset {
+                item_ix: hit.block,
+                offset_in_item: px(0.),
+            });
+        }
+    }
+
+    pub(super) fn record_search_geometry(
+        &mut self,
+        segment: usize,
+        source_offset: usize,
+        text_len: usize,
+        layout: &gpui::TextLayout,
+        horizontal: Option<&gpui::ScrollHandle>,
+    ) {
+        if !self.search_geometry_pending || self.search_reveal_pending {
+            return;
+        }
+        let Some(hit) = self.search_matches.get(self.search_current) else {
+            return;
+        };
+        if hit.segment != segment
+            || !(source_offset..source_offset + text_len).contains(&hit.range.start)
