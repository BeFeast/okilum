+            return;
+        }
+        let Some(start) = layout.position_for_index(hit.range.start - source_offset) else {
+            return;
+        };
+        let end = layout
+            .position_for_index((hit.range.end - source_offset).min(text_len))
+            .unwrap_or(start);
+        self.search_geometry = Some(SearchGeometry {
+            start,
+            bottom: start.y + layout.line_height(),
+            right: if end.y == start.y {
+                end.x
+            } else {
+                start.x + px(8.)
+            },
+            horizontal: horizontal.cloned(),
+        });
+    }
+
+    fn apply_search_geometry(&mut self, cx: &mut Context<Self>) {
+        let Some(SearchGeometry {
+            start,
+            bottom,
+            right,
+            horizontal,
+        }) = self.search_geometry.take()
+        else {
+            return;
+        };
+        let delta = if start.y < self.bounds.top() {
+            start.y - self.bounds.top()
+        } else if bottom > self.bounds.bottom() {
+            bottom - self.bounds.bottom()
+        } else {
+            px(0.)
