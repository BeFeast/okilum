+            color: Some(color),
+            bold,
+            italic: !bold,
+            strikethrough: bold,
+        };
+        let fixture = StyledFixture {
+            source: SourceSnapshot {
+                stamp: SourceStamp {
+                    document: 3,
+                    generation: 7,
+                },
+                text: Arc::from(text),
