+    fn visible_projection_font_resolution_does_not_rescan_offscreen_styles_per_row() {
+        use super::super::projection_layout::RUN_STYLE_VISITS;
+        let mut text = String::new();
+        let mut styles = Vec::new();
+        for row in 0..700 {
+            let start = text.len();
+            text.push_str(&format!("Line {row:03} with styled Unicode אבג and enough distinct text to form a real note.\n"));
+            styles.push(ProjectionStyle {
+                range: ProjectedByte(start)..ProjectedByte(text.len() - 1),
+                font_family: Some("sans-serif".into()),
+                color: None,
+                bold: row % 2 == 0,
+                italic: false,
+                strikethrough: false,
+            });
+        }
+        assert!(
+            (50_000..65_536).contains(&text.len()),
+            "supported long-note control"
+        );
+        let fixture = StyledFixture {
+            source: SourceSnapshot {
+                stamp: SourceStamp {
+                    document: 5,
+                    generation: 2,
+                },
+                text: Arc::from(text.as_str()),
+            },
+            styles,
+        };
+        let rope = Rope::from(text.as_str());
+        let font = gpui::font("sans-serif");
+        let rows: Vec<_> = (350..382).collect();
+        RUN_STYLE_VISITS.with(|visits| visits.set(0));
+        let runs =
