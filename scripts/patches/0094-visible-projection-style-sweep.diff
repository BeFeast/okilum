+        let actual = RUN_STYLE_VISITS.with(|visits| visits.get());
+        assert!(
+            !runs.is_empty()
+                && runs
+                    .iter()
+                    .any(|run| run.font.weight == gpui::FontWeight::BOLD)
+        );
+        RUN_STYLE_VISITS.with(|visits| visits.set(0));
+        for &row in &rows {
+            let start = rope.line_start_offset(row);
+            let end = (start + rope.slice_line(row).len() + 1).min(rope.len());
+            let _ = super::super::projection_layout::projected_runs(
