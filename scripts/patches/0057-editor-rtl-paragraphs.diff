+/// Whether a paragraph is right-to-left: its first strong character is R or
+/// AL (Unicode bidi rules P2/P3, without isolates). A paragraph with no strong
+/// character is left-to-right. Reader and the editor both use this (S6c, #1034).
+pub(crate) fn paragraph_is_rtl(text: &str) -> bool {
+    use unicode_bidi::BidiClass::{AL, L, R};
+    text.chars()
+        .map(unicode_bidi::bidi_class)
+        .find(|class| matches!(class, L | R | AL))
+        .is_some_and(|class| matches!(class, R | AL))
+}
