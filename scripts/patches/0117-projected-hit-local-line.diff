+    #[test]
+    fn distant_hit_clipping_segments_only_its_line_and_matches_the_whole_source_oracle() {
+        use unicode_segmentation::UnicodeSegmentation as _;
+        let line = "row e\u{301} אבג 👩\u{200d}💻 🇺🇸\r\n";
+        for rows in [700, 12000] {
+            let text = line.repeat(rows);
+            let boundaries: Vec<_> = text.grapheme_indices(true).map(|(at, _)| at)
+                .chain(std::iter::once(text.len())).collect();
+            assert!(boundaries.len() > rows * 8,
+                "positive control: the cold oracle segments all unchanged rows");
+            for offset in text.len() - line.len()..=text.len() {
+                for bias in [ConcealBias::Left, ConcealBias::Right] {
+                    let expected = if offset > 0
+                        && text.as_bytes().get(offset - 1) == Some(&b'\r')
+                        && text.as_bytes().get(offset) == Some(&b'\n') {
+                        Some(offset - 1)
+                    } else {
+                        Some(match boundaries.binary_search(&offset) {
+                            Ok(_) => offset,
+                            Err(at) if bias == ConcealBias::Left => boundaries[at - 1],
+                            Err(at) => boundaries[at],
+                        })
+                    };
+                    HIT_GRAPHEME_STEPS.with(|n| n.set(0));
+                    assert_eq!(clip_hit_offset(&text, offset, bias), expected,
+                        "row count {rows}, byte {offset}, bias {bias:?}");
+                    assert!(HIT_GRAPHEME_STEPS.with(|n| n.get()) <= line.len() + 1,
+                        "caret/hit lookup must never segment the whole note");
+                }
+            }
+        }
+    }
