+/// Follow the `<table>` and `</table>` tags of one raw HTML block, keeping
+/// the number of tables still open in `depth`.
+fn track_open_tables(html: &str, depth: &mut usize) {
+    let mut at = 0;
+    while let Some(found) = html[at..].find('<') {
+        let tag = at + found;
+        let rest = &html[tag + 1..];
+        if rest.starts_with("!--") {
+            match html[tag..].find("-->") {
+                Some(end) => at = tag + end + 3,
+                None => return,
+            }
+            continue;
+        }
+        let (closing, name) = match rest.strip_prefix('/') {
+            Some(name) => (true, name),
+            None => (false, rest),
+        };
+        let name_len = name
+            .find(|c: char| !c.is_ascii_alphanumeric())
+            .unwrap_or(name.len());
+        let ends_name = name[name_len..]
+            .chars()
+            .next()
+            .is_none_or(|c| c == '>' || c == '/' || c.is_ascii_whitespace());
+        if name[..name_len].eq_ignore_ascii_case("table") && ends_name {
+            if closing {
+                *depth = depth.saturating_sub(1);
+            } else {
+                *depth += 1;
+            }
+        }
+        at = tag + 1;
+    }
+}
