+/// The text of a `<pre>`, `<br>` as a line ending, and the language a nested
+/// `<code class="language-x">` names.
+fn collect_pre_text(node: &Node, out: &mut String, lang: &mut Option<String>) {
+    for child in node.children.borrow().iter() {
+        match &child.data {
+            NodeData::Text { contents } => out.push_str(&contents.borrow()),
+            NodeData::Element { name, attrs, .. } => {
+                if name.local == local_name!("br") {
+                    out.push('\n');
+                    continue;
+                }
+                if name.local == local_name!("code") && lang.is_none() {
+                    *lang = attr_value(attrs, local_name!("class")).and_then(|class| {
+                        class
+                            .split_whitespace()
+                            .find_map(|name| name.strip_prefix("language-").map(str::to_string))
+                    });
+                }
+                collect_pre_text(child, out, lang);
+            }
+            _ => {}
+        }
