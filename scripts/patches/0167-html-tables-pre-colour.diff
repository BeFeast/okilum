+/// The root's children as blocks. Markdown ends an HTML block at a blank
+/// line, but a browser parses the whole document as one, so a `<table>` with
+/// blank lines inside it falls apart into pieces. An HTML block that leaves a
+/// table open is joined, with every block up to the one that closes it and the
+/// Markdown between them, into one HTML fragment. The blocks keep the span of
+/// the whole range. A table that is never closed stays as it was.
+///
+/// Only tables are joined: elsewhere (a `<div>` around Markdown, say) the
+/// blocks between are Markdown, and CommonMark renders them as such.
+fn root_blocks(source: &str, children: Vec<Node>, cx: &mut NodeContext) -> Vec<BlockNode> {
+    let mut pending: std::collections::VecDeque<Node> = children.into();
+    let mut blocks = Vec::with_capacity(pending.len());
+    while let Some(node) = pending.pop_front() {
+        if let Some(joined) = join_open_table(source, &node, &pending, cx) {
+            let (count, block) = joined;
+            pending.drain(..count);
+            blocks.push(block);
+            continue;
+        }
+        blocks.push(ast_to_node(source, node, cx));
+    }
+    blocks
+}
+
+/// The block for `first` (an HTML block opening a table) and the `count`
+/// following nodes that belong to the same table, if it is closed later.
+fn join_open_table(
+    source: &str,
+    first: &Node,
+    following: &std::collections::VecDeque<Node>,
+    cx: &mut NodeContext,
+) -> Option<(usize, BlockNode)> {
+    let Node::Html(html) = first else {
+        return None;
+    };
+    let mut depth = 0;
+    track_open_tables(&html.value, &mut depth);
+    if depth == 0 {
+        return None;
+    }
+    let mut last = None;
+    for (ix, node) in following.iter().enumerate() {
+        if let Node::Html(html) = node {
+            track_open_tables(&html.value, &mut depth);
+            if depth == 0 {
+                last = Some(ix);
+                break;
+            }
+        }
+    }
+    let last = last?;
+    let start = html.position.as_ref()?.start.clone();
+    let end = following[last].position()?.end.clone();
+    let fragment = source.get(start.offset..end.offset)?;
+    let parsed = super::html::parse(fragment, cx).ok()?;
+    Some((
+        last + 1,
+        BlockNode::Root {
+            children: Arc::unwrap_or_clone(parsed.blocks),
+            span: new_span(Some(markdown::unist::Position { start, end }), cx),
+        },
+    ))
+}
