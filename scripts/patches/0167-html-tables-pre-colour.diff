+/// The text colour of a `<span style="color:…">` or `<font color="…">`.
+fn text_color(attrs: &RefCell<Vec<html5ever::Attribute>>, font: bool) -> Option<Hsla> {
+    if let Some(color) = style_attrs(attrs)
+        .get("color")
+        .and_then(|value| parse_css_color(value))
+    {
+        return Some(color);
+    }
+    if font {
+        return attr_value(attrs, local_name!("color")).and_then(|value| parse_css_color(&value));
+    }
+    None
+}
