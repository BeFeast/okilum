+            g: from.g + (to.g - from.g) * t,
+            b: from.b + (to.b - from.b) * t,
+            a: from.a,
+        };
+        let blended = Hsla::from(blended);
+        if contrast_ratio(relative_luminance(blended), background) >= MIN_CONTRAST {
+            return blended;
+        }
