# 0095: retain cached text-selection registrations, clear only actual selection changes.
# Cause: finish_frame prunes GPUI-cached participants -> empty clear emits
# SelectionChanged(None) -> the text adapter re-notifies its cached feed forever.
# Use an element-state lease (preserved by cached paint, dropped on unmount),
# never a permanent participant reference. No gpui-core patch or API dependency.
diff --git a/crates/base/src/text_selection.rs b/crates/base/src/text_selection.rs
--- a/crates/base/src/text_selection.rs
+++ b/crates/base/src/text_selection.rs
@@ -209,6 +209,9 @@
     document_order: u64,
     text_bounds: Vec<Bounds<Pixels>>,
     self_scroll: bool,
+    // Owned by GPUI element state, so cached paint keeps it alive and unmount
+    // drops it even when the application retains the selection participant.
+    frame_lease: Option<WeakEntity<()>>,
 }

 impl TextSelectionRegistration {
@@ -222,6 +225,7 @@
             document_order: 0,
             text_bounds: Vec::new(),
             self_scroll: false,
+            frame_lease: None,
         }
     }

@@ -645,9 +649,15 @@
     }

     fn clear_state(&mut self, cx: &mut Context<Self>) -> Option<ClearHandler> {
+        let changed = self.snapshot.is_some() || self.local_selection;
         self.snapshot = None;
         self.projected_copy_text = None;
         self.local_selection = false;
+        // Empty cleanup is not a selection change. In particular, it must not
+        // notify a cached renderer through an adapter's clear callback.
+        if !changed {
+            return None;
+        }
         cx.emit(TextSelectionEvent::Cleared);
         cx.emit(TextSelectionEvent::SelectionChanged(None));
         self.clear.clone()
@@ -725,6 +735,15 @@
         let Some(state) = WindowSelectionState::existing(window, cx) else {
             return;
         };
+        // A cached GPUI subtree replays paint without calling register again.
+        // Its element state survives that replay; after an actual unmount the
+        // lease dies before the post-frame sweep, independently of the handle.
+        let lease = window.use_keyed_state(
+            ("text-selection-registration", self.entity_id()),
+            cx,
+            |_, _| (),
+        );
+        registration.frame_lease = Some(lease.downgrade());
         state.update(cx, |state, cx| {
             state.register_participant(self.clone(), registration, cx)
         });
@@ -975,6 +994,8 @@

     /// Sweeps participants after a rendered frame has completed.
     ///
+    /// Element-state leases preserve registrations replayed by a cached subtree;
+    /// unlike a participant handle, their lifetime ends when the element unmounts.
     /// Registrations are stamped with the current generation while any sibling
     /// is painting. Sweeping only after paint makes registration independent of
     /// whether a participant or the lifecycle element paints first.
@@ -985,7 +1006,12 @@
             .participants
             .iter()
             .filter_map(|(id, registration)| {
-                (registration.generation != self.frame_generation)
+                let cached = registration
+                    .registration
