+    struct CachedSelectionChild {
+        selection: TextSelectionHandle,
+        renders: Rc<Cell<usize>>,
+    }
+    impl Render for CachedSelectionChild {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            self.renders.set(self.renders.get() + 1);
+            let selection = self.selection.clone();
+            div().size_full().on_prepaint(move |bounds, window, cx| {
+                let hitbox = window.insert_hitbox(bounds, HitboxBehavior::Normal);
+                selection.register(
+                    TextSelectionRegistration::new(hitbox, bounds).with_text_bounds(vec![bounds]),
+                    window,
+                    cx,
+                );
+            })
+        }
+    }
+    struct CachedSelectionHost {
+        child: Entity<CachedSelectionChild>,
+        shown: bool,
+    }
+    impl Render for CachedSelectionHost {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div()
+                .size_full()
+                .child(TextSelectionLayer)
+                .when(self.shown, |this| {
+                    this.child(
+                        self.child
+                            .clone()
+                            .cached(gpui::StyleRefinement::default().size_full()),
+                    )
+                })
+        }
+    }
+
+    #[gpui::test]
+    fn cached_participant_keeps_copy_and_unmount_clears_a_still_live_handle(
+        cx: &mut TestAppContext,
+    ) {
+        let renders = Rc::new(Cell::new(0));
+        let (host, visual) = cx.add_window_view(|_, cx| {
+            let selection = TextSelectionHandle::new("cached copy", cx);
+            CachedSelectionHost {
+                child: cx.new(|_| CachedSelectionChild {
+                    selection,
+                    renders: renders.clone(),
+                }),
+                shown: true,
+            }
+        });
+        let selection = host.read_with(visual, |host, cx| host.child.read(cx).selection.clone());
+        visual.update(|window, cx| {
+            let state = WindowSelectionState::existing(window, cx).expect("selection layer");
+            state.update(cx, |state, cx| {
+                state.begin(point(px(1.), px(1.)), false, cx);
+                state.update(point(px(8.), px(1.)), cx);
+                state.end(cx);
+            });
+            assert_eq!(TextSelection::selected_text(window, cx), "cached copy");
+        });
+        visual.run_until_parked();
+        let before = renders.get();
+        assert!(before > 0, "positive control: participant really rendered");
+        host.update(visual, |_, cx| cx.notify());
+        visual.run_until_parked();
+        assert_eq!(renders.get(), before, "the child really used cached paint");
+        visual.update(|window, cx| {
+            assert_eq!(TextSelection::selected_text(window, cx), "cached copy");
+            assert!(selection.snapshot(cx).is_some());
+        });
+        host.update(visual, |host, cx| {
+            host.shown = false;
+            cx.notify();
+        });
+        visual.run_until_parked();
+        visual.update(|window, cx| {
+            assert_eq!(TextSelection::selected_text(window, cx), "");
+            assert!(
+                selection.snapshot(cx).is_none(),
+                "a live handle cannot retain unmounted geometry"
+            );
+        });
+    }
+
+    #[gpui::test]
+    fn empty_clear_is_silent_but_a_real_local_selection_clears_once(cx: &mut TestAppContext) {
+        let events = Rc::new(Cell::new(0));
+        let clears = Rc::new(Cell::new(0));
+        let (selection, _events) = cx.update(|cx| {
+            let selection = TextSelectionHandle::new("control", cx);
+            let count = events.clone();
+            let events = selection.subscribe(
+                move |event, _| {
+                    if matches!(event, TextSelectionEvent::SelectionChanged(None)) {
+                        count.set(count.get() + 1);
+                    }
+                },
+                cx,
+            );
+            let count = clears.clone();
+            selection.clear_with(move |_| count.set(count.get() + 1), cx);
+            (selection, events)
+        });
+        let clear = |cx: &mut App| {
+            if let Some(clear) = selection.0.update(cx, |state, cx| state.clear_state(cx)) {
+                clear(cx);
+            }
+        };
+        cx.update(clear);
+        assert_eq!((events.get(), clears.get()), (0, 0));
+        cx.update(|cx| selection.set_local_selection(true, cx));
+        cx.update(clear);
+        assert_eq!(
+            (events.get(), clears.get()),
+            (1, 1),
+            "positive control: real clear delivered"
+        );
+        cx.update(clear);
+        assert_eq!(
+            (events.get(), clears.get()),
+            (1, 1),
+            "empty clear is idempotent"
+        );
+    }
