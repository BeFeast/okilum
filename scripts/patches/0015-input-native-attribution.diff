+//! Opt-in, bounded native attribution. No event formatting or I/O in measured paths.
+use std::{
+    cell::Cell,
+    sync::{
+        Mutex, OnceLock,
+        atomic::{AtomicBool, AtomicU64, Ordering},
+    },
+};
+
+use super::projection::SourceStamp;
+use serde::Serialize;
+
+pub const CAPACITY: usize = 65_536;
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static BUFFER: OnceLock<Mutex<Buffer>> = OnceLock::new();
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+static NEXT_THREAD: AtomicU64 = AtomicU64::new(1);
+thread_local! {
+    static PARENT: Cell<u64> = const { Cell::new(0) };
+    static THREAD: u64 = NEXT_THREAD.fetch_add(1, Ordering::Relaxed);
+}
+
+#[derive(Clone, Copy, Default, Serialize)]
+pub struct Identity {
+    pub document: u64,
+    pub generation: u64,
+    pub epoch: u64,
+    pub projected: Option<bool>,
+}
+impl Identity {
+    /// Fixture scheduling knows source authority, but does not inspect component projection state.
+    pub fn source(stamp: SourceStamp, epoch: u64) -> Self {
+        Self {
+            document: stamp.document,
+            generation: stamp.generation,
+            epoch,
+            projected: None,
+        }
+    }
+    pub fn new(stamp: SourceStamp, epoch: u64, projected: bool) -> Self {
+        Self {
+            document: stamp.document,
+            generation: stamp.generation,
+            epoch,
+            projected: Some(projected),
+        }
+    }
+}
+
+#[derive(Serialize)]
+pub struct Event {
+    pub name: &'static str,
+    pub id: u64,
+    pub parent: u64,
+    pub thread: u64,
+    pub start_ns: u64,
+    pub end_ns: u64,
+    pub identity: Identity,
+    pub current: Option<Identity>,
+    pub outcome: Option<&'static str>,
+    pub counts: [u64; 4],
+    pub shape_calls: u64,
+    pub shape_ns: u64,
+}
+struct Buffer {
+    events: Vec<Event>,
+    overflow: u64,
+    overflow_first_ns: Option<u64>,
+    overflow_last_ns: Option<u64>,
+}
+
+/// Call before constructing the editor. Each disabled span reads one relaxed atomic;
+/// they do not call a clock, acquire the buffer lock, initialize TLS, or allocate.
+pub fn init(enabled: bool) {
+    if enabled {
+        BUFFER.get_or_init(|| {
+            Mutex::new(Buffer {
+                events: Vec::with_capacity(CAPACITY),
+                overflow: 0,
+                overflow_first_ns: None,
+                overflow_last_ns: None,
+            })
+        });
+        raw_now().expect("native attribution needs Linux 64-bit CLOCK_MONOTONIC");
+    }
+    ENABLED.store(enabled, Ordering::Relaxed);
+}
+
+pub fn now() -> u64 {
+    if !ENABLED.load(Ordering::Relaxed) {
+        return 0;
+    }
+    raw_now().expect("CLOCK_MONOTONIC failed")
+}
+
+#[cfg(all(target_os = "linux", target_pointer_width = "64"))]
+fn raw_now() -> Option<u64> {
+    #[repr(C)]
+    struct Timespec {
+        seconds: std::ffi::c_long,
+        nanos: std::ffi::c_long,
+    }
+    unsafe extern "C" {
+        fn clock_gettime(clock: std::ffi::c_int, time: *mut Timespec) -> std::ffi::c_int;
+    }
+    let mut time = Timespec {
+        seconds: 0,
+        nanos: 0,
+    };
+    // SAFETY: Linux 64-bit timespec is two C longs. This writable value outlives
+    // clock_gettime and its pointer does not escape; CLOCK_MONOTONIC is 1.
+    if unsafe { clock_gettime(1, &mut time) } != 0
+        || time.seconds < 0
+        || !(0..1_000_000_000).contains(&time.nanos)
+    {
+        return None;
+    }
+    (time.seconds as u64)
+        .checked_mul(1_000_000_000)?
+        .checked_add(time.nanos as u64)
+}
+#[cfg(not(all(target_os = "linux", target_pointer_width = "64")))]
+fn raw_now() -> Option<u64> {
+    None
+}
+
+pub struct Span {
+    event: Option<Event>,
+    // Nesting is thread-local: a live span must never cross threads or await.
+    _not_send: std::marker::PhantomData<std::rc::Rc<()>>,
+}
+impl Span {
+    pub fn new(name: &'static str, identity: Identity) -> Self {
+        let start_ns = now();
+        if start_ns == 0 {
+            return Self {
+                event: None,
+                _not_send: std::marker::PhantomData,
+            };
+        }
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        Self {
+            _not_send: std::marker::PhantomData,
+            event: Some(Event {
+                name,
+                id,
+                parent: PARENT.with(|p| p.replace(id)),
+                thread: THREAD.with(|t| *t),
+                start_ns,
+                end_ns: 0,
+                identity,
+                current: None,
+                outcome: None,
+                counts: [0; 4],
+                shape_calls: 0,
+                shape_ns: 0,
+            }),
+        }
+    }
+    pub fn id(&self) -> u64 {
+        self.event.as_ref().map_or(0, |event| event.id)
+    }
+    pub fn outcome(&mut self, outcome: &'static str) {
+        if let Some(event) = self.event.as_mut() {
+            event.outcome = Some(outcome);
+        }
+    }
+    pub fn counts(&mut self, counts: [u64; 4]) {
+        if let Some(event) = self.event.as_mut() {
+            event.counts = counts;
+        }
+    }
+    pub fn current(&mut self, identity: Identity) {
+        if let Some(event) = self.event.as_mut() {
+            event.current = Some(identity);
+        }
+    }
+    pub fn shape_finished(&mut self, start: u64) {
+        if let Some(event) = self.event.as_mut() {
+            event.shape_calls += 1;
+            event.shape_ns += now().saturating_sub(start);
+        }
+    }
+}
+impl Drop for Span {
+    fn drop(&mut self) {
+        let Some(mut event) = self.event.take() else {
+            return;
+        };
+        event.end_ns = now();
+        PARENT.with(|p| p.set(event.parent));
+        let mut buffer = BUFFER
+            .get()
+            .expect("enabled buffer")
+            .lock()
+            .expect("attribution buffer");
+        if buffer.events.len() < CAPACITY {
+            buffer.events.push(event);
+        } else {
+            buffer.overflow += 1;
+            buffer.overflow_first_ns.get_or_insert(event.start_ns);
+            buffer.overflow_last_ns = Some(event.end_ns);
+        }
+    }
+}
+
+/// Serialize/print only from an explicit untimed fixture action. Any overflow
+/// invalidates this entire dump interval; never silently retain partial samples.
+pub fn dump() -> serde_json::Value {
+    let dump_start_ns = now();
+    let Some(buffer) = BUFFER.get() else {
+        return serde_json::json!({"enabled": false, "capacity": CAPACITY, "events": []});
+    };
+    let mut buffer = buffer.lock().expect("attribution buffer");
+    let mut result = serde_json::json!({
+        "dump_start_ns": dump_start_ns,
+        "enabled": ENABLED.load(Ordering::Relaxed), "capacity": CAPACITY,
+        "overflow": buffer.overflow, "overflow_first_ns": buffer.overflow_first_ns,
+        "overflow_last_ns": buffer.overflow_last_ns, "events": buffer.events,
+    });
+    buffer.events.clear();
+    buffer.overflow = 0;
+    buffer.overflow_first_ns = None;
+    buffer.overflow_last_ns = None;
+    result["dump_end_ns"] = serde_json::json!(now());
+    result
+}
+
+#[cfg(all(test, target_os = "linux", target_pointer_width = "64"))]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn disabled_nested_and_overflow_controls() {
+        init(false);
+        assert_eq!(now(), 0);
+        assert_eq!(Span::new("off", Identity::default()).id(), 0);
+        init(true);
+        let identity = Identity {
+            document: 7,
+            generation: 3,
+            epoch: 11,
+            projected: Some(true),
+        };
+        let outer = Span::new("outer", identity);
+        let outer_id = outer.id();
+        drop(Span::new("inner", identity));
+        drop(outer);
+        let dump = dump();
+        let events = dump["events"].as_array().unwrap();
+        assert_eq!(events.len(), 2);
+        assert_eq!(events[0]["parent"], outer_id);
+        assert_eq!(events[0]["thread"], events[1]["thread"]);
+        assert_eq!(events[1]["parent"], 0);
+        assert!(events[0]["start_ns"].as_u64().unwrap() >= events[1]["start_ns"].as_u64().unwrap());
+        assert!(events[0]["end_ns"].as_u64().unwrap() <= events[1]["end_ns"].as_u64().unwrap());
+        assert_eq!(events[0]["identity"]["epoch"], 11);
+        for _ in 0..=CAPACITY {
+            drop(Span::new("fill", identity));
+        }
+        let full = super::dump();
+        assert_eq!(full["events"].as_array().unwrap().len(), CAPACITY);
+        assert_eq!(full["overflow"], 1);
+        assert!(full["overflow_first_ns"].as_u64().unwrap() > 0);
+        assert_eq!(super::dump()["overflow"], 0);
+        init(false);
+    }
+}
