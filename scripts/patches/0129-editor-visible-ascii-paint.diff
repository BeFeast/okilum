+    #[test]
+    fn large_ascii_paint_submits_only_visible_unchanged_glyphs() {
+        let mut line = ShapedLine::default();
+        line.text = "a".repeat(256 * 1024).into();
+        *line = std::sync::Arc::new(gpui::LineLayout {
+            len: line.text.len(), width: px(8. * line.text.len() as f32),
+            runs: vec![gpui::ShapedRun { font_id: gpui::FontId(0),
+                glyphs: (0..line.text.len()).map(|index| gpui::ShapedGlyph {
+                    index, id: gpui::GlyphId(1), position: point(px(index as f32 * 8.), px(0.)),
+                    is_emoji: false,
+                }).collect() }],
+            ..Default::default()
+        });
+        for left in [px(0.), px(8000.), line.width - px(160.)] {
+            let visible = viewport_paint_line(&line, left - px(16.), left + px(176.)).unwrap();
+            assert!(visible.runs[0].glyphs.len() < 30);
+            assert_eq!((visible.len(), visible.width), (line.len(), line.width));
+            for glyph in &visible.runs[0].glyphs {
+                let original = &line.runs[0].glyphs[glyph.index];
+                assert_eq!((glyph.id, glyph.position), (original.id, original.position));
+            }
+        }
+        assert_eq!(line.runs[0].glyphs.len(), 256 * 1024);
+        line.text = format!("{}שלום", line.text).into();
+        assert!(viewport_paint_line(&line, px(0.), px(160.)).is_none());
+    }
