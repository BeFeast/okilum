+/// Retain exact source geometry for caret/selection, but submit only glyphs
+/// intersecting the horizontal paint mask. GPUI otherwise visits millions of
+/// clipped glyphs even on a popup-hover frame. Non-ASCII keeps its full path.
+fn viewport_paint_line(line: &ShapedLine, left: Pixels, right: Pixels) -> Option<ShapedLine> {
+    if line.len() < 64 * 1024 || !line.text.is_ascii() || line.runs.len() != 1 {
+        return None;
+    }
+    let run = &line.runs[0];
+    let start = run.glyphs.partition_point(|g| g.position.x < left).saturating_sub(1);
+    let end = (run.glyphs.partition_point(|g| g.position.x <= right) + 1).min(run.glyphs.len());
+    let mut visible = line.clone();
+    *visible = std::sync::Arc::new(gpui::LineLayout {
+        font_size: line.font_size, width: line.width, ascent: line.ascent,
+        descent: line.descent, len: line.len(),
+        runs: vec![gpui::ShapedRun { font_id: run.font_id,
+            glyphs: run.glyphs[start.min(end)..end].to_vec() }],
+    });
+    Some(visible)
 }
 
