+    fn published_release_on_reset(cx: &mut TestAppContext, queued: bool) {
+        use super::super::highlighter::{
+            INJECTION_LAYER_DROPS, RELEASED_SYNTAX_COMPLETED, RELEASED_SYNTAX_SCHEDULED,
+        };
+        cx.update(crate::init);
+        let v = cx.add_empty_window();
+        let scheduler = v.dispatcher.scheduler().clone();
+        let source = completed_output_source();
+        let changed = source.replace("owned_0", "after_reload_0");
+        let input = v.update(|window, cx| {
+            cx.new(|cx| {
+                let mut input = EditorState::new(window, cx).language("markdown");
+                input.ensure_highlighter_factory(input_highlighter_factory());
+                input.set_value(source.clone(), window, cx);
+                input.prepare_highlighting(window, cx);
+                input
+            })
+        });
+        v.run_until_parked();
+        assert!(!input.read_with(v, |input, _| input.highlighting_pending()));
+        if queued {
+            input.update_in(v, |input, window, cx| {
+                input.replace_source_range(0..0, "queued שלום🙂\r\n", window, cx);
+            });
+            v.run_until_parked();
+            assert!(
+                input.read_with(v, |input, _| input.highlighting_pending()),
+                "positive: a real debounced foreground continuation retains the highlighter"
+            );
+        }
+        RELEASED_SYNTAX_SCHEDULED.with(|count| count.set((0, 0)));
+        RELEASED_SYNTAX_COMPLETED.with(|count| count.set(0));
+        INJECTION_LAYER_DROPS.with(|count| count.set(0));
+        // The actual native API used by clean reload. It preserves the editor
+        // entity while replacing its source/history base and syntax adapter.
+        input.update_in(v, |input, window, cx| {
+            input.set_value(changed.clone(), window, cx);
+            input.prepare_highlighting(window, cx);
+        });
+        for _ in 0..2000 {
+            if RELEASED_SYNTAX_SCHEDULED.with(|count| count.get().0) == 1 {
+                break;
+            }
+            assert!(
+                scheduler.tick(),
+                "actual final highlighter owner must be released"
+            );
+        }
+        let (scheduled, layers) = RELEASED_SYNTAX_SCHEDULED.with(|count| count.get());
+        assert_eq!(
+            scheduled, 1,
+            "final release must schedule exactly one existing syntax payload"
+        );
+        assert!(
+            layers >= 24,
+            "real published Rust injection payload must fire"
+        );
+        assert_eq!(
+            INJECTION_LAYER_DROPS.with(|count| count.get()),
+            0,
+            "final published injection syntax was destroyed on the foreground release path"
+        );
+        assert_eq!(RELEASED_SYNTAX_COMPLETED.with(|count| count.get()), 0);
+        while scheduler.tick_background_only() {}
+        assert_eq!(
+            RELEASED_SYNTAX_COMPLETED.with(|count| count.get()),
+            1,
+            "retirement must actually complete, not only enqueue a future"
+        );
+        assert_eq!(
+            INJECTION_LAYER_DROPS.with(|count| count.get()),
+            layers,
+            "all old published layers must be destroyed in background cleanup"
+        );
+        v.run_until_parked();
+        assert_eq!(
+            input.read_with(v, |input, _| input.value().to_string()),
+            changed
+        );
+        assert!(
+            !input.read_with(v, |input, _| input.highlighting_pending()),
+            "old cancellation cannot keep the replacement highlighter pending"
+        );
+        let mut fresh = SyntaxHighlighter::new("markdown");
+        assert!(fresh.update(None, &Rope::from_str(&changed), None));
+        input.update(v, |input, cx| input.set_all_folded(true, cx));
+        assert_eq!(
+            input.read_with(v, |input, _| input.folded_ranges().to_vec()),
+            extract_fold_ranges(fresh.tree().unwrap()),
+            "cancelled old syntax cannot publish stale folds to the same editor entity"
+        );
+        // Same real destructor meter, deliberately fired locally as a positive.
+        INJECTION_LAYER_DROPS.with(|count| count.set(0));
+        drop(fresh);
+        assert!(INJECTION_LAYER_DROPS.with(|count| count.get()) >= 24);
+    }
