+impl Drop for SyntaxHighlighter {
+    fn drop(&mut self) {
+        let Some(executor) = self.retirement_executor.take() else {
+            return;
+        };
+        if self.query.is_none()
+            && self.injections_query.is_none()
+            && self.tree.is_none()
+            && self.injection_layers.is_empty()
+        {
+            return;
+        }
+        #[cfg(test)]
+        RELEASED_SYNTAX_SCHEDULED.with(|count| {
+            count.set((count.get().0 + 1, self.injection_layers.len()));
+        });
+        // Final ownership only: active pending coordinates and parser reuse
+        // never leave this object before Drop. Keep parser/source/UI lifetimes
+        // unchanged; this batch owns only existing Send syntax data.
+        let retired = RetiredSyntax::Released {
+            _query: self.query.take(),
+            _injections_query: self.injections_query.take(),
+            _tree: self.tree.take(),
+            _injection_layers: std::mem::take(&mut self.injection_layers),
+        };
+        executor
+            .spawn(async move {
+                drop(retired);
+                #[cfg(test)]
+                RELEASED_SYNTAX_COMPLETED.with(|count| count.set(count.get() + 1));
+            })
+            .detach();
+    }
+}
