+    #[test]
+    fn a_correction_clamped_at_the_top_is_cancelled_by_its_reverse() {
+        // #1241, as traced on Wayland: typing on a quote line under a list draws
+        // the note raw for one frame (rows above the caret 21.5 px shorter),
+        // then rendered again. Before: 0 -> 0, then -21.5 with a 21.5 px tail.
+        let (v, h) = (px(658.), px(435.5));
+        let (offset, tail, over) = anchored_scroll_y_at_top(px(0.), px(0.), px(21.5), px(437.), v);
+        assert_eq!((offset, tail, over), (px(0.), px(0.), px(21.5)));
+        let (offset, tail, over) = anchored_scroll_y_at_top(offset, over, px(-21.5), h, v);
+        assert_eq!((offset, tail, over), (px(0.), px(0.), px(0.)), "no net scroll");
+        // Undo replays the same pair: still nothing.
+        let (offset, _, over) = anchored_scroll_y_at_top(offset, over, px(21.5), px(437.), v);
+        assert_eq!(anchored_scroll_y_at_top(offset, over, px(-21.5), h, v),
+            (px(0.), px(0.), px(0.)));
+        // Positive control: without the remembered part the reverse scrolls.
+        assert_eq!(anchored_scroll_y(px(0.), px(-21.5), h, v), (px(-21.5), px(21.5)));
+        // Away from the top a stale overshoot is ignored and corrections apply
+        // as before, both ways.
+        assert_eq!(anchored_scroll_y_at_top(px(-100.), px(21.5), px(-21.5), px(2000.), v),
+            (px(-121.5), px(0.), px(0.)));
+        assert_eq!(anchored_scroll_y_at_top(px(-121.5), px(0.), px(21.5), px(2000.), v),
+            (px(-100.), px(0.), px(0.)));
+        // A genuine growth above the caret at the top, with nothing clamped
+        // before, keeps the caret's row where it was, as before.
+        assert_eq!(anchored_scroll_y_at_top(px(0.), px(0.), px(-40.), px(2000.), v),
+            (px(-40.), px(0.), px(0.)));
+    }
