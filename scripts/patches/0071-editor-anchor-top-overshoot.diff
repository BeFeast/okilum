+// The same, remembering what the document top clamps away (#1241). Rows above
+// the anchor can shrink for one frame and grow back on the next (an edit
+// drawn raw before its classification returns). At the top the first
+// correction cannot scroll up, and applying the second in full scrolled the
+// note down by its amount, with a temporary tail to allow it. `overshoot` is
+// the clamped part, and counts only while the view is still at the top.
+fn anchored_scroll_y_at_top(scroll: Pixels, overshoot: Pixels, delta: Pixels, content: Pixels,
+    viewport: Pixels) -> (Pixels, Pixels, Pixels)
+{
+    let from = if scroll == px(0.) { overshoot } else { px(0.) };
+    let wanted = scroll + from + delta;
+    let (offset, tail) = anchored_scroll_y(scroll + from, delta, content, viewport);
+    (offset, tail, wanted.max(px(0.)))
+}
