new file mode 100644
--- /dev/null
+++ b/crates/base/src/text/link_pointer.rs
@@ -0,0 +1,127 @@
+//! A link release belongs to its original press, not just its hitbox.
+//! Kept independent of rendering so cancellation sequences can be tested directly.
+
+pub(super) struct LinkPointer<K, T> {
+    pressed: Option<(K, (f32, f32), T)>,
+}
+
+impl<K, T> Default for LinkPointer<K, T> {
+    fn default() -> Self {
+        Self { pressed: None }
+    }
+}
+
+impl<K: PartialEq, T> LinkPointer<K, T> {
+    pub(super) fn key(&self) -> Option<&K> {
+        self.pressed.as_ref().map(|(key, _, _)| key)
+    }
+
+    pub(super) fn press(&mut self, key: K, position: (f32, f32), event: T) {
+        self.pressed = Some((key, position, event));
+    }
+
+    pub(super) fn cancel(&mut self) {
+        self.pressed = None;
+    }
+
+    pub(super) fn moved(&mut self, button_held: bool, position: (f32, f32)) {
+        if !button_held || !self.near_press(position) {
+            self.cancel();
+        }
+    }
+
+    fn near_press(&self, position: (f32, f32)) -> bool {
+        self.pressed.as_ref().is_some_and(|(_, start, _)| {
+            // A drag must stay cancelled even if it returns to its starting link.
+            (position.0 - start.0).abs() <= 4.0 && (position.1 - start.1).abs() <= 4.0
+        })
+    }
+
+    pub(super) fn release(
+        &mut self,
+        key: Option<&K>,
+        position: (f32, f32),
+        single_click: bool,
+        selected: bool,
+    ) -> Option<T> {
+        let near = self.near_press(position);
+        let (pressed_key, _, event) = self.pressed.take()?;
+        (single_click && !selected && near && key == Some(&pressed_key)).then_some(event)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::LinkPointer;
+    const LINK: (usize, &str) = (1, "target.md");
+
+    #[test]
+    fn first_click_after_a_selection_needs_no_repaint() {
+        let mut pointer = LinkPointer::default();
+        // The normal selection layer clears the old word selection on press.
+        pointer.press(LINK, (10.0, 10.0), "original down");
+        assert_eq!(
+            pointer.release(Some(&LINK), (10.0, 10.0), true, false),
+            Some("original down")
+        );
+        assert_eq!(
+            pointer.release(Some(&LINK), (10.0, 10.0), true, false),
+            None
+        );
+    }
+
+    #[test]
+    fn release_outside_or_on_another_link_disarms_the_original_press() {
+        for target in [None, Some(&(2, "target.md")), Some(&(1, "other.md"))] {
+            let mut pointer = LinkPointer::default();
+            pointer.press(LINK, (10.0, 10.0), ());
+            assert_eq!(pointer.key(), Some(&LINK));
+            assert_eq!(pointer.release(target, (10.0, 10.0), true, false), None);
+            assert_eq!(
+                pointer.release(Some(&LINK), (10.0, 10.0), true, false),
+                None
+            );
+        }
+    }
+
+    #[test]
+    fn cancellation_lost_release_and_drag_return_cannot_activate_a_link() {
+        for reason in 0..3 {
+            let mut pointer = LinkPointer::default();
+            pointer.press(LINK, (10.0, 10.0), ());
+            match reason {
+                0 => pointer.cancel(), // exit, deactivation, resize, source change
+                1 => pointer.moved(false, (10.0, 10.0)), // compositor swallowed Up
+                _ => {
+                    pointer.moved(true, (30.0, 10.0));
+                    pointer.moved(true, (10.0, 10.0));
+                }
+            }
+            assert_eq!(
+                pointer.release(Some(&LINK), (10.0, 10.0), true, false),
+                None
+            );
+            pointer.press(LINK, (10.0, 10.0), ());
+            assert_eq!(
+                pointer.release(Some(&LINK), (10.0, 10.0), true, false),
+                Some(())
+            );
+        }
+    }
+
+    #[test]
+    fn selection_and_non_matching_release_remain_inert() {
+        for (primary, selected, position) in [
+            (true, true, (10.0, 10.0)),
+            (false, false, (10.0, 10.0)),
+            (true, false, (30.0, 10.0)),
+        ] {
+            let mut pointer = LinkPointer::default();
+            pointer.press(LINK, (10.0, 10.0), ());
+            assert_eq!(
+                pointer.release(Some(&LINK), position, primary, selected),
+                None
+            );
+        }
+    }
+}
