+/// Replaced/rejected syntax owners; their nodes may still be shared by other
+/// trees. Variant field order retains each original path's destruction order.
+#[must_use = "retire replaced syntax data on the background executor"]
+pub(crate) enum RetiredSyntax {
+    Replaced {
+        _tree: Option<Tree>,
+        _injection_layers: Vec<InjectionLayer>,
+    },
+    Rejected {
+        _injection_layers: Vec<InjectionLayer>,
+        _tree: Tree,
+    },
+}
+
+#[cfg(test)]
+thread_local! {
+    static INJECTION_LAYER_DROPS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+// Observe the actual layer destructor, not a simulated retirement callback.
+// Its owned query/ranges/tree fields are dropped on this same thread next.
+#[cfg(test)]
+impl Drop for InjectionLayer {
+    fn drop(&mut self) {
+        INJECTION_LAYER_DROPS.with(|count| count.set(count.get() + 1));
+    }
 }
 
