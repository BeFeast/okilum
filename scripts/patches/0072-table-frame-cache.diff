+    /// [`Self::table_data`] with `overflows` set, made once per table.
+    fn frame_data(&self, overflows: bool) -> Arc<TableData> {
+        let mut cache = self.frame_cache.0.lock().unwrap_or_else(|e| e.into_inner());
+        cache.data[usize::from(overflows)]
+            .get_or_insert_with(|| {
+                let mut data = self.table_data();
+                data.overflows = overflows;
+                Arc::new(data)
+            })
+            .clone()
+    }
+
+    /// The max-content and minimum column widths (see [`measure_table_widths`]),
+    /// measured once per table and text style instead of on every frame.
+    fn frame_widths(
+        &self,
+        col_count: usize,
+        node_cx: &NodeContext,
+        window: &mut Window,
+    ) -> (Vec<f32>, Vec<f32>) {
+        let key = TableWidthsKey {
+            text_style: window.text_style(),
+            rem_size: window.rem_size(),
+            style: node_cx.style.clone(),
+            col_count,
+        };
+        let mut cache = self.frame_cache.0.lock().unwrap_or_else(|e| e.into_inner());
+        if let Some((cached, full, min)) = &cache.widths
+            && *cached == key
+        {
+            return (full.clone(), min.clone());
+        }
+        let full = measure_table_widths(self, col_count, node_cx, window, false);
+        let nowrap = node_cx.style.table_cell().text.white_space == Some(WhiteSpace::Nowrap);
+        let min = if nowrap {
+            full.clone()
+        } else {
+            measure_table_widths(self, col_count, node_cx, window, true)
+        };
+        cache.widths = Some((key, full.clone(), min.clone()));
+        (full, min)
+    }
