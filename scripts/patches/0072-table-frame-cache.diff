+    /// A table's column widths and its `table_actions` snapshot are made once,
+    /// not on every frame (#1290 in Okilum: every scroll frame measured each
+    /// visible table twice and serialized it to Markdown).
+    #[test]
+    fn table_frame_cache_keeps_widths_and_data_until_the_style_changes() {
+        use crate::text::inline::test_fonts::{MONO, WideMonoTextSystem};
+        use gpui::{Empty, TestApp};
+
+        let table = table_of(
+            vec![
+                vec![plain_cell("Name"), plain_cell("A longer cell")],
+                vec![plain_cell("x"), plain_cell("y")],
+            ],
+            vec![ColumnumnAlign::Left, ColumnumnAlign::Left],
+        );
+        let node_cx = NodeContext::default();
+        let mut app = TestApp::with_text_system(Arc::new(WideMonoTextSystem));
+        let mut window = app.open_window(|_, _| Empty);
+        window.update(|_, window, _| {
+            let measured = (
+                measure_table_widths(&table, 2, &node_cx, window, false),
+                measure_table_widths(&table, 2, &node_cx, window, true),
+            );
+            assert!(
+                measured.0[1] > measured.0[0],
+                "positive control: real widths"
+            );
+            assert_eq!(table.frame_widths(2, &node_cx, window), measured);
+            // The next frame reads the cache: a value planted there comes back.
+            table
+                .frame_cache
+                .0
+                .lock()
+                .unwrap()
+                .widths
+                .as_mut()
+                .unwrap()
+                .1 = vec![1., 2.];
+            assert_eq!(table.frame_widths(2, &node_cx, window).0, vec![1., 2.]);
+            // Another style measures again.
+            let other = NodeContext {
+                style: TextViewStyle::default().with_inline_code_font_family(Some(MONO.into())),
+                ..Default::default()
+            };
+            assert_eq!(table.frame_widths(2, &other, window).0, measured.0);
+        });
+
+        // The snapshot is made once and shared by clones of the parsed table.
+        let data = table.frame_data(false);
+        assert!(Arc::ptr_eq(&data, &table.clone().frame_data(false)));
+        assert_eq!(*data, table.table_data());
+        let overflowing = table.frame_data(true);
+        assert!(overflowing.overflows && !data.overflows);
+        assert_eq!(overflowing.markdown, data.markdown);
+    }
