+        let rows = RowMetrics::with_heights(px(20.), [(3, px(36.)), (4, px(36.))]);
+        let heading = rows.line(3);
+        assert_eq!(heading.row_top(0), px(0.));
+        assert_eq!(heading.row_top(1), px(36.));
+        assert_eq!(heading.row_height(1), px(36.));
+        assert_eq!(heading.rows_height(2), px(72.));
+        assert_eq!(heading.row_at(px(-3.)), 0);
+        assert_eq!(heading.row_at(px(35.9)), 0);
+        assert_eq!(heading.row_at(px(36.)), 1);
+        assert_eq!(heading.row_end_at(px(36.)), 1);
+        assert_eq!(heading.row_end_at(px(37.)), 2);
