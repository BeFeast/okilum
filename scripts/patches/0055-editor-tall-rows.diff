+/// Row geometry of one buffer line, in wrap rows counted from 0 and y measured
+/// from the top of the line.
+#[derive(Clone, Copy)]
+pub(crate) struct LineRows<'a> {
+    rows: &'a RowMetrics,
+    first: usize,
+    top: Pixels,
