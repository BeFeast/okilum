+            .into_iter()
+            .map(|(row, height)| {
+                let extra = height - line_height;
+                extra_through += extra;
+                TallRow {
+                    row,
+                    extra,
+                    extra_through,
+                }
+            })
+            .collect();
+        Self { line_height, tall }
