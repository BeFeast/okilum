+    pub(crate) fn row_height(&self, row: usize) -> Pixels {
+        self.rows.row_height(self.first + row)
+    }
+
+    pub(crate) fn rows_height(&self, rows: usize) -> Pixels {
+        self.row_top(rows)
+    }
+
+    /// The wrap row holding y, in exact agreement with [`Self::row_top`]: the
+    /// document-space guess can land one row off when `top + y` rounds.
+    pub(crate) fn row_at(&self, y: Pixels) -> usize {
+        let y = y.max(px(0.));
+        if self.rows.is_uniform() {
+            return (f32::from(y) / f32::from(self.rows.line_height)).floor() as usize;
+        }
+        let mut row = self.rows.row_at(self.top + y).saturating_sub(self.first);
+        while row > 0 && self.row_top(row) > y {
+            row -= 1;
+        }
+        while self.row_top(row + 1) <= y {
+            row += 1;
+        }
+        row
+    }
+
+    pub(crate) fn row_end_at(&self, y: Pixels) -> usize {
+        if self.rows.is_uniform() {
+            return (f32::from(y.max(px(0.))) / f32::from(self.rows.line_height)).ceil() as usize;
+        }
+        let row = self.row_at(y);
+        if y <= self.row_top(row) { row } else { row + 1 }
+    }
