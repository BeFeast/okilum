+
+impl LineRows<'_> {
+    /// Built from the line's own rows rather than as a difference of two
+    /// document tops, so uniform rows give exactly `row * line_height`.
+    pub(crate) fn row_top(&self, row: usize) -> Pixels {
+        let rows = self.rows;
+        rows.line_height * row
+            + (rows.extra_before(self.first + row) - rows.extra_before(self.first))
+    }
