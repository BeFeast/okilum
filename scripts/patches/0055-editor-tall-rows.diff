+        for line_height in [px(18.4), px(20.02), px(23.7)] {
+            // Uniform rows: bit-identical to `row * line_height`, any first row.
+            let uniform = RowMetrics::uniform(line_height);
+            let tall = RowMetrics::with_heights(line_height, [(40, line_height * 2.)]);
+            for first in [0, 41, 999, 4_321, 12_345] {
+                let line = uniform.line(first);
+                for row in 0..6 {
+                    assert_eq!(line.row_top(row), line_height * row);
+                    assert_eq!(line.row_at(line_height * row), row);
+                }
