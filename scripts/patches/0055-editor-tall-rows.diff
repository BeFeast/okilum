+/// One source of truth for row geometry (S6a/S6b, #1034): where a display row
+/// starts, how tall it is, and which row holds a y. Rows are `line_height` tall
+/// unless listed as tall rows (headings), so callers never compute
+/// `row * line_height`.
+///
+/// Rows here are absolute display rows. Wrap rows counted from 0 inside one
+/// buffer line go through [`LineRows`], which offsets them by the line's first
+/// display row.
+#[derive(Clone, Debug, PartialEq)]
 pub(crate) struct RowMetrics {
     line_height: Pixels,
+    /// Rows taller than `line_height`, sorted by row, without duplicates.
+    tall: Rc<[TallRow]>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct TallRow {
+    row: usize,
+    /// Height above `line_height`.
+    extra: Pixels,
+    /// Sum of `extra` over this row and every tall row before it.
+    extra_through: Pixels,
 }
 
