+                    assert_eq!(
+                        line.row_end_at(top),
+                        row,
+                        "{line_height:?} first {first} row {row}"
+                    );
+                    let inside = top + line.row_height(row) * 0.5;
+                    assert_eq!(line.row_at(inside), row);
+                    assert_eq!(line.row_end_at(inside), row + 1);
+                }
+            }
+        }
