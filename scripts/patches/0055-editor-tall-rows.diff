+            view.input.update(cx, |state, cx| {
+                state.set_value(text, window, cx);
+                // Room for the hanging `## ` left of the text.
+                state.set_text_gutter(px(80.));
+                state.set_projection_provider(Some(Arc::new(ScaledLineProvider { hang: 3 })), cx);
+                window.activate_window();
+                state.focus(window, cx);
+            })
+        });
+        v.run_until_parked();
+        v.update(|window, cx| {
+            view.input.update(cx, |state, cx| {
+                let layout = state.last_layout.as_ref().unwrap();
+                // The gutter is the distance from the editor's edge to the text.
+                assert_eq!(state.editor_paddings.left + layout.line_number_width, px(80.));
+                let heading = &layout.lines[1];
+                // The text after `## ` starts where the line starts; the marker
+                // sits left of it.
+                let text_start = heading.position_for_index(3, layout, false).unwrap();
+                let marker = heading.position_for_index(0, layout, false).unwrap();
+                assert!(f32::from(text_start.x).abs() < 0.01, "{text_start:?}");
+                assert!(marker.x < px(-1.), "{marker:?}");
+                // A click on the heading text hits it; vertical movement from
+                // column 0 of the body lands on the heading text, not the marker.
+                let (hit, _) = heading
