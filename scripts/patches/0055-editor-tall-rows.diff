+                    .unwrap();
+                assert_eq!(hit, 3);
+                state.move_vertical(1, window, cx);
+                assert_eq!(state.cursor(), "abcd\n## ".len());
+                // Without room the marker stays inline instead of being clipped.
+                state.set_text_gutter(px(0.));
+                cx.notify();
+            })
+        });
+        v.run_until_parked();
+        v.update(|_, cx| {
+            let state = view.input.read(cx);
+            let layout = state.last_layout.as_ref().unwrap();
+            let marker = layout.lines[1].position_for_index(0, layout, false).unwrap();
+            assert!(f32::from(marker.x).abs() < 0.01, "{marker:?}");
+        });
