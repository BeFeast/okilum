+        // Rows 2 and 5 are 36 and 30 px tall; the rest 20.
+        let rows = RowMetrics::with_heights(
+            px(20.),
+            [(5, px(30.)), (2, px(36.)), (7, px(12.)), (2, px(36.))],
+        );
+        assert!(!rows.is_uniform());
+        let tops = [0., 20., 40., 76., 96., 116., 146., 166.];
+        for (row, top) in tops.iter().enumerate() {
+            assert_eq!(rows.row_top(row), px(*top), "row {row}");
+        }
+        assert_eq!(rows.row_height(2), px(36.));
+        assert_eq!(rows.row_height(5), px(30.));
+        assert_eq!(rows.row_height(7), px(20.), "short heights are ignored");
+        assert_eq!(rows.rows_height(8), px(166.) + px(20.));
+
+        assert_eq!(rows.row_at(px(39.9)), 1);
+        assert_eq!(rows.row_at(px(40.)), 2);
+        assert_eq!(rows.row_at(px(75.9)), 2);
+        assert_eq!(rows.row_at(px(76.)), 3);
+        assert_eq!(rows.row_at(px(145.9)), 5);
+        assert_eq!(rows.row_at(px(146.)), 6);
+        assert_eq!(rows.row_at(px(1000.)), 6 + ((1000. - 146.) / 20.) as usize);
+        assert_eq!(rows.row_end_at(px(76.)), 3);
+        assert_eq!(rows.row_end_at(px(76.5)), 4);
+        for row in 0..40 {
+            assert_eq!(rows.row_at(rows.row_top(row)), row, "row {row}");
+            let bottom = rows.row_top(row) + rows.row_height(row);
+            assert_eq!(rows.row_at(bottom - px(0.01)), row, "row {row} bottom");
+        }
+    }
