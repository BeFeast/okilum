+    /// Projected bytes at the start of the line drawn in the left margin, so
+    /// the text after them stays where it is when they are concealed: a
+    /// revealed heading marker. 0 for none.
+    pub hang: usize,
+}
+
+/// The largest line scale honoured; larger requests are clamped.
+pub const MAX_LINE_SCALE: f32 = 4.;
+
+/// The font scale of projected `line`: 1 unless listed, clamped to
+/// `1..=MAX_LINE_SCALE` so a bad provider cannot collapse or explode rows.
+pub fn line_scale(scales: &[LineScale], line: usize) -> f32 {
+    match scales.binary_search_by_key(&line, |s| s.line) {
+        Ok(ix) if scales[ix].scale.is_finite() => scales[ix].scale.clamp(1., MAX_LINE_SCALE),
+        _ => 1.,
+    }
+}
+
+/// The hanging prefix of projected `line`, in bytes.
+pub fn line_hang(scales: &[LineScale], line: usize) -> usize {
+    scales.binary_search_by_key(&line, |s| s.line).map_or(0, |ix| scales[ix].hang)
+}
