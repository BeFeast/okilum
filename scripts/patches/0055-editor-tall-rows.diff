+    pub(crate) fn with_heights(
+        line_height: Pixels,
+        heights: impl IntoIterator<Item = (usize, Pixels)>,
+    ) -> Self {
+        let mut rows: Vec<(usize, Pixels)> = heights
+            .into_iter()
+            .filter(|(_, h)| *h > line_height)
+            .collect();
+        rows.sort_by_key(|(row, _)| *row);
+        rows.dedup_by(|later, earlier| {
+            let same = later.0 == earlier.0;
+            if same {
