+    pub(crate) fn push_inline_parser<F>(&mut self, parser: F)
+    where
+        F: Fn(&mdast::Node) -> Option<MarkdownInline> + Send + Sync + 'static,
+    {
+        self.inline_parsers.push(Arc::new(parser));
+        self.bump_revision();
+    }
+
+    pub(crate) fn parse_inline(&self, node: &mdast::Node) -> Option<MarkdownInline> {
+        self.inline_parsers.iter().find_map(|parser| {
+            let parsed = parser(node)?;
+            parsed.marks.iter().all(|(range, _)| {
+                range.start <= range.end && parsed.text.get(range.clone()).is_some()
+            }).then_some(parsed)
+        })
+    }
