+    /// Replace several exact source ranges as one undoable user edit and put
+    /// the selection at `selection` (source offsets after the edit). `edits`
+    /// hold ranges of the current text, sorted and not overlapping; each is
+    /// applied as its own minimal change, last first, so Undo restores every
+    /// byte and the selection before the edit in one step. Returns false,
+    /// changing nothing, when the editor is not editable or a range is out of
+    /// order or off a character boundary. Used for list continuation with
+    /// renumbering (#1635).
+    pub fn replace_source_edits(
+        &mut self,
+        edits: &[(std::ops::Range<usize>, String)],
+        selection: std::ops::Range<usize>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        let value = self.text.to_string();
+        let mut end = 0;
+        for (range, _) in edits {
+            if range.start < end
+                || range.start > range.end
+                || !value.is_char_boundary(range.start)
+                || !value.is_char_boundary(range.end)
+            {
+                return false;
+            }
+            end = range.end;
+        }
+        let length = value.len() as isize
+            + edits
+                .iter()
+                .map(|(range, text)| text.len() as isize - range.len() as isize)
+                .sum::<isize>();
+        if !self.is_editable()
+            || edits.is_empty()
+            || selection.start > selection.end
+            || selection.end as isize > length
+        {
+            return false;
+        }
+        let after: Selection = selection.into();
+        self.undo_manager.begin_group();
+        self.exact_replacement = true;
+        for (ix, (range, text)) in edits.iter().enumerate().rev() {
+            self.undo_manager.pending_intent = Some(EditIntent::Atomic);
+            // Redo ends on the last change it replays: the first range.
+            if ix == 0 {
+                self.pending_selection_after = Some(after);
+            }
+            let range_utf16 = self.range_to_utf16(range);
+            self.replace_text_in_range_silent(Some(range_utf16), text, window, cx);
+        }
+        self.exact_replacement = false;
+        self.pending_selection_after = None;
+        self.undo_manager.end_group();
+        let text = self.text.to_string();
+        let clip = |offset: usize| {
+            let mut offset = offset.min(text.len());
+            while !text.is_char_boundary(offset) {
+                offset -= 1;
+            }
+            offset
+        };
+        self.selected_range = (clip(after.start)..clip(after.end)).into();
+        self.selection_reversed = false;
+        self.update_preferred_column();
+        self.sync_projection_active();
+        cx.notify();
+        true
+    }
+
+    /// True while a completion menu is open or an inline completion is
