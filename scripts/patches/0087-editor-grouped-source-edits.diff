+    #[test]
+    fn a_group_is_one_undo_step_undone_in_reverse() {
+        let mut manager = UndoManager::new();
+        manager.record_transaction(typing_change(0, "a"), EditIntent::Typing);
+        manager.begin_group();
+        manager.record_transaction(typing_change(1, "\n- "), EditIntent::Atomic);
+        manager.record_transaction(typing_change(9, "3"), EditIntent::Atomic);
+        manager.end_group();
+        manager.record_transaction(typing_change(4, "b"), EditIntent::Typing);
+
+        assert_eq!(manager.undo().unwrap().len(), 1, "typing after the group");
+        let group = manager.undo().unwrap();
+        assert_eq!(group.len(), 2);
+        assert_eq!(group[0].new_text, "3", "the last change is undone first");
+        assert_eq!(manager.undo().unwrap().len(), 1, "typing before the group");
+        assert!(manager.undo().is_none());
+        assert_eq!(manager.redo().unwrap().len(), 1);
+        assert_eq!(manager.redo().unwrap().len(), 2, "redo replays the group");
+    }
