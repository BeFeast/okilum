 #[cfg(test)]
 mod tests {
+    /// #931: right-to-left glyphs arrive in visual order; rows must still be
+    /// logical ranges that break after whitespace and fit the width.
+    #[test]
+    fn rtl_lines_wrap_in_logical_order() {
+        use gpui::{FontId, GlyphId, LineLayout, ShapedGlyph, ShapedRun};
+        let layout = |line: &str, visual: &[usize]| LineLayout {
+            font_size: px(10.),
+            width: px(10. * visual.len() as f32),
+            ascent: px(8.),
+            descent: px(2.),
+            runs: vec![ShapedRun {
+                font_id: FontId(0),
+                glyphs: visual
+                    .iter()
+                    .enumerate()
+                    .map(|(i, &index)| ShapedGlyph {
+                        id: GlyphId(0),
+                        position: point(px(10. * i as f32), px(0.)),
+                        index,
+                        is_emoji: false,
+                    })
+                    .collect(),
+            }],
+            len: line.len(),
+        };
+        // "אב גד הו": eight 10px clusters drawn right to left.
+        let line = "אב גד הו";
+        let visual = [12, 10, 9, 7, 5, 4, 2, 0];
+        assert!(has_rtl(line) && !has_rtl("abc 123"));
+        assert_eq!(logical_wrap_boundaries(line, &layout(line, &visual), px(35.)), vec![5, 10]);
+        // Everything fits: no boundary.
+        assert!(logical_wrap_boundaries(line, &layout(line, &visual), px(80.)).is_empty());
+        // A word longer than the row breaks before the overflowing cluster.
+        let word = "אבגדהו";
+        let visual = [10, 8, 6, 4, 2, 0];
+        assert_eq!(logical_wrap_boundaries(word, &layout(word, &visual), px(25.)), vec![4, 8]);
+        // Mixed: LTR prefix, RTL run, LTR suffix ("ab אב cd").
+        let mixed = "ab אב cd";
+        let visual = [0, 1, 2, 5, 3, 7, 8, 9];
+        let bounds = logical_wrap_boundaries(mixed, &layout(mixed, &visual), px(35.));
+        assert_eq!(bounds, vec![3, 8]);
+        assert!(bounds.windows(2).all(|w| w[0] < w[1]));
+    }
