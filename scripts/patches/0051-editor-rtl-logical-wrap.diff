+/// Whether `line` holds right-to-left script (Hebrew, Arabic, Syriac, Thaana,
+/// N'Ko, Samaritan, Mandaic and their presentation forms).
+fn has_rtl(line: &str) -> bool {
+    line.chars().any(|c| {
+        matches!(c as u32, 0x0590..=0x08FF | 0xFB1D..=0xFDFF | 0xFE70..=0xFEFF | 0x10800..=0x10FFF | 0x1E800..=0x1EFFF)
+    })
+}
+
+/// Greedy wrap boundaries in logical (byte) order from the advances of an
+/// unwrapped styled layout: break after the last whitespace that fits, else
+/// before the cluster that overflows. Trailing whitespace may hang, as in
+/// gpui's LineWrapper. Returned byte offsets ascend and start clusters.
+fn logical_wrap_boundaries(line: &str, layout: &gpui::LineLayout, width: Pixels) -> Vec<usize> {
+    let mut glyphs: Vec<(Pixels, usize)> = layout
+        .runs
+        .iter()
+        .flat_map(|run| run.glyphs.iter().map(|glyph| (glyph.position.x, glyph.index)))
+        .collect();
+    glyphs.sort_by(|a, b| a.0.partial_cmp(&b.0).unwrap_or(std::cmp::Ordering::Equal));
+    // Advance of each glyph in visual order, summed per logical cluster start.
+    let mut clusters: std::collections::BTreeMap<usize, Pixels> = std::collections::BTreeMap::new();
+    for (i, &(x, index)) in glyphs.iter().enumerate() {
+        let next = glyphs.get(i + 1).map_or(layout.width, |g| g.0);
+        *clusters.entry(index.min(line.len())).or_insert(Pixels::ZERO) += (next - x).max(Pixels::ZERO);
+    }
+    let clusters: Vec<(usize, Pixels)> = clusters.into_iter().collect();
+    let mut boundaries = Vec::new();
+    let mut row_start = 0usize; // index into `clusters`
+    let mut row_width = Pixels::ZERO;
+    let mut after_space: Option<usize> = None; // cluster index that follows a whitespace
+    let mut i = 0;
+    while i < clusters.len() {
+        let (offset, advance) = clusters[i];
+        let space = line[offset..].chars().next().is_some_and(char::is_whitespace);
+        if !space && i > row_start && row_width + advance > width {
+            let at = after_space.filter(|&at| at > row_start && at <= i).unwrap_or(i);
+            boundaries.push(clusters[at].0);
+            row_start = at;
+            row_width = clusters[at..i].iter().map(|c| c.1).fold(Pixels::ZERO, |a, b| a + b);
+            after_space = None;
+            continue;
+        }
+        row_width += advance;
+        if space {
+            after_space = Some(i + 1);
+        }
+        i += 1;
+    }
+    boundaries.retain(|&b| b > 0 && b < line.len());
+    boundaries
+}
