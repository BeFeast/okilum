+
+type RenderBlockFn = dyn Fn(usize, &mut Window, &mut App) -> AnyElement;
+
+/// How long the view must stay where it is before the blocks ahead are shaped.
+const SHAPE_AHEAD_SETTLE: Duration = Duration::from_millis(200);
+/// How far below the scroll position, in pixels of laid-out blocks, to shape.
+/// A fast flick on a wheel covers about five viewports.
+const SHAPE_AHEAD_PIXELS: Pixels = px(7000.);
+/// What a block that is not laid out ahead counts for towards the distance.
+const SHAPE_AHEAD_SKIPPED_HEIGHT: Pixels = px(80.);
+/// Real time one frame spends on this, so the frame is not held up.
+const SHAPE_AHEAD_BUDGET: Duration = Duration::from_millis(4);
+
+/// Shapes the text of the blocks below the viewport while the view is idle, so
+/// the first fast scroll after opening a note finds it already shaped (#1312).
+///
+/// A large note is virtualized: the list lays out a block only when it enters
+/// its overdraw band, and the first lines of every block go through the
+/// platform text shaper then. A fast flick brings a new section into the band
+/// every frame, and that shaping is most of what is left of its cost once lines
+/// are kept in the shaped-line cache. Here the blocks beyond the band are laid
+/// out (layout only: no hitboxes, nothing painted) in a few frames after the
+/// scroll position has stopped moving, so the cache holds their lines before
+/// the user scrolls.
+///
+/// The work is finite. It runs only in frames of a view that stays still, in
+/// small steps, asks for a next frame only while blocks are left, and then
+/// stops: a view that is not being used does no work here. Scrolling again
+/// restarts it from the new position and skips what is already done. It does
+/// nothing for a note whose blocks the list measures all at once.
+struct ShapeAhead {
+    list_state: ListState,
+    render_item: Rc<RenderBlockFn>,
+    /// Identity of the parsed blocks: a new parse starts over.
+    document: usize,
+    blocks: Arc<Vec<BlockNode>>,
+}
+
+/// Whether laying a block out ahead of time could start work beyond shaping:
+/// loading an image, or whatever a Markdown extension renders.
+fn may_start_loading(block: &BlockNode) -> bool {
+    let has_image = |paragraph: &Paragraph| paragraph.children.iter().any(|node| node.image.is_some());
+    match block {
+        BlockNode::Paragraph(paragraph) => has_image(paragraph),
+        BlockNode::Heading { children, .. } => has_image(children),
+        BlockNode::Root { children, .. }
+        | BlockNode::Blockquote { children, .. }
+        | BlockNode::List { children, .. }
+        | BlockNode::ListItem { children, .. } => children.iter().any(may_start_loading),
+        BlockNode::Table(table) => table
+            .children
+            .iter()
+            .any(|row| row.children.iter().any(|cell| has_image(&cell.children))),
+        BlockNode::Custom(_) => true,
+        BlockNode::CodeBlock(_)
+        | BlockNode::Break { .. }
+        | BlockNode::HorizontalRule { .. }
+        | BlockNode::Definition { .. }
+        | BlockNode::Unknown => false,
+    }
+}
+
+#[derive(Default)]
+struct ShapeAheadProgress {
+    document: usize,
+    width: Pixels,
+    /// Blocks already laid out here, and their heights.
+    laid_out: HashMap<usize, Pixels>,
+    last_top: Option<(usize, Pixels)>,
+    last_change: Option<Instant>,
+    /// A wake-up timer is waiting to redraw the view once it has settled.
+    wake_pending: Arc<AtomicBool>,
+    finished_at: Option<(usize, Pixels)>,
+}
+
+impl IntoElement for ShapeAhead {
+    type Element = Self;
+
+    fn into_element(self) -> Self::Element {
+        self
+    }
+}
+
+impl Element for ShapeAhead {
+    type RequestLayoutState = ();
+    type PrepaintState = ();
+
+    fn id(&self) -> Option<ElementId> {
+        Some("shape-ahead".into())
+    }
+
+    fn source_location(&self) -> Option<&'static core::panic::Location<'static>> {
+        None
+    }
+
+    fn request_layout(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (LayoutId, Self::RequestLayoutState) {
+        let mut style = Style::default();
+        style.position = gpui::Position::Absolute;
+        (window.request_layout(style, [], cx), ())
+    }
+
+    fn prepaint(
+        &mut self,
+        id: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut Self::RequestLayoutState,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Self::PrepaintState {
+        let Some(id) = id else {
+            return;
+        };
+        let viewport = self.list_state.viewport_bounds();
+        let count = self.list_state.item_count();
+        if viewport.size.width <= px(0.) || count == 0 {
+            return;
+        }
+        let list_state = self.list_state.clone();
+        let render_item = self.render_item.clone();
+        let blocks = self.blocks.clone();
+        let document = self.document;
+        let now = cx.background_executor().now();
+        window.with_element_state::<ShapeAheadProgress, _>(id, |progress, window| {
+            let mut progress = progress.unwrap_or_default();
+            if progress.document != document || progress.width != viewport.size.width {
+                progress = ShapeAheadProgress {
+                    document,
+                    width: viewport.size.width,
+                    wake_pending: progress.wake_pending,
+                    ..Default::default()
+                };
+            }
+            let offset = list_state.logical_scroll_top();
+            let top = (offset.item_ix, offset.offset_in_item);
+            if progress.last_top != Some(top) {
+                // Moving: nothing to do now, and look again once it stops.
+                progress.last_top = Some(top);
+                progress.last_change = Some(now);
+                progress.finished_at = None;
+                Self::wake_after(SHAPE_AHEAD_SETTLE, &progress.wake_pending, window, cx);
+                return ((), progress);
+            }
+            if progress.finished_at == Some(top) {
+                return ((), progress);
+            }
+            let still_for = progress
+                .last_change
+                .map_or(Duration::ZERO, |at| now.saturating_duration_since(at));
+            if still_for < SHAPE_AHEAD_SETTLE {
+                Self::wake_after(
+                    SHAPE_AHEAD_SETTLE - still_for,
+                    &progress.wake_pending,
+                    window,
+                    cx,
+                );
+                return ((), progress);
+            }
+            let space = size(
+                AvailableSpace::Definite(viewport.size.width),
+                AvailableSpace::MinContent,
+            );
+            let began = Instant::now();
+            let mut extent = px(0.);
+            let mut ix = offset.item_ix;
+            let mut finished = true;
+            while ix < count && extent < SHAPE_AHEAD_PIXELS {
+                if let Some(bounds) = list_state.bounds_for_item(ix) {
+                    // The list measured it: its lines were shaped then.
+                    extent += bounds.size.height;
+                } else if let Some(height) = progress.laid_out.get(&ix) {
+                    extent += *height;
+                } else {
+                    if began.elapsed() >= SHAPE_AHEAD_BUDGET {
+                        finished = false;
+                        break;
+                    }
+                    let height = if may_start_loading(&blocks[ix]) {
+                        // Left for the list: nothing here may start loading.
+                        SHAPE_AHEAD_SKIPPED_HEIGHT
+                    } else {
+                        render_item(ix, window, cx)
+                            .layout_as_root(space, window, cx)
+                            .height
+                    };
+                    progress.laid_out.insert(ix, height);
+                    extent += height;
                 }
+                ix += 1;
+            }
+            if finished {
+                progress.finished_at = Some(top);
+            } else {
+                window.request_animation_frame();
+            }
+            ((), progress)
+        });
+    }
+
+    fn paint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut Self::RequestLayoutState,
+        _: &mut Self::PrepaintState,
+        _: &mut Window,
+        _: &mut App,
+    ) {
+    }
+}
+
+impl ShapeAhead {
+    /// Redraws the view after `delay`, once, unless a redraw is already waiting.
+    fn wake_after(delay: Duration, pending: &Arc<AtomicBool>, window: &mut Window, cx: &mut App) {
+        if pending.swap(true, Ordering::AcqRel) {
+            return;
+        }
+        let view = window.current_view();
+        let pending = pending.clone();
+        window
+            .spawn(cx, async move |cx| {
+                cx.background_executor().timer(delay).await;
+                pending.store(false, Ordering::Release);
+                let _ = cx.update(|_, cx| cx.notify(view));
             })
-            .size_full()
-            .pb(node_cx.style.bottom_padding()),
-        )
+            .detach();
     }
 }
