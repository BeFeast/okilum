+    /// #1312: the blocks of a large document beyond the list's band are shaped
+    /// while the view is idle, in a few frames, and then the work stops.
+    #[test]
+    fn an_idle_large_document_is_shaped_ahead_and_then_does_nothing() {
+        use super::super::inline::test_fonts::WideMonoTextSystem;
+        use gpui::{
+            Bounds, DevicePixels, Font, FontId, FontMetrics, FontRun, GlyphId, LineLayout,
+            PlatformTextSystem, RenderGlyphParams, Size, TestApp, TextRenderingMode,
+        };
+        use std::{borrow::Cow, sync::Mutex, time::Duration};
+
+        /// Records the text of every line the platform is asked to shape.
+        #[derive(Default)]
+        struct CountingTextSystem {
+            shaped: Mutex<Vec<String>>,
+        }
+
+        impl PlatformTextSystem for CountingTextSystem {
+            fn add_fonts(&self, fonts: Vec<Cow<'static, [u8]>>) -> anyhow::Result<()> {
+                WideMonoTextSystem.add_fonts(fonts)
+            }
+            fn all_font_names(&self) -> Vec<String> {
+                WideMonoTextSystem.all_font_names()
+            }
+            fn font_id(&self, descriptor: &Font) -> anyhow::Result<FontId> {
+                WideMonoTextSystem.font_id(descriptor)
+            }
+            fn font_metrics(&self, font_id: FontId) -> FontMetrics {
+                WideMonoTextSystem.font_metrics(font_id)
+            }
+            fn typographic_bounds(
+                &self,
+                font_id: FontId,
+                glyph_id: GlyphId,
+            ) -> anyhow::Result<Bounds<f32>> {
+                WideMonoTextSystem.typographic_bounds(font_id, glyph_id)
+            }
+            fn advance(&self, font_id: FontId, glyph_id: GlyphId) -> anyhow::Result<Size<f32>> {
+                WideMonoTextSystem.advance(font_id, glyph_id)
+            }
+            fn glyph_for_char(&self, font_id: FontId, ch: char) -> Option<GlyphId> {
+                WideMonoTextSystem.glyph_for_char(font_id, ch)
+            }
+            fn glyph_raster_bounds(
+                &self,
+                params: &RenderGlyphParams,
+            ) -> anyhow::Result<Bounds<DevicePixels>> {
+                WideMonoTextSystem.glyph_raster_bounds(params)
+            }
+            fn rasterize_glyph(
+                &self,
+                params: &RenderGlyphParams,
+                raster_bounds: Bounds<DevicePixels>,
+            ) -> anyhow::Result<(Size<DevicePixels>, Vec<u8>)> {
+                WideMonoTextSystem.rasterize_glyph(params, raster_bounds)
+            }
+            fn layout_line(&self, text: &str, font_size: Pixels, runs: &[FontRun]) -> LineLayout {
+                self.shaped.lock().unwrap().push(text.to_string());
+                WideMonoTextSystem.layout_line(text, font_size, runs)
+            }
+            fn recommended_rendering_mode(
+                &self,
+                font_id: FontId,
+                font_size: Pixels,
+            ) -> TextRenderingMode {
+                WideMonoTextSystem.recommended_rendering_mode(font_id, font_size)
+            }
+        }
+
+        let text_system = Arc::new(CountingTextSystem::default());
+        let mut app = TestApp::with_text_system(text_system.clone());
+        app.update(crate::init);
+        let mut window = app.open_window(|_, cx| FullWidthTestRoot {
+            text_view: cx.new(|cx| TextViewState::markdown(&document_of(600, 1), cx)),
+        });
+        let frame = |app: &mut TestApp, window: &mut gpui::TestAppWindow<FullWidthTestRoot>| {
+            app.run_until_parked();
+            window.draw();
+        };
+        for _ in 0..3 {
+            frame(&mut app, &mut window);
+        }
+        window.read(|root, cx| assert!(root.text_view.read(cx).list_visible_only));
+
+        let furthest = |text_system: &CountingTextSystem| {
+            text_system
+                .shaped
+                .lock()
+                .unwrap()
+                .iter()
+                .filter_map(|line| {
+                    line.strip_prefix("Block ")
+                        .and_then(|rest| rest.split(':').next())
+                        .and_then(|n| n.parse::<usize>().ok())
+                })
+                .max()
+                .unwrap_or(0)
+        };
+        let opened = furthest(&text_system);
+        assert!(opened > 0, "positive control: the band is shaped on open");
+
+        // Nothing moves for a while: the blocks ahead are shaped in some frames.
+        for _ in 0..80 {
+            app.advance_clock(Duration::from_millis(250));
+            frame(&mut app, &mut window);
+        }
+        let ahead = furthest(&text_system);
+        assert!(
+            ahead > opened + 100,
+            "blocks beyond the band are shaped while idle: first {opened}, then {ahead}"
+        );
+
+        // And then it stops: no line is shaped in frames that follow.
+        let lines = text_system.shaped.lock().unwrap().len();
+        for _ in 0..20 {
+            app.advance_clock(Duration::from_secs(1));
+            frame(&mut app, &mut window);
+        }
+        assert_eq!(
+            text_system.shaped.lock().unwrap().len(),
+            lines,
+            "an idle view does no shaping once the blocks ahead are done"
+        );
+
+        // Scrolling brings only blocks that were shaped ahead (lines are shaped
+        // again by this test platform, which has no cache, but no block new).
+        let seen = ahead;
+        for _ in 0..60 {
+            window.update(|root, _, cx| {
+                root.text_view.read(cx).list_state().scroll_by(px(40.));
+                cx.notify();
+            });
+            frame(&mut app, &mut window);
+        }
+        assert!(
+            furthest(&text_system) <= seen + 30,
+            "a flick inside the shaped range brings few new blocks: {} after {seen}",
+            furthest(&text_system)
+        );
+    }
+
     struct StatelessMarkdownRoot {
         renders: Arc<AtomicUsize>,
     }
