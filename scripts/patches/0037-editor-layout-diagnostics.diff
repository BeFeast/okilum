+    /// Enable counters explicitly; no clocks, formatting, I/O or notifications in layout.
+    pub fn enable_layout_diagnostics(&mut self) {
+        self.layout_diagnostics.get_or_insert_with(Default::default);
+    }
+
+    pub fn layout_diagnostics(&self) -> Option<LayoutDiagnostics> {
+        self.layout_diagnostics.as_ref().map(Cell::get)
+    }
+
+    pub(super) fn record_layout_diagnostic(&self, update: impl FnOnce(&mut LayoutDiagnostics)) {
+        if let Some(cell) = &self.layout_diagnostics {
+            let mut value = cell.get();
+            update(&mut value);
+            cell.set(value);
+        }
+    }
