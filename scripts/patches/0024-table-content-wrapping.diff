+//! Shared break opportunities for table min-content measurement and layout.
+//! Byte ranges refer to the original text: selection, links and copying keep
+//! their source offsets; no zero-width characters are inserted into the text.
+use std::ops::Range;
+use unicode_segmentation::UnicodeSegmentation;
+
+pub(super) fn segments(text: &str) -> Vec<Range<usize>> {
+    // Symbol tailoring must never suppress a mandatory UAX #14 break.
+    let mut ends: Vec<usize> = unicode_linebreak::linebreaks(text)
+        .filter_map(|(i, kind)| {
+            (kind == unicode_linebreak::BreakOpportunity::Mandatory
+                || !text[i..].starts_with(['♯', '♭', '″', '′']))
+            .then_some(i)
+        })
+        .collect();
+    let mut start = 0;
+    for token in text.split_inclusive(char::is_whitespace) {
+        let word = token.trim_end();
+        let chars: Vec<usize> = word
+            .grapheme_indices(true)
+            .map(|(i, _)| i)
+            .chain(std::iter::once(word.len()))
+            .collect();
+        let n = chars.len().saturating_sub(1);
+        let technical = word.contains(['/', '_'])
+            || (word.contains(['-', '.']) && word.chars().any(|c| c.is_ascii_digit()))
+            || (word.chars().all(|c| c.is_ascii_hexdigit())
+                && word.chars().any(|c| c.is_ascii_digit()));
+        if n > 24 && technical {
+            ends.retain(|&i| i <= start || i >= start + word.len());
+            let mut previous = 0;
+            while n - previous > 24 {
+                let limit = (previous + 24).min(n - 4);
+                let split = (previous + 4..=limit)
+                    .rev()
+                    .find(|&i| word[..chars[i]].ends_with(['/', '-', '_', '.']))
+                    .unwrap_or(limit);
+                ends.push(start + chars[split]);
+                previous = split;
+            }
+        }
+        start += token.len();
+    }
+    ends.push(text.len());
+    ends.sort_unstable();
+    ends.dedup();
+    let mut start = 0;
+    ends.into_iter()
+        .filter_map(|end| {
+            let range = start..end;
+            start = end;
+            (!range.is_empty()).then_some(range)
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn keeps_words_pitch_and_measurements_intact() {
+        let text =
+            "25.5″ Floyd / Drop C♯ B♭ Кириллица mixedЯзык supercalifragilisticexpialidocious";
+        let parts: Vec<_> = segments(text).into_iter().map(|r| &text[r]).collect();
+        for word in [
+            "25.5″",
+            "C♯",
+            "B♭",
+            "Кириллица",
+            "mixedЯзык",
+            "supercalifragilisticexpialidocious",
+        ] {
+            assert!(parts.iter().any(|p| p.contains(word)), "{word}: {parts:?}");
+        }
+        assert_eq!(parts.concat(), text);
+    }
+    #[test]
+    fn mandatory_breaks_before_symbols_survive_tailoring() {
+        for symbol in ["♯", "♭", "″", "′"] {
+            for newline in ["\n", "\r\n"] {
+                let text = format!("first{newline}{symbol}second");
+                let parts: Vec<_> = segments(&text).into_iter().map(|r| &text[r]).collect();
+                assert_eq!(parts[0], format!("first{newline}"));
+                assert_eq!(parts.concat(), text);
+            }
+        }
+    }
+    #[test]
+    fn technical_fragments_have_no_tiny_tails() {
+        for text in [
+            "https://example.com/very_long_directory/another_document.md",
+            "/Users/example/attachments/long_file_name_2026.png",
+            "0123456789abcdef0123456789abcdef0123456789abcdef",
+        ] {
+            let parts: Vec<_> = segments(text).into_iter().map(|r| &text[r]).collect();
+            assert!(parts.len() > 1);
+            assert!(parts.iter().all(|p| p.chars().count() >= 4), "{parts:?}");
+            assert_eq!(parts.concat(), text);
+        }
+    }
+}
