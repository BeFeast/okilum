+/// Shape the same unbreakable segments used by min-content measurement.
+/// Unlike the general GPUI wrapper, this never falls back to a glyph boundary.
+fn table_line_ranges(
+    items: &[MeasureItem],
+    image_sizes: &[Option<Size<Pixels>>],
+    style: &TextStyle,
+    wrap_width: Option<Pixels>,
+    window: &mut Window,
+) -> Vec<Range<usize>> {
+    let mut text = String::new();
+    for item in items {
+        match item {
+            MeasureItem::Text { text: value, .. } => text.push_str(value),
+            MeasureItem::Image { .. } => text.push('\u{1}'),
+        }
+    }
+    let Some(limit) = wrap_width else {
+        return line_ranges(items, image_sizes, style, None, window);
+    };
+    let mut ends: Vec<_> = super::table_wrap::segments(&text)
+        .into_iter()
+        .map(|r| r.end)
+        .collect();
+    for (i, _) in text.match_indices('\u{1}') {
+        ends.extend([i, i + IMAGE_LEN]);
+    }
+    ends.sort_unstable();
+    ends.dedup();
+    let font_size = style.font_size.to_pixels(window.rem_size());
+    let measure = |range: Range<usize>| {
+        let mut width = px(0.);
+        let mut offset = 0;
+        for (ix, item) in items.iter().enumerate() {
+            let start = range.start.max(offset);
+            let end = range.end.min(offset + item.len());
+            if start < end {
+                match item {
+                    MeasureItem::Image { .. } => width += image_sizes[ix].unwrap_or_default().width,
+                    MeasureItem::Text {
+                        text, highlights, ..
+                    } => {
+                        let local = start - offset..end - offset;
+                        let clipped: Vec<_> = highlights
+                            .iter()
+                            .filter_map(|(r, h)| {
+                                let a = r.start.max(local.start);
+                                let b = r.end.min(local.end);
+                                (a < b).then(|| (a - local.start..b - local.start, h.clone()))
+                            })
+                            .collect();
+                        let part = &text[local];
+                        let runs = text_runs(part, style, &clipped);
+                        width += window
+                            .text_system()
+                            .layout_line(part, font_size, &runs, None)
+                            .width;
+                    }
+                }
+            }
+            offset += item.len();
+        }
+        width
+    };
+    let mut result = Vec::new();
+    let mut line_start = 0;
+    let mut segment_start = 0;
+    let mut line_width = px(0.);
+    for end in ends {
+        if end == segment_start {
+            continue;
+        }
+        let segment = &text[segment_start..end];
+        let visible_end = end - (segment.len() - segment.trim_end_matches(['\r', '\n']).len());
+        let trimmed_end = segment_start + segment.trim_end().len();
+        let visible_width = measure(segment_start..trimmed_end);
+        if line_start < segment_start && line_width + visible_width > limit {
+            result.push(line_start..segment_start);
+            line_start = segment_start;
+            line_width = px(0.);
+        }
+        line_width += measure(segment_start..visible_end);
+        if segment.ends_with('\n') || segment.ends_with('\r') {
+            result.push(line_start..visible_end);
+            line_start = end;
+            line_width = px(0.);
+        }
+        segment_start = end;
+    }
+    if line_start < text.len() || result.is_empty() {
+        result.push(line_start..text.len());
+    }
+    result
+}
