+/// Data other than file paths dragged into a window from another application:
+/// text, rich text, a URL or image data. Each representation is named by the
+/// platform's own type identifier (a uniform type identifier on macOS), in
+/// the order the drag source offered them.
+///
+/// While the drag is over the window only the types are known; the contents
+/// are read when the data is dropped ([`FileDropEvent::DataSubmit`]).
+#[derive(Debug, Clone, Default, Eq, PartialEq)]
+pub struct ExternalData {
+    types: Vec<SharedString>,
+    contents: Vec<(SharedString, Arc<[u8]>)>,
+}
+
+impl ExternalData {
+    /// The offered types of a drag still in progress, without contents.
+    pub fn new(types: impl IntoIterator<Item = SharedString>) -> Self {
+        Self {
+            types: types.into_iter().collect(),
+            contents: Vec::new(),
+        }
+    }
+
+    /// Dropped data: its types and the contents that could be read.
+    pub fn with_contents(
+        types: impl IntoIterator<Item = SharedString>,
+        contents: impl IntoIterator<Item = (SharedString, Arc<[u8]>)>,
+    ) -> Self {
+        Self {
+            types: types.into_iter().collect(),
+            contents: contents.into_iter().collect(),
+        }
+    }
+
+    /// The offered type identifiers, in the drag source's order.
+    pub fn types(&self) -> &[SharedString] {
+        &self.types
+    }
+
+    /// The contents of one type, once the data was dropped.
+    pub fn contents(&self, kind: &str) -> Option<&[u8]> {
+        self.contents
+            .iter()
+            .find(|(name, _)| name.as_ref() == kind)
+            .map(|(_, bytes)| bytes.as_ref())
+    }
+}
+
+impl Render for ExternalData {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        // The platform renders the drag image.
+        Empty
+    }
+}
