+
+    struct DataDropView {
+        dropped: Rc<RefCell<Vec<ExternalData>>>,
+    }
+
+    impl Render for DataDropView {
+        fn render(&mut self, _window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+            let dropped = self.dropped.clone();
+            div()
+                .size_full()
+                .on_drop(move |data: &ExternalData, _, _| dropped.borrow_mut().push(data.clone()))
+        }
+    }
+
+    #[gpui::test]
+    fn dropped_external_data_reaches_the_drop_target_with_its_contents(cx: &mut TestAppContext) {
+        let dropped = Rc::new(RefCell::new(Vec::new()));
+        let window: AnyWindowHandle = cx
+            .add_window({
+                let dropped = dropped.clone();
+                move |_, _| DataDropView { dropped }
+            })
+            .into();
+        let position = point(px(10.), px(10.));
+        let text: SharedString = "public.utf8-plain-text".into();
+        let html: SharedString = "public.html".into();
+        cx.update_window(window, |_, window, cx| {
+            window.draw(cx).clear(cx);
+            window.dispatch_event(
+                FileDropEvent::DataEntered {
+                    position,
+                    data: ExternalData::new([text.clone(), html.clone()]),
+                }
+                .to_platform_input(),
+                cx,
+            );
+            let drag = cx.active_drag.as_ref().expect("a data drag is active");
+            let data = drag.value.downcast_ref::<ExternalData>().unwrap();
+            assert_eq!(data.types(), [text.clone(), html.clone()]);
+            assert_eq!(data.contents(&text), None, "no contents before the drop");
+            window.dispatch_event(
+                FileDropEvent::DataSubmit {
+                    position,
+                    data: ExternalData::with_contents(
+                        [text.clone(), html.clone()],
+                        [(text.clone(), Arc::from(&b"dropped"[..]))],
+                    ),
+                }
+                .to_platform_input(),
+                cx,
+            );
+            assert!(cx.active_drag.is_none(), "the drop consumed the drag");
+        })
+        .unwrap();
+        let dropped = dropped.borrow();
+        assert_eq!(dropped.len(), 1);
+        assert_eq!(dropped[0].contents(&text), Some(&b"dropped"[..]));
+        assert_eq!(dropped[0].contents(&html), None);
+    }
