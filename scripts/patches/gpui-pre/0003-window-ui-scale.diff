+#[cfg(test)]
+mod ui_scale_tests {
+    use super::*;
+    use crate::TestAppContext;
+
+    struct EmptyView;
+    impl Render for EmptyView {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            crate::div()
+        }
+    }
+
+    #[gpui::test]
+    fn ui_scale_maps_native_input_and_dpi_resize_but_not_synthetic_input(cx: &mut TestAppContext) {
+        let handle = cx.add_window(|_, _| EmptyView);
+        handle
+            .update(cx, |_, window, cx| {
+                let viewport = window.viewport_size();
+                let native_bounds = window.bounds();
+                let os_scale = window.scale_factor();
+                window.set_ui_scale(1.5);
+                assert_eq!(window.viewport_size(), viewport / 1.5);
+                assert_eq!(window.bounds(), native_bounds);
+                assert_eq!(window.scale_factor(), os_scale * 1.5);
+                let event = PlatformInput::MouseMove(MouseMoveEvent {
+                    position: point(px(300.), px(150.)),
+                    ..Default::default()
+                });
+                let PlatformInput::MouseMove(mapped) = window.input_from_native(event) else {
+                    panic!()
+                };
+                assert_eq!(mapped.position, point(px(200.), px(100.)));
+                window.dispatch_event(PlatformInput::MouseMove(mapped), cx);
+                assert_eq!(window.mouse_position(), point(px(200.), px(100.)));
+                let event = PlatformInput::ScrollWheel(crate::ScrollWheelEvent {
+                    position: point(px(300.), px(150.)),
+                    delta: crate::ScrollDelta::Pixels(point(px(0.), px(30.))),
+                    ..Default::default()
+                });
+                let PlatformInput::ScrollWheel(mapped) = window.input_from_native(event) else {
+                    panic!()
+                };
+                assert_eq!(mapped.delta.pixel_delta(px(10.)), point(px(0.), px(20.)));
+                window.bounds_changed(cx);
+                assert_eq!(window.viewport_size(), viewport / 1.5);
+                assert_eq!(window.scale_factor(), os_scale * 1.5);
+                window.set_ui_scale(f32::NAN);
+                assert_eq!(window.ui_scale(), 1.5);
+                window.set_ui_scale(1.);
+                assert_eq!(window.viewport_size(), viewport);
+            })
+            .unwrap();
+    }
