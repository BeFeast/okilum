+
+    /// Scale the logical viewport and vector rendering without resizing the native
+    /// window. Screen-space window bounds and synthetic dispatch_event inputs
+    /// retain their original coordinate contract.
+    pub fn set_ui_scale(&mut self, scale: f32) {
+        if !scale.is_finite() || scale <= 0. || scale == self.ui_scale {
+            return;
+        }
+        let ratio = self.ui_scale / scale;
+        self.viewport_size = self.platform_window.content_size() / scale;
+        self.mouse_position = self.mouse_position * ratio;
+        self.scale_factor = self.platform_window.scale_factor() * scale;
+        self.ui_scale = scale;
+        if let Some(inset) = self.client_inset {
+            self.platform_window.set_client_inset(inset * scale);
+        }
+        self.refresh();
+    }
+
+    /// Convert native local input once; synthesized gestures already use UI units.
+    fn input_from_native(&self, mut event: PlatformInput) -> PlatformInput {
+        let scale = self.ui_scale;
+        match &mut event {
+            PlatformInput::MouseDown(e) => e.position = e.position / scale,
+            PlatformInput::MouseUp(e) => e.position = e.position / scale,
+            PlatformInput::MouseMove(e) => e.position = e.position / scale,
+            PlatformInput::MouseExited(e) => e.position = e.position / scale,
+            PlatformInput::MousePressure(e) => e.position = e.position / scale,
+            PlatformInput::Pinch(e) => e.position = e.position / scale,
+            PlatformInput::ScrollWheel(e) => {
+                e.position = e.position / scale;
+                if let crate::ScrollDelta::Pixels(delta) = &mut e.delta {
+                    *delta = *delta / scale;
+                }
+            }
+            PlatformInput::Touch(e) => {
+                e.position = e.position / scale;
+                e.predicted_position = e.predicted_position.map(|p| p / scale);
+            }
+            PlatformInput::TouchDrag(e) => {
+                e.position = e.position / scale;
+                e.start_position = e.start_position / scale;
+            }
+            PlatformInput::LongPress(e) => {
+                e.position = e.position / scale;
+                e.start_position = e.start_position / scale;
+            }
+            PlatformInput::FileDrop(e) => match e {
+                FileDropEvent::Entered { position, .. }
+                | FileDropEvent::Pending { position }
+                | FileDropEvent::Submit { position }
+                | FileDropEvent::DataEntered { position, .. }
+                | FileDropEvent::DataSubmit { position, .. } => *position = *position / scale,
+                FileDropEvent::Exited | FileDropEvent::Ended => {}
+            },
+            PlatformInput::KeyDown(_)
+            | PlatformInput::KeyUp(_)
+            | PlatformInput::ModifiersChanged(_) => {}
+        }
+        event
     }
 
