+fn logical_viewport(
+    ui_scale: f32,
+    content_size: Size<Pixels>,
+    mouse_position: Point<Pixels>,
+) -> (Size<Pixels>, Point<Pixels>) {
+    if ui_scale == 1. {
+        (content_size, mouse_position)
+    } else {
+        let inverse = 1. / ui_scale;
+        (
+            size(content_size.width * inverse, content_size.height * inverse),
+            mouse_position * inverse,
+        )
+    }
+}
