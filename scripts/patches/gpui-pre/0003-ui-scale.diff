+    fn adopt_platform_viewport(&mut self) {
+        self.display_scale = self.platform_window.scale_factor();
+        self.scale_factor = self.display_scale * self.ui_scale;
+        let (viewport, mouse) = logical_viewport(
+            self.ui_scale,
+            self.platform_window.content_size(),
+            self.platform_window.mouse_position(),
+        );
+        self.viewport_size = viewport;
+        self.mouse_position = mouse;
+    }
+
+    fn sync_ui_scale(&mut self, cx: &App) {
+        if self.ui_scale == cx.ui_scale {
+            return;
+        }
+        self.ui_scale = cx.ui_scale;
+        self.adopt_platform_viewport();
+    }
