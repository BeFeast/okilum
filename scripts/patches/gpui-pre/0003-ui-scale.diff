+    /// Application UI zoom, independent of the display scale. `1.0` is the
+    /// normal size. The same physical window then shows a larger or smaller
+    /// interface; pointer coordinates and outgoing native rectangles move with it.
+    pub fn ui_scale(&self) -> f32 {
+        self.ui_scale
+    }
+
+    /// Sets the application UI zoom for every window. Non-finite and non-positive
+    /// values are ignored. Each window applies the zoom on its next draw, or
+    /// immediately on the next platform resize.
+    pub fn set_ui_scale(&mut self, ui_scale: f32) {
+        if !ui_scale.is_finite() || ui_scale <= 0. || self.ui_scale == ui_scale {
+            return;
+        }
+        self.ui_scale = ui_scale;
+        self.refresh_windows();
+    }
