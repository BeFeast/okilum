+    pub(crate) fn from_platform_point(&self, position: Point<Pixels>) -> Point<Pixels> {
+        if self.ui_scale == 1. {
+            position
+        } else {
+            position * (1. / self.ui_scale)
+        }
+    }
+
+    fn to_platform_point(&self, position: Point<Pixels>) -> Point<Pixels> {
+        if self.ui_scale == 1. {
+            position
+        } else {
+            position * self.ui_scale
+        }
+    }
+
+    fn to_platform_size(&self, size: Size<Pixels>) -> Size<Pixels> {
+        if self.ui_scale == 1. {
+            size
+        } else {
+            crate::size(size.width * self.ui_scale, size.height * self.ui_scale)
+        }
+    }
+
+    pub(crate) fn to_platform_px(&self, value: Pixels) -> Pixels {
+        if self.ui_scale == 1. {
+            value
+        } else {
+            value * self.ui_scale
+        }
+    }
+
+    pub(crate) fn to_platform_bounds(&self, bounds: Bounds<Pixels>) -> Bounds<Pixels> {
+        if self.ui_scale == 1. {
+            bounds
+        } else {
+            Bounds {
+                origin: self.to_platform_point(bounds.origin),
+                size: self.to_platform_size(bounds.size),
+            }
+        }
+    }
+
+    fn scale_platform_input(&self, event: PlatformInput) -> PlatformInput {
+        if self.ui_scale == 1. {
+            return event;
+        }
+        let inverse = 1. / self.ui_scale;
+        let point = |position: Point<Pixels>| position * inverse;
+        match event {
+            PlatformInput::MouseMove(mut event) => {
+                event.position = point(event.position);
+                PlatformInput::MouseMove(event)
+            }
+            PlatformInput::MouseDown(mut event) => {
+                event.position = point(event.position);
+                PlatformInput::MouseDown(event)
+            }
+            PlatformInput::MouseUp(mut event) => {
+                event.position = point(event.position);
+                PlatformInput::MouseUp(event)
+            }
+            PlatformInput::MousePressure(mut event) => {
+                event.position = point(event.position);
+                PlatformInput::MousePressure(event)
+            }
+            PlatformInput::MouseExited(mut event) => {
+                event.position = point(event.position);
+                PlatformInput::MouseExited(event)
+            }
+            PlatformInput::ScrollWheel(mut event) => {
+                event.position = point(event.position);
+                if let crate::ScrollDelta::Pixels(delta) = event.delta {
+                    event.delta = crate::ScrollDelta::Pixels(delta * inverse);
+                }
+                PlatformInput::ScrollWheel(event)
+            }
+            PlatformInput::Pinch(mut event) => {
+                event.position = point(event.position);
+                PlatformInput::Pinch(event)
+            }
+            PlatformInput::LongPress(mut event) => {
+                event.position = point(event.position);
+                event.start_position = point(event.start_position);
+                PlatformInput::LongPress(event)
+            }
+            PlatformInput::TouchDrag(mut event) => {
+                event.position = point(event.position);
+                event.start_position = point(event.start_position);
+                PlatformInput::TouchDrag(event)
+            }
+            PlatformInput::Touch(mut event) => {
+                event.position = point(event.position);
+                event.predicted_position = event.predicted_position.map(point);
+                PlatformInput::Touch(event)
+            }
+            PlatformInput::FileDrop(drop) => PlatformInput::FileDrop(match drop {
+                FileDropEvent::Entered { position, paths } => FileDropEvent::Entered {
+                    position: point(position),
+                    paths,
+                },
+                FileDropEvent::Pending { position } => FileDropEvent::Pending {
+                    position: point(position),
+                },
+                FileDropEvent::Submit { position } => FileDropEvent::Submit {
+                    position: point(position),
+                },
+                FileDropEvent::DataEntered { position, data } => FileDropEvent::DataEntered {
+                    position: point(position),
+                    data,
+                },
+                FileDropEvent::DataSubmit { position, data } => FileDropEvent::DataSubmit {
+                    position: point(position),
+                    data,
+                },
+                other => other,
+            }),
+            other => other,
+        }
+    }
