+fn estimated_block_height(source_bytes: usize, blocks: usize) -> Pixels {
+    let bytes_per_block = source_bytes as f32 / blocks.max(1) as f32;
+    px((bytes_per_block / 80.).ceil().max(1.) * 24. + 12.)
