+    /// #1003: a large document measures only visible blocks. Its unmeasured
+    /// blocks keep an estimated height through the list's first layout and
+    /// through width changes, or the scroll extent covers only what was seen.
+    struct FullWidthTestRoot {
+        text_view: Entity<TextViewState>,
+    }
+
+    impl Render for FullWidthTestRoot {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div()
+                .size_full()
+                .overflow_hidden()
+                .child(TextView::new(&self.text_view).scrollable(true))
+        }
+    }
+
+    #[gpui::test]
+    fn large_document_keeps_estimated_extent_after_layout_and_resize(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        const BLOCKS: usize = 600;
+        let (root, cx) = cx.add_window_view(|_, cx| FullWidthTestRoot {
+            text_view: cx.new(|cx| TextViewState::markdown(&document_of(3, 1), cx)),
+        });
+        let cx: &mut VisualTestContext = cx;
+        let settle = |cx: &mut VisualTestContext| {
+            for _ in 0..3 {
+                cx.run_until_parked();
+                cx.update(|window, cx| window.draw(cx).clear(cx));
+            }
+            cx.run_until_parked();
+        };
+        settle(cx);
+        root.update(cx, |root, cx| {
+            root.text_view
+                .update(cx, |state, cx| state.set_text(&document_of(BLOCKS, 1), cx));
+        });
+        settle(cx);
+        let extent = |cx: &mut VisualTestContext| {
+            root.read_with(cx, |root, cx| {
+                let state = root.text_view.read(cx);
+                assert_eq!(state.list_state().item_count(), BLOCKS, "positive control");
+                assert!(state.list_visible_only);
+                f32::from(state.list_state().max_offset_for_scrollbar().y)
+            })
+        };
+        // Every block counts for at least its estimate; measured-only would be
+        // about one viewport.
+        let floor = BLOCKS as f32 * 36. * 0.8;
+        let opened = extent(cx);
+        assert!(opened > floor, "extent after first layout: {opened} <= {floor}");
+        cx.simulate_resize(gpui::size(px(640.), px(480.)));
+        settle(cx);
+        let resized = extent(cx);
+        assert!(resized > floor, "extent after a width change: {resized} <= {floor}");
+    }
