+    /// Choose how the list measures this document. Small documents measure
+    /// every block so the scrollbar is exact. Large ones measure what becomes
+    /// visible; the rest carry an estimated height that real heights replace
+    /// while scrolling, so the first screen never waits for the whole document.
+    fn prepare_list_for_document(&mut self) {
+        let document = &self.parsed_content.document;
+        let count = document.blocks.len();
+        let visible_only = count > MEASURE_ALL_MAX_BLOCKS;
+        if visible_only != self.list_visible_only {
+            self.list_visible_only = visible_only;
+            let list = ListState::new(0, gpui::ListAlignment::Top, px(1000.));
+            self.list_state = if visible_only { list } else { list.measure_all() };
+        }
+        self.list_hint = visible_only.then(|| estimated_block_height(document.source.len(), count));
+        if let Some(hint) = self.list_hint
+            && self.list_state.item_count() != count
+        {
+            self.list_state.reset_with_uniform_height(count, hint);
+        }
+        self.list_hinted_width = None;
+    }
+
+    /// The list forgets unmeasured heights when its width changes, and a new
+    /// list does so on its first layout. Restore the estimate in the frame
+    /// after, keeping measured heights and the scroll position.
+    pub(super) fn restore_list_hint(&mut self, width: Pixels) -> bool {
+        if self.list_hint.is_none() || self.list_hinted_width == Some(width) {
+            return false;
+        }
+        self.list_hinted_width = Some(width);
+        true
+    }
+
+    pub(super) fn apply_list_hint(&mut self, cx: &mut Context<Self>) {
+        if let Some(hint) = self.list_hint {
+            let _ = self.list_state.clone().with_uniform_item_height(hint);
+            cx.notify();
+        }
+    }
