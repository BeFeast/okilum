index 00000000..280940ec
--- /dev/null
+++ b/crates/base/src/input/source_text.rs
@@ -0,0 +1,108 @@
+//! Immutable native Rope revisions and bounded edit ancestry. No source mutation
+//! is inferred by comparing complete note bytes.
+use std::{ops::{Deref, Range}, sync::{Arc, OnceLock, atomic::{AtomicU64, Ordering}}};
+use ropey::Rope;
+
+#[derive(Clone, Debug)]
+pub struct SourceText(Arc<Revision>);
+#[derive(Debug)]
+struct Revision { id: u64, rope: Rope, flat: OnceLock<Arc<str>>, ancestors: Vec<EditDelta>, native: bool }
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct EditDelta { pub previous: u64, pub old: Range<usize>, pub inserted: usize }
+impl EditDelta {
+    pub fn new_end(&self) -> usize { self.old.start + self.inserted }
+    pub fn forward(&self, at: usize) -> usize {
+        if at < self.old.start { at } else if at >= self.old.end { at - self.old.end + self.new_end() } else { self.old.start }
+    }
+    pub fn backward(&self, at: usize) -> usize {
+        if at < self.old.start { at } else if at >= self.new_end() { at - self.new_end() + self.old.end } else { self.old.start }
+    }
+}
+impl SourceText {
+    pub fn from_rope(rope: Rope) -> Self { Self::revision(rope, Vec::new()) }
+    fn revision(rope: Rope, ancestors: Vec<EditDelta>) -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(1 << 63);
+        Self(Arc::new(Revision { id: NEXT.fetch_add(1, Ordering::Relaxed), rope, flat: OnceLock::new(), ancestors, native: true }))
+    }
+    pub fn edited(&self, rope: Rope, old: Range<usize>, inserted: usize) -> Self {
+        assert!(old.start <= old.end && old.end <= self.len());
+        assert_eq!(self.len() - old.len() + inserted, rope.len());
+        let edit = EditDelta { previous: self.id(), old, inserted };
+        let mut ancestors = Vec::with_capacity(32);
+        ancestors.push(edit.clone());
+        // Aggregate receipts, without retaining any old Rope or source String.
+        for ancestor in self.0.ancestors.iter().take(31) {
+            let start = ancestor.old.start.min(ancestor.backward(edit.old.start));
+            let end = ancestor.old.end.max(ancestor.backward(edit.old.end));
+            let inserted = end - start + ancestor.inserted + edit.inserted - ancestor.old.len() - edit.old.len();
+            ancestors.push(EditDelta { previous: ancestor.previous, old: start..end, inserted });
+        }
+        Self::revision(rope, ancestors)
+    }
+    pub fn is_native(&self) -> bool { self.0.native }
+    pub fn id(&self) -> u64 { self.0.id }
+    pub fn rope(&self) -> &Rope { &self.0.rope }
+    pub fn len(&self) -> usize { self.0.rope.len() }
+    pub fn edit_steps(&self, steps: u64) -> Option<EditDelta> {
+        if steps == 0 { return Some(EditDelta { previous: self.id(), old: self.len()..self.len(), inserted: 0 }); }
+        self.0.ancestors.get(usize::try_from(steps).ok()?.checked_sub(1)?).cloned()
+    }
+    pub fn edit_since(&self, previous: u64) -> Option<EditDelta> {
+        if self.id() == previous { return Some(EditDelta { previous, old: self.len()..self.len(), inserted: 0 }); }
+        self.0.ancestors.iter().find(|edit| edit.previous == previous).cloned()
+    }
+    pub fn same(&self, other: &Self) -> bool { Arc::ptr_eq(&self.0, &other.0) }
+}
+impl Deref for SourceText {
+    type Target = str;
+    fn deref(&self) -> &str { self.0.flat.get_or_init(|| { FLATTENED.with(|n|n.set(n.get()+self.len())); self.0.rope.to_string().into() }) }
+}
+impl AsRef<str> for SourceText { fn as_ref(&self) -> &str { self } }
+impl std::fmt::Display for SourceText { fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { f.write_str(self) } }
+impl PartialEq for SourceText { fn eq(&self, other: &Self) -> bool { self.same(other) || self.0.rope == other.0.rope } }
+impl Eq for SourceText {}
+impl From<Arc<str>> for SourceText {
+    fn from(text: Arc<str>) -> Self { FLATTENED.with(|n|n.set(n.get()+text.len())); let mut result = Self::from_rope(Rope::from_str(&text)); Arc::get_mut(&mut result.0).unwrap().native = false; result.0.flat.set(text).ok(); result }
+}
+impl From<&str> for SourceText { fn from(text: &str) -> Self { Self::from(Arc::<str>::from(text)) } }
+impl From<String> for SourceText { fn from(text: String) -> Self { Self::from(Arc::<str>::from(text)) } }
+
+impl PartialEq<str> for SourceText { fn eq(&self, other: &str) -> bool { self.rope() == other } }
+impl PartialEq<&str> for SourceText { fn eq(&self, other: &&str) -> bool { self.rope() == *other } }
+
+thread_local! { static FLATTENED: std::cell::Cell<usize> = const {std::cell::Cell::new(0)}; }
+pub fn take_flattened_bytes() -> usize { FLATTENED.with(|n|n.replace(0)) }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn coalesced_receipts_map_ime_undo_and_unpainted_edits() {
+        let original=SourceText::from_rope(Rope::from_str("\u{feff}ab\r\nשלום"));
+        let mut rope=original.rope().clone(); rope.remove(4..5);rope.insert(4,"中");
+        let ime=original.edited(rope,4..5,3);
+        let mut rope=ime.rope().clone();rope.insert(7,"\n");
+        let enter=ime.edited(rope,7..7,1);
+        let receipt=enter.edit_since(original.id()).unwrap();
+        assert_eq!(receipt.old,4..5);assert_eq!(receipt.inserted,4);
+        assert_eq!(receipt.forward(original.len()),enter.len());
+        assert_eq!(receipt.backward(enter.len()),original.len());
+        let mut rope=enter.rope().clone();rope.remove(4..8);rope.insert(4,"b");
+        let undo=enter.edited(rope,4..8,1);
+        assert_eq!(undo.rope(),original.rope());
+        let receipt=undo.edit_since(original.id()).unwrap();
+        assert_eq!(receipt.forward(original.len()),undo.len());
+        assert!(undo.edit_since(SourceText::from_rope(Rope::from_str("foreign")).id()).is_none());
+        assert!(!original.same(&undo),"Undo restores bytes, never a revision lease");
+    }
+    #[test]
+    fn source_snapshot_flattening_has_an_old_input_positive_control() {
+        for bytes in [25*1024,130*1024,1024*1024] {
+            let text=SourceText::from_rope(Rope::from_str(&"x".repeat(bytes)));
+            take_flattened_bytes();let _shared=text.clone();
+            assert_eq!(take_flattened_bytes(),0);
+            let _old_input=SourceText::from(Arc::<str>::from(text.rope().to_string()));
+            assert_eq!(take_flattened_bytes(),bytes);
+        }
+    }
+}
