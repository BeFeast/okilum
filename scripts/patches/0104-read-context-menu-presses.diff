+/// The link at `offset` and the text of every adjacent run carrying the same
+/// link: inline markup splits one link into several runs.
+fn link_press_at(
+    text: &str,
+    links: &[(Range<usize>, LinkMark)],
+    offset: usize,
+) -> Option<super::text_view::LinkSecondaryPress> {
+    let hit = links.iter().position(|(range, _)| range.contains(&offset))?;
+    let url = &links[hit].1.url;
+    let same = |ix: usize, next: usize| {
+        links[next].1.url == *url && links[ix].0.end == links[next].0.start
+    };
+    let mut first = hit;
+    while first > 0 && same(first - 1, first) {
+        first -= 1;
+    }
+    let mut last = hit;
+    while last + 1 < links.len() && same(last, last + 1) {
+        last += 1;
+    }
+    let span = links[first].0.start..links[last].0.end;
+    let label = text.get(span)?;
+    Some(super::text_view::LinkSecondaryPress::new(
+        url.clone(),
+        label.to_string().into(),
+    ))
+}
