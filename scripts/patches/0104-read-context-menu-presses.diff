+/// A secondary (right) press on a rendered link: its URL as the view holds it
+/// and the visible text of the whole link (every run that carries it).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LinkSecondaryPress {
+    url: SharedString,
+    text: SharedString,
+}
+
+impl LinkSecondaryPress {
+    pub(crate) fn new(url: SharedString, text: SharedString) -> Self {
+        Self { url, text }
+    }
+
+    /// The link's URL, as the parsed document holds it.
+    pub fn url(&self) -> &SharedString {
+        &self.url
+    }
+
+    /// The link's visible text.
+    pub fn text(&self) -> &SharedString {
+        &self.text
+    }
+}
+
+pub(crate) type LinkSecondaryPressFn =
