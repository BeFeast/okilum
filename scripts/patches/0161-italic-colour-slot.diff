     use super::*;
 
+    /// Italic colour slot: plain italic takes the theme colour; bold italic,
+    /// italic code and text without the slot keep theirs.
+    #[test]
+    fn italic_slot_colours_plain_italic_only() {
+        let purple: Hsla = gpui::rgb(0xbb9af7).into();
+        let themed = NodeContext {
+            style: TextViewStyle::default().with_decorations(crate::text::TextDecorations {
+                italic: Some(purple),
+                ..Default::default()
+            }),
+            ..Default::default()
+        };
+        let color = |mark: TextMark, node_cx: &NodeContext| mark_highlight(&mark, node_cx).style.color;
+        assert_eq!(color(TextMark::default().italic(), &themed), Some(purple));
+        assert_eq!(color(TextMark::default().italic(), &NodeContext::default()), None);
+        assert_eq!(color(TextMark::default(), &themed), None);
+        assert_eq!(color(TextMark::default().italic().bold(), &themed), None);
+        assert_ne!(color(TextMark::default().italic().code(), &themed), Some(purple));
+    }
