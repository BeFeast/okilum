+    fn code_span(source: &str) -> String {
+        let mut cx = NodeContext::default();
+        let document = parse(source, &mut cx).unwrap();
+        let BlockNode::Paragraph(paragraph) = &document.blocks[0] else {
+            panic!("expected paragraph for {source:?}");
+        };
+        paragraph
+            .children
+            .iter()
+            .find(|node| node.marks.iter().any(|(_, mark)| mark.code))
+            .map(|node| node.text.to_string())
+            .unwrap_or_default()
+    }
+
+    /// CommonMark code spans: line endings become spaces, then one space is
+    /// stripped from each end when both ends are spaces and not all are
+    /// (spec examples 335-337, 121, 640, 641 and the padding examples).
+    #[test]
+    fn test_code_span_line_endings_become_spaces() {
+        assert_eq!(code_span("`code\nspan`"), "code span");
+        assert_eq!(code_span("`code\r\nspan`"), "code span");
+        assert_eq!(code_span("``\nfoo\nbar  \nbaz\n``"), "foo bar   baz");
+        assert_eq!(code_span("``\nfoo \n``"), "foo ");
+        assert_eq!(code_span("`foo   bar \nbaz`"), "foo   bar  baz");
+        // The parser already strips literal padding; it is not stripped twice.
+        assert_eq!(code_span("` a `"), "a");
+        assert_eq!(code_span("`  a\nb  `"), " a b ");
+        assert_eq!(code_span("` \nfoo\n `"), " foo ");
+        assert_eq!(code_span("` `"), " ");
+        assert_eq!(code_span("`\n`\n`"), " ");
+    }
