+        assert_eq!(paragraph_texts(&document.blocks[0]).concat(), "a x y b p q");
+        let document = parse("- item `x\ny`", &mut cx).unwrap();
+        let BlockNode::List { children, .. } = &document.blocks[0] else {
+            panic!("expected list");
+        };
+        let BlockNode::ListItem { children, .. } = &children[0] else {
+            panic!("expected item");
+        };
+        assert_eq!(paragraph_texts(&children[0]).concat(), "item x y");
+    }
