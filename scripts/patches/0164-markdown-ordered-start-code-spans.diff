+    fn code_block_texts(source: &str) -> (String, String) {
+        fn find(block: &BlockNode) -> Option<(String, String)> {
+            match block {
+                BlockNode::CodeBlock(code) => Some((
+                    code.code().to_string(),
+                    code.copy_code().map(|c| c.to_string()).unwrap_or_default(),
+                )),
+                BlockNode::List { children, .. }
+                | BlockNode::ListItem { children, .. }
+                | BlockNode::Root { children, .. } => children.iter().find_map(find),
+                _ => None,
+            }
+        }
+        let mut cx = NodeContext::default();
+        let document = parse(source, &mut cx).unwrap();
+        document.blocks.iter().find_map(find).expect("code block")
+    }
+
+    /// A fenced block keeps every blank line before its closing fence, in the
+    /// document root and inside a list item (CommonMark example 318). Display
+    /// text omits the terminal line ending; the copied text has it.
+    #[test]
+    fn test_fenced_code_keeps_trailing_blank_lines() {
+        for (source, shown, copied) in [
+            ("```\nb\n\n\n```\n", "b\n\n", "b\n\n\n"),
+            ("- a\n- ```\n  b\n\n\n  ```\n- c\n", "b\n\n", "b\n\n\n"),
+            ("```\nb\n```\n", "b", "b\n"),
+        ] {
+            let (code, copy) = code_block_texts(source);
+            assert_eq!((code.as_str(), copy.as_str()), (shown, copied), "{source:?}");
+        }
+    }
 }
