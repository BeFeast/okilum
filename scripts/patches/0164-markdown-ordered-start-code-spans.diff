+/// Line endings inside an inline code span become spaces, and one space is
+/// stripped from each end when both ends are spaces and the span is not all
+/// spaces (CommonMark 0.31.2, code spans).
+///
+/// markdown-rs does the padding strip but only for literal spaces, so a span
+/// whose edge is a line ending (`` `\nfoo\n` ``) keeps its newlines and its
+/// padding. The raw span in `source` tells which edges markdown-rs already
+/// stripped, so a span is never stripped twice.
+fn normalize_inline_code(node: &mut Node, source: &str) {
+    if let Node::InlineCode(code) = node {
+        if let Some(value) = inline_code_value(source, code) {
+            code.value = value;
+        }
+        return;
+    }
+    if let Some(children) = node.children_mut() {
+        for child in children {
+            normalize_inline_code(child, source);
+        }
+    }
+}
+
+fn inline_code_value(source: &str, code: &mdast::InlineCode) -> Option<String> {
+    let position = code.position.as_ref()?;
+    let span = source.get(position.start.offset..position.end.offset)?;
+    let ticks = span.bytes().take_while(|b| *b == b'`').count();
+    let raw = span.get(ticks..span.len().checked_sub(ticks)?)?;
+    if !raw.contains(['\n', '\r']) {
+        return None;
+    }
+    let flatten = |text: &str| text.replace("\r\n", " ").replace(['\n', '\r'], " ");
+    let padded = |text: &str| {
+        text.starts_with(' ') && text.ends_with(' ') && text.bytes().any(|b| b != b' ')
+    };
+    let mut value = flatten(&code.value);
+    let stripped_by_parser = raw.len() > 2 && padded(raw);
+    if !stripped_by_parser && padded(&flatten(raw)) {
+        value.remove(0);
+        value.pop();
+    }
+    Some(value)
+}
+
 /// Parse Markdown into a tree of nodes.
