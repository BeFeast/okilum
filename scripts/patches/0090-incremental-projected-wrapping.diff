diff --git a/crates/base/src/input/editor/display_map/projected_cache.rs b/crates/base/src/input/editor/display_map/projected_cache.rs
--- /dev/null
+++ b/crates/base/src/input/editor/display_map/projected_cache.rs
@@ -0,0 +1,173 @@
+//! Derived, editor-local wrapping of exact projected lines. No source identity or
+//! hit map is reused here: callers bind cached relative row ranges to the new
+//! projection. Keep only the previous and current publication's bounded entries.
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use gpui::{Font, Pixels, TextRun};
+
+use super::text_wrapper::LineItem;
+
+const MAX_ENTRIES: usize = 8192;
+const MAX_BYTES: usize = 2 * 1024 * 1024;
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub(super) struct LineKey {
+    text: Arc<str>,
+    fonts: Vec<(usize, Font)>,
+    font_size: u32,
+    wrap_width: Option<u32>,
+    scale_factor: u32,
+    hang: usize,
+    hang_room: u32,
+}
+
+impl LineKey {
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn new(
+        text: &str,
+        runs: &[TextRun],
+        font_size: Pixels,
+        wrap_width: Option<Pixels>,
+        scale_factor: f32,
+        hang: usize,
+        hang_room: Pixels,
+    ) -> Self {
+        Self {
+            text: Arc::from(text),
+            // Foreground/strike paint does not change wrap geometry. Retain
+            // every run's exact length and resolved font, including fallback
+            // family, weight, features and italic. No content hash is trusted
+            // without the key's full equality check.
+            fonts: runs.iter().map(|run| (run.len, run.font.clone())).collect(),
+            font_size: f32::from(font_size).to_bits(),
+            wrap_width: wrap_width.map(|width| f32::from(width).to_bits()),
+            scale_factor: scale_factor.to_bits(),
+            hang,
+            hang_room: f32::from(hang_room).to_bits(),
+        }
+    }
+
+    fn bytes(&self, line: &LineItem) -> usize {
+        self.text.len()
+            + self
+                .fonts
+                .iter()
+                .map(|(_, font)| std::mem::size_of::<(usize, Font)>() + font.family.len())
+                .sum::<usize>()
+            + line.wrapped_lines.len() * std::mem::size_of::<std::ops::Range<usize>>()
+            + std::mem::size_of::<Self>()
+            + std::mem::size_of::<LineItem>()
+    }
+}
+
+#[derive(Default)]
+pub(super) struct ProjectedCache {
+    document: Option<u64>,
+    previous: HashMap<LineKey, LineItem>,
+    current: HashMap<LineKey, LineItem>,
+    bytes: usize,
+}
+
+impl ProjectedCache {
+    pub(super) fn begin(&mut self, document: u64) {
+        if self.document != Some(document) {
+            self.previous.clear();
+            self.current.clear();
+            self.document = Some(document);
+        } else {
+            self.previous = std::mem::take(&mut self.current);
+        }
+        self.bytes = 0;
+    }
+
+    pub(super) fn get(&self, key: &LineKey) -> Option<LineItem> {
+        self.current
+            .get(key)
+            .or_else(|| self.previous.get(key))
+            .cloned()
+    }
+
+    pub(super) fn retain(&mut self, key: LineKey, line: LineItem) {
+        if self.current.contains_key(&key) {
+            return;
+        }
+        let bytes = key.bytes(&line);
+        if self.current.len() < MAX_ENTRIES && bytes <= MAX_BYTES.saturating_sub(self.bytes) {
+            self.bytes += bytes;
+            self.current.insert(key, line);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui::{TextRun, px};
+
+    fn key(text: &str, width: f32, size: f32, hang: usize) -> LineKey {
+        LineKey::new(
+            text,
+            &[TextRun {
+                len: text.len(),
+                font: gpui::font("sans-serif"),
+                ..Default::default()
+            }],
+            px(size),
+            Some(px(width)),
+            1.,
+            hang,
+            px(50.),
+        )
+    }
+
+    fn line() -> LineItem {
+        // Construct through the sibling module's test helper.
+        LineItem::cached_test_line(8, smallvec::smallvec![0..4, 4..8])
+    }
+
+    #[test]
+    fn exact_line_metrics_and_document_are_required_for_reuse() {
+        let mut cache = ProjectedCache::default();
+        cache.begin(1);
+        cache.retain(key("abcdefgh", 40., 16., 0), line());
+        cache.begin(1);
+        assert!(cache.get(&key("abcdefgh", 40., 16., 0)).is_some());
+        for different in [
+            key("abcdxfgh", 40., 16., 0),
+            key("abcdefgh", 41., 16., 0),
+            key("abcdefgh", 40., 17., 0),
+            key("abcdefgh", 40., 16., 2),
+        ] {
+            assert!(cache.get(&different).is_none());
+        }
+        let mut font = key("abcdefgh", 40., 16., 0);
+        font.fonts[0].1.weight = gpui::FontWeight::BOLD;
+        assert!(cache.get(&font).is_none());
+        cache.begin(2);
+        assert!(cache.get(&key("abcdefgh", 40., 16., 0)).is_none());
+    }
+
+    #[test]
+    fn entries_are_bounded_and_unretained_history_is_discarded() {
+        let mut cache = ProjectedCache::default();
+        cache.begin(1);
+        for i in 0..MAX_ENTRIES + 10 {
+            cache.retain(key(&format!("line{i:08}"), 40., 16., 0), line());
+        }
+        assert!(cache.current.len() <= MAX_ENTRIES && cache.bytes <= MAX_BYTES);
+        let huge = key(&"x".repeat(MAX_BYTES + 1), 40., 16., 0);
+        cache.retain(huge.clone(), line());
+        assert!(cache.get(&huge).is_none());
+        let retained = key("abcdefgh", 40., 16., 0);
+        cache.begin(1);
+        cache.retain(retained.clone(), line());
+        cache.begin(1);
+        assert!(cache.get(&retained).is_some());
+        cache.begin(1);
+        assert!(
+            cache.get(&retained).is_none(),
+            "older publications are discarded"
+        );
+    }
+}
