+/// Starts building the shader library and render pipelines for the default
+/// device on a background thread. Call it when the platform starts, before the
+/// first window: compiling them can take most of a second on a cold launch
+/// (runtime shader source, empty Metal cache), and renderers created later
+/// reuse the result instead of building it on the main thread.
+pub fn prepare_pipelines() {
+    shared_pipelines(&MetalRenderer::create_device());
+}
+
+/// The library and pipelines depend only on the device, not on a window.
+struct Pipelines {
+    paths_rasterization: metal::RenderPipelineState,
+    path_sprites: metal::RenderPipelineState,
+    shadows: metal::RenderPipelineState,
+    quads: metal::RenderPipelineState,
+    underlines: metal::RenderPipelineState,
+    monochrome_sprites: metal::RenderPipelineState,
+    polychrome_sprites: metal::RenderPipelineState,
+    surfaces: metal::RenderPipelineState,
+}
+
+struct SharedPipelines {
+    registry_id: u64,
+    result: Mutex<Option<std::result::Result<Arc<Pipelines>, String>>>,
+    ready: Condvar,
+}
+
+impl SharedPipelines {
+    fn wait(&self) -> Arc<Pipelines> {
+        let mut result = self.result.lock();
+        while result.is_none() {
+            self.ready.wait(&mut result);
+        }
+        match result.as_ref().unwrap() {
+            Ok(pipelines) => pipelines.clone(),
+            Err(message) => panic!("{message}"),
+        }
+    }
+}
+
+/// One background build per process for the first device; another device
+/// (rare) gets its own build.
+fn shared_pipelines(device: &metal::Device) -> Arc<SharedPipelines> {
+    static FIRST: OnceLock<Arc<SharedPipelines>> = OnceLock::new();
+    let first = FIRST.get_or_init(|| start_pipelines(device.clone()));
+    if first.registry_id == device.registry_id() {
+        first.clone()
+    } else {
+        start_pipelines(device.clone())
+    }
+}
+
+fn start_pipelines(device: metal::Device) -> Arc<SharedPipelines> {
+    let shared = Arc::new(SharedPipelines {
+        registry_id: device.registry_id(),
+        result: Mutex::new(None),
+        ready: Condvar::new(),
+    });
+    let build = {
+        let shared = shared.clone();
+        move || {
+            // A failed build still fails the first draw, as it did in `new`.
+            // This thread has no autorelease pool of its own: drain the
+            // strings and descriptors the bindings autorelease. The pool sits
+            // outside `catch_unwind`, so it is popped on failure too.
+            let result = objc::rc::autoreleasepool(|| {
+                std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    Arc::new(build_pipelines(&device))
+                }))
+            })
+            .map_err(|panic| {
+                panic
+                    .downcast_ref::<&str>()
+                    .map(|message| message.to_string())
+                    .or_else(|| panic.downcast_ref::<String>().cloned())
+                    .unwrap_or_else(|| "error building metal pipelines".into())
+            });
+            *shared.result.lock() = Some(result);
+            shared.ready.notify_all();
+        }
+    };
+    let builder = std::thread::Builder::new().name("gpui-metal-pipelines".into());
+    if let Err(error) = builder.spawn(build.clone()) {
+        log::error!("building metal pipelines on the main thread: {error}");
+        build();
+    }
+    shared
+}
+
+fn build_pipelines(device: &metal::Device) -> Pipelines {
+    #[cfg(feature = "runtime_shaders")]
+    let library = device
+        .new_library_with_source(&SHADERS_SOURCE_FILE, &metal::CompileOptions::new())
+        .expect("error building metal library");
+    #[cfg(not(feature = "runtime_shaders"))]
+    let library = device
+        .new_library_with_data(SHADERS_METALLIB)
+        .expect("error building metal library");
+    let format = MTLPixelFormat::BGRA8Unorm;
+    let pipeline = |label, vertex, fragment| {
+        build_pipeline_state(device, &library, label, vertex, fragment, format)
+    };
+    Pipelines {
+        paths_rasterization: build_path_rasterization_pipeline_state(
+            device,
+            &library,
+            "paths_rasterization",
+            "path_rasterization_vertex",
+            "path_rasterization_fragment",
+            format,
+            PATH_SAMPLE_COUNT,
+        ),
+        path_sprites: build_path_sprite_pipeline_state(
+            device,
+            &library,
+            "path_sprites",
+            "path_sprite_vertex",
+            "path_sprite_fragment",
+            format,
+        ),
+        shadows: pipeline("shadows", "shadow_vertex", "shadow_fragment"),
+        quads: pipeline("quads", "quad_vertex", "quad_fragment"),
+        underlines: pipeline("underlines", "underline_vertex", "underline_fragment"),
+        monochrome_sprites: pipeline(
+            "monochrome_sprites",
+            "monochrome_sprite_vertex",
+            "monochrome_sprite_fragment",
+        ),
+        polychrome_sprites: pipeline(
+            "polychrome_sprites",
+            "polychrome_sprite_vertex",
+            "polychrome_sprite_fragment",
+        ),
+        surfaces: pipeline("surfaces", "surface_vertex", "surface_fragment"),
+    }
+}
+
