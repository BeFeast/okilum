+    struct PrefixRevealProvider;
+    struct PrefixRevealProjection {
+        source: super::super::projection::SourceSnapshot,
+        text: String,
+        hidden: Option<Range<usize>>,
+    }
+    impl ProjectionProvider for PrefixRevealProvider {
+        fn compose(
+            &self,
+            source: &super::super::projection::SourceSnapshot,
+            active: &ActiveSource,
+        ) -> Option<Arc<dyn super::super::projection::SourceProjection>> {
+            let marker = source.text.find("**")?;
+            let end = source.text[marker..]
+                .find('\n')
+                .map_or(source.text.len(), |i| marker + i);
+            let hidden = (!(marker..=end).contains(&active.head.0)).then_some(marker..marker + 2);
+            let mut text = source.text.to_string();
+            if let Some(range) = &hidden {
+                text.replace_range(range.clone(), "");
+            }
+            Some(Arc::new(PrefixRevealProjection {
+                source: source.clone(),
+                text,
+                hidden,
+            }))
+        }
+    }
+    impl super::super::projection::SourceProjection for PrefixRevealProjection {
+        fn source(&self) -> &super::super::projection::SourceSnapshot {
+            &self.source
+        }
+        fn text(&self) -> &str {
+            &self.text
+        }
+        fn styles(&self) -> &[super::super::projection::ProjectionStyle] {
+            &[]
+        }
+        fn to_projected(
+            &self,
+            source: SourceByte,
+            _: ConcealBias,
+        ) -> Option<super::super::projection::ProjectedByte> {
+            let index = match &self.hidden {
+                Some(range) if source.0 > range.start => {
+                    source.0 - (source.0 - range.start).min(range.len())
+                }
+                _ => source.0,
+            };
+            (source.0 <= self.source.text.len())
+                .then_some(super::super::projection::ProjectedByte(index))
+        }
+        fn to_source(
+            &self,
+            display: super::super::projection::ProjectedByte,
+            bias: ConcealBias,
+        ) -> Option<SourceByte> {
+            let index = match &self.hidden {
+                Some(range)
+                    if display.0 > range.start
+                        || (display.0 == range.start && bias == ConcealBias::Right) =>
+                {
+                    display.0 + range.len()
+                }
+                _ => display.0,
+            };
+            (display.0 <= self.text.len()).then_some(SourceByte(index))
+        }
+    }
