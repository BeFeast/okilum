+    #[gpui::test]
+    fn projection_first_vertical_key_derives_preferred_x_after_initial_paint(
+        cx: &mut TestAppContext,
+    ) {
+        cx.update(crate::init);
+        let view = InputView::build_editor(cx, |state| {
+            state
+                .folding(false)
+                .searchable(false)
+                .wrapping_indent(super::super::WrappingIndent::None)
+        });
+        let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+        v.update(|window, cx| {
+            view.input.update(cx, |state, cx| {
+                state.set_value(
+                    "abcdefghijklmnop\n**abcdefghijklmnop\nabcdefghijklmnop",
+                    window,
+                    cx,
+                );
+                state.set_projection_provider(Some(Arc::new(PrefixRevealProvider)), cx);
+                window.activate_window();
+                state.focus(window, cx);
+            })
+        });
+        v.run_until_parked();
+        v.update(|window, cx| {
+            view.input.update(cx, |state, cx| {
+                assert!(state.last_layout.as_ref().unwrap().projection.is_some());
+                assert!(state.preferred_column.is_none());
+                assert_eq!(state.cursor(), 0);
+                state.move_vertical(1, window, cx);
+                assert_eq!(state.cursor(), state.value().find("**").unwrap());
+                assert_eq!(state.preferred_column.unwrap().0, px(0.));
+            })
+        });
+    }
