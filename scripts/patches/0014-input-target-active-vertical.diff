+    #[gpui::test]
+    fn projection_vertical_reveal_is_synchronous_before_rapid_keys_and_edits(
+        cx: &mut TestAppContext,
+    ) {
+        cx.update(crate::init);
+        let text = "abcdefghijklmnop\n**abcdefghijklmnop\nabcdefghijklmnop";
+        for edit in ["type", "delete", "paste", "rewrap"] {
+            let start = if edit == "rewrap" {
+                text.rfind('\n').unwrap() + 2
+            } else {
+                text.find("**").unwrap() + 6
+            };
+            let view = InputView::build_editor(cx, |state| {
+                state
+                    .folding(false)
+                    .searchable(false)
+                    .wrapping_indent(super::super::WrappingIndent::None)
+            });
+            let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+            v.update(|window, cx| {
+                view.input.update(cx, |state, cx| {
+                    window.activate_window();
+                    state.focus(window, cx);
+                })
+            });
+            v.run_until_parked();
+            let (sender, receiver) = futures::channel::oneshot::channel();
+            v.update(|window, cx| {
+                view.input.update(cx, |state, cx| {
+                    state.set_value(text, window, cx);
+                    state.set_projection_provider(Some(Arc::new(PrefixRevealProvider)), cx);
+                    state.set_exact_clipboard_provider(
+                        Some(Arc::new(DelayedClipboardProvider {
+                            receiver: std::sync::Mutex::new(Some(receiver)),
+                            calls: std::sync::atomic::AtomicUsize::new(0),
+                        })),
+                        cx,
+                    );
+                    state.move_to(start, None, cx);
+                    state.refresh_projection();
+                    let font = gpui::font("monospace");
+                    let run = gpui::TextRun {
+                        len: 18,
+                        font: font.clone(),
+                        color: gpui::black(),
+                        background_color: None,
+                        underline: None,
+                        strikethrough: None,
+                    };
+                    let shaped = window.text_system().shape_line(
+                        "**abcdefghijklmnop".into(),
+                        px(16.),
+                        &[run],
+                        None,
+                    );
+                    let preferred = shaped.x_for_index(if edit == "rewrap" { 1 } else { 6 });
+                    let mut last = state.last_layout.as_ref().unwrap().clone();
+                    last.projection = state.projection.pin();
+                    last.source_stamp = state.source_stamp();
+                    last.presentation_epoch = state.presentation_epoch();
+                    last.font = font;
+                    last.font_size = px(16.);
+                    last.wrap_width = Some(if edit == "rewrap" {
+                        shaped.x_for_index(16) + px(1.)
+                    } else {
+                        px(500.)
+                    });
+                    last.wrapping_indent = super::super::WrappingIndent::None;
+                    last.text_align = TextAlign::Left;
+                    state.last_layout = Some(last);
+                    state.preferred_column = Some((preferred, 6));
+                    let stamp = state.source_stamp();
+                    // No paint is allowed between these native movement handlers.
+                    if edit == "rewrap" {
+                        state.move_vertical(-1, window, cx);
+                        assert!(
+                            state.cursor() >= text.find("**").unwrap() + 16,
+                            "entering from below uses the new final wrapped row"
+                        );
+                        state.move_vertical(1, window, cx);
+                        assert_eq!(state.cursor(), start);
+                        assert_eq!(state.source_stamp(), stamp);
+                        return;
+                    }
+                    state.move_vertical(-1, window, cx);
+                    assert_ne!(state.cursor(), start, "positive control: Up moved");
+                    state.move_vertical(1, window, cx);
+                    assert_eq!(
+                        state.cursor(),
+                        start,
+                        "target-active x must survive conceal/reveal"
+                    );
+                    state.move_vertical(1, window, cx);
+                    state.move_vertical(1, window, cx); // clamp at final row
+                    state.move_vertical(-1, window, cx);
+                    assert_eq!(
+                        state.cursor(),
+                        start,
+                        "ordered rapid keys retain the EOF clamp"
+                    );
+                    assert_eq!(state.source_stamp(), stamp);
+                    assert_eq!(state.preferred_column, Some((preferred, 6)));
+                    assert!(state.projection_pending_vertical.is_none());
+                    match edit {
+                        "type" => state.replace_text_in_range(None, "X", window, cx),
+                        "delete" => state.delete(&Delete, window, cx),
+                        "paste" => state.paste(&Paste, window, cx),
+                        _ => unreachable!(),
+                    }
+                    if edit != "paste" {
+                        let mut expected = text.to_string();
+                        expected.replace_range(
+                            start..if edit == "delete" { start + 1 } else { start },
+                            if edit == "delete" { "" } else { "X" },
+                        );
+                        assert_eq!(state.value().as_ref(), expected);
+                    }
+                })
+            });
+            if edit == "paste" {
+                sender.send(Ok(Some("X".into()))).unwrap();
+                v.run_until_parked();
+                v.update(|_, cx| {
+                    view.input.update(cx, |state, _| {
+                        let mut expected = text.to_string();
+                        expected.insert(start, 'X');
+                        assert_eq!(state.value().as_ref(), expected);
+                    })
+                });
+            }
+        }
+    }
