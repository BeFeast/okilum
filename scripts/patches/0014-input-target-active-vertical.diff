+    /// Resolve projected vertical movement against hypothetical target-active
+    /// geometry before publishing any selection. Native edits arriving next can
+    /// therefore never observe an intermediate concealed-layout caret.
+    fn projected_vertical_target(
+        &self,
+        move_lines: isize,
+        window: &Window,
+        cx: &mut Context<Self>,
+    ) -> Option<(usize, bool, gpui::Pixels)> {
+        use super::projection::{
+            LayoutStamp, PinnedProjection, SourceByte, SourceSnapshot, WrapAffinity,
+        };
+        let last = self.last_layout.as_ref()?;
+        let provider = self.projection.provider.as_ref()?;
+        if last.source_stamp != self.source_stamp()
+            || !M::projection_compatible(self)
+            || self.masked
+            || !self.soft_wrap
+            || self.searchable
+            || self.mode.is_folding()
+            || self.wrapping_indent != super::WrappingIndent::None
+        {
+            return None;
+        }
+        let source = SourceSnapshot {
+            stamp: self.source_stamp(),
+            text: std::sync::Arc::from(self.text.to_string()),
+        };
+        let compose = |active: &super::projection::ActiveSource| {
+            let projection = provider.compose(&source, active)?;
+            (projection.source().stamp == source.stamp && projection.source().text == source.text)
+                .then_some(projection)
+        };
+        let map = |projection: std::sync::Arc<dyn super::projection::SourceProjection>,
+                   cx: &mut Context<Self>| {
+            let mut map = super::display_map::DisplayMap::new(
+                last.font.clone(),
+                last.font_size,
+                last.wrap_width,
+            );
+            map.install_projection(
+                Some(PinnedProjection {
+                    stamp: LayoutStamp {
+                        source: source.stamp,
+                        presentation: last.presentation_epoch,
+                    },
+                    projection,
+                }),
+                &self.text,
+                window,
+                cx,
+            );
+            map
+        };
+        let current = compose(&self.projection.active)?;
+        let current_map = map(current.clone(), cx);
+        let preferred = if let Some((x, _)) = self.preferred_column {
+            x
+        } else {
+            let row = self.text.offset_to_point(self.cursor()).row;
+            let (start, line) =
+                Self::projected_line_layout(current.as_ref(), &current_map, last, row, window)?;
+            let offset = current
+                .to_projected(SourceByte(self.cursor()), ConcealBias::Right)?
+                .0;
+            line.position_for_index(
+                offset.checked_sub(start)?,
+                last,
+                self.cursor_line_end_affinity,
+            )?
+            .x
+        };
+        let origin = current_map.offset_to_wrap_display_point_with_affinity(
+            self.cursor(),
+            self.cursor_line_end_affinity,
+        );
+        let target_row = origin
+            .row
+            .saturating_add_signed(move_lines)
+            .min(current_map.wrap_row_count().saturating_sub(1));
+        let (provisional, provisional_affinity) = Self::projected_row_hit(
+            current.as_ref(),
+            &current_map,
+            last,
+            target_row,
+            preferred,
+            window,
+        )?;
+        let mut active = self.projection.active.clone();
+        active.anchor = SourceByte(provisional);
+        active.head = SourceByte(provisional);
+        active.affinity = if provisional_affinity {
+            WrapAffinity::End
+        } else {
+            WrapAffinity::Start
+        };
+        let revealed = compose(&active)?;
+        let revealed_map = map(revealed.clone(), cx);
+        let mut target = revealed_map
+            .offset_to_wrap_display_point_with_affinity(provisional, provisional_affinity);
+        let row = self.text.offset_to_point(provisional).row;
+        if move_lines.unsigned_abs() == 1 && row != self.text.offset_to_point(self.cursor()).row {
+            let first = revealed_map.offset_to_wrap_display_point(self.text.line_start_offset(row));
+            target.row = first.row
+                + if move_lines < 0 {
+                    revealed_map
+                        .line(row)?
+                        .wrapped_lines
+                        .len()
+                        .saturating_sub(1)
+                } else {
+                    0
+                };
+        }
+        let resolved = Self::projected_row_hit(
+            revealed.as_ref(),
+            &revealed_map,
+            last,
+            target.row,
+            preferred,
+            window,
+        )?;
+        active.anchor = SourceByte(resolved.0);
+        active.head = SourceByte(resolved.0);
+        active.affinity = if resolved.1 {
+            WrapAffinity::End
+        } else {
+            WrapAffinity::Start
+        };
+        let final_projection = compose(&active)?;
+        // An arbitrary provider may change more than block reveal. Never accept
+        // a hit if its final active state would use different bytes or metrics.
+        if final_projection.text() != revealed.text()
+            || final_projection.styles() != revealed.styles()
+        {
+            return None;
+        }
+        let hit = revealed.to_projected(SourceByte(resolved.0), ConcealBias::Right)?;
+        if final_projection.to_projected(SourceByte(resolved.0), ConcealBias::Right) != Some(hit)
+            || final_projection.to_source(hit, ConcealBias::Right) != Some(SourceByte(resolved.0))
+        {
+            return None;
+        }
+        Some((resolved.0, resolved.1, preferred))
+    }
+
+    fn projected_row_hit(
+        projection: &dyn super::projection::SourceProjection,
+        map: &super::display_map::DisplayMap,
+        last: &super::layout::LastLayout,
+        wrap_row: usize,
+        preferred: gpui::Pixels,
+        window: &Window,
+    ) -> Option<(usize, bool)> {
+        let row = map.display_row_to_buffer_line(wrap_row);
+        let (start, line) = Self::projected_line_layout(projection, map, last, row, window)?;
+        let first_source =
+            projection.to_source(super::projection::ProjectedByte(start), ConcealBias::Right)?;
+        let first = map.offset_to_wrap_display_point(first_source.0);
+        let (index, affinity) = line.closest_index_for_position(
+            Point {
+                x: preferred,
+                y: wrap_row.saturating_sub(first.row) * last.line_height,
+            },
+            last,
+        )?;
+        let displayed = super::projection_layout::clip_hit_offset(
+            projection.text(),
+            start + index,
+            ConcealBias::Right,
+        )?;
+        let source = projection.to_source(
+            super::projection::ProjectedByte(displayed),
+            ConcealBias::Right,
+        )?;
+        Some((source.0, affinity))
+    }
+
+    fn projected_line_layout(
+        projection: &dyn super::projection::SourceProjection,
+        map: &super::display_map::DisplayMap,
+        last: &super::layout::LastLayout,
+        row: usize,
+        window: &Window,
+    ) -> Option<(usize, super::display_map::LineLayout)> {
+        let displayed = ropey::Rope::from(projection.text());
+        let start = displayed.line_start_offset(row);
+        let text = displayed.slice_line(row).to_string();
+        let item = map.line(row)?;
+        let mut shaped = smallvec::SmallVec::new();
+        for range in &item.wrapped_lines {
+            let runs = super::projection_layout::projected_runs(
+                projection,
+                start + range.start..start + range.end,
+                &last.font,
+                gpui::black(),
+            );
+            shaped.push(window.text_system().shape_line(
+                text[range.clone()].to_string().into(),
+                last.font_size,
+                &runs,
+                None,
+            ));
+        }
+        let line = super::display_map::LineLayout::new().lines(shaped);
+        Some((start, line))
+    }
