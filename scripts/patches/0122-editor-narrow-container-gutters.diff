+    struct DeepIndentProvider(usize);
+    impl ProjectionProvider for DeepIndentProvider {
+        fn compose(
+            &self,
+            source: &super::super::projection::SourceSnapshot,
+            _: &ActiveSource,
+        ) -> Option<Arc<dyn super::super::projection::SourceProjection>> {
+            Some(Arc::new(IndentProjection {
+                source: source.clone(),
+                indents: vec![super::super::projection::LineIndent { line: 0, prefix: self.0 }],
+                markers: vec![],
+            }))
+        }
+    }
+
+    /// #1641: inspect shaped row widths, not clipped pixels or just row starts.
+    #[gpui::test]
+    fn narrow_deep_projected_gutters_fit_every_shaped_row(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        for spaces in [0, 12, 40, 120] {
+            let prefix = spaces + 2;
+            let words = format!("words café 🧠 {} ", "unbroken".repeat(12)).repeat(5);
+            let text = format!("{}- {words}\nend", " ".repeat(spaces));
+            let view = InputView::build_editor(cx, |state| {
+                state.folding(false).searchable(false).line_number(false)
+                    .wrapping_indent(super::super::WrappingIndent::None)
+            });
+            let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+            v.simulate_resize(gpui::size(px(240.), px(2400.)));
+            v.update(|window, cx| view.input.update(cx, |state, cx| {
+                state.set_value(text, window, cx);
+                state.set_projection_provider(Some(Arc::new(DeepIndentProvider(prefix))), cx);
+            }));
+            v.run_until_parked();
+            v.update(|window, cx| view.input.update(cx, |state, cx| {
+                let layout = state.last_layout.as_ref().expect("painted editor");
+                assert!(layout.projection.is_some(), "positive control: projected layout installed");
+                let width = layout.wrap_width.expect("soft wrap");
+                let line = &layout.lines[0];
+                assert!(line.wrapped_lines.len() > 3, "positive control: content really wraps");
+                let first = line.position_for_index(prefix, layout, false).unwrap();
+                let mut offset = 0;
+                for (row, shaped) in line.wrapped_lines.iter().enumerate() {
+                    let start = line.position_for_index(offset, layout, false).unwrap();
+                    assert!(shaped.width + line.line_indent(row) <= width + px(1.),
+                        "spaces={spaces} row={row}: shaped={:?} offset={:?} width={width:?}",
+                        shaped.width, line.line_indent(row));
+                    if row > 0 {
+                        assert!((start.x - first.x).abs() <= px(1.),
+                            "spaces={spaces}: continuation {start:?} vs body {first:?}");
+                        let height = layout.rows.row_height(row);
+                        let (hit, _) = line.closest_index_for_position(
+                            point(start.x + px(0.1), start.y + height / 2.), layout).unwrap();
+                        assert_eq!(hit, offset, "wrapped-row text remains clickable");
+                    }
+                    offset += shaped.len();
+                }
+                let next = line.wrapped_lines[0].len();
+                state.move_to(prefix, None, cx);
+                state.move_vertical(1, window, cx);
+                assert_eq!(state.cursor(), next, "vertical movement retains the body column");
+            }));
+        }
+    }
+
