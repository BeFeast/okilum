+        let calls = shaped.load(Ordering::Relaxed);
+        assert!(calls > 0, "positive control: the first layout really shapes");
+        let after = shape(&painted);
+        assert_eq!(
+            shaped.load(Ordering::Relaxed),
+            calls,
+            "the gradient must hit the shaped-line cache"
+        );
+        assert!(std::ptr::eq::<gpui::WrappedLineLayout>(&**before[0], &**after[0]));
+
+        // Control: a colour run per letter splits the bold font run and
+        // shapes the line again.
+        let per_letter: Vec<_> = text[bold_range.clone()]
+            .char_indices()
+            .map(|(i, ch)| {
+                let start = bold_range.start + i;
+                let mut highlight = bold();
+                highlight.style.color = Some(gradient.color_at(i as f32 / 10.));
+                (start..start + ch.len_utf8(), highlight)
+            })
+            .collect();
+        let naive = shape(&text_runs(text, &style, &per_letter));
+        assert!(
+            shaped.load(Ordering::Relaxed) > calls,
+            "per-letter colour runs reshape the line"
+        );
+        assert!(!std::ptr::eq::<gpui::WrappedLineLayout>(&**before[0], &**naive[0]));
+    }
+}
