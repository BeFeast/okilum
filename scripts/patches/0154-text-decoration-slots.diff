+/// Bold ranges whose letters take the theme's bold gradient: bold weight, no
+/// colour of their own (links, code and syntax keep theirs), no font family
+/// override. Touching ranges form one span, so the gradient runs along the
+/// whole bold phrase. Right-to-left text keeps its solid colour: its glyph
+/// order does not follow byte order.
+pub(super) fn bold_gradient_spans(
+    text: &str,
+    highlights: &[(Range<usize>, InlineHighlight)],
+) -> Vec<Range<usize>> {
+    if unicode_bidi::BidiInfo::new(text, None).has_rtl() {
+        return Vec::new();
+    }
+    super::merge_touching(
+        highlights
+            .iter()
+            .filter(|(range, h)| {
+                h.style.font_weight == Some(gpui::FontWeight::BOLD)
+                    && h.style.color.is_none()
+                    && h.font_family.is_none()
+                    && text.is_char_boundary(range.start.min(text.len()))
+                    && text.is_char_boundary(range.end.min(text.len()))
+            })
+            .map(|(range, _)| range.clone()),
+    )
+}
+
+/// Keeps only the gradient spans whose edges already are font-run
+/// boundaries: the run before and the run after resolve to a different font
+/// (bold body text, or a heading whose own weight is not bold). A span inside
+/// text of the same font (bold in an H1, a family without a bold face) is
+/// dropped, so its colour never adds a font-run split.
+pub(super) fn spans_on_font_boundaries(
+    runs: &[TextRun],
+    spans: Vec<Range<usize>>,
+    font_id: impl Fn(&gpui::Font) -> gpui::FontId,
+) -> Vec<Range<usize>> {
+    if spans.is_empty() {
+        return spans;
+    }
+    let mut starts = Vec::with_capacity(runs.len());
+    let mut offset = 0;
+    for run in runs {
+        starts.push(offset);
+        offset += run.len;
+    }
+    let same = |a: usize, b: usize| font_id(&runs[a].font) == font_id(&runs[b].font);
+    spans
+        .into_iter()
+        .filter(|span| {
+            let (Ok(first), Some(last)) = (
+                starts.binary_search(&span.start),
+                starts.binary_search(&span.end).map_or_else(
+                    |_| (span.end == offset).then(|| runs.len()),
+                    Some,
+                ),
+            ) else {
+                return false;
+            };
+            let Some(last) = last.checked_sub(1).filter(|last| *last >= first) else {
+                return false;
+            };
+            !(first > 0 && same(first - 1, first)) && !(last + 1 < runs.len() && same(last, last + 1))
+        })
+        .collect()
+}
+
+/// `runs` with the gradient spans in [`super::gradient_run_color`], set on
+/// the runs themselves: a highlight colour would be blended onto the text
+/// colour, and a transparent one would leave it unchanged. Only the colour
+/// changes: a bold span already is its own font run, so the font runs, and
+/// with them shaping and the line-layout cache key, stay as they were. Lines
+/// drawn through or under the text keep the text colour.
+pub(super) fn gradient_runs(
+    mut runs: Vec<TextRun>,
+    spans: &[Range<usize>],
+) -> Vec<TextRun> {
+    if spans.is_empty() {
+        return runs;
+    }
+    let mut offset = 0;
+    for run in &mut runs {
+        let range = offset..offset + run.len;
+        offset = range.end;
+        if !spans
+            .iter()
+            .any(|span| span.start <= range.start && range.end <= span.end)
+        {
+            continue;
+        }
+        if let Some(strike) = run.strikethrough.as_mut() {
+            strike.color.get_or_insert(run.color);
+        }
+        if let Some(underline) = run.underline.as_mut() {
+            underline.color.get_or_insert(run.color);
+        }
+        run.color = super::gradient_run_color();
+    }
+    runs
+}
+
+/// One visual row of an inline layout, placed as gpui's paint places it.
+pub(super) struct PaintedRow {
+    pub(super) line: Arc<gpui::LineLayout>,
+    /// Byte offset of the row's hard line in the inline text.
+    pub(super) line_start: usize,
+    /// Painted top-left of the row.
+    pub(super) origin: Point<Pixels>,
+    /// Layout x of the row's first glyph and of its end.
+    pub(super) row_x: Pixels,
+    pub(super) end_x: Pixels,
+    pub(super) glyphs: Vec<(gpui::FontId, gpui::ShapedGlyph)>,
+}
+
+/// Every visual row of `layout`, top to bottom, with its glyphs.
+pub(super) fn painted_rows(layout: &AlignedLayout) -> Vec<PaintedRow> {
+    let bounds = layout.bounds();
+    let line_height = layout.line_height();
+    let offsets = layout.row_offsets();
+    let mut rows = Vec::new();
+    let mut top = bounds.origin.y;
+    let mut line_start = 0;
+    for line in layout.line_layouts() {
+        let unwrapped = line.unwrapped_layout.clone();
+        let x_at =
+            |b: &gpui::WrapBoundary| unwrapped.runs[b.run_ix].glyphs[b.glyph_ix].position.x;
+        let starts: Vec<Pixels> = std::iter::once(px(0.))
+            .chain(line.wrap_boundaries.iter().map(x_at))
+            .collect();
+        let mut row_glyphs = vec![Vec::new(); starts.len()];
+        let mut boundaries = line.wrap_boundaries.iter().peekable();
+        let mut row = 0;
+        for (run_ix, run) in unwrapped.runs.iter().enumerate() {
+            for (glyph_ix, glyph) in run.glyphs.iter().enumerate() {
+                if boundaries.peek() == Some(&&gpui::WrapBoundary { run_ix, glyph_ix }) {
+                    boundaries.next();
+                    row = (row + 1).min(starts.len() - 1);
+                }
+                row_glyphs[row].push((run.font_id, *glyph));
+            }
+        }
+        for (ix, glyphs) in row_glyphs.into_iter().enumerate() {
+            let offset = offsets.get(rows.len()).map_or(px(0.), |(_, offset)| *offset);
+            rows.push(PaintedRow {
+                line: unwrapped.clone(),
+                line_start,
+                origin: point(bounds.origin.x + offset, top + line_height * ix as f32),
+                row_x: starts[ix],
+                end_x: starts.get(ix + 1).copied().unwrap_or(unwrapped.width),
+                glyphs,
+            });
+        }
+        top += line.size(line_height).height;
+        line_start += unwrapped.len + 1;
+    }
+    rows
+}
+
+/// The painted `(left, right)` of `range` on `row`, if the row holds any of it.
+fn row_span(row: &PaintedRow, range: &Range<usize>) -> Option<(Pixels, Pixels)> {
+    let index = |glyph: &gpui::ShapedGlyph| row.line_start + glyph.index;
+    let first = row.glyphs.iter().position(|(_, g)| range.contains(&index(g)))?;
+    let left = row.glyphs[first].1.position.x;
+    let right = row.glyphs[first..]
+        .iter()
+        .find(|(_, g)| index(g) >= range.end)
+        .map_or(row.end_x, |(_, g)| g.position.x);
+    let x = |x: Pixels| row.origin.x + x - row.row_x;
+    (right > left).then(|| (x(left), x(right)))
+}
+
+/// The theme's link marker: a band under the lower part of each link's line.
+fn paint_link_markers(
+    marker: &super::LinkMarker,
+    links: &[(Range<usize>, LinkMark)],
+    layout: &AlignedLayout,
+    rows: &[PaintedRow],
+    window: &mut Window,
+) {
+    let line_height = layout.line_height();
+    let mask = window.content_mask().bounds;
+    for (range, _) in links {
+        // Right-to-left lines: the drawn spans of the link's characters.
+        if let Some(rects) = layout.rtl_selection_rects(range.clone()) {
+            for rect in rects {
+                marker.paint(rect.left(), rect.right(), rect.top(), line_height, window);
+            }
+            continue;
+        }
+        for row in rows {
+            if row.origin.y > mask.bottom() || row.origin.y + line_height < mask.top() {
+                continue;
+            }
+            if let Some((left, right)) = row_span(row, range) {
+                marker.paint(left, right, row.origin.y, line_height, window);
+            }
+        }
+    }
+}
