@@ -0,0 +1,374 @@
+//! Theme decoration slots for rich text and the editor's Live Preview.
+//!
+//! A theme fills these with parameters; the renderer draws each slot in one
+//! place. Every slot is optional, and an empty [`TextDecorations`] draws
+//! exactly what the renderer drew before slots existed. Decorations are
+//! paint-time only: they never change text, font runs or layout, so the
+//! shaped-line cache keeps hitting.
+
+use std::ops::Range;
+
+use gpui::{
+    Background, Bounds, Hsla, Pixels, Point, Rgba, Window, linear_color_stop,
+    linear_gradient, point, px,
+};
+
+/// A two-stop linear gradient. `angle` is in degrees as in CSS
+/// `linear-gradient`: 90 runs left to right, 180 top to bottom.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Gradient {
+    pub angle: f32,
+    pub from: Hsla,
+    pub to: Hsla,
+}
+
+impl Gradient {
+    pub fn new(angle: f32, from: Hsla, to: Hsla) -> Self {
+        Self { angle, from, to }
+    }
+
+    /// Left to right.
+    pub fn horizontal(from: Hsla, to: Hsla) -> Self {
+        Self::new(90., from, to)
+    }
+
+    /// The quad background for this gradient.
+    pub fn background(&self) -> Background {
+        linear_gradient(
+            self.angle,
+            linear_color_stop(self.from, 0.),
+            linear_color_stop(self.to, 1.),
+        )
+    }
+
+    /// The colour at `t` (0 = `from`, 1 = `to`), interpolated in sRGB with
+    /// alpha, as a two-stop CSS gradient is.
+    pub fn color_at(&self, t: f32) -> Hsla {
+        let t = if t.is_finite() { t.clamp(0., 1.) } else { 0. };
+        let (a, b) = (Rgba::from(self.from), Rgba::from(self.to));
+        let mix = |x: f32, y: f32| x + (y - x) * t;
+        Hsla::from(Rgba {
+            r: mix(a.r, b.r),
+            g: mix(a.g, b.g),
+            b: mix(a.b, b.b),
+            a: mix(a.a, b.a),
+        })
+    }
+}
+
+/// A thin gradient bar covering the first `length` (0..=1) of its width.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct GradientBar {
+    pub gradient: Gradient,
+    pub length: f32,
+    pub thickness: Pixels,
+}
+
+impl GradientBar {
+    /// The bar's width in a box `width` wide.
+    pub fn width_in(&self, width: Pixels) -> Pixels {
+        width * self.length.clamp(0., 1.)
+    }
+
+    /// Paints the bar with its top-left corner at `origin`.
+    pub fn paint(&self, origin: Point<Pixels>, width: Pixels, window: &mut Window) {
+        let width = self.width_in(width);
+        if width <= px(0.) || self.thickness <= px(0.) {
+            return;
+        }
+        window.paint_quad(gpui::fill(
+            Bounds::new(origin, gpui::size(width, self.thickness)),
+            self.gradient.background(),
+        ));
+    }
+}
+
+/// `hr`: `edge → middle → edge`, drawn as two two-stop halves.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct HorizontalRule {
+    pub edge: Hsla,
+    pub middle: Hsla,
+    pub thickness: Pixels,
+}
+
+impl HorizontalRule {
+    /// The left half's gradient; the right half runs the other way.
+    pub fn halves(&self) -> [Gradient; 2] {
+        [
+            Gradient::horizontal(self.edge, self.middle),
+            Gradient::horizontal(self.middle, self.edge),
+        ]
+    }
+
+    /// Paints the rule with its top-left corner at `origin`.
+    pub fn paint(&self, origin: Point<Pixels>, width: Pixels, window: &mut Window) {
+        if width <= px(0.) || self.thickness <= px(0.) {
+            return;
+        }
+        let half = width / 2.;
+        for (ix, gradient) in self.halves().into_iter().enumerate() {
+            window.paint_quad(gpui::fill(
+                Bounds::new(
+                    origin + point(half * ix as f32, px(0.)),
+                    gpui::size(half, self.thickness),
+                ),
+                gradient.background(),
+            ));
+        }
+    }
+}
+
+/// Blockquote: an angled background, a left border colour, and short
+/// gradient bars along the top and bottom edges.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct BlockquoteDecoration {
+    pub background: Option<Gradient>,
+    pub border: Option<Hsla>,
+    pub top_bar: Option<GradientBar>,
+    pub bottom_bar: Option<GradientBar>,
+}
+
+impl BlockquoteDecoration {
+    /// Paints the background and bars over `bounds` (the quote's box).
+    pub fn paint(&self, bounds: Bounds<Pixels>, window: &mut Window) {
+        if let Some(background) = self.background {
+            window.paint_quad(gpui::fill(bounds, background.background()));
+        }
+        if let Some(bar) = self.top_bar {
+            bar.paint(bounds.origin, bounds.size.width, window);
+        }
+        if let Some(bar) = self.bottom_bar {
+            bar.paint(
+                point(bounds.left(), bounds.bottom() - bar.thickness),
+                bounds.size.width,
+                window,
+            );
+        }
+    }
+}
+
+/// A highlight band under the lower part of a link's line, not the full line
+/// height. `height` is the band's share of the line height (0..=1); the band
+/// ends at `bottom`, also a share of the line height measured from its top.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct LinkMarker {
+    pub fill: Gradient,
+    pub height: f32,
+    pub bottom: f32,
+}
+
+impl LinkMarker {
+    /// The band's `(top, bottom)` inside a line that starts at `line_top`.
+    pub fn band(&self, line_top: Pixels, line_height: Pixels) -> (Pixels, Pixels) {
+        let bottom = self.bottom.clamp(0., 1.);
+        let height = self.height.clamp(0., bottom);
+        (
+            line_top + line_height * (bottom - height),
+            line_top + line_height * bottom,
+        )
+    }
+
+    /// Paints the band over `left..right` of the line at `line_top`.
+    pub fn paint(
+        &self,
+        left: Pixels,
+        right: Pixels,
+        line_top: Pixels,
+        line_height: Pixels,
+        window: &mut Window,
+    ) {
+        let (top, bottom) = self.band(line_top, line_height);
+        if right <= left || bottom <= top {
+            return;
+        }
+        window.paint_quad(gpui::fill(
+            Bounds::from_corners(point(left, top), point(right, bottom)),
+            self.fill.background(),
+        ));
+    }
+}
+
+/// The decoration slots a theme can fill. `Default` is no decoration.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct TextDecorations {
+    /// A rule under H2–H6.
+    pub heading_rule: Option<GradientBar>,
+    pub horizontal_rule: Option<HorizontalRule>,
+    pub blockquote: Option<BlockquoteDecoration>,
+    pub link_marker: Option<LinkMarker>,
+    /// Bold text coloured letter by letter along the span.
+    pub bold: Option<Gradient>,
+}
+
+impl TextDecorations {
+    pub fn is_empty(&self) -> bool {
+        *self == Self::default()
+    }
+}
+
+/// The run colour of glyphs that [`paint_gradient_glyphs`] paints itself. A
+/// bold span already is its own font run, so giving it one colour adds no
+/// font-run split and leaves the shaped-line cache key unchanged; the letter
+/// colours come at paint time.
+pub fn gradient_run_color() -> Hsla {
+    gpui::transparent_black()
+}
+
+/// Per-letter colours for byte ranges of a line: the `t` of a byte offset
+/// along its span, counted in characters, so every letter gets its own step.
+/// Character starts are indexed once per span, so a lookup is a binary search.
+pub struct LetterGradient<'a> {
+    spans: &'a [Range<usize>],
+    /// Per span, the byte offset (from the span start) of every character;
+    /// None when the text does not cover the span (steps fall back to bytes).
+    starts: Vec<Option<Vec<usize>>>,
+}
+
+impl<'a> LetterGradient<'a> {
+    pub fn new(text: &str, spans: &'a [Range<usize>]) -> Self {
+        let starts = spans
+            .iter()
+            .map(|span| {
+                text.get(span.clone())
+                    .map(|t| t.char_indices().map(|(i, _)| i).collect())
+            })
+            .collect();
+        Self { spans, starts }
+    }
+
+    /// `t` for the character starting at `index`, if it is in a span.
+    pub fn t_at(&self, index: usize) -> Option<f32> {
+        let at = self.spans.partition_point(|span| span.end <= index);
+        let span = self.spans.get(at).filter(|span| span.start <= index)?;
+        let offset = index - span.start;
+        // A glyph inside a span always gets a colour: should the text not
+        // cover the span, the step falls back to bytes.
+        let (before, count) = match &self.starts[at] {
+            Some(starts) => (
+                starts.partition_point(|start| *start <= offset).saturating_sub(1),
+                starts.len(),
+            ),
+            None => (offset, span.len()),
+        };
+        if count <= 1 {
+            return Some(0.);
+        }
+        Some(before as f32 / (count - 1) as f32)
+    }
+}
+
+/// Paints the glyphs of one visual row whose byte index lies in a gradient
+/// span, each in its letter's colour. `origin` is the row's painted top-left
+/// and `row_x` the layout x of its first glyph (0 for the first row of a
+/// line); `start` is the line's first byte in the text `letters` indexes. Emoji keep their own colours and are skipped:
+/// the ordinary paint drew them, since an emoji ignores its run colour.
+pub fn paint_gradient_glyphs(
+    layout: &gpui::LineLayout,
+    glyphs: impl Iterator<Item = (gpui::FontId, gpui::ShapedGlyph)>,
+    origin: Point<Pixels>,
+    row_x: Pixels,
+    line_height: Pixels,
+    start: usize,
+    gradient: &Gradient,
+    letters: &LetterGradient,
+    window: &mut Window,
+) {
+    let padding_top = (line_height - layout.ascent - layout.descent) / 2.;
+    let baseline = padding_top + layout.ascent;
+    let mask = window.content_mask().bounds;
+    if origin.y > mask.bottom() || origin.y + line_height < mask.top() {
+        return;
+    }
+    for (font_id, glyph) in glyphs {
+        if glyph.is_emoji {
+            continue;
+        }
+        let at = origin + point(glyph.position.x - row_x, baseline + glyph.position.y);
+        // Clip first: the colour lookup runs only for glyphs that can show.
+        if at.x > mask.right() + layout.font_size * 2. || at.x < mask.left() - layout.font_size * 2.
+        {
+            continue;
+        }
+        let Some(t) = letters.t_at(start + glyph.index) else {
+            continue;
+        };
+        let _ = window.paint_glyph(at, font_id, glyph.id, layout.font_size, gradient.color_at(t));
+    }
+}
+
+/// Merges sorted byte ranges that touch into maximal spans.
+pub fn merge_touching(ranges: impl IntoIterator<Item = Range<usize>>) -> Vec<Range<usize>> {
+    let mut spans: Vec<Range<usize>> = Vec::new();
+    for range in ranges {
+        if range.is_empty() {
+            continue;
+        }
+        match spans.last_mut() {
+            Some(last) if last.end == range.start => last.end = range.end,
+            _ => spans.push(range),
+        }
+    }
+    spans
+}
