+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn gradient_interpolates_from_end_to_end() {
+        let from: Hsla = gpui::rgb(0x87c2fd).into();
+        let to: Hsla = gpui::rgb(0xdcb9fc).into();
+        let g = Gradient::horizontal(from, to);
+        let close = |a: Hsla, b: Hsla| {
+            let (a, b) = (Rgba::from(a), Rgba::from(b));
+            (a.r - b.r).abs() < 1e-3 && (a.g - b.g).abs() < 1e-3 && (a.b - b.b).abs() < 1e-3
+        };
+        assert!(close(g.color_at(0.), from));
+        assert!(close(g.color_at(1.), to));
+        let mid = Rgba::from(g.color_at(0.5));
+        assert!((mid.r - (0x87 as f32 + 0xdc as f32) / 2. / 255.).abs() < 1e-2);
+        assert!(close(g.color_at(f32::NAN), from));
+    }
+
+    #[test]
+    fn letters_step_once_per_character_and_only_inside_spans() {
+        let text = "a **éclat** b";
+        let start = text.find('é').unwrap();
+        let span = start..start + text[start..].find("**").unwrap();
+        let spans = [span.clone()];
+        let letters = LetterGradient::new(text, &spans);
+        assert_eq!(letters.t_at(0), None);
+        assert_eq!(letters.t_at(span.start), Some(0.));
+        // `é` is two bytes: `c` is the second letter of five.
+        assert_eq!(letters.t_at(span.start + 2), Some(0.25));
+        assert_eq!(letters.t_at(span.end - 1), Some(1.));
+        assert_eq!(letters.t_at(span.end), None);
+    }
+
+    #[test]
+    fn touching_ranges_merge_into_one_span() {
+        assert_eq!(merge_touching([0..2, 2..5, 6..8, 8..8]), vec![0..5, 6..8]);
+    }
