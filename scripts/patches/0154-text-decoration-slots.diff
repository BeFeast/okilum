+    #[test]
+    fn empty_decorations_are_the_default() {
+        assert!(TextDecorations::default().is_empty());
+        let bold = TextDecorations {
+            bold: Some(Gradient::horizontal(gpui::red(), gpui::blue())),
+            ..Default::default()
