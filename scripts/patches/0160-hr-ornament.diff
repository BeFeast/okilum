+/// The glyphs an [`HrOrnament`] can draw. Each is a vector path, so a
+/// rotated ornament needs no text shaping and no rotated glyph paint.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OrnamentGlyph {
+    /// `§`, the section sign.
+    Section,
+}
+
+impl OrnamentGlyph {
+    /// The glyph for a theme's `glyph` string, if it is one we can draw.
+    pub fn from_text(text: &str) -> Option<Self> {
+        match text {
+            "§" => Some(Self::Section),
+            _ => None,
+        }
+    }
+
+    /// The glyph's strokes as cubic Béziers `[start, control a, control b,
+    /// end]` in a box one unit tall centred on (0, 0), y down. `§` is two
+    /// interlocking S curves, each the other turned half a circle.
+    fn strokes(self) -> [[(f32, f32); 4]; 4] {
+        match self {
+            Self::Section => {
+                let upper = [
+                    [(0.2, -0.33), (0.15, -0.5), (-0.22, -0.5), (-0.2, -0.3)],
+                    [(-0.2, -0.3), (-0.18, -0.14), (0.24, -0.12), (0.22, 0.08)],
+                ];
+                let turn = |c: [(f32, f32); 4]| c.map(|(x, y)| (-x, -y));
+                [upper[0], upper[1], turn(upper[0]), turn(upper[1])]
+            }
+        }
+    }
+}
+
+/// An ornament in the middle of an `hr`, like a theme's `hr::after`: a
+/// glyph `size` pixels tall, turned `rotate` degrees clockwise (CSS
+/// `rotate()`), with `gap` pixels of blank line on each side of its box.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct HrOrnament {
+    pub glyph: OrnamentGlyph,
+    pub color: Hsla,
+    pub rotate: f32,
+    pub size: Pixels,
+    pub gap: Pixels,
+}
+
+impl HrOrnament {
+    /// The width the rule leaves blank: the glyph's box and a gap each side.
+    pub fn blank_width(&self) -> Pixels {
+        (self.size + self.gap * 2.).max(px(0.))
+    }
+
+    /// The glyph's strokes in window coordinates, centred on `center`.
+    fn curves(&self, center: Point<Pixels>) -> [[Point<Pixels>; 4]; 4] {
+        let (sin, cos) = self.rotate.to_radians().sin_cos();
+        let scale = f32::from(self.size);
+        // y grows downwards, so this turns clockwise on screen, as CSS does.
+        let place = |(x, y): (f32, f32)| {
+            let (x, y) = (x * scale, y * scale);
+            center + point(px(x * cos - y * sin), px(x * sin + y * cos))
+        };
+        self.glyph.strokes().map(|curve| curve.map(place))
+    }
+
+    /// Paints the ornament centred on `center`.
+    pub fn paint(&self, center: Point<Pixels>, window: &mut Window) {
+        if self.size <= px(0.) {
+            return;
+        }
+        // Stroke weight of a regular-weight glyph at this size.
+        let mut builder = gpui::PathBuilder::stroke((self.size * 0.09).max(px(1.)));
+        for [start, a, b, end] in self.curves(center) {
+            builder.move_to(start);
+            builder.cubic_bezier_to(end, a, b);
+        }
+        if let Ok(path) = builder.build() {
+            window.paint_path(path, self.color);
         }
     }
 }
