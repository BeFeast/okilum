+    #[test]
+    fn ornament_glyph_is_centred_and_turns_clockwise() {
+        let center = point(px(50.), px(50.));
+        let upright = section(0.).curves(center);
+        let turned = section(90.).curves(center);
+        let all = |c: &[[Point<Pixels>; 4]; 4]| c.iter().flatten().copied().collect::<Vec<_>>();
+        // Point-symmetric about the centre: the § is two S curves.
+        let pts = all(&upright);
+        let (sx, sy) = pts.iter().fold((0., 0.), |(x, y), p| {
+            (x + f32::from(p.x), y + f32::from(p.y))
+        });
+        assert!((sx / pts.len() as f32 - 50.).abs() < 1e-3);
+        assert!((sy / pts.len() as f32 - 50.).abs() < 1e-3);
+        // 90° clockwise on screen: (x, y) offset becomes (-y, x).
+        for (u, t) in all(&upright).iter().zip(all(&turned)) {
+            let (dx, dy) = (f32::from(u.x) - 50., f32::from(u.y) - 50.);
+            assert!((f32::from(t.x) - 50. + dy).abs() < 1e-3);
+            assert!((f32::from(t.y) - 50. - dx).abs() < 1e-3);
+        }
+        // The upright glyph is taller than it is wide, and `size` tall at most.
+        let height = pts.iter().map(|p| f32::from(p.y)).fold(f32::MIN, f32::max)
+            - pts.iter().map(|p| f32::from(p.y)).fold(f32::MAX, f32::min);
+        let width = pts.iter().map(|p| f32::from(p.x)).fold(f32::MIN, f32::max)
+            - pts.iter().map(|p| f32::from(p.x)).fold(f32::MAX, f32::min);
+        assert!(height > width && height <= 16.);
+    }
