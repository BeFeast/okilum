+
+/// Which paste command is running.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum PasteMode {
+    /// Cmd+V / Ctrl+V and the Paste menu item.
+    #[default]
+    Smart,
+    /// Paste as Plain Text: the clipboard's plain text, nothing converted.
+    Plain,
+    /// Paste as Titled Link: a URL becomes `[title](url)`.
+    TitledLink,
+}
+
+/// The editor's state when a paste command runs.
+#[derive(Clone, Debug)]
+pub struct PasteContext {
+    pub mode: PasteMode,
+    /// The whole source text at the time of the command.
+    pub source: gpui::SharedString,
+    /// The selected source byte range (`start <= end`); a caret is empty.
+    pub selection: std::ops::Range<usize>,
 }
 
 #[derive(Default)]
