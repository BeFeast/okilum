+    #[test]
+    fn a_data_drop_reads_the_dragging_pasteboard_contents() {
+        unsafe {
+            let pool = NSAutoreleasePool::new(nil);
+            let pasteboard: id = msg_send![class!(NSPasteboard), pasteboardWithUniqueName];
+            let _: NSInteger = msg_send![pasteboard, clearContents];
+            let text_set: BOOL = msg_send![
+                pasteboard,
+                setString: ns_string("dropped text")
+                forType: ns_string("public.utf8-plain-text")
+            ];
+            assert_eq!(text_set, YES);
+            let html = b"<b>dropped</b>";
+            let html_data: id = msg_send![
+                class!(NSData),
+                dataWithBytes: html.as_ptr()
+                length: html.len() as NSUInteger
+            ];
+            let html_set: BOOL =
+                msg_send![pasteboard, setData: html_data forType: ns_string("public.html")];
+            assert_eq!(html_set, YES);
+            let data = external_data_from_pasteboard(pasteboard).expect("a text drag is data");
+            assert!(
+                data.types()
+                    .iter()
+                    .any(|kind| kind.as_ref() == "public.html")
+            );
+            assert_eq!(
+                data.contents("public.utf8-plain-text"),
+                Some(&b"dropped text"[..])
+            );
+            assert_eq!(data.contents("public.html"), Some(&html[..]));
+            let () = msg_send![pasteboard, releaseGlobally];
+
+            // A drag of private data only is not a data drop.
+            let private: id = msg_send![class!(NSPasteboard), pasteboardWithUniqueName];
+            let _: NSInteger = msg_send![private, clearContents];
+            let private_set: BOOL = msg_send![
+                private,
+                setString: ns_string("private")
+                forType: ns_string("org.example.private")
+            ];
+            assert_eq!(private_set, YES);
+            assert!(external_data_from_pasteboard(private).is_none());
+            let () = msg_send![private, releaseGlobally];
+            pool.drain();
+        }
+    }
