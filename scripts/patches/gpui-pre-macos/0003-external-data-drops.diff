+            ];
+            assert_eq!(text_set, YES);
+            set_data(pasteboard, "public.html", b"<b>dropped</b>");
+            set_data(pasteboard, "public.rtf", &[b'r'; 64]);
+            set_data(pasteboard, "public.png", b"\x89PNG\r\n\x1a\n");
+            set_data(pasteboard, "public.tiff", b"II*\0");
+            set_data(pasteboard, "org.example.private", b"private");
+            let limits = DropLimits {
+                text: 32,
+                image: 32,
+                metadata: 32,
+                total: 1024,
+            };
+            let data = external_data_with_limits(pasteboard, &limits).expect("a text drag is data");
+            assert!(
