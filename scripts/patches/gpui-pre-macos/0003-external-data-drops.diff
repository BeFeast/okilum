+
+/// Text representations a window accepts from a drag, read at the drop.
+const DROPPED_TEXT_TYPES: [&str; 6] = [
+    "public.utf8-plain-text",
+    "public.utf16-plain-text",
+    "public.html",
+    "public.rtf",
+    "com.apple.flat-rtfd",
+    "public.url",
+];
+
+/// Image types a window accepts from a drag, most faithful and compact
+/// first. Only the first one offered is read: a browser image often comes
+/// as PNG and as a far larger TIFF of the same pixels.
+const DROPPED_IMAGE_TYPES: [&str; 6] = [
+    "public.png",
+    "public.jpeg",
+    "com.compuserve.gif",
+    "org.webmproject.webp",
+    "public.heic",
+    "public.tiff",
+];
+
+/// Small descriptions read next to accepted data when offered: a link's
+/// title, the page it came from, an editor's language hint.
+const DROPPED_METADATA_TYPES: [&str; 3] = [
+    "public.url-name",
+    "org.chromium.source-url",
+    "vscode-editor-data",
+];
+
+/// Byte limits for what a drop reads. A representation above its limit, or
+/// one that would take all reads past `total`, is skipped, not truncated.
+struct DropLimits {
+    text: usize,
+    image: usize,
+    metadata: usize,
+    total: usize,
+}
+
+const DROP_LIMITS: DropLimits = DropLimits {
+    text: 32 << 20,
+    image: 64 << 20,
+    metadata: 64 << 10,
+    total: 128 << 20,
+};
+
+/// Whether a drag offering `types` is a data drag a window accepts.
+fn is_dragged_data(types: &[SharedString]) -> bool {
+    types.iter().any(|kind| {
+        DROPPED_TEXT_TYPES.contains(&kind.as_ref()) || DROPPED_IMAGE_TYPES.contains(&kind.as_ref())
+    })
+}
+
+/// The offered types a drop reads, each with its byte limit, in reading
+/// order: every accepted text type, small metadata, then the first image
+/// type. Anything else the source offered (private and dynamic types, file
+/// promises, other image representations) is never read.
+fn dropped_reads(types: &[SharedString], limits: &DropLimits) -> Vec<(SharedString, usize)> {
+    let offered = |wanted: &str| types.iter().find(|kind| kind.as_ref() == wanted).cloned();
+    DROPPED_TEXT_TYPES
+        .iter()
+        .filter_map(|kind| offered(kind).map(|kind| (kind, limits.text)))
+        .chain(
+            DROPPED_METADATA_TYPES
+                .iter()
+                .filter_map(|kind| offered(kind).map(|kind| (kind, limits.metadata))),
+        )
+        .chain(
+            DROPPED_IMAGE_TYPES
+                .iter()
+                .find_map(|kind| offered(kind))
+                .map(|kind| (kind, limits.image)),
+        )
+        .collect()
+}
+
+/// The types on `pasteboard`, in the order the drag source offered them.
+unsafe fn pasteboard_types(pasteboard: id) -> Vec<SharedString> {
+    let types: id = unsafe { msg_send![pasteboard, types] };
+    if types == nil {
+        return Vec::new();
+    }
+    let count: NSUInteger = unsafe { msg_send![types, count] };
+    (0..count)
+        .filter_map(|index| {
+            let kind: id = unsafe { msg_send![types, objectAtIndex: index] };
+            let utf8 = unsafe { NSString::UTF8String(kind) };
+            (!utf8.is_null()).then(|| {
+                SharedString::from(
+                    unsafe { CStr::from_ptr(utf8) }
+                        .to_string_lossy()
+                        .into_owned(),
+                )
+            })
+        })
+        .collect()
+}
+
+/// The data on `pasteboard` with its readable contents, if it is a data drag.
+unsafe fn external_data_from_pasteboard(pasteboard: id) -> Option<ExternalData> {
+    unsafe { external_data_with_limits(pasteboard, &DROP_LIMITS) }
+}
+
+unsafe fn external_data_with_limits(pasteboard: id, limits: &DropLimits) -> Option<ExternalData> {
+    let types = unsafe { pasteboard_types(pasteboard) };
+    if !is_dragged_data(&types) {
+        return None;
+    }
+    let mut total = 0;
+    let mut contents = Vec::new();
+    for (kind, limit) in dropped_reads(&types, limits) {
+        // A skipped representation is released with this pool right away.
+        let pool = unsafe { NSAutoreleasePool::new(nil) };
+        let data: id = unsafe { msg_send![pasteboard, dataForType: ns_string(&kind)] };
+        if data != nil {
+            let length: NSUInteger = unsafe { msg_send![data, length] };
+            let length = length as usize;
+            if length <= limit && total + length <= limits.total {
+                let bytes: *const u8 = unsafe { msg_send![data, bytes] };
+                let bytes: Arc<[u8]> = if length == 0 || bytes.is_null() {
+                    Arc::from(&[][..])
+                } else {
+                    Arc::from(unsafe { std::slice::from_raw_parts(bytes, length) })
+                };
+                total += length;
+                contents.push((kind, bytes));
+            } else {
+                log::warn!("data drop: skipped {kind} ({length} bytes) over the read limit");
+            }
+        }
+        unsafe { pool.drain() };
+    }
+    Some(ExternalData::with_contents(types, contents))
 }
 
