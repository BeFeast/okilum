 extern "C" fn perform_drag_operation(this: &Object, _: Sel, dragging_info: id) -> BOOL {
     let window_state = unsafe { get_window_state(this) };
     let position = drag_event_position(&window_state, dragging_info);
-    send_file_drop_event(window_state, FileDropEvent::Submit { position }).to_objc()
+    let event = if external_paths_from_event(dragging_info).is_some() {
+        FileDropEvent::Submit { position }
+    } else {
+        // A data drop hands over the contents read now, while AppKit still
+        // owns the dragging pasteboard for this drop.
+        let pasteboard: id = unsafe { msg_send![dragging_info, draggingPasteboard] };
+        match unsafe { external_data_from_pasteboard(pasteboard) } {
+            Some(data) => FileDropEvent::DataSubmit { position, data },
+            None => FileDropEvent::Submit { position },
+        }
+    };
+    send_file_drop_event(window_state, event).to_objc()
