+    unsafe fn set_data(pasteboard: id, kind: &str, bytes: &[u8]) {
+        unsafe {
+            let data: id = msg_send![
+                class!(NSData),
+                dataWithBytes: bytes.as_ptr()
+                length: bytes.len() as NSUInteger
+            ];
+            let set: BOOL = msg_send![pasteboard, setData: data forType: ns_string(kind)];
+            assert_eq!(set, YES, "{kind}");
+        }
