+
+/// Types other than file paths a window accepts from a drag: text, rich
+/// text, URLs and image data. Delivered as [`ExternalData`].
+const DRAGGED_DATA_TYPES: [&str; 12] = [
+    "public.utf8-plain-text",
+    "public.utf16-plain-text",
+    "public.html",
+    "public.rtf",
+    "com.apple.flat-rtfd",
+    "public.url",
+    "public.png",
+    "public.jpeg",
+    "public.tiff",
+    "com.compuserve.gif",
+    "org.webmproject.webp",
+    "public.heic",
+];
+
+/// Whether a drag offering `types` is a data drag a window accepts.
+fn is_dragged_data(types: &[SharedString]) -> bool {
+    types
+        .iter()
+        .any(|kind| DRAGGED_DATA_TYPES.contains(&kind.as_ref()))
+}
+
+/// Whether a dropped type's contents are read into [`ExternalData`]. Dynamic
+/// types are private to the source; promised files are only received on
+/// request, never by reading the pasteboard.
+fn reads_dropped_contents(kind: &str) -> bool {
+    !kind.starts_with("dyn.") && !kind.to_ascii_lowercase().contains("promise")
+}
+
+/// The types on `pasteboard`, in the order the drag source offered them.
+unsafe fn pasteboard_types(pasteboard: id) -> Vec<SharedString> {
+    let types: id = unsafe { msg_send![pasteboard, types] };
+    if types == nil {
+        return Vec::new();
+    }
+    let count: NSUInteger = unsafe { msg_send![types, count] };
+    (0..count)
+        .filter_map(|index| {
+            let kind: id = unsafe { msg_send![types, objectAtIndex: index] };
+            let utf8 = unsafe { NSString::UTF8String(kind) };
+            (!utf8.is_null()).then(|| {
+                SharedString::from(
+                    unsafe { CStr::from_ptr(utf8) }
+                        .to_string_lossy()
+                        .into_owned(),
+                )
+            })
+        })
+        .collect()
+}
+
+/// The data on `pasteboard` with its readable contents, if it is a data drag.
+unsafe fn external_data_from_pasteboard(pasteboard: id) -> Option<ExternalData> {
+    let types = unsafe { pasteboard_types(pasteboard) };
+    if !is_dragged_data(&types) {
+        return None;
+    }
+    let contents = types
+        .iter()
+        .filter(|kind| reads_dropped_contents(kind))
+        .filter_map(|kind| {
+            let data: id = unsafe { msg_send![pasteboard, dataForType: ns_string(kind)] };
+            if data == nil {
+                return None;
+            }
+            let length: NSUInteger = unsafe { msg_send![data, length] };
+            let bytes: *const u8 = unsafe { msg_send![data, bytes] };
+            let bytes: Arc<[u8]> = if length == 0 || bytes.is_null() {
+                Arc::from(&[][..])
+            } else {
+                Arc::from(unsafe { std::slice::from_raw_parts(bytes, length as usize) })
+            };
+            Some((kind.clone(), bytes))
+        })
+        .collect::<Vec<_>>();
+    Some(ExternalData::with_contents(types, contents))
 }
 
