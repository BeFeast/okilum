+    #[test]
+    fn tab_group_is_queried_once_tabbing_may_be_active_and_stays_queried() {
+        // Process-wide state: this is the only test that touches the flag.
+        assert!(!tab_group_query_needed(false));
+        assert!(tab_group_query_needed(true));
+        assert!(!tab_group_query_needed(
