+/// Whether any window of this process may have joined a native tab group.
+///
+/// `-[NSWindow tabGroup]` builds the window's tab group and stack controller on
+/// first use; on a cold first window that took ~0.6 s (mostly blocked
+/// off-CPU) inside `Window::new`. A window can only be in a tab group after
+/// tabbing was enabled for some window (a tabbing identifier) or an explicit
+/// tabbing action ran (merge, move to new window, toggle tab bar). Until then
+/// no window can show a tab bar, so there is nothing to ask AppKit. The flag
+/// never resets: a window keeps its group after its identifier is cleared.
+static TABBING_MAY_BE_ACTIVE: AtomicBool = AtomicBool::new(false);
+
+fn note_tabbing_may_be_active() {
+    TABBING_MAY_BE_ACTIVE.store(true, Ordering::Release);
+}
+
+fn tab_group_query_needed(tabbing_may_be_active: bool) -> bool {
+    tabbing_may_be_active
+}
+
 struct MacWindowState {
     handle: AnyWindowHandle,
     foreground_executor: ForegroundExecutor,
