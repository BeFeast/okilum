+//! XDND selection transfers on a dedicated connection, including INCR.
+use crate::linux::external_drop::{self, TIMEOUT};
+use std::time::Instant;
+use x11rb::{
+    COPY_FROM_PARENT, CURRENT_TIME,
+    connection::Connection,
+    protocol::{
+        Event,
+        xproto::{AtomEnum, ConnectionExt, CreateWindowAux, EventMask, Property, WindowClass},
+    },
+};
+
+pub(super) fn receive(
+    source: u32,
+    types: &[String],
+    timestamp: u32,
+) -> Vec<(gpui::SharedString, Vec<u8>)> {
+    let Ok((conn, screen)) = x11rb::connect(None) else {
+        return Vec::new();
+    };
+    let Ok(window) = conn.generate_id() else {
+        return Vec::new();
+    };
+    let root = conn.setup().roots[screen].root;
+    let result = (|| -> anyhow::Result<_> {
+        conn.create_window(
+            COPY_FROM_PARENT as u8,
+            window,
+            root,
+            0,
+            0,
+            1,
+            1,
+            0,
+            WindowClass::INPUT_ONLY,
+            0,
+            &CreateWindowAux::new().event_mask(EventMask::PROPERTY_CHANGE),
+        )?
+        .check()?;
+        let selection = conn.intern_atom(false, b"XdndSelection")?.reply()?.atom;
+        let property = conn.intern_atom(false, b"GPUI_DROP")?.reply()?.atom;
+        let incr = conn.intern_atom(false, b"INCR")?.reply()?.atom;
+        Ok(external_drop::read_all(types, |mime, cap| {
+            (|| -> anyhow::Result<Vec<u8>> {
+                anyhow::ensure!(
+                    conn.get_selection_owner(selection)?.reply()?.owner == source,
+                    "drag source changed"
+                );
+                let target = conn.intern_atom(false, mime.as_bytes())?.reply()?.atom;
+                conn.convert_selection(
+                    window,
+                    selection,
+                    target,
+                    property,
+                    if timestamp == 0 {
+                        CURRENT_TIME
+                    } else {
+                        timestamp
+                    },
+                )?
+                .check()?;
+                conn.flush()?;
+                let deadline = Instant::now() + TIMEOUT;
+                loop {
+                    if let Event::SelectionNotify(event) = next_event(&conn, deadline)? {
+                        anyhow::ensure!(
+                            event.property == property && event.target == target,
+                            "selection refused"
+                        );
+                        break;
+                    }
+                }
+                let reply = conn
+                    .get_property(
+                        false,
+                        window,
+                        property,
+                        AtomEnum::ANY,
+                        0,
+                        (cap / 4 + 1) as u32,
+                    )?
+                    .reply()?;
+                if reply.type_ != incr {
+                    anyhow::ensure!(
+                        reply.bytes_after == 0 && reply.value.len() <= cap && reply.format == 8,
+                        "oversize or invalid selection"
+                    );
+                    conn.delete_property(window, property)?.check()?;
+                    return Ok(reply.value);
+                }
+                anyhow::ensure!(
+                    reply
+                        .value32()
+                        .and_then(|mut n| n.next())
+                        .is_some_and(|n| n as usize <= cap),
+                    "oversize INCR"
+                );
+                conn.delete_property(window, property)?.check()?;
+                conn.flush()?;
+                let mut bytes = Vec::new();
+                loop {
+                    match next_event(&conn, deadline)? {
+                        Event::PropertyNotify(event)
+                            if event.atom == property && event.state == Property::NEW_VALUE =>
+                        {
+                            let remaining = cap - bytes.len();
+                            let chunk = conn
+                                .get_property(
+                                    true,
+                                    window,
+                                    property,
+                                    AtomEnum::ANY,
+                                    0,
+                                    (remaining / 4 + 1) as u32,
+                                )?
+                                .reply()?;
+                            anyhow::ensure!(
+                                chunk.bytes_after == 0
+                                    && chunk.value.len() <= remaining
+                                    && chunk.format == 8,
+                                "oversize INCR chunk"
+                            );
+                            if chunk.value.is_empty() {
+                                return Ok(bytes);
+                            }
+                            bytes.extend_from_slice(&chunk.value);
+                            conn.flush()?;
+                        }
+                        _ => {}
+                    }
+                }
+            })()
+            .ok()
+        }))
+    })();
+    // Closing this connection also cancels unfinished INCR transfers and frees
+    // the requestor window. Never acknowledge a transfer before its final read.
+    result.unwrap_or_default()
+}
+
+fn next_event(conn: &impl Connection, deadline: Instant) -> anyhow::Result<Event> {
+    loop {
+        anyhow::ensure!(Instant::now() < deadline, "XDND transfer timed out");
+        if let Some(event) = conn.poll_for_event()? {
+            return Ok(event);
+        }
+        std::thread::sleep(std::time::Duration::from_millis(2));
+    }
+}
