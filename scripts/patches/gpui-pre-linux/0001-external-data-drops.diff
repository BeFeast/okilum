+//! Public drag representations only. Payload I/O runs on the background executor.
+use gpui::{ExternalData, ExternalPaths, FileDropEvent, Pixels, Point, SharedString};
+use std::{
+    io::Read,
+    os::fd::AsRawFd,
+    time::{Duration, Instant},
+};
+
+pub(super) const MAX_TOTAL: usize = 128 * 1024 * 1024;
+pub(super) const TIMEOUT: Duration = Duration::from_secs(4);
+const TEXT: usize = 32 * 1024 * 1024;
+const IMAGE: usize = 64 * 1024 * 1024;
+
+pub(super) fn limit(mime: &str) -> Option<usize> {
+    Some(match mime {
+        "text/plain"
+        | "text/plain;charset=utf-8"
+        | "UTF8_STRING"
+        | "text/plain;charset=utf-16"
+        | "text/plain;charset=utf-16le"
+        | "text/plain;charset=utf-16be"
+        | "text/html"
+        | "text/uri-list" => TEXT,
+        "image/png" | "image/jpeg" | "image/gif" | "image/webp" | "image/tiff" => IMAGE,
+        _ => return None,
+    })
+}
+
+pub(super) fn selected(types: &[String]) -> Vec<String> {
+    // Stable preference, not source order; one successful image is enough.
+    let order = [
+        "text/uri-list",
+        "text/html",
+        "text/plain;charset=utf-8",
+        "UTF8_STRING",
+        "text/plain",
+        "text/plain;charset=utf-16",
+        "text/plain;charset=utf-16le",
+        "text/plain;charset=utf-16be",
+        "image/png",
+        "image/jpeg",
+        "image/gif",
+        "image/webp",
+        "image/tiff",
+    ];
+    order
+        .into_iter()
+        .filter(|m| types.iter().any(|t| t == m))
+        .map(str::to_owned)
+        .collect()
+}
+
+pub(super) fn read_all(
+    types: &[String],
+    read: impl FnMut(&str, usize) -> Option<Vec<u8>>,
+) -> Vec<(SharedString, Vec<u8>)> {
+    read_with_budget(types, MAX_TOTAL, read)
+}
+
+fn read_with_budget(
+    types: &[String],
+    budget: usize,
+    mut read: impl FnMut(&str, usize) -> Option<Vec<u8>>,
+) -> Vec<(SharedString, Vec<u8>)> {
+    let mut used = 0;
+    let mut image = false;
+    let mut contents = Vec::new();
+    for mime in selected(types) {
+        if image && mime.starts_with("image/") {
+            continue;
+        }
+        let cap = limit(&mime).unwrap().min(budget - used);
+        if cap == 0 {
+            break;
+        }
+        match read(&mime, cap).filter(|b| b.len() <= cap) {
+            Some(bytes) => {
+                used += bytes.len();
+                image |= mime.starts_with("image/");
+                contents.push((mime.into(), bytes));
+            }
+            // A failed transfer may have consumed its entire allowance.
+            None => used += cap,
+        }
+    }
+    contents
+}
+
+pub(super) fn entered(position: Point<Pixels>, types: &[String]) -> FileDropEvent {
+    FileDropEvent::DataEntered {
+        position,
+        data: ExternalData::new(types.iter().cloned().map(SharedString::from)),
+    }
+}
+
+pub(super) fn submitted(
+    position: Point<Pixels>,
+    contents: Vec<(SharedString, Vec<u8>)>,
+) -> (Option<ExternalPaths>, FileDropEvent) {
+    // URI lists can represent files or web links. Preserve file drops; comments
+    // and remote URLs never become local paths.
+    let paths = contents
+        .iter()
+        .find(|(m, _)| m.as_ref() == "text/uri-list")
+        .and_then(|(_, b)| std::str::from_utf8(b).ok())
+        .into_iter()
+        .flat_map(str::lines)
+        .filter(|s| !s.starts_with('#'))
+        .filter_map(|s| http_client::Url::parse(s.trim()).ok())
+        .filter_map(|u| u.to_file_path().ok())
+        .collect();
+    let paths = ExternalPaths(paths);
+    if !paths.0.is_empty() {
+        (Some(paths), FileDropEvent::Submit { position })
+    } else {
+        (
+            None,
+            FileDropEvent::DataSubmit {
+                position,
+                data: ExternalData::with_contents(
+                    contents.iter().map(|(m, _)| m.clone()),
+                    contents
+                        .iter()
+                        .map(|(m, b)| (m.clone(), std::sync::Arc::from(b.as_slice()))),
+                ),
+            },
+        )
+    }
+}
+
+pub(super) fn read_pipe(mut fd: filedescriptor::FileDescriptor, cap: usize) -> Option<Vec<u8>> {
+    fd.set_non_blocking(true).ok()?;
+    let deadline = Instant::now() + TIMEOUT;
+    let mut bytes = Vec::new();
+    let mut chunk = [0; 8192];
+    loop {
+        let remaining = deadline.checked_duration_since(Instant::now())?;
+        let mut poll = [filedescriptor::pollfd {
+            fd: fd.as_raw_fd(),
+            events: filedescriptor::POLLIN,
+            revents: 0,
+        }];
+        if filedescriptor::poll(&mut poll, Some(remaining)).ok()? == 0 {
+            return None;
+        }
+        match fd.read(&mut chunk) {
+            Ok(0) => return Some(bytes),
+            Ok(n) => {
+                if n > cap.saturating_sub(bytes.len()) {
+                    return None;
+                }
+                bytes.extend_from_slice(&chunk[..n]);
+            }
+            Err(e)
+                if matches!(
+                    e.kind(),
+                    std::io::ErrorKind::WouldBlock | std::io::ErrorKind::Interrupted
+                ) => {}
+            Err(_) => return None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn external_drop_selection_and_bounds() {
+        let types = [
+            "application/private",
+            "image/tiff",
+            "image/png",
+            "image/jpeg",
+            "text/html",
+        ]
+        .map(str::to_owned);
+        let mut reads = Vec::new();
+        let got = read_all(&types, |m, cap| {
+            reads.push((m.to_owned(), cap));
+            if m == "image/png" {
+                None
+            } else {
+                Some(vec![1])
+            }
+        });
+        assert_eq!(
+            reads,
+            [
+                ("text/html".into(), TEXT),
+                ("image/png".into(), IMAGE),
+                ("image/jpeg".into(), IMAGE - 1)
+            ]
+        );
+        assert_eq!(got.len(), 2);
+        assert_eq!(limit("text/plain;charset=utf-16be"), Some(TEXT));
+        assert_eq!(limit("x-special/gnome-copied-files"), None);
+        assert!(read_all(&["text/plain".into()], |_, cap| Some(vec![0; cap + 1])).is_empty());
+    }
+    #[test]
+    fn external_drop_aggregate_budget_counts_failed_reads() {
+        let types = ["text/html", "text/plain", "image/png"].map(str::to_owned);
+        let mut caps = Vec::new();
+        let got = read_with_budget(&types, 8, |mime, cap| {
+            caps.push(cap);
+            if mime == "text/html" {
+                Some(vec![1; 3])
+            } else {
+                None
+            }
+        });
+        assert_eq!(caps, [8, 5]);
+        assert_eq!(got.len(), 1);
+    }
+    #[test]
+    fn external_drop_pipe_rejects_oversize_and_timeout() {
+        use std::io::Write;
+        let mut pipe = filedescriptor::Pipe::new().unwrap();
+        pipe.write.write_all(b"12345").unwrap();
+        drop(pipe.write);
+        assert_eq!(read_pipe(pipe.read, 4), None);
+        let mut pipe = filedescriptor::Pipe::new().unwrap();
+        pipe.write.write_all(b"1234").unwrap();
+        drop(pipe.write);
+        assert_eq!(read_pipe(pipe.read, 4), Some(b"1234".to_vec()));
+        let pipe = filedescriptor::Pipe::new().unwrap();
+        let started = Instant::now();
+        assert!(read_pipe(pipe.read, 4).is_none());
+        assert!(started.elapsed() >= TIMEOUT);
+        drop(pipe.write);
+    }
+    #[test]
+    fn external_drop_uri_lists_keep_file_and_web_routes() {
+        let pos = Point::default();
+        let (paths, event) = submitted(
+            pos,
+            vec![(
+                "text/uri-list".into(),
+                b"#comment\r\nhttps://example.org/\r\n".to_vec(),
+            )],
+        );
+        assert!(paths.is_none());
+        assert!(matches!(event, FileDropEvent::DataSubmit { .. }));
+        let (paths, event) = submitted(
+            pos,
+            vec![("text/uri-list".into(), b"file:///example.txt\r\n".to_vec())],
+        );
+        assert_eq!(
+            paths.unwrap().0[0],
+            std::path::PathBuf::from("/example.txt")
+        );
+        assert!(matches!(event, FileDropEvent::Submit { .. }));
+    }
+}
