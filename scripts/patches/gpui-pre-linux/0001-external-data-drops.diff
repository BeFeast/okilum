+#[cfg(test)]
+mod tests {
+    use super::*;
+    use x11rb::protocol::xproto::{
+        ChangeWindowAttributesAux, PropMode, SELECTION_NOTIFY_EVENT, SelectionNotifyEvent,
+    };
+    use x11rb::wrapper::ConnectionExt as _;
+
+    #[test]
+    fn external_drop_x11_real_selection_and_incr() {
+        // This is a real selection owner, not an unfired event probe. CI runs
+        // it under Xvfb; missing DISPLAY must fail instead of passing silently.
+        let (_display_guard, _) = x11rb::connect(None).unwrap();
+        for (incremental, oversized) in [(false, false), (true, false), (true, true)] {
+            let (send, recv) = std::sync::mpsc::channel();
+            let (done, wait_done) = std::sync::mpsc::channel();
+            let owner = std::thread::spawn(move || {
+                let (conn, screen) = x11rb::connect(None).unwrap();
+                let window = conn.generate_id().unwrap();
+                conn.create_window(
+                    COPY_FROM_PARENT as u8,
+                    window,
+                    conn.setup().roots[screen].root,
+                    0,
+                    0,
+                    1,
+                    1,
+                    0,
+                    WindowClass::INPUT_ONLY,
+                    0,
+                    &CreateWindowAux::new(),
+                )
+                .unwrap()
+                .check()
+                .unwrap();
+                let selection = conn
+                    .intern_atom(false, b"XdndSelection")
+                    .unwrap()
+                    .reply()
+                    .unwrap()
+                    .atom;
+                let incr = conn
+                    .intern_atom(false, b"INCR")
+                    .unwrap()
+                    .reply()
+                    .unwrap()
+                    .atom;
+                conn.set_selection_owner(window, selection, CURRENT_TIME)
+                    .unwrap()
+                    .check()
+                    .unwrap();
+                conn.flush().unwrap();
+                send.send(window).unwrap();
+                let deadline = Instant::now() + std::time::Duration::from_secs(10);
+                let request = loop {
+                    if let Event::SelectionRequest(r) = next_event(&conn, deadline).unwrap() {
+                        break r;
+                    }
+                };
+                let payload = "one\r\nПривет".as_bytes();
+                if incremental {
+                    conn.change_window_attributes(
+                        request.requestor,
+                        &ChangeWindowAttributesAux::new().event_mask(EventMask::PROPERTY_CHANGE),
+                    )
+                    .unwrap()
+                    .check()
+                    .unwrap();
+                    conn.change_property32(
+                        PropMode::REPLACE,
+                        request.requestor,
+                        request.property,
+                        incr,
+                        &[if oversized {
+                            external_drop::limit("text/plain").unwrap() as u32 + 1
+                        } else {
+                            payload.len() as u32
+                        }],
+                    )
+                    .unwrap()
+                    .check()
+                    .unwrap();
+                } else {
+                    conn.change_property8(
+                        PropMode::REPLACE,
+                        request.requestor,
+                        request.property,
+                        request.target,
+                        payload,
+                    )
+                    .unwrap()
+                    .check()
+                    .unwrap();
+                }
+                conn.send_event(
+                    false,
+                    request.requestor,
+                    EventMask::NO_EVENT,
+                    SelectionNotifyEvent {
+                        response_type: SELECTION_NOTIFY_EVENT,
+                        sequence: 0,
+                        time: request.time,
+                        requestor: request.requestor,
+                        selection: request.selection,
+                        target: request.target,
+                        property: request.property,
+                    },
+                )
+                .unwrap()
+                .check()
+                .unwrap();
+                conn.flush().unwrap();
+                if incremental && !oversized {
+                    for chunk in [payload, &[]] {
+                        loop {
+                            if let Event::PropertyNotify(e) = next_event(&conn, deadline).unwrap()
+                                && e.atom == request.property
+                                && e.state == Property::DELETE
+                            {
+                                break;
+                            }
+                        }
+                        conn.change_property8(
+                            PropMode::REPLACE,
+                            request.requestor,
+                            request.property,
+                            request.target,
+                            chunk,
+                        )
+                        .unwrap()
+                        .check()
+                        .unwrap();
+                        conn.flush().unwrap();
+                    }
+                }
+                wait_done
+                    .recv_timeout(std::time::Duration::from_secs(10))
+                    .unwrap();
+            });
+            let source = recv.recv().unwrap();
+            let got = receive(
+                source,
+                &["text/plain".into(), "application/private".into()],
+                CURRENT_TIME,
+            );
+            if oversized {
+                assert!(got.is_empty());
+            } else {
+                assert_eq!(
+                    got,
+                    vec![("text/plain".into(), "one\r\nПривет".as_bytes().to_vec())]
+                );
+            }
+            done.send(()).unwrap();
+            owner.join().unwrap();
+        }
+    }
+}
