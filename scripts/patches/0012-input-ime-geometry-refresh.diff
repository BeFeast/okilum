+impl<M: InputModeKind> InputBaseState<M> {
+    /// Refresh the platform only after coherent geometry is installed. The same
+    /// public candidate-bounds policy is used by the deferred platform query;
+    /// cache actual bounds so idle paints never schedule an IME feedback loop.
+    pub(super) fn refresh_native_candidate_geometry(
+        &mut self,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        if !self.projection.enabled || !self.focus_handle.is_focused(window) {
+            self.projection_ime_bounds = None;
+            return;
+        }
+        let Some(layout) = &self.last_layout else {
+            return;
+        };
+        if layout.source_stamp != self.source_stamp()
+            || layout.presentation_epoch != self.presentation_epoch()
+        {
+            return;
+        }
+        let Some(bounds) = self.last_bounds else {
+            return;
+        };
+        let marked = self.marked_text_range(window, cx);
+        let Some(selection) = self.selected_text_range(true, window, cx) else {
+            return;
+        };
+        let candidate =
+            gpui::PlatformInputHandler::compute_ime_candidate_bounds(marked, &selection, |range| {
+                self.bounds_for_range(range, bounds, window, cx)
+            });
+        if candidate != self.projection_ime_bounds {
+            self.projection_ime_bounds = candidate;
+            if candidate.is_some() {
+                // GPUI queries the current input handler on its next frame; no
+                // captured source or projected indices escape this paint.
+                window.invalidate_character_coordinates();
+            }
+        }
+    }
+}
