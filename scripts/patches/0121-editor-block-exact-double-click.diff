+    /// Retain a visible authored-source row during an explicit presentation
+    /// change. This uses painted geometry, without materializing source bytes.
+    pub fn preserve_source_anchor(&mut self, source: usize) {
+        let Some(last) = self.last_layout.as_ref().filter(|last| last.source_stamp == self.source_stamp()) else { return; };
+        if source > self.text.len() { return; }
+        // Prefer an unchanged visible row above the transitioning block. Its
+        // metrics cannot depend on the block's rendered content or grid lease.
+        let source = last.visible_line_byte_offsets.iter()
+            .filter_map(|&at| last.source(at, ConcealBias::Right))
+            .filter(|&at| at <= source)
+            .find(|&at| {
+                let row = self.display_map.offset_to_wrap_display_point_with_affinity(at, false).row;
+                last.rows.row_top(row) + self.scroll_handle.offset().y >= px(0.)
+            }).unwrap_or(source);
+        let row = self.display_map.offset_to_wrap_display_point_with_affinity(source, false).row;
+        // Anchor row tops. The glyph inside a rendered block is vertically
+        // centered in its measured row; retaining that glyph's inset introduces
+        // a jump when prepaint restores the raw row's top.
+        let y = last.rows.row_top(row);
+        let screen_y = y + self.scroll_handle.offset().y;
+        if screen_y >= px(0.) && screen_y < self.input_bounds.size.height {
+            self.zoom_anchor = Some((source, y, false));
+        }
+    }
