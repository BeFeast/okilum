diff --git a/crates/base/src/input/projection.rs b/crates/base/src/input/projection.rs
--- a/crates/base/src/input/projection.rs
+++ b/crates/base/src/input/projection.rs
@@ -15,6 +15,18 @@
 #[path = "source_text.rs"]
 mod source_text;
 pub use source_text::{SourceText, EditDelta, take_flattened_bytes};
+
+thread_local! {
+    static MATERIALIZED_VALUE_BYTES: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+pub(crate) fn record_materialized_value_bytes(bytes: usize) {
+    MATERIALIZED_VALUE_BYTES.with(|count| count.set(count.get() + bytes));
+}
+/// Native value() copies, separate from immutable source snapshot flattening.
+/// Explicit block commands check both; recovery snapshots have their own scope.
+pub fn take_materialized_value_bytes() -> usize {
+    MATERIALIZED_VALUE_BYTES.with(|count| count.replace(0))
+}

 /// Maximum canonical bytes admitted to native projected layout and anchoring.
 pub const MAX_SOURCE_BYTES: usize = 1024 * 1024;
