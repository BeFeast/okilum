+    #[gpui::test]
+    fn textarea_visual_edges_follow_wrap_resize_affinity_and_selection(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        let view = InputView::build_textarea(cx, |state| state);
+        let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+        v.update(|_, cx| view.input.update(cx, |state, _| {
+            assert!(state.value().is_empty());
+            assert!(state.is_caret_on_visual_edge(false));
+            assert!(state.is_caret_on_visual_edge(true), "empty input is on both edges even before paint");
+        }));
+        v.simulate_resize(gpui::size(px(220.), px(500.)));
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            state.set_value("one two three four five six seven eight nine ten ".repeat(3), window, cx);
+            state.set_selected_range(0..0, cx);
+            assert!(!state.is_caret_on_visual_edge(false), "an unpainted edit has no trustworthy geometry");
+        }));
+        v.run_until_parked();
+        let boundary = v.update(|_, cx| view.input.update(cx, |state, _| {
+            assert!(state.display_map.display_row_count() > 1, "positive control: source really soft-wraps");
+            assert!(state.is_caret_on_visual_edge(false));
+            assert!(!state.is_caret_on_visual_edge(true));
+            state.display_map.line(0).unwrap().wrapped_lines[0].end
+        }));
+        v.update(|_, cx| view.input.update(cx, |state, cx| state.set_selected_range(boundary..boundary, cx)));
+        v.run_until_parked();
+        v.update(|_, cx| view.input.update(cx, |state, cx| {
+            state.cursor_line_end_affinity = true;
+            assert!(state.is_caret_on_visual_edge(false), "wrap-end caret is still on the first row");
+            state.cursor_line_end_affinity = false;
+            assert!(!state.is_caret_on_visual_edge(false), "same byte at wrap-start is on the next row");
+            state.set_selected_range(0..boundary, cx);
+            assert!(!state.is_caret_on_visual_edge(false), "selection must keep native Arrow handling");
+            state.set_selected_range(boundary..boundary, cx);
+        }));
+        v.simulate_resize(gpui::size(px(4000.), px(500.)));
+        v.run_until_parked();
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            assert_eq!(state.display_map.display_row_count(), 1, "positive control: resize removed the wrap");
+            assert!(state.is_caret_on_visual_edge(false));
+            assert!(state.is_caret_on_visual_edge(true));
+            state.ime_marked_range = Some((0..1).into());
+            assert!(!state.is_caret_on_visual_edge(false));
+            state.ime_marked_range = None;
+            state.set_value("first\nsecond", window, cx);
+        }));
+        v.run_until_parked();
+        v.update(|_, cx| view.input.update(cx, |state, cx| {
+            let end = state.value().len();
+            state.set_selected_range(end..end, cx);
+        }));
+        v.run_until_parked();
+        v.update(|_, cx| view.input.update(cx, |state, _| {
+            assert!(!state.is_caret_on_visual_edge(false));
+            assert!(state.is_caret_on_visual_edge(true), "last hard line is the bottom edge");
+        }));
+    }
