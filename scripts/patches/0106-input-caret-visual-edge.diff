+    /// Whether the collapsed caret is on the first (`end == false`) or last
+    /// visual row. Uses the painted wrap map and soft-wrap affinity, not LF
+    /// counting. An empty input is on both edges (matching a DOM composer).
+    /// Otherwise an unpainted/stale layout or active selection/IME is unknown
+    /// and returns false, so callers preserve normal caret movement.
+    pub fn is_caret_on_visual_edge(&self, end: bool) -> bool {
+        if !self.selected_range.is_empty() || self.ime_marked_range.is_some()
+            || self.projection_pending_vertical.is_some()
+        {
+            return false;
+        }
+        if self.text.len() == 0 { return true; }
+        let Some(layout) = &self.last_layout else { return false; };
+        let Some(bounds) = self.last_bounds else { return false; };
+        if layout.source_stamp != self.source_stamp()
+            || layout.presentation_epoch != self.presentation_epoch()
+            // input_bounds includes the textarea's padding; last_bounds is
+            // the text box that produced this layout and its wrap width.
+            || layout.content_width != bounds.size.width
+        {
+            return false;
+        }
+        let point = self.display_map.offset_to_wrap_display_point_with_affinity(
+            self.cursor(), self.cursor_line_end_affinity,
+        );
+        let Some(row) = self.display_map.wrap_row_to_display_row(point.row) else {
+            return false;
+        };
+        let last = self.display_map.display_row_count().saturating_sub(1);
+        row == if end { last } else { 0 }
+    }
