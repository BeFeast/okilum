+
+// Keep a presentation anchor legal even when the new content fits the viewport.
+// The extent is derived from this offset, not accumulated across transitions.
+fn anchored_scroll_y(scroll: Pixels, delta: Pixels, content: Pixels, viewport: Pixels)
+    -> (Pixels, Pixels)
+{
+    let requested = (scroll + delta).min(px(0.));
+    let natural = content.max(viewport);
+    (requested, (viewport - requested - natural).max(px(0.)))
+}
 
