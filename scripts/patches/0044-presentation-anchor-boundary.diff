+    #[test]
+    fn presentation_anchor_tail_is_bounded_and_retires_on_adoption() {
+        let (raw, tail) = anchored_scroll_y(px(0.), px(-192.), px(600.), px(624.));
+        assert_eq!((raw, tail), (px(-192.), px(192.)));
+        assert_eq!(anchored_scroll_y(raw, px(192.), px(408.), px(624.)), (px(0.), px(0.)));
+        // Genuine content overflow needs no artificial extent.
+        assert_eq!(anchored_scroll_y(px(-100.), px(-100.), px(1000.), px(624.)),
+            (px(-200.), px(0.)));
+        // Repeated identical adoption cannot accumulate empty space.
+        assert_eq!(anchored_scroll_y(raw, px(0.), px(600.), px(624.)), (raw, tail));
+        assert_eq!(anchored_scroll_y(px(0.), px(192.), px(408.), px(624.)), (px(0.), px(0.)));
+    }
 
