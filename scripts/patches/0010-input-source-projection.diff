+//! Shared font runs for wrapping and painting projected source.
+use super::projection::SourceProjection;
+use gpui::{Font, FontStyle, FontWeight, Hsla, StrikethroughStyle, TextRun, px};
+use std::ops::Range;
+
+pub(super) fn projected_runs(
+    projection: &dyn SourceProjection,
+    range: Range<usize>,
+    font: &Font,
+    color: Hsla,
+) -> Vec<TextRun> {
+    let mut boundaries = vec![range.start, range.end];
+    for style in projection.styles() {
+        if style.range.start.0 < range.end && style.range.end.0 > range.start {
+            boundaries.push(style.range.start.0.max(range.start));
+            boundaries.push(style.range.end.0.min(range.end));
+        }
+    }
+    boundaries.sort_unstable();
+    boundaries.dedup();
+    boundaries
+        .windows(2)
+        .filter(|r| r[0] < r[1])
+        .map(|r| {
+            let mut actual_font = font.clone();
+            let mut strike = false;
+            for style in projection
+                .styles()
+                .iter()
+                .filter(|s| s.range.start.0 <= r[0] && s.range.end.0 >= r[1])
+            {
+                if let Some(family) = &style.font_family {
+                    actual_font.family = family.clone().into();
+                }
+                if style.bold {
+                    actual_font.weight = FontWeight::BOLD;
+                }
+                if style.italic {
+                    actual_font.style = FontStyle::Italic;
+                }
+                strike |= style.strikethrough;
+            }
+            TextRun {
+                len: r[1] - r[0],
+                font: actual_font,
+                color,
+                background_color: None,
+                underline: None,
+                strikethrough: strike.then_some(StrikethroughStyle {
+                    thickness: px(1.),
+                    color: Some(color),
+                }),
+            }
+        })
+        .collect()
+}
+
+/// Clip a *displayed user hit*, never a native canonical replacement range.
+/// The zero-width CR at a CRLF line ending belongs to the preceding visual row.
+pub(super) fn clip_hit_offset(
+    text: &str,
+    offset: usize,
+    bias: super::projection::ConcealBias,
+) -> Option<usize> {
+    use super::projection::ConcealBias;
+    use unicode_segmentation::UnicodeSegmentation;
+    if offset > text.len() {
+        return None;
+    }
+    if offset > 0
+        && text.as_bytes().get(offset - 1) == Some(&b'\r')
+        && text.as_bytes().get(offset) == Some(&b'\n')
+    {
+        return Some(offset - 1);
+    }
+    let mut previous = 0;
+    for boundary in text
+        .grapheme_indices(true)
+        .map(|(i, _)| i)
+        .chain(std::iter::once(text.len()))
+    {
+        if boundary == offset {
+            return Some(offset);
+        }
+        if boundary > offset {
+            return Some(if bias == ConcealBias::Left {
+                previous
+            } else {
+                boundary
+            });
+        }
+        previous = boundary;
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::input::projection::ConcealBias;
+    #[test]
+    fn hit_clipping_retains_crlf_row_and_whole_emoji() {
+        let text = "a\r\n👩\u{200d}💻";
+        assert_eq!(clip_hit_offset(text, 2, ConcealBias::Right), Some(1));
+        assert_eq!(clip_hit_offset(text, 3, ConcealBias::Left), Some(3));
+        assert_eq!(clip_hit_offset(text, 7, ConcealBias::Left), Some(3));
+        assert_eq!(
+            clip_hit_offset(text, 7, ConcealBias::Right),
+            Some(text.len())
+        );
+        assert_eq!(
+            clip_hit_offset(text, text.len() + 1, ConcealBias::Right),
+            None
+        );
+    }
+}
