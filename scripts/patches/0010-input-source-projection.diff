+//! Generic, immutable presentation of an editor's canonical source.
+//!
+//! Providers recompose previously classified data; they must not parse in an input
+//! handler. The editor owns text, selection, composition and history. A provider
+//! owns no mutable editor state. Returning `None` requests exact Source display.
+use std::{
+    ops::Range,
+    sync::{
+        Arc,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SourceByte(pub usize);
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ProjectedByte(pub usize);
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SourceUtf16(pub usize);
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ConcealBias {
+    Left,
+    Right,
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum WrapAffinity {
+    #[default]
+    Start,
+    End,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SourceStamp {
+    pub document: u64,
+    pub generation: u64,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct LayoutStamp {
+    pub source: SourceStamp,
+    pub presentation: u64,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ActiveSource {
+    /// Direction is retained: anchor may be greater than head.
+    pub anchor: SourceByte,
+    pub head: SourceByte,
+    pub composition: Option<Range<SourceByte>>,
+    /// An explicit native replacement can differ from the selection.
+    pub replacement: Option<Range<SourceByte>>,
+    pub affinity: WrapAffinity,
+}
+impl Default for ActiveSource {
+    fn default() -> Self {
+        Self {
+            anchor: SourceByte(0),
+            head: SourceByte(0),
+            composition: None,
+            replacement: None,
+            affinity: WrapAffinity::Start,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct SourceSnapshot {
+    pub stamp: SourceStamp,
+    pub text: Arc<str>,
+}
+
+/// Metric-changing styles supported by the first candidate. All runs share the
+/// editor's font size and line height. Color-only decoration is intentionally
+/// outside this metric contract.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ProjectionStyle {
+    pub range: Range<ProjectedByte>,
+    pub font_family: Option<String>,
+    pub bold: bool,
+    pub italic: bool,
+    pub strikethrough: bool,
+}
+
+pub trait SourceProjection: Send + Sync {
+    fn source(&self) -> &SourceSnapshot;
+    fn text(&self) -> &str;
+    fn styles(&self) -> &[ProjectionStyle];
+    fn to_projected(&self, source: SourceByte, bias: ConcealBias) -> Option<ProjectedByte>;
+    fn to_source(&self, projected: ProjectedByte, bias: ConcealBias) -> Option<SourceByte>;
+}
+
+pub trait ProjectionProvider: Send + Sync {
+    /// Only compose immutable, already classified ranges with current native
+    /// active state. A stale classification or unrepresentable IME range returns
+    /// None, keeping exact Source editable. Never round an IME replacement.
+    fn compose(
+        &self,
+        source: &SourceSnapshot,
+        active: &ActiveSource,
+    ) -> Option<Arc<dyn SourceProjection>>;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SourceMutationReason {
+    Edit,
+    Preedit,
+    Silent,
+    Reset,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SourceMutation {
+    pub stamp: SourceStamp,
+    pub reason: SourceMutationReason,
+}
+
+/// One hit resolved against one displayed layout. Reveal/reflow may consume this
+/// source target, but must never re-hit-test its original pixel.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ResolvedSourceHit {
+    pub source: SourceByte,
+    pub bias: ConcealBias,
+    pub affinity: WrapAffinity,
+    pub stamp: LayoutStamp,
+}
+
+#[derive(Clone)]
+pub struct PinnedProjection {
+    pub stamp: LayoutStamp,
+    pub projection: Arc<dyn SourceProjection>,
+}
+impl PinnedProjection {
+    /// Presentation changes alone do not invalidate the old *displayed* hit
+    /// map. Source changes do: callers must defer instead of guessing an offset.
+    pub fn resolve_hit(
+        &self,
+        current: SourceStamp,
+        offset: ProjectedByte,
+        bias: ConcealBias,
+        affinity: WrapAffinity,
+    ) -> Option<ResolvedSourceHit> {
+        if self.stamp.source != current {
+            return None;
+        }
+        Some(ResolvedSourceHit {
+            source: self.projection.to_source(offset, bias)?,
+            bias,
+            affinity,
+            stamp: self.stamp,
+        })
+    }
+}
+
+/// Authority bookkeeping shared by native input paths, never by undo history.
+/// Advancing either epoch has no transaction or source Change side effects.
+pub(crate) struct ProjectionSession {
+    pub(crate) enabled: bool,
+    pub(crate) stamp: LayoutStamp,
+    pub(crate) active: ActiveSource,
+    pub(crate) provider: Option<Arc<dyn ProjectionProvider>>,
+    pub(crate) current: Option<Arc<dyn SourceProjection>>,
+}
+impl Default for ProjectionSession {
+    fn default() -> Self {
+        static NEXT_DOCUMENT: AtomicU64 = AtomicU64::new(1);
+        Self {
+            enabled: false,
+            stamp: LayoutStamp {
+                source: SourceStamp {
+                    document: NEXT_DOCUMENT.fetch_add(1, Ordering::Relaxed),
+                    generation: 0,
+                },
+                presentation: 0,
+            },
+            active: ActiveSource::default(),
+            provider: None,
+            current: None,
+        }
+    }
+}
+impl ProjectionSession {
+    pub(crate) fn mutation(&mut self, reason: SourceMutationReason) -> SourceMutation {
+        self.stamp.source.generation = self
+            .stamp
+            .source
+            .generation
+            .checked_add(1)
+            .expect("editor source generation exhausted");
+        self.presentation_changed();
+        SourceMutation {
+            stamp: self.stamp.source,
+            reason,
+        }
+    }
+    pub(crate) fn presentation_changed(&mut self) {
+        self.stamp.presentation = self
+            .stamp
+            .presentation
+            .checked_add(1)
+            .expect("editor presentation epoch exhausted");
+        self.current = None;
+    }
+    pub(crate) fn set_active(&mut self, active: ActiveSource) {
+        if self.active != active {
+            self.active = active;
+            self.presentation_changed();
+        }
+    }
+    pub(crate) fn compose(&mut self, source: Arc<str>) {
+        self.current = None;
+        let Some(provider) = &self.provider else {
+            return;
+        };
+        let snapshot = SourceSnapshot {
+            stamp: self.stamp.source,
+            text: source,
+        };
+        let Some(projection) = provider.compose(&snapshot, &self.active) else {
+            return;
+        };
+        // A provider cannot publish a mapping for a different document or bytes.
+        if projection.source().stamp != snapshot.stamp || projection.source().text != snapshot.text
+        {
+            return;
+        }
+        self.current = Some(projection);
+    }
+    pub(crate) fn pin(&self) -> Option<PinnedProjection> {
+        Some(PinnedProjection {
+            stamp: self.stamp,
+            projection: self.current.clone()?,
+        })
+    }
+}
+
+/// Validated native bridge. Out-of-range positions and the middle of a UTF-16
+/// surrogate pair are rejected; valid scalar positions inside a grapheme remain
+/// exact and may require Source presentation. No display coordinates are used.
+pub fn source_utf16_to_byte(text: &str, offset: SourceUtf16) -> Option<SourceByte> {
+    let mut utf16 = 0;
+    for (byte, ch) in text.char_indices() {
+        if utf16 == offset.0 {
+            return Some(SourceByte(byte));
+        }
+        utf16 += ch.len_utf16();
+        if utf16 > offset.0 {
+            return None;
+        }
+    }
+    (utf16 == offset.0).then_some(SourceByte(text.len()))
+}
+pub fn source_byte_to_utf16(text: &str, offset: SourceByte) -> Option<SourceUtf16> {
+    Some(SourceUtf16(text.get(..offset.0)?.encode_utf16().count()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    struct Identity(SourceSnapshot);
+    impl SourceProjection for Identity {
+        fn source(&self) -> &SourceSnapshot {
+            &self.0
+        }
+        fn text(&self) -> &str {
+            &self.0.text
+        }
+        fn styles(&self) -> &[ProjectionStyle] {
+            &[]
+        }
+        fn to_projected(&self, p: SourceByte, _: ConcealBias) -> Option<ProjectedByte> {
+            self.text()
+                .is_char_boundary(p.0)
+                .then_some(ProjectedByte(p.0))
+        }
+        fn to_source(&self, p: ProjectedByte, _: ConcealBias) -> Option<SourceByte> {
+            self.text().is_char_boundary(p.0).then_some(SourceByte(p.0))
+        }
+    }
+    struct Provider;
+    impl ProjectionProvider for Provider {
+        fn compose(
+            &self,
+            s: &SourceSnapshot,
+            _: &ActiveSource,
+        ) -> Option<Arc<dyn SourceProjection>> {
+            Some(Arc::new(Identity(s.clone())))
+        }
+    }
+    #[test]
+    fn displayed_hit_survives_reveal_but_never_source_aba() {
+        let mut s = ProjectionSession::default();
+        s.provider = Some(Arc::new(Provider));
+        s.compose(Arc::from("**a**"));
+        let displayed = s.pin().unwrap();
+        s.set_active(ActiveSource {
+            head: SourceByte(3),
+            ..ActiveSource::default()
+        });
+        assert!(
+            displayed
+                .resolve_hit(
+                    s.stamp.source,
+                    ProjectedByte(3),
+                    ConcealBias::Right,
+                    WrapAffinity::End
+                )
+                .is_some()
+        );
+        s.mutation(SourceMutationReason::Edit);
+        s.compose(Arc::from("**b**"));
+        s.mutation(SourceMutationReason::Silent);
+        s.compose(Arc::from("**a**"));
+        assert!(
+            displayed
+                .resolve_hit(
+                    s.stamp.source,
+                    ProjectedByte(3),
+                    ConcealBias::Right,
+                    WrapAffinity::End
+                )
+                .is_none()
+        );
+    }
+    #[test]
+    fn exact_native_bridge_preserves_subgrapheme_preedit() {
+        let text = "a\u{301}👩\u{200d}💻\r\n";
+        assert_eq!(
+            source_utf16_to_byte(text, SourceUtf16(1)),
+            Some(SourceByte(1))
+        );
+        assert_eq!(source_utf16_to_byte(text, SourceUtf16(3)), None);
+        for (byte, _) in text
+            .char_indices()
+            .chain(std::iter::once((text.len(), '\0')))
+        {
+            let native = source_byte_to_utf16(text, SourceByte(byte)).unwrap();
+            assert_eq!(source_utf16_to_byte(text, native), Some(SourceByte(byte)));
+        }
+        assert_eq!(source_byte_to_utf16(text, SourceByte(2)), None);
+        assert_eq!(source_utf16_to_byte(text, SourceUtf16(999)), None);
+    }
+}
