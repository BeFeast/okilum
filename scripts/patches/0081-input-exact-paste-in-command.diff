+    /// Answers inside the paste command, like the macOS pasteboard reader.
+    struct InCommandClipboardProvider(Result<Option<String>, ClipboardReadError>);
+    impl ExactClipboardProvider for InCommandClipboardProvider {
+        fn read_text(
+            &self,
+            _: super::super::clipboard::ClipboardReadRequest,
+            _: &App,
+        ) -> gpui::Task<Result<Option<String>, ClipboardReadError>> {
+            panic!("an in-command read never starts the asynchronous path")
+        }
+        fn read_text_now(&self, _: &App) -> Option<Result<Option<String>, ClipboardReadError>> {
+            Some(self.0.clone())
+        }
+    }
+
+    /// #1602: a clipboard manager re-activates the window and posts Cmd+V at
+    /// once; GPUI records the activation one turn later. The paste still lands,
+    /// inside the command, with one Undo step and the busy slot released.
+    #[gpui::test]
+    fn exact_paste_in_command_lands_before_the_activation_is_recorded(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        for (response, expected) in [
+            (Ok(Some("b\u{301}🧠".to_string())), "ab\u{301}🧠c"),
+            (Ok(Some(String::new())), "ac"),
+            (Ok(None), "ac"),
+            (Err(ClipboardReadError::ChangedOffer), "ac"),
+        ] {
+            let view = InputView::new(cx);
+            let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+            let outcomes = Rc::new(std::cell::RefCell::new(Vec::new()));
+            let provider = Arc::new(InCommandClipboardProvider(response.clone()));
+            let _subscription = v.update(|window, cx| {
+                let captured = outcomes.clone();
+                let subscription =
+                    cx.subscribe(&view.input, move |_, event: &ClipboardPasteEvent, _| {
+                        captured.borrow_mut().push(event.clone())
+                    });
+                view.input.update(cx, |state, cx| {
+                    state.set_value("ac", window, cx);
+                    state.set_selected_range(1..1, cx);
+                    state.set_exact_clipboard_provider(Some(provider.clone()), cx);
+                    window.activate_window();
+                    state.focus(window, cx);
+                });
+                subscription
+            });
+            v.run_until_parked();
+            v.deactivate_window();
+            v.update(|window, cx| {
+                assert!(!window.is_window_active(), "positive control: GPUI flag is off");
+                view.input.update(cx, |state, cx| {
+                    state.paste(&Paste, window, cx);
+                    // Applied before the command returns, not on a later turn.
+                    assert_eq!(state.value().as_ref(), expected, "{response:?}");
+                });
+            });
+            v.update(|window, _| window.activate_window());
+            v.run_until_parked();
+            let outcome = outcomes.borrow().last().cloned();
+            match &response {
+                Ok(Some(text)) => assert_eq!(
+                    outcome,
+                    Some(ClipboardPasteEvent::Applied {
+                        request: 1,
+                        bytes: text.len()
+                    })
+                ),
+                Ok(None) => assert_eq!(
+                    outcome,
+                    Some(ClipboardPasteEvent::Failed(ClipboardReadError::Unavailable))
+                ),
+                Err(error) => {
+                    assert_eq!(outcome, Some(ClipboardPasteEvent::Failed(error.clone())))
+                }
+            }
+            v.update(|window, cx| {
+                view.input.update(cx, |state, cx| {
+                    let (id, revision, _) = state.exact_clipboard.begin().unwrap();
+                    assert!(state.exact_clipboard.complete(id, revision));
+                    if response.as_ref().is_ok_and(|text| text.as_deref() == Some("b\u{301}🧠")) {
+                        state.undo(&Undo, window, cx);
+                        assert_eq!(state.value().as_ref(), "ac");
+                    }
+                });
+            });
+        }
+    }
