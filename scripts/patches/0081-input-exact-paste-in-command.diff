+    /// #1602: an asynchronous read started in the turn before the activation
+    /// is recorded still applies; leaving the window still cancels it.
+    #[gpui::test]
+    fn exact_async_paste_survives_activation_and_cancels_on_deactivation(
+        cx: &mut TestAppContext,
+    ) {
+        cx.update(crate::init);
+        for leave in [false, true] {
+            let view = InputView::new(cx);
+            let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+            let (sender, receiver) = futures::channel::oneshot::channel();
+            let provider = Arc::new(DelayedClipboardProvider {
+                receiver: std::sync::Mutex::new(Some(receiver)),
+                calls: std::sync::atomic::AtomicUsize::new(0),
+            });
+            v.update(|window, cx| {
+                view.input.update(cx, |state, cx| {
+                    state.set_value("ac", window, cx);
+                    state.set_selected_range(1..1, cx);
+                    state.set_exact_clipboard_provider(Some(provider.clone()), cx);
+                    window.activate_window();
+                    state.focus(window, cx);
+                })
+            });
+            v.run_until_parked();
+            v.deactivate_window();
+            v.update(|window, cx| {
+                view.input
+                    .update(cx, |state, cx| state.paste(&Paste, window, cx))
+            });
+            assert_eq!(provider.calls.load(std::sync::atomic::Ordering::Relaxed), 1);
+            v.update(|window, _| window.activate_window());
+            v.run_until_parked();
+            if leave {
+                v.deactivate_window();
+            }
+            sender.send(Ok(Some("b".into()))).unwrap();
+            v.run_until_parked();
+            v.update(|_, cx| {
+                let expected = if leave { "ac" } else { "abc" };
+                assert_eq!(view.input.read(cx).value().as_ref(), expected, "leave={leave}");
+            });
+        }
+    }
