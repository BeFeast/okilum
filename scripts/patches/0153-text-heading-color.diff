+    #[test]
+    fn heading_color_is_opt_in_and_part_of_the_fingerprint() {
+        let base = TextViewStyle::default();
+        assert!((0..=7).all(|level| base.heading_color(level).is_none()));
+
+        let violet: Hsla = gpui::rgb(0x5034a8).into();
+        let colored = base.clone().with_heading_color(Some(violet));
+        assert!((1..=6).all(|level| colored.heading_color(level) == Some(violet)));
+        assert_eq!(colored.heading_color(0), None);
+        assert_eq!(colored.heading_color(7), None);
+        assert!(colored != base);
+        assert!(colored.clone().with_heading_color(None) == base);
+    }
+
+    #[test]
+    fn heading_color_takes_the_level() {
+        let violet: Hsla = gpui::rgb(0x5034a8).into();
+        let slate: Hsla = gpui::rgb(0xcbdbe5).into();
+        let style = TextViewStyle::default()
+            .with_heading_color(Some(slate))
+            .with_heading_level_color(1, Some(violet))
+            .with_heading_level_color(9, Some(violet));
+        assert_eq!(style.heading_color(1), Some(violet));
+        assert!((2..=6).all(|level| style.heading_color(level) == Some(slate)));
+        let other = TextViewStyle::default()
+            .with_heading_color(Some(slate))
+            .with_heading_level_color(2, Some(violet));
+        assert!(style != other, "the level is part of the fingerprint");
+    }
