+    /// no extra seam: bordered variants already draw it with the action
+    /// half's right edge, and transparent ones have no surface to divide.
+    pub(super) fn split_seam(
+        &self,
+        outline: bool,
+        disabled: bool,
+        cx: &mut App,
+    ) -> Option<(Background, Hsla)> {
+        if outline || self.is_default() || self.is_ghost() || self.no_padding() {
+            return None;
+        }
+        let style = if disabled {
+            self.disabled(false, cx)
+        } else {
+            self.normal(false, cx)
+        };
+        Some((style.bg, style.fg.opacity(0.35)))
+    }
