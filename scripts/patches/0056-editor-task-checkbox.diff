+    #[gpui::test]
+    fn source_range_edit_keeps_selection_and_undoes_in_one_step(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        let view = InputView::new(cx);
+        let mut cx = VisualTestContext::from_window(view.window_handle.into(), cx);
+        cx.update(|window, cx| {
+            view.input.update(cx, |state, cx| {
+                state.set_value("- [ ] one\n- [ ] two", window, cx);
+                let end = state.value().len();
+                state.selected_range = (end..end).into();
+                // Toggle the first box with the caret at the end of the note.
+                assert!(state.replace_source_range(3..4, "x", window, cx));
+                assert_eq!(state.value().as_ref(), "- [x] one\n- [ ] two");
+                assert_eq!(state.selected_range.start, end);
+                assert_eq!(state.selected_range.end, end);
+                // A longer replacement shifts a selection after it.
+                assert!(state.replace_source_range(6..9, "ONE!", window, cx));
+                assert_eq!(state.selected_range.start, end + 1);
+                state.undo(&Undo, window, cx);
+                assert_eq!(state.value().as_ref(), "- [x] one\n- [ ] two");
+                state.undo(&Undo, window, cx);
+                assert_eq!(state.value().as_ref(), "- [ ] one\n- [ ] two", "one undo per edit");
+                // Redo re-applies the toggle and keeps the caret where it was.
+                state.redo(&Redo, window, cx);
+                assert_eq!(state.value().as_ref(), "- [x] one\n- [ ] two");
+                assert_eq!(state.selected_range.start, end);
+                // Not on a character boundary, or read-only: nothing changes.
+                state.set_value("é", window, cx);
+                assert!(!state.replace_source_range(1..2, "x", window, cx));
+                state.set_value("- [ ] ro", window, cx);
+                state.set_readonly(true, cx);
+                assert!(!state.replace_source_range(3..4, "x", window, cx));
+                assert_eq!(state.value().as_ref(), "- [ ] ro");
+            })
+        });
+    }
