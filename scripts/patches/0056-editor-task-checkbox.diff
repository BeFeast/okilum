+    /// checkbox toggle (S5, #1034).
+    pub fn replace_source_range(
+        &mut self,
+        range: std::ops::Range<usize>,
+        text: &str,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        let value = self.text.to_string();
+        if !self.is_editable()
+            || range.start > range.end
+            || !value.is_char_boundary(range.start)
+            || !value.is_char_boundary(range.end)
+        {
+            return false;
+        }
+        let selected = self.selected_range;
+        let map = |offset: usize| {
+            if offset >= range.end {
+                offset - range.len() + text.len()
+            } else if offset > range.start {
+                range.start + (offset - range.start).min(text.len())
+            } else {
+                offset
+            }
+        };
+        self.undo_manager.pending_intent = Some(EditIntent::Atomic);
+        let range_utf16 = self.range_to_utf16(&range);
+        self.replace_text_in_range_silent(Some(range_utf16), text, window, cx);
+        self.selected_range = (map(selected.start)..map(selected.end)).into();
+        self.sync_projection_active();
+        cx.notify();
+        true
+    }
