+    /// Replace exact source `range` with `text` as one undoable user edit,
+    /// keeping the selection where it was (shifted past the edit). Returns
+    /// false, changing nothing, when the editor is not editable or `range` is
+    /// not on character boundaries. Used for widget edits such as a task
+    /// checkbox toggle (S5, #1034).
+    pub fn replace_source_range(
+        &mut self,
+        range: std::ops::Range<usize>,
+        text: &str,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        let value = self.text.to_string();
+        if !self.is_editable()
+            || range.start > range.end
+            || !value.is_char_boundary(range.start)
+            || !value.is_char_boundary(range.end)
+        {
+            return false;
+        }
+        let selected = self.selected_range;
+        let map = |offset: usize| {
+            if offset >= range.end {
+                offset - range.len() + text.len()
+            } else if offset > range.start {
+                range.start + (offset - range.start).min(text.len())
+            } else {
+                offset
+            }
+        };
+        let after: Selection = (map(selected.start)..map(selected.end)).into();
+        self.undo_manager.pending_intent = Some(EditIntent::Atomic);
+        self.pending_selection_after = Some(after);
+        let range_utf16 = self.range_to_utf16(&range);
+        self.replace_text_in_range_silent(Some(range_utf16), text, window, cx);
+        self.pending_selection_after = None;
+        self.selected_range = after;
+        self.sync_projection_active();
+        cx.notify();
+        true
+    }
