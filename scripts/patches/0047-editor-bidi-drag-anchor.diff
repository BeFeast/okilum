+    /// Every caret at the edge nearest `x`, with the cell that owns it. Where
+    /// two directional runs meet, one X is the edge of two cells with
+    /// different offsets.
+    pub(crate) fn edge_carets(&self, x: Pixels) -> Vec<(Caret, Range<usize>)> {
+        let Some(edge) = self.hit(x).and_then(|hit| self.position(hit)) else {
+            return Vec::new();
+        };
+        self.cells
+            .iter()
+            .filter_map(|cell| {
+                let caret = if cell.leading() == edge {
+                    Caret {
+                        index: cell.source.start,
+                        affinity: Affinity::Before,
+                    }
+                } else if cell.trailing() == edge {
+                    Caret {
+                        index: cell.source.end,
+                        affinity: Affinity::After,
+                    }
+                } else {
+                    return None;
+                };
+                Some((caret, cell.source.clone()))
+            })
+            .collect()
+    }
+
+    /// Hit-test the moving end of a selection whose fixed end is `anchor`,
+    /// so the highlight reaches the pointer at a run boundary (#879).
+    pub(crate) fn hit_extending(&self, x: Pixels, anchor: usize) -> Option<Caret> {
+        let hit = self.hit(x)?;
+        let carets = self.edge_carets(x);
+        if carets.iter().all(|(caret, _)| caret.index == hit.index) {
+            return Some(hit);
+        }
+        covering(
+            carets
+                .into_iter()
+                .map(|(caret, cell)| (caret, caret.index, cell)),
+            anchor,
+        )
+        .or(Some(hit))
+    }
