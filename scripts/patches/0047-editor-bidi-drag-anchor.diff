+/// Of the carets at one X, the one whose own cell lies between it and the
+/// other selection end, nearest that end. `None` when no cell would be covered.
+pub(crate) fn covering<T>(
+    candidates: impl IntoIterator<Item = (T, usize, Range<usize>)>,
+    other_end: usize,
+) -> Option<T> {
+    candidates
+        .into_iter()
+        .filter(|(_, index, cell)| {
+            other_end.min(*index) <= cell.start && cell.end <= other_end.max(*index)
+        })
+        .min_by_key(|(_, index, _)| index.abs_diff(other_end))
+        .map(|(candidate, _, _)| candidate)
+}
