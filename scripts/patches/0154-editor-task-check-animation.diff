+/// A task box a click just toggled (#3155): its marker's source start, the
+/// state it was toggled to and when. Paint animates only a box at `at` that
+/// already shows `checked`; the hit bounds never change.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct TaskAnimation {
+    pub(super) at: usize,
+    pub(super) checked: bool,
+    pub(super) started: std::time::Instant,
+    pub(super) spec: crate::input::projection::TaskCheckAnimation,
+}
+
+impl TaskAnimation {
+    /// The frame for a box at `at` showing `checked`, `elapsed` in; else None.
+    fn frame_for(
+        &self,
+        at: usize,
+        checked: bool,
+        elapsed: std::time::Duration,
+    ) -> Option<crate::input::projection::TaskCheckFrame> {
+        (self.at == at && self.checked == checked)
+            .then(|| self.spec.frame(elapsed, checked))
+            .flatten()
+    }
+}
+
+/// The checkmark in box-side units, drawn from its short leg to its tip.
+const CHECK: [(f32, f32); 3] = [(0.24, 0.52), (0.43, 0.72), (0.78, 0.3)];
+
+/// The checkmark's points with only `stroke` (0..=1) of its length drawn, and
+/// how many of them are used. No allocation: this runs in paint.
+fn check_points(stroke: f32) -> ([(f32, f32); 3], usize) {
+    if stroke >= 1. {
+        return (CHECK, 3);
+    }
+    let len = |a: (f32, f32), b: (f32, f32)| (b.0 - a.0).hypot(b.1 - a.1);
+    let legs = [len(CHECK[0], CHECK[1]), len(CHECK[1], CHECK[2])];
+    let left = stroke.max(0.) * (legs[0] + legs[1]);
+    let along = |a: (f32, f32), b: (f32, f32), f: f32| (a.0 + (b.0 - a.0) * f, a.1 + (b.1 - a.1) * f);
+    if left < legs[0] {
+        ([CHECK[0], along(CHECK[0], CHECK[1], left / legs[0]), CHECK[2]], 2)
+    } else {
+        ([CHECK[0], CHECK[1], along(CHECK[1], CHECK[2], (left - legs[0]) / legs[1])], 3)
+    }
+}
