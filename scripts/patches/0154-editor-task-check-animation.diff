+    /// #3155: the bounce peaks and settles, the check draws in on check and
+    /// out on uncheck, and the animation ends at its duration.
+    #[test]
+    fn task_check_animation_bounces_draws_and_ends() {
+        let spec = TaskCheckAnimation::new(std::time::Duration::from_millis(300), 0.2);
+        let at = |ms| spec.frame(std::time::Duration::from_millis(ms), true);
+        let start = at(0).unwrap();
+        assert_eq!((start.scale, start.stroke), (1., 0.));
+        let peak = at(90).unwrap();
+        assert!((peak.scale - 1.2).abs() < 1e-4, "{peak:?}");
+        assert_eq!(at(180).unwrap().scale, 1., "the bounce settles first");
+        assert!(at(150).unwrap().stroke > at(60).unwrap().stroke);
+        assert!(at(299).unwrap().stroke > 0.99);
+        assert_eq!(at(300), None, "ends at its duration");
+        assert_eq!(at(5000), None);
+        let off = spec.frame(std::time::Duration::from_millis(0), false).unwrap();
+        assert_eq!(off.stroke, 1., "unchecking draws the check out");
+        assert!(spec.frame(std::time::Duration::from_millis(299), false).unwrap().stroke < 0.01);
+        assert_eq!(TaskCheckAnimation::new(std::time::Duration::ZERO, 0.2).frame(Default::default(), true), None);
+        assert_eq!(TaskCheckAnimation::new(std::time::Duration::from_millis(1), -1.).bounce(), 0.);
+
+        let running = TaskAnimation { at: 4, checked: true, started: std::time::Instant::now(), spec };
+        let mid = std::time::Duration::from_millis(100);
+        assert!(running.frame_for(4, true, mid).is_some());
+        assert!(running.frame_for(4, false, mid).is_none(), "a box not yet repainted");
+        assert!(running.frame_for(5, true, mid).is_none(), "another box");
+    }
+
+    #[test]
+    fn check_points_draw_a_prefix_of_the_checkmark() {
+        let drawn = |stroke| {
+            let (points, used) = check_points(stroke);
+            points[..used].to_vec()
+        };
+        assert_eq!(drawn(1.), CHECK.to_vec(), "a checked box draws the whole mark");
+        assert_eq!(drawn(0.), vec![CHECK[0], CHECK[0]]);
+        let half = drawn(0.5);
+        // The short leg is about a third of the length: half reaches the long leg.
+        assert_eq!(half.len(), 3);
+        assert_eq!(half[1], CHECK[1]);
+        assert!(half[2].0 < CHECK[2].0 && half[2].0 > CHECK[1].0);
+        let start = drawn(0.1);
+        assert_eq!(start.len(), 2);
+        assert!(start[1].0 < CHECK[1].0);
+    }
