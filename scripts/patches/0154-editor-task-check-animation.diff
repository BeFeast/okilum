+/// A theme's task check/uncheck animation (#3155), installed by the app as a
+/// GPUI global; no global, no animation. It runs only after a click toggles a
+/// painted box, never with reduce motion, and only repaints: the box bounces
+/// and the checkmark draws in (or out). Frames are requested while it runs.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct TaskCheckAnimation {
+    duration: std::time::Duration,
+    bounce: f32,
+}
+
+impl gpui::Global for TaskCheckAnimation {}
+
+/// One frame of a [`TaskCheckAnimation`].
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct TaskCheckFrame {
+    /// Scale of the box around its centre.
+    pub(crate) scale: f32,
+    /// Share of the checkmark drawn, `0.` none to `1.` whole.
+    pub(crate) stroke: f32,
+}
+
+impl TaskCheckAnimation {
+    /// `bounce` is the peak extra scale of the box: `0.2` = 120 % at the top.
+    pub fn new(duration: std::time::Duration, bounce: f32) -> Self {
+        Self { duration, bounce: bounce.max(0.) }
+    }
+
+    pub fn duration(&self) -> std::time::Duration {
+        self.duration
+    }
+
+    pub fn bounce(&self) -> f32 {
+        self.bounce
+    }
+
+    /// The frame `elapsed` after a toggle to `checked`; `None` once it ended.
+    pub(crate) fn frame(&self, elapsed: std::time::Duration, checked: bool) -> Option<TaskCheckFrame> {
+        if self.duration.is_zero() || elapsed >= self.duration {
+            return None;
+        }
+        let t = elapsed.as_secs_f32() / self.duration.as_secs_f32();
+        // The bounce takes the first 60 %, the stroke eases out over all of it.
+        let bounce = (std::f32::consts::PI * (t / 0.6).min(1.)).sin();
+        let drawn = 1. - (1. - t).powi(3);
+        Some(TaskCheckFrame {
+            scale: 1. + self.bounce * bounce,
+            stroke: if checked { drawn } else { 1. - drawn },
+        })
+    }
+}
