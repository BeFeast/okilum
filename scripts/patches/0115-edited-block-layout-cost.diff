+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct DirtyRows {
+    pub old: Range<usize>,
+    pub new: Range<usize>,
+}
+
+impl DirtyRows {
+    fn include(&mut self, old: Range<usize>, new: Range<usize>, old_rows: usize, new_rows: usize) {
+        if old.is_empty() && new.is_empty() { return; }
+        let unchanged = self.old.is_empty() && self.new.is_empty();
+        let mut prefix = if unchanged { old_rows.min(new_rows) } else { self.old.start };
+        let mut suffix = if unchanged { old_rows.min(new_rows) }
+            else { (old_rows - self.old.end).min(new_rows - self.new.end) };
+        if !old.is_empty() {
+            prefix = prefix.min(old.start);
+            suffix = suffix.min(old_rows.saturating_sub(old.end));
+        }
+        if !new.is_empty() {
+            prefix = prefix.min(new.start);
+            suffix = suffix.min(new_rows.saturating_sub(new.end));
+        }
+        self.old = prefix..old_rows - suffix;
+        self.new = prefix..new_rows - suffix;
+    }
+
+    fn map_row(&self, row: usize) -> Option<usize> {
+        if row < self.old.start { Some(row) }
+        else if row >= self.old.end { Some(self.new.end + row - self.old.end) }
+        else { None }
+    }
+}
+
+fn changed_middle<'a, T>(old: &'a [T], new: &'a [T], equal: impl Fn(&T, &T) -> bool)
+    -> (&'a [T], &'a [T])
+{
+    let prefix = old.iter().zip(new).take_while(|(a, b)| equal(a, b)).count();
+    let suffix = old[prefix..].iter().rev().zip(new[prefix..].iter().rev())
+        .take_while(|(a, b)| equal(a, b)).count();
+    (&old[prefix..old.len() - suffix], &new[prefix..new.len() - suffix])
+}
+
+fn row_start(text: &str, row: usize) -> usize {
+    if row == 0 { return 0; }
+    text.bytes().enumerate().inspect(|_| {
+        #[cfg(test)]
+        LINE_SCAN_BYTES.with(|count| count.set(count.get() + 1));
+    }).filter(|(_, b)| *b == b'\n')
+        .nth(row - 1).map_or(text.len(), |(i, _)| i + 1)
+}
+
+fn indexed_row_start(text: &str, index: Option<&Rope>, row: usize) -> usize {
+    match index {
+        Some(index) if row < index.lines_len() => index.line_start_offset(row),
+        Some(_) => text.len(),
+        None => row_start(text, row),
+    }
+}
+
+fn style_rows(text: &str, index: Option<&Rope>, styles: &[ProjectionStyle], otherwise: Range<usize>) -> Range<usize> {
+    let Some(start) = styles.iter().map(|s| s.range.start.0).min() else { return otherwise; };
+    let end = styles.iter().map(|s| s.range.end.0).max().unwrap().max(start);
+    let row = |byte: usize| {
+        let byte = byte.min(text.len());
+        if let Some(index) = index { return index.offset_to_point(byte).row; }
+        #[cfg(test)]
+        LINE_SCAN_BYTES.with(|count| count.set(count.get() + byte));
+        text.as_bytes()[..byte].iter().filter(|b| **b == b'\n').count()
+    };
+    row(start)..row(end.saturating_sub(1).max(start)) + 1
+}
+
+/// Use the byte edit's indexed row boundaries when available, without a second
+/// whole-document line traversal. Standalone callers retain exact discovery.
+/// Metadata comparison remains conservative and linear; unchanged row layout
+/// is omitted before any font runs, LineKeys, LineItems or shaping are computed.
+fn discover_dirty_rows(old: &dyn SourceProjection, old_rows: usize,
+    new: &dyn SourceProjection, new_rows: usize, prepared: Option<DirtyRows>,
+    old_index: Option<&Rope>, new_index: Option<&Rope>) -> DirtyRows
+{
+    let text_dirty = prepared.unwrap_or_else(|| {
+    let prefix = old.text().split('\n').zip(new.text().split('\n'))
+        .take_while(|(a, b)| a == b).count();
+    let suffix = old.text().rsplit('\n').zip(new.text().rsplit('\n'))
+        .take(old_rows.min(new_rows) - prefix).take_while(|(a, b)| a == b).count();
+    DirtyRows { old: prefix..old_rows - suffix, new: prefix..new_rows - suffix }
+    });
+    let mut dirty = text_dirty.clone();
+    let prefix_byte = indexed_row_start(old.text(), old_index, text_dirty.old.start);
+    let old_suffix = indexed_row_start(old.text(), old_index, text_dirty.old.end);
+    let new_suffix = indexed_row_start(new.text(), new_index, text_dirty.new.end);
+    let map_byte = |byte: usize, start: bool| {
+        // At a pure insertion boundary, a prefix style's end stays on the
+        // left while a suffix style's start moves right with its original text.
+        if start && byte >= old_suffix { Some(new_suffix + byte - old_suffix) }
+        else if byte <= prefix_byte { Some(byte) }
+        else if byte >= old_suffix { Some(new_suffix + byte - old_suffix) }
+        else { None }
+    };
+    // Keep provider order (including unsorted overlapping styles). Equal runs
+    // may cross the edited block if both endpoints still map exactly. Paint-only
+    // changes do not invalidate row geometry; current-pin paint remains separate.
+    let (a, b) = changed_middle(old.styles(), new.styles(), |a, b| {
+        map_byte(a.range.start.0, true) == Some(b.range.start.0)
+            && map_byte(a.range.end.0, false) == Some(b.range.end.0)
+            && a.font_family == b.font_family && a.bold == b.bold && a.italic == b.italic
+    });
+    dirty.include(style_rows(old.text(), old_index, a, text_dirty.old.clone()),
+        style_rows(new.text(), new_index, b, text_dirty.new.clone()), old_rows, new_rows);
+    let (a, b) = changed_middle(old.line_scales(), new.line_scales(), |a, b|
+        text_dirty.map_row(a.line) == Some(b.line) && a.scale == b.scale && a.hang == b.hang);
+    for item in a { dirty.include(item.line..item.line + 1, text_dirty.new.clone(), old_rows, new_rows); }
+    for item in b { dirty.include(text_dirty.old.clone(), item.line..item.line + 1, old_rows, new_rows); }
+    let (a, b) = changed_middle(old.line_indents(), new.line_indents(), |a, b|
+        text_dirty.map_row(a.line) == Some(b.line) && a.prefix == b.prefix);
+    for item in a { dirty.include(item.line..item.line + 1, text_dirty.new.clone(), old_rows, new_rows); }
+    for item in b { dirty.include(text_dirty.old.clone(), item.line..item.line + 1, old_rows, new_rows); }
+    dirty
 }

