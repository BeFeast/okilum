+    #[test]
+    fn projected_rope_reuses_revision_bound_index_and_only_inserts_changed_bytes() {
+        let original = format!("{}é👩\u{200d}💻\r\ntail\n", "unchanged row\r\n".repeat(10000));
+        let mut cache = ProjectedCache::default();
+        let mut previous: Option<Rope> = None;
+        let at = original.find('é').unwrap();
+        let mut edited = original.clone();
+        edited.replace_range(at..at + 'é'.len_utf8(), "ê");
+        let mut inserted = edited.clone();
+        inserted.insert_str(at, "漢\r\n");
+        let variants = [&original, &edited, &inserted, &edited, &original, &original];
+        let expected_work = [original.len(), 2, "漢\r\n".len(), 0, 2, 0];
+        for (generation, (value, bytes)) in variants.into_iter().zip(expected_work).enumerate() {
+            let mut next = snapshot(value);
+            next.source.stamp.generation = generation as u64 + 1;
+            cache.begin(next.source.stamp.document);
+            TEXT_BYTES_BUILT.with(|count| count.set(0));
+            let next = Arc::new(next);
+            let rope = cache.prepare_text(next.clone());
+            assert_eq!(rope.to_string(), *value, "exact authored bytes survive edit/IME/Undo");
+            let cold = Rope::from(value.as_str());
+            assert_eq!(rope.lines_len(), cold.lines_len());
+            for row in [0, 9999, 10000, rope.lines_len() - 1] {
+                assert_eq!(rope.line_start_offset(row), cold.line_start_offset(row));
+            }
+            assert_eq!(TEXT_BYTES_BUILT.with(|count| count.get()), bytes,
+                "cold positive control and incremental UTF-8 work bound");
+            if let Some(old) = previous.take() {
+                assert_eq!(old.to_string(), *variants[generation - 1], "old viewport index is immutable");
+            }
+            previous = Some(rope);
+            cache.remember_projection(next);
+        }
+        // Identical bytes in another document must not inherit the old index.
+        let mut other = snapshot(&original); other.source.stamp.document = 10;
+        cache.begin(10);
+        TEXT_BYTES_BUILT.with(|count| count.set(0));
+        assert_eq!(cache.prepare_text(Arc::new(other)).to_string(), original);
+        assert_eq!(TEXT_BYTES_BUILT.with(|count| count.get()), original.len());
+    }
