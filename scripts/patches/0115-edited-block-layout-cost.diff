+    #[test]
+    fn superseded_preparation_cannot_replace_another_projection_index() {
+        let mut cache = ProjectedCache::default();
+        let original = Arc::new(snapshot("head\nold\ntail\n"));
+        publish(&mut cache, original.clone(), layout());
+        // Same source stamp does not identify a reveal/presentation decision.
+        let abandoned = Arc::new(snapshot("head\npending\nextra\ntail\n"));
+        cache.prepare_text(abandoned.clone());
+        let current = Arc::new(snapshot("head\nnew\ntail\n"));
+        let rope = cache.prepare_text(current.clone());
+        assert_eq!(rope.to_string(), current.text());
+        assert_eq!(cache.text.as_ref().unwrap().to_string(), original.text(),
+            "preparation leaves the installed viewport index immutable");
+        assert_eq!(cache.dirty_rows(current.as_ref(), 4, &layout()),
+            DirtyRows { old: 1..2, new: 1..2 });
+        // A stale candidate's prepared boundaries cannot be used for this pin.
+        let other = snapshot("new head\nold\ntail\n");
+        assert_eq!(cache.dirty_rows(&other, 4, &layout()),
+            DirtyRows { old: 0..1, new: 0..1 });
+        // Installing a candidate different from the prepared one discards its
+        // index instead of pairing old text with the new mapping.
+        cache.remember_projection(abandoned.clone());
+        assert!(cache.text.is_none());
+        assert!(cache.lines.is_none(), "a mismatched adoption invalidates geometry too");
+        TEXT_BYTES_BUILT.with(|count| count.set(0));
+        assert_eq!(cache.prepare_text(abandoned.clone()).to_string(), abandoned.text());
+        assert_eq!(TEXT_BYTES_BUILT.with(|count| count.get()), abandoned.text().len(),
+            "mismatched preparation takes the honest cold path");
+    }
