+/// Adopt only the dirty interval of projected row metrics. All keys and line
+/// metrics are still visited above; unchanged tree nodes keep their summaries.
+/// Compare relative geometry, never source offsets or presentation identities:
+/// the caller installs the new Rope and projection even for an empty interval.
+/// The previous tree belongs to the projection cache, not `self.lines`, which
+/// may already have been restored to Source by an IME, Undo or ordinary edit.
+pub(super) fn adopt_projected_lines(
+    previous: &SumTree<LineItem>,
+    items: Vec<LineItem>,
+) -> (SumTree<LineItem>, usize) {
+    let old: Vec<_> = previous.iter().collect();
+    let prefix = old.iter().zip(&items).take_while(|(a, b)| **a == *b).count();
+    let suffix = old[prefix..].iter().rev().zip(items[prefix..].iter().rev())
+        .take_while(|(a, b)| **a == *b).count();
+    let dirty_end = items.len() - suffix;
+    let replaced = dirty_end - prefix;
+    if prefix == old.len() && prefix == items.len() {
+        return (previous.clone(), 0);
+    }
+    let mut cursor = previous.cursor::<BufferRows>(&());
+    let mut lines = cursor.slice(&BufferRows(prefix), Bias::Right);
+    cursor.seek_forward(&BufferRows(old.len() - suffix), Bias::Right);
+    lines.extend(items.into_iter().skip(prefix).take(replaced), &());
+    lines.append(cursor.suffix(), &());
+    (lines, replaced)
 }

