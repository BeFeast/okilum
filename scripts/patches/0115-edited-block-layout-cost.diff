+    struct HiddenPrefix {
+        source: crate::input::projection::SourceSnapshot,
+        prefix: usize,
+    }
+    impl SourceProjection for HiddenPrefix {
+        fn source(&self) -> &crate::input::projection::SourceSnapshot {
+            &self.source
+        }
+        fn text(&self) -> &str {
+            &self.source.text[self.prefix..]
+        }
+        fn styles(&self) -> &[ProjectionStyle] {
+            &[]
+        }
+        fn to_projected(
+            &self,
+            byte: crate::input::projection::SourceByte,
+            _: crate::input::projection::ConcealBias,
+        ) -> Option<crate::input::projection::ProjectedByte> {
+            (byte.0 <= self.source.text.len()).then_some(crate::input::projection::ProjectedByte(
+                byte.0.saturating_sub(self.prefix),
+            ))
+        }
+        fn to_source(
+            &self,
+            byte: crate::input::projection::ProjectedByte,
+            bias: crate::input::projection::ConcealBias,
+        ) -> Option<crate::input::projection::SourceByte> {
+            (byte.0 <= self.text().len()).then_some(crate::input::projection::SourceByte(
+                if byte.0 == 0 && bias == crate::input::projection::ConcealBias::Left {
+                    0
+                } else {
+                    self.prefix + byte.0
+                },
+            ))
+        }
+    }
