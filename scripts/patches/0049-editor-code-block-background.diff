+/// Visual rows inside a code block, painted as a background before selection
+/// and text. Same prepaint pin and source as glyph markers; the block must map
+/// unconcealed, and a stale or unsafe block paints nothing. No caret reveal:
+/// typing inside the block keeps its background steady.
+pub(super) fn code_rows(layout: &LastLayout, validated: &MarkerSource) -> Vec<Vec<bool>> {
+    let Some(pin) = &layout.projection else {
+        return vec![];
+    };
+    let boundaries = &validated.boundaries;
+    let blocks: Vec<_> = pin
+        .projection
+        .markers()
+        .iter()
+        .filter(|marker| matches!(marker.kind, MarkerKind::CodeBlock))
+        .filter_map(|marker| {
+            let (start, end) = (marker.range.start, marker.range.end);
+            if start.0 >= end.0
+                || boundaries.binary_search(&start.0).is_err()
+                || boundaries.binary_search(&end.0).is_err()
+            {
+                return None;
+            }
+            let projected = pin.projection.to_projected(start, ConcealBias::Left)?.0
+                ..pin.projection.to_projected(end, ConcealBias::Right)?.0;
+            (projected.len() == end.0 - start.0).then_some(projected)
+        })
+        .collect();
+    if blocks.is_empty() {
+        return vec![];
+    }
+    layout
+        .lines
+        .iter()
+        .enumerate()
+        .map(|(li, line)| {
+            let mut offset = layout.visible_line_byte_offsets[li];
+            line.wrapped_lines
+                .iter()
+                .map(|row| {
+                    let start = offset;
+                    offset += row.len();
+                    blocks
+                        .iter()
+                        .any(|block| block.start <= start && start < block.end)
+                })
+                .collect()
+        })
+        .collect()
+}
