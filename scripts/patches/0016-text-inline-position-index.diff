@@ -0,0 +1,246 @@
+//! Per-paint lookup of GPUI's existing geometry, without repeated glyph-prefix scans.
+use gpui::{Pixels, Point, TextLayout, WrappedLineLayout, point};
+
+/// GPUI returns the first glyph whose byte index is >= the requested index.
+/// Keeping only strict prefix maxima preserves that rule even for bidi glyphs
+/// whose byte indices are not sorted. Equal indices keep their first position.
+struct FirstAtOrAfter<T> {
+    entries: Vec<(usize, T)>,
+    #[cfg(test)]
+    comparisons: std::cell::Cell<usize>,
+}
+
+impl<T> FirstAtOrAfter<T> {
+    fn new() -> Self {
+        Self {
+            entries: Vec::new(),
+            #[cfg(test)]
+            comparisons: std::cell::Cell::new(0),
+        }
+    }
+
+    fn push(&mut self, index: usize, value: T) {
+        if self.entries.last().is_none_or(|(last, _)| index > *last) {
+            self.entries.push((index, value));
+        }
+    }
+
+    fn get(&self, index: usize) -> Option<&T> {
+        let offset = self.entries.partition_point(|(end, _)| {
+            #[cfg(test)]
+            self.comparisons.set(self.comparisons.get() + 1);
+            *end < index
+        });
+        self.entries.get(offset).map(|(_, value)| value)
+    }
+}
+
+struct IndexedLine {
+    start: usize,
+    origin: Point<Pixels>,
+    width: Pixels,
+    glyph_x: FirstAtOrAfter<Pixels>,
+    // x is the unwrapped start x; y is the original visual row's offset.
+    rows: FirstAtOrAfter<Point<Pixels>>,
+}
+
+/// Built lazily for selectable Inline geometry and dropped at the end of paint.
+/// It owns no font, shaping cache, source mapping, or state across frames.
+pub(super) struct InlineGeometry {
+    lines: FirstAtOrAfter<IndexedLine>,
+}
+
+impl InlineGeometry {
+    pub(super) fn new(layout: &TextLayout) -> Self {
+        Self::from_lines(
+            layout.line_layouts().iter().map(|line| line.as_ref()),
+            layout.bounds().origin,
+            layout.line_height(),
+        )
+    }
+
+    pub(super) fn from_lines<'a>(
+        layouts: impl IntoIterator<Item = &'a WrappedLineLayout>,
+        mut origin: Point<Pixels>,
+        line_height: Pixels,
+    ) -> Self {
+        let mut lines = FirstAtOrAfter::new();
+        let mut start = 0;
+        for layout in layouts {
+            let mut glyph_x = FirstAtOrAfter::new();
+            for run in &layout.unwrapped_layout.runs {
+                for glyph in &run.glyphs {
+                    glyph_x.push(glyph.index, glyph.position.x);
+                }
+            }
+            let width = layout.unwrapped_layout.width;
+            let mut rows = FirstAtOrAfter::new();
+            let mut row_start = 0;
+            for (row, end) in layout
+                .wrap_boundaries
+                .iter()
+                .map(|boundary| {
+                    layout.unwrapped_layout.runs[boundary.run_ix].glyphs[boundary.glyph_ix].index
+                })
+                .chain([layout.len()])
+                .enumerate()
+            {
+                let x = glyph_x.get(row_start).copied().unwrap_or(width);
+                rows.push(end, point(x, line_height * row));
+                // Preserve the preceding raw boundary, not just retained maxima.
+                row_start = end;
+            }
+            lines.push(
+                start + layout.len(),
+                IndexedLine {
+                    start,
+                    origin,
+                    width,
+                    glyph_x,
+                    rows,
+                },
+            );
+            start += layout.len() + 1;
+            origin.y += layout.size(line_height).height;
+        }
+        Self { lines }
+    }
+
+    pub(super) fn position_for_index(&self, index: usize) -> Option<Point<Pixels>> {
+        let line = self.lines.get(index)?;
+        let local = index.checked_sub(line.start)?;
+        let row = line.rows.get(local)?;
+        let x = line.glyph_x.get(local).copied().unwrap_or(line.width);
+        Some(line.origin + point(x - row.x, row.y))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui::px;
+    use gpui::{FontId, GlyphId, LineLayout, ShapedGlyph, ShapedRun, WrapBoundary};
+    use std::sync::Arc;
+
+    fn line(len: usize, indices: &[usize], wraps: &[usize]) -> WrappedLineLayout {
+        WrappedLineLayout {
+            unwrapped_layout: Arc::new(LineLayout {
+                len,
+                width: px(indices.len() as f32 * 7.),
+                runs: vec![ShapedRun {
+                    font_id: FontId(0),
+                    glyphs: indices
+                        .iter()
+                        .enumerate()
+                        .map(|(i, index)| ShapedGlyph {
+                            id: GlyphId(i as u32),
+                            index: *index,
+                            // Include zero-width advances as well as reordered indices.
+                            position: point(px((i / 2) as f32 * 7.), px(0.)),
+                            is_emoji: false,
+                        })
+                        .collect(),
+                }],
+                ..Default::default()
+            }),
+            wrap_boundaries: wraps
+                .iter()
+                .map(|i| WrapBoundary {
+                    run_ix: 0,
+                    glyph_ix: *i,
+                })
+                .collect(),
+            wrap_width: Some(px(21.)),
+        }
+    }
+
+    // The original public GPUI lookup is the oracle, including its inclusive
+    // wrap-end affinity. Do not substitute an idealized bidi interpretation.
+    fn oracle(
+        lines: &[WrappedLineLayout],
+        mut origin: Point<Pixels>,
+        height: Pixels,
+        index: usize,
+    ) -> Option<Point<Pixels>> {
+        let mut start = 0;
+        for line in lines {
+            let end = start + line.len();
+            if index < start {
+                break;
+            }
+            if index <= end {
+                return line
+                    .position_for_index(index - start, height)
+                    .map(|p| origin + p);
+            }
+            start = end + 1;
+            origin.y += line.size(height).height;
+        }
+        None
+    }
+
+    #[test]
+    fn positions_match_gpui_for_wrapping_unicode_bidi_and_glyphless_lines() {
+        let samples = [
+            "ascii\r\n",
+            "אבג عربي",
+            "e\u{301}👩\u{200d}💻\u{200b}",
+            "\t\r",
+            "",
+        ];
+        for text in samples {
+            let indices: Vec<_> = text.char_indices().map(|(i, _)| i).collect();
+            let mut backwards = indices.clone();
+            backwards.reverse();
+            for glyphs in [indices, backwards, vec![0, 4, 2, 2, 1, 9, 5, 11], vec![]] {
+                let wraps: Vec<_> = (1..glyphs.len()).step_by(2).collect();
+                let lines = vec![
+                    line(text.len(), &glyphs, &wraps),
+                    line(0, &[], &[]),
+                    line(5, &[0, 2, 2, 4], &[1, 2]),
+                ];
+                let origin = point(px(-5.), px(-30.));
+                let height = px(18.);
+                let geometry = InlineGeometry::from_lines(lines.iter(), origin, height);
+                let len: usize = lines.iter().map(|l| l.len() + 1).sum();
+                for index in 0..=len + 1 {
+                    assert_eq!(
+                        geometry.position_for_index(index),
+                        oracle(&lines, origin, height, index),
+                        "text={text:?}, glyphs={glyphs:?}, index={index}"
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn long_line_lookup_work_grows_below_quadratic() {
+        let comparisons = |len: usize| {
+            let indices: Vec<_> = (0..len).collect();
+            let wraps: Vec<_> = (64..len).step_by(64).collect();
+            let lines = [line(len, &indices, &wraps)];
+            let geometry = InlineGeometry::from_lines(lines.iter(), point(px(0.), px(0.)), px(18.));
+            for index in 0..=len {
+                assert!(geometry.position_for_index(index).is_some());
+            }
+            geometry.lines.comparisons.get()
+                + geometry
+                    .lines
+                    .entries
+                    .iter()
+                    .map(|(_, l)| l.glyph_x.comparisons.get() + l.rows.comparisons.get())
+                    .sum::<usize>()
+        };
+        let small = comparisons(4096);
+        let large = comparisons(16384);
+        assert!(
+            large < small * 6,
+            "four times the text must not cause sixteen times the work: {small} -> {large}"
+        );
+        assert!(
+            large < 16385 * 40,
+            "bound actual binary-search comparisons: {large}"
+        );
+    }
+}
