+    /// A break that ends a paragraph adds no empty last line; two leave one.
+    #[test]
+    fn test_trailing_break_adds_no_empty_line() {
+        for (source, text) in [
+            ("a<br>", "a"),
+            ("a<br><br>", "a\n"),
+            ("<br>a", "\na"),
+        ] {
+            let mut cx = NodeContext::default();
+            let document = parse(source, &mut cx).unwrap();
+            assert_eq!(
+                paragraph_texts(&document.blocks[0]).concat(),
+                text,
+                "source: {source:?}"
+            );
+        }
+    }
+
+    /// `<br />` lines between paragraphs are one break block each, without
+    /// empty paragraphs for the line endings between them (#3259).
+    #[test]
+    fn test_html_block_breaks_are_one_line_each() {
+        fn leaves<'a>(block: &'a BlockNode, out: &mut Vec<&'a BlockNode>) {
+            match block {
+                BlockNode::Root { children, .. } => {
+                    children.iter().for_each(|child| leaves(child, out))
+                }
+                _ => out.push(block),
+            }
+        }
+        let mut cx = NodeContext::default();
+        let document = parse("a\n\n<br />\n<br />\n<br />\n\nb", &mut cx).unwrap();
+        assert_eq!(document.blocks.len(), 3);
+        let mut html = Vec::new();
+        leaves(&document.blocks[1], &mut html);
+        assert_eq!(html.len(), 3, "{:?}", document.blocks[1]);
+        assert!(
+            html.iter()
+                .all(|block| matches!(block, BlockNode::Break { html: true, .. })),
+            "{html:?}"
+        );
+    }
