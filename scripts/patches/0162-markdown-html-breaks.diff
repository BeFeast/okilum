--- a/crates/base/src/text/format/html.rs
+++ b/crates/base/src/text/format/html.rs
@@ -664,6 +664,19 @@ fn consume_paragraph(children: &mut Vec<BlockNode>, paragraph: &mut Paragraph) {
     if paragraph.is_empty() {
         return;
     }
+    // Whitespace between block-level elements (the line endings between
+    // `<br />` lines, `<p>`s or `<div>`s) collapses away in HTML; it is not an
+    // empty paragraph. U+00A0 (`&nbsp;`) is not HTML whitespace and stays.
+    if paragraph.children.iter().all(|node| {
+        node.image.is_none()
+            && node
+                .text
+                .chars()
+                .all(|c| matches!(c, ' ' | '\t' | '\n' | '\r' | '\x0c'))
+    }) {
+        paragraph.take();
+        return;
+    }
 
     children.push(BlockNode::Paragraph(paragraph.take()));
 }
