-/// `hr`: `edge → middle → edge`, drawn as two two-stop halves.
+/// `hr`: `edge → middle → edge`, drawn as two two-stop halves, with an
+/// optional ornament between them.
 #[derive(Clone, Copy, Debug, PartialEq)]
 pub struct HorizontalRule {
     pub edge: Hsla,
     pub middle: Hsla,
     pub thickness: Pixels,
+    pub ornament: Option<RuleOrnament>,
+}
+
+/// A mark centred on an `hr` (CSS `hr::after`), such as a rotated `§`. The
+/// rule's halves stop `gap` short of the mark's box on each side. The mark is
+/// an SVG painted as a one-colour mask, so it needs no text shaping; its
+/// rotation is a sprite transform, so it changes no layout.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct RuleOrnament {
+    /// An SVG document; its alpha is painted in `color`. Also the sprite
+    /// atlas key, so equal marks share one rasterisation.
+    pub svg: &'static str,
+    pub color: Hsla,
+    /// Clockwise degrees, as CSS `rotate()`.
+    pub rotate: f32,
+    /// Side of the square box the SVG is drawn in.
+    pub size: Pixels,
+    /// Clear space between each half of the rule and the box.
+    pub gap: Pixels,
+}
+
+impl RuleOrnament {
+    /// Width the ornament takes out of the middle of the rule.
+    pub fn span(&self) -> Pixels {
+        (self.size + self.gap * 2.).max(px(0.))
+    }
+
+    /// Paints the mark centred on `center`.
+    pub fn paint(&self, center: Point<Pixels>, window: &mut Window, cx: &gpui::App) {
+        if self.size <= px(0.) {
+            return;
+        }
+        let half = self.size / 2.;
+        let bounds = Bounds::new(center - point(half, half), gpui::size(self.size, self.size));
+        let scale = window.scale_factor();
+        // As `gpui::Transformation::rotate` does for `svg()`: about the centre.
+        let transformation = gpui::TransformationMatrix::unit()
+            .translate(center.scale(scale))
+            .rotate(gpui::radians(self.rotate.to_radians()))
+            .translate(center.scale(-scale));
+        window
+            .paint_svg(
+                bounds,
+                gpui::SharedString::new_static(self.svg),
+                Some(self.svg.as_bytes()),
+                transformation,
+                self.color,
+                cx,
+            )
+            .ok();
+    }
 }
 
