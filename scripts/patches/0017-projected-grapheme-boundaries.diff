diff --git a/crates/base/src/input/projection_layout.rs b/crates/base/src/input/projection_layout.rs
index 925bf03d..d6659ed2 100644
--- a/crates/base/src/input/projection_layout.rs
+++ b/crates/base/src/input/projection_layout.rs
@@ -94,10 +94,206 @@ pub(super) fn clip_hit_offset(
     None
 }
 
+/// One logical line's grapheme boundaries, owned only during projected wrapping.
+/// Keep single hit tests on clip_hit_offset; this table serves repeated queries.
+struct GraphemeBoundaryTable<'a> {
+    text: &'a str,
+    boundaries: Vec<usize>,
+    #[cfg(test)]
+    work: std::cell::Cell<usize>,
+}
+
+impl<'a> GraphemeBoundaryTable<'a> {
+    fn new(text: &'a str) -> Self {
+        use unicode_segmentation::UnicodeSegmentation;
+        #[cfg(test)]
+        let mut work = 0;
+        let boundaries = text
+            .grapheme_indices(true)
+            .map(|(offset, _)| {
+                #[cfg(test)]
+                {
+                    work += 1;
+                }
+                offset
+            })
+            .chain(std::iter::once(text.len()))
+            .collect();
+        Self {
+            text,
+            boundaries,
+            #[cfg(test)]
+            work: std::cell::Cell::new(work),
+        }
+    }
+
+    fn clip(&self, offset: usize, bias: super::projection::ConcealBias) -> Option<usize> {
+        use super::projection::ConcealBias;
+        if offset > self.text.len() {
+            return None;
+        }
+        if offset > 0
+            && self.text.as_bytes().get(offset - 1) == Some(&b'\r')
+            && self.text.as_bytes().get(offset) == Some(&b'\n')
+        {
+            return Some(offset - 1);
+        }
+        let next = self.boundaries.partition_point(|boundary| {
+            #[cfg(test)]
+            self.work.set(self.work.get() + 1);
+            *boundary < offset
+        });
+        let boundary = *self.boundaries.get(next)?;
+        if boundary == offset || bias == ConcealBias::Right {
+            Some(boundary)
+        } else {
+            self.boundaries.get(next.checked_sub(1)?).copied()
+        }
+    }
+}
+
+pub(super) fn projected_wrap_ranges(
+    line: &str,
+    boundaries: impl IntoIterator<Item = usize>,
+) -> smallvec::SmallVec<[Range<usize>; 1]> {
+    use super::projection::ConcealBias;
+    let mut boundaries = boundaries.into_iter().peekable();
+    // No segmentation/allocation is needed when shape_text did not wrap.
+    if boundaries.peek().is_none() {
+        return smallvec::smallvec![0..line.len()];
+    }
+    let table = GraphemeBoundaryTable::new(line);
+    let mut ranges = smallvec::SmallVec::new();
+    let mut previous = 0;
+    for raw_index in boundaries {
+        let mut index = table
+            .clip(raw_index, ConcealBias::Left)
+            .expect("shaped boundary is inside its text");
+        if index <= previous {
+            index = table
+                .clip(raw_index, ConcealBias::Right)
+                .expect("shaped boundary is inside its text");
+        }
+        if index > previous {
+            ranges.push(previous..index);
+            previous = index;
+        }
+    }
+    if previous < line.len() || ranges.is_empty() {
+        ranges.push(previous..line.len());
+    }
+    ranges
+}
