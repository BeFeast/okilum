 #[cfg(test)]
 mod tests {
     use super::*;
     use crate::input::projection::ConcealBias;
+
+    #[test]
+    fn grapheme_table_matches_original_at_every_byte_and_both_biases() {
+        for text in [
+            "",
+            "ascii",
+            "\r",
+            "\n",
+            "\r\n",
+            "a\r\nb\n",
+            "e\u{301}",
+            "אבג عربي",
+            "👩\u{200d}💻🇮🇱\u{200b}",
+            "\u{feff}\tक्\u{200d}ष\r\n",
+        ] {
+            let table = GraphemeBoundaryTable::new(text);
+            // Includes offsets inside UTF-8 scalars, not only char boundaries.
+            for offset in (0..=text.len() + 2).chain([usize::MAX]) {
+                for bias in [ConcealBias::Left, ConcealBias::Right] {
+                    assert_eq!(
+                        table.clip(offset, bias),
+                        clip_hit_offset(text, offset, bias),
+                        "text={text:?}, offset={offset}, bias={bias:?}"
+                    );
+                }
+            }
+        }
+    }
+
+    fn original_ranges(line: &str, boundaries: &[usize]) -> Vec<Range<usize>> {
+        let mut ranges = Vec::new();
+        let mut previous = 0;
+        for &raw in boundaries {
+            let mut index = clip_hit_offset(line, raw, ConcealBias::Left).unwrap();
+            if index <= previous {
+                index = clip_hit_offset(line, raw, ConcealBias::Right).unwrap();
+            }
+            if index > previous {
+                ranges.push(previous..index);
+                previous = index;
+            }
+        }
+        if previous < line.len() || ranges.is_empty() {
+            ranges.push(previous..line.len());
+        }
+        ranges
+    }
+
+    #[test]
+    fn projected_ranges_match_original_for_repeated_reversed_and_empty_boundaries() {
+        for line in [
+            "",
+            "plain text",
+            "a\r\nb",
+            "e\u{301}👩\u{200d}💻אבג",
+            "\u{feff}\t🇮🇱\r\n",
+        ] {
+            let increasing: Vec<_> = (0..=line.len()).collect();
+            let reversed: Vec<_> = increasing.iter().copied().rev().collect();
+            let duplicate: Vec<_> = increasing
+                .iter()
+                .flat_map(|offset| [*offset, *offset])
+                .collect();
+            for boundaries in [
+                vec![],
+                vec![0],
+                vec![line.len()],
+                increasing,
+                reversed,
+                duplicate,
+            ] {
+                assert_eq!(
+                    projected_wrap_ranges(line, boundaries.iter().copied()).as_slice(),
+                    original_ranges(line, &boundaries),
+                    "line={line:?}, boundaries={boundaries:?}"
+                );
+            }
+        }
+        // Retain the invariant failure for impossible shaped byte offsets.
+        assert!(std::panic::catch_unwind(|| projected_wrap_ranges("x", [2])).is_err());
+    }
+
+    #[test]
+    fn grapheme_table_work_does_not_rescan_prefixes_for_each_wrap() {
+        let work = |len: usize| {
+            let text = "x".repeat(len);
+            let table = GraphemeBoundaryTable::new(&text);
+            for offset in (0..=len).step_by(64) {
+                for bias in [ConcealBias::Left, ConcealBias::Right] {
+                    assert_eq!(table.clip(offset, bias), Some(offset));
+                }
+            }
+            table.work.get()
+        };
+        let small = work(4096);
+        let large = work(16384);
+        assert!(
+            large < small * 5,
+            "four times the line must not cause sixteen times the work: {small} -> {large}"
+        );
+        assert!(
+            large < 16384 * 2,
+            "count segmentation yields and actual lookup comparisons: {large}"
+        );
+    }
