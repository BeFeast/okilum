+/// Apply an outer block-level inline HTML mark (`<del>`, `<mark>`,
+/// `<span style="color:…">`, ...) to every inline run in `paragraph`, keeping
+/// inner marks on top so nested colours or links win.
+fn apply_mark_to_paragraph(paragraph: &mut Paragraph, mark: &TextMark) {
+    for node in &mut paragraph.children {
+        if let Some(image) = &mut node.image {
+            if image.link.is_none()
+                && let Some(link) = &mark.link
+            {
+                image.link = Some(link.clone());
+            }
+            continue;
+        }
+        if node.text.is_empty() {
+            continue;
+        }
+        let len = node.text.len();
+        if node.marks.len() == 1
+            && node.marks[0].0.start == 0
+            && node.marks[0].0.end == len
+        {
+            let mut combined = mark.clone();
+            combined.merge(node.marks[0].1.clone());
+            node.marks[0].1 = combined;
+        } else {
+            node.marks.insert(0, (0..len, mark.clone()));
+        }
+    }
+}
+
+fn apply_mark_to_block(block: &mut BlockNode, mark: &TextMark) {
+    match block {
+        BlockNode::Root { children, .. }
+        | BlockNode::Blockquote { children, .. }
+        | BlockNode::List { children, .. }
+        | BlockNode::ListItem { children, .. } => {
+            for child in children {
+                apply_mark_to_block(child, mark);
+            }
+        }
+        BlockNode::Paragraph(paragraph) | BlockNode::Heading { children: paragraph, .. } => {
+            apply_mark_to_paragraph(paragraph, mark);
+        }
+        BlockNode::Table(table) => {
+            for row in &mut table.children {
+                for cell in &mut row.children {
+                    apply_mark_to_paragraph(&mut cell.children, mark);
+                }
+            }
+        }
+        _ => {}
+    }
+}
