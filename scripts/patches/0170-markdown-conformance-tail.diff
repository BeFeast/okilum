+fn has_unquoted_gt(s: &str) -> bool {
+    let mut quote: Option<u8> = None;
+    for b in s.bytes() {
+        match quote {
+            Some(q) if b == q => quote = None,
+            Some(_) => {}
+            None if b == b'"' || b == b'\'' => quote = Some(b),
+            None if b == b'>' => return true,
+            None => {}
+        }
+    }
+    false
+}
