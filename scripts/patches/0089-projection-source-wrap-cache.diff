+            state.display_map.take_edit_reshape();
+            state.replace_text_in_range(Some(0..0), "x", window, cx);
+            assert_eq!(state.display_map.take_edit_reshape().1, 1,
+                "one-line input must not restore the whole source wrap");
+            assert_eq!(state.value().as_ref(), format!("x{original}"));
+        }));
+        v.run_until_parked();
