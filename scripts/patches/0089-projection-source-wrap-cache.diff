+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            state.set_value(original.clone(), window, cx);
+            state.set_projection_provider(Some(Arc::new(ScaledLineProvider { hang: 0 })), cx);
+            window.activate_window();
+            state.focus(window, cx);
+        }));
