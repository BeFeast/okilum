+    #[gpui::test]
+    fn projection_source_wrap_cache_tracks_layout_and_document_reset(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        let view = InputView::build_editor(cx, |state| state.folding(false).searchable(false)
+            .wrapping_indent(super::super::WrappingIndent::None));
+        let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            let text = Rope::from("body words wrap over several rows\n## heading words\n  - list words\nעברית\n");
+            state.set_value(text.to_string(), window, cx);
+            state.set_projection_provider(Some(Arc::new(ScaledLineProvider { hang: 0 })), cx);
+            let font = gpui::font("sans-serif");
+            let mut map = DisplayMap::new(font.clone(), px(16.), Some(px(90.)));
+            map.set_wrapping_indent(super::super::WrappingIndent::None, cx);
+            map.ensure_text_prepared(&text, cx);
+            map.install_projection(state.projection.pin(), &text, window, cx);
+            // Resizing/zoom and indent changes while projected must update the
+            // saved plain map too; its rows must match a fresh Source layout.
+            map.on_layout_changed(Some(px(140.)), cx);
+            map.set_font(font.clone(), px(18.), cx);
+            map.set_wrapping_indent(super::super::WrappingIndent::Same, cx);
+            assert_eq!(map.install_projection(None, &text, window, cx), 0,
+                "returning to Source reuses its metric-current map");
+            let mut fresh = DisplayMap::new(font.clone(), px(18.), Some(px(140.)));
+            fresh.ensure_text_prepared(&text, cx);
+            for (offset, _) in text.to_string().char_indices() {
+                assert_eq!(map.offset_to_wrap_display_point(offset),
+                    fresh.offset_to_wrap_display_point(offset));
+            }
+            map.install_projection(state.projection.pin(), &text, window, cx);
+            let replacement = Rope::from("another document\nshort\n");
+            // Native document replacement uses on_text_changed with the full
+            // previous source range (the same path as set_value/replace_all).
+            map.on_text_changed(&replacement, &(0..text.len()), &replacement, cx);
+            let mut fresh = DisplayMap::new(font, px(18.), Some(px(140.)));
+            fresh.ensure_text_prepared(&replacement, cx);
+            for (offset, _) in replacement.to_string().char_indices() {
+                assert_eq!(map.offset_to_wrap_display_point(offset),
+                    fresh.offset_to_wrap_display_point(offset),
+                    "a document reset cannot retain the old source map");
+            }
+        }));
+    }
