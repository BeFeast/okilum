+
+    /// Restore a prepared document before its first layout, without painting
+    /// the top first. The host must wait for successful preparation.
+    pub fn scroll_to_prepared_position(
+        &mut self,
+        mut position: gpui::ListOffset,
+        cx: &mut Context<Self>,
+    ) -> bool {
+        if !matches!(self.preparation_status(), Some(Ok(()))) {
+            return false;
+        }
+        let count = self.parsed_content.document.blocks.len();
+        if self.list_state.item_count() != count {
+            self.list_state.reset(count);
+        }
+        if position.item_ix >= count {
+            position.item_ix = count.saturating_sub(1);
+            position.offset_in_item = px(0.);
+        }
+        self.list_state.scroll_to(position);
+        cx.notify();
+        true
     }
 
