+/// Probe and cache whether `(font, font_size)` renders every printable ASCII
+/// character with one uniform cell width and no fallback font.
+pub(crate) fn monospace_ascii_cell_width(
+    window: &mut Window,
+    font: &Font,
+    font_size: Pixels,
+) -> Option<Pixels> {
+    thread_local! {
+        static CACHE: RefCell<HashMap<(gpui::FontId, u32, u32), Option<Pixels>>> =
+            RefCell::new(HashMap::new());
+    }
+    let font_id = window.text_system().resolve_font(font);
+    let key = (
+        font_id,
+        f32::from(font_size).to_bits(),
+        window.scale_factor().to_bits(),
+    );
+    if let Some(cached) = CACHE.with(|cache| cache.borrow().get(&key).copied()) {
+        return cached;
+    }
+    let measure = |text: &str, window: &mut Window| {
+        let run = TextRun {
+            len: text.len(),
+            font: font.clone(),
+            color: gpui::black(),
+            background_color: None,
+            underline: None,
+            strikethrough: None,
+        };
+        window
+            .text_system()
+            .shape_line(SharedString::from(text.to_owned()), font_size, &[run], None)
+    };
+    let mut cell_width: Option<Pixels> = None;
+    let mut resolved_font: Option<gpui::FontId> = None;
+    let mut ok = true;
+    for byte in b' '..=b'~' {
+        let buf = [byte];
+        let s = std::str::from_utf8(&buf).unwrap();
+        let shaped = measure(s, window);
+        if shaped.runs.len() != 1
+            || shaped.runs[0].glyphs.len() != 1
+            || shaped.width <= px(0.)
+        {
+            ok = false;
+            break;
+        }
+        let run_font = shaped.runs[0].font_id;
+        match (cell_width, resolved_font) {
+            (None, None) => {
+                cell_width = Some(shaped.width);
+                resolved_font = Some(run_font);
+            }
+            (Some(w), Some(f)) if (w - shaped.width).abs() <= px(0.005) && f == run_font => {}
+            _ => {
+                ok = false;
+                break;
+            }
+        }
+    }
+    let verified = if ok {
+        cell_width.filter(|&w| {
+            let eps = px(0.01);
+            let pair = measure("aa", window);
+            let punct = measure("{}[],:\"", window);
+            pair.runs.len() == 1
+                && pair.runs[0].glyphs.len() == 2
+                && (pair.runs[0].glyphs[1].position.x - w).abs() <= eps
+                && (pair.width - w * 2.).abs() <= eps
+                && punct.runs.len() == 1
+                && (punct.width - w * 7.).abs() <= eps
+        })
+    } else {
+        None
+    };
+    CACHE.with(|cache| {
+        let mut cache = cache.borrow_mut();
+        if cache.len() >= 128 {
+            cache.clear();
+        }
+        cache.insert(key, verified);
+    });
+    verified
+}
