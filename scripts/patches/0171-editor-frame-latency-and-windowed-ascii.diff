+/// Viewport-windowed layout for a huge unwrapped printable-ASCII row in a
+/// verified monospace font (#2803). Avoids materializing or shaping megabytes
+/// of offscreen text on the UI thread while shaping the visible slice natively.
+#[derive(Clone)]
+pub(crate) struct WindowedMonospaceAscii {
+    rope: Rope,
+    line_start: usize,
+    len: usize,
+    cell_width: Pixels,
+    font_size: Pixels,
+    run: TextRun,
+    window: Rc<RefCell<Option<(usize, ShapedLine)>>>,
+}
+
+impl WindowedMonospaceAscii {
+    pub(crate) fn new(
+        rope: Rope,
+        line_start: usize,
+        len: usize,
+        cell_width: Pixels,
+        font_size: Pixels,
+        run: TextRun,
+    ) -> Self {
+        Self {
+            rope,
+            line_start,
+            len,
+            cell_width,
+            font_size,
+            run,
+            window: Rc::new(RefCell::new(None)),
+        }
+    }
+
+    #[inline]
+    pub(crate) fn width(&self) -> Pixels {
+        self.cell_width * (self.len as f32)
+    }
+
+    fn matches(&self, font_size: Pixels, text: ropey::RopeSlice<'_>) -> bool {
+        self.font_size == font_size
+            && self.len == text.len()
+            && self.rope.slice(self.line_start..self.line_start + self.len) == text
+    }
+
+    fn x_for_index(&self, index: usize) -> Pixels {
+        let index = index.min(self.len);
+        if let Some((start, shaped)) = self.window.borrow().as_ref() {
+            if index >= *start && index <= start + shaped.len {
+                return self.cell_width * (*start as f32) + shaped.x_for_index(index - start);
+            }
+        }
+        self.cell_width * (index as f32)
+    }
+
+    fn closest_index_for_x(&self, x: Pixels) -> usize {
+        if x <= px(0.) {
+            return 0;
+        }
+        if let Some((start, shaped)) = self.window.borrow().as_ref() {
+            let slice_x = self.cell_width * (*start as f32);
+            if x >= slice_x && x <= slice_x + shaped.width {
+                return start + shaped.closest_index_for_x(x - slice_x);
+            }
+        }
+        let cell = f32::from(self.cell_width);
+        if cell <= 0. {
+            return 0;
+        }
+        ((f32::from(x) / cell).round() as usize).min(self.len)
+    }
+
+    fn index_for_x(&self, x: Pixels) -> Option<usize> {
+        if x < px(0.) || x >= self.width() {
+            return None;
+        }
+        if let Some((start, shaped)) = self.window.borrow().as_ref() {
+            let slice_x = self.cell_width * (*start as f32);
+            if x >= slice_x && x < slice_x + shaped.width {
+                return shaped.index_for_x(x - slice_x).map(|i| start + i);
+            }
+        }
+        let cell = f32::from(self.cell_width);
+        if cell <= 0. {
+            return None;
+        }
+        Some(((f32::from(x) / cell).floor() as usize).min(self.len.saturating_sub(1)))
+    }
+
+    fn shape_window(
+        &self,
+        vis_start: usize,
+        vis_end: usize,
+        window: &mut Window,
+    ) -> (usize, ShapedLine) {
+        let vis_start = vis_start.min(self.len);
+        let vis_end = vis_end.min(self.len);
+        if let Some((start, shaped)) = self.window.borrow().as_ref() {
+            if *start <= vis_start && vis_end <= start + shaped.len {
+                return (*start, shaped.clone());
+            }
+        }
+        let mut start = vis_start.saturating_sub(64);
+        let mut end = (vis_end + 64).min(self.len);
+        let mut step = 0;
+        while start > 0
+            && step < 16
+            && self
+                .rope
+                .byte(self.line_start + start - 1)
+                .is_ascii_punctuation()
+        {
+            start -= 1;
+            step += 1;
+        }
+        let mut step = 0;
+        while end < self.len
+            && step < 16
+            && self.rope.byte(self.line_start + end).is_ascii_punctuation()
+        {
+            end += 1;
+            step += 1;
+        }
+        let slice: SharedString = self
+            .rope
+            .slice(self.line_start + start..self.line_start + end)
+            .to_string()
+            .into();
+        let mut run = self.run.clone();
+        run.len = slice.len();
+        let shaped = window
+            .text_system()
+            .shape_line(slice, self.font_size, &[run], None);
+        *self.window.borrow_mut() = Some((start, shaped.clone()));
+        (start, shaped)
+    }
+
+    fn visible_slice(&self, origin_x: Pixels, window: &mut Window) -> Option<(usize, ShapedLine)> {
+        let cell = f32::from(self.cell_width);
+        if cell <= 0. || self.len == 0 {
+            return None;
+        }
+        let mask = window.content_mask().bounds;
+        let left_px = (mask.left() - origin_x).max(px(0.));
+        let right_px = (mask.right() - origin_x).max(px(0.));
+        if right_px <= px(0.) {
+            return None;
+        }
+        let vis_start = ((f32::from(left_px) / cell).floor() as usize)
+            .saturating_sub(8)
+            .min(self.len);
+        let vis_end = (((f32::from(right_px) / cell).ceil() as usize) + 8).min(self.len);
+        if vis_start >= vis_end {
+            return None;
+        }
+        Some(self.shape_window(vis_start, vis_end, window))
+    }
+}
