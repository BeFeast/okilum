+    #[gpui::test]
+    fn projection_mouse_lease_releases_after_multi_click_window(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        let executor = cx.executor();
+        let view = InputView::build_editor(cx, |state| state.folding(false).searchable(false)
+            .wrapping_indent(super::super::WrappingIndent::None));
+        let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            state.set_value("plain\n**bold\ntail", window, cx);
+            state.set_projection_provider(Some(Arc::new(PrefixRevealProvider)), cx);
+            window.activate_window();
+            state.focus(window, cx);
+        }));
+        v.run_until_parked();
+        let shown = |state: &InputBaseState<EditorMode>| {
+            state.projection.current.as_ref().unwrap().text().to_owned()
+        };
+        let up = |position, click_count| MouseUpEvent {
+            button: MouseButton::Left,
+            position,
+            modifiers: Default::default(),
+            click_count,
+        };
+        let step = PROJECTION_MOUSE_LEASE / 5;
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            assert!(!shown(state).contains("**"));
+            // A click on the `**bold` line, as on_mouse_down leaves it.
+            state.selecting = true;
+            state.projection_mouse_hold = true;
+            state.move_to(9, None, cx);
+            state.on_mouse_up(&up(Point::default(), 1), window, cx);
+            assert!(state.projection_mouse_hold);
+            assert!(!shown(state).contains("**"), "release alone keeps the painted geometry");
+        }));
+        executor.advance_clock(step * 4);
+        v.run_until_parked();
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            assert!(state.projection_mouse_hold, "a second click may still follow");
+            assert!(!shown(state).contains("**"));
+            // The second press of a double click starts a new lease.
+            let origin = state.last_bounds.unwrap().origin + point(px(2.), px(2.));
+            let down = MouseDownEvent {
+                button: MouseButton::Left,
+                position: origin,
+                modifiers: Default::default(),
+                click_count: 2,
+                first_mouse: false,
+            };
+            state.on_mouse_down(&down, window, cx);
+            state.on_mouse_up(&up(origin, 2), window, cx);
+            assert!(state.projection_mouse_hold);
+        }));
+        executor.advance_clock(step * 2);
+        v.run_until_parked();
+        v.update(|_, cx| view.input.update(cx, |state, _| {
+            assert!(state.projection_mouse_hold, "the first release no longer counts");
+        }));
+        executor.advance_clock(step * 4);
+        v.run_until_parked();
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            assert!(!state.projection_mouse_hold);
+            // Positive control for the reveal itself: a settled caret on the
+            // marker line recomposes with the marker shown.
+            state.selecting = true;
+            state.projection_mouse_hold = true;
+            state.move_to(9, None, cx);
+            state.on_mouse_up(&up(Point::default(), 1), window, cx);
+            assert!(!shown(state).contains("**"));
+        }));
+        executor.advance_clock(PROJECTION_MOUSE_LEASE);
+        v.run_until_parked();
+        v.update(|_, cx| view.input.update(cx, |state, _| {
+            assert!(!state.projection_mouse_hold);
+            assert_eq!(shown(state), state.value().as_str());
+        }));
+    }
