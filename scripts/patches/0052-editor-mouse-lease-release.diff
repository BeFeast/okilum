+    /// The lease outlives the platform multi-click window, so a double or triple
+    /// click hits the geometry its first press saw. After that a settled mouse
+    /// caret or selection reveals source like a keyboard move.
+    pub(super) fn schedule_projection_lease_release(&mut self, cx: &mut Context<Self>) {
+        if !self.projection_mouse_hold {
+            self.projection_lease_release = None;
+            return;
+        }
+        self.projection_lease_release = Some(cx.spawn(async move |this, cx| {
+            cx.background_executor().timer(PROJECTION_MOUSE_LEASE).await;
+            let _ = this.update(cx, |state, cx| state.release_projection_mouse_lease(cx));
+        }));
+    }
+
+    fn release_projection_mouse_lease(&mut self, cx: &mut Context<Self>) {
+        self.projection_lease_release = None;
+        if self.selecting || !self.projection_mouse_hold {
+            return;
+        }
+        self.projection_mouse_hold = false;
+        self.projection.presentation_changed();
+        self.refresh_projection();
+        cx.notify();
+    }
