+    /// Pin the actual match through a presentation handoff. Uses the painted
+    /// source-to-display map; no source edit, caret move or Undo transaction.
+    pub(super) fn preserve_search_match_anchor(&mut self) {
+        let Some(last) = self.last_layout.as_ref()
+            .filter(|last| last.source_stamp == self.source_stamp()) else { return; };
+        let matcher = &self.search_session.matcher;
+        let Some(range) = matcher.matched_ranges().get(matcher.current_match_index()).cloned() else { return; };
+        let row = self.display_map.offset_to_wrap_display_point_with_affinity(range.start, false).row;
+        let y = last.rows.row_top(row);
+        let screen_y = y + self.scroll_handle.offset().y;
+        if screen_y >= gpui::px(0.) && screen_y + last.rows.row_height(row) <= self.input_bounds.size.height {
+            self.zoom_anchor = Some((range.start, y, false));
+            // Find owns this presentation handoff even if typewriter had been
+            // following the editing caret. An edit/caret move resumes it.
+            self.typewriter_paused = true;
+        }
+    }
+
     pub fn close_search(&mut self, cx: &mut Context<Self>) {
+        if self.search_session.open {
+            self.search_return = Some((self.source_stamp(), self.selected_range()));
+        }
         self.search_session.close();
         cx.notify();
     }
