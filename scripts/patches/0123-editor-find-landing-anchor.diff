diff --git a/crates/base/src/input/editor/search.rs b/crates/base/src/input/editor/search.rs
--- a/crates/base/src/input/editor/search.rs
+++ b/crates/base/src/input/editor/search.rs
@@ -133,7 +133,28 @@
