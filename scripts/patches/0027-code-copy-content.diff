+/// mdast preserves content bytes (including CRLF and code indentation), but
+/// removes one terminal line ending. Restore that ending from the parsed span;
+/// Markdown container indentation is already excluded by the parser.
+fn exact_code_content(source: &str, code: &mdast::Code) -> String {
+    let mut value = code.value.clone();
+    let Some(position) = &code.position else {
+        return value;
+    };
+    let start = position.start.offset;
+    let end = position.end.offset;
+    let Some(raw) = source.get(start..end) else {
+        return value;
+    };
+    let first = raw.trim_start_matches(' ');
+    let fenced =
+        raw.len() - first.len() < 4 && (first.starts_with("```") || first.starts_with("~~~"));
+    let suffix_eol = |text: &str| {
+        if text.ends_with("\r\n") {
+            "\r\n"
+        } else if text.ends_with('\n') {
+            "\n"
+        } else if text.ends_with('\r') {
+            "\r"
+        } else {
+            ""
+        }
+    };
+    let after = &source[end..];
+    let following_eol = if after.starts_with("\r\n") {
+        "\r\n"
+    } else if after.starts_with('\n') {
+        "\n"
+    } else if after.starts_with('\r') {
+        "\r"
+    } else {
+        ""
+    };
+    let ending = if fenced {
+        let lines = position.end.line - position.start.line;
+        // An empty fence or an opener alone has no content line ending.
+        if value.is_empty() && lines <= 1 {
+            return value;
+        }
+        let terminal = suffix_eol(raw);
+        if !terminal.is_empty() {
+            // Unclosed fence reaching EOF, including its final newline.
+            terminal
+        } else {
+            let breaks = value.bytes().filter(|b| *b == b'\n').count()
+                + value
+                    .as_bytes()
+                    .iter()
+                    .enumerate()
+                    .filter(|(i, b)| **b == b'\r' && value.as_bytes().get(i + 1) != Some(&b'\n'))
+                    .count();
+            if lines >= breaks + 2 {
+                // Closed fence: restore the ending immediately before its line,
+                // never the ending after the closing delimiter.
+                let boundary = raw.rfind(['\r', '\n']).map(|i| i + 1).unwrap_or(0);
+                suffix_eol(&raw[..boundary])
+            } else {
+                following_eol
+            }
+        }
+    } else {
+        let terminal = suffix_eol(raw);
+        if terminal.is_empty() {
+            following_eol
+        } else {
+            terminal
+        }
+    };
+    value.push_str(ending);
+    value
+}
