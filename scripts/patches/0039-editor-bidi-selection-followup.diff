+#[cfg(test)]
+mod boundary_extension_tests {
+    use super::*;
+    #[test]
+    fn shift_entry_anchors_to_the_crossed_cluster() {
+        let map = Geometry {
+            cells: [
+                (0..1, false),
+                (1..2, false),
+                (2..3, false),
+                (3..4, false),
+                (10..12, true),
+                (8..10, true),
+                (6..8, true),
+                (4..6, true),
+                (12..13, false),
+                (13..14, false),
+            ]
+            .into_iter()
+            .enumerate()
+            .map(|(i, (source, rtl))| Cell {
+                source,
+                rtl,
+                left: gpui::px(i as f32 * 10.),
+                right: gpui::px((i + 1) as f32 * 10.),
+            })
+            .collect(),
+        };
+        for (caret, right, expected) in [
+            (
+                Caret {
+                    index: 4,
+                    affinity: Affinity::After,
+                },
+                true,
+                10..12,
+            ),
+            (
+                Caret {
+                    index: 12,
+                    affinity: Affinity::Before,
+                },
+                false,
+                4..6,
+            ),
+        ] {
+            let head = map.step(caret, right).unwrap();
+            let anchor = map.step(head, !right).unwrap();
+            assert_eq!(
+                anchor.index.min(head.index)..anchor.index.max(head.index),
+                expected
+            );
+            assert_eq!(map.position(anchor), map.position(caret));
+        }
+    }
+}
