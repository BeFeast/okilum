+#[cfg(test)]
+mod hebrew_tests {
+    #[test]
+    fn hebrew_word_and_niqqud_preserve_byte_ranges() {
+        for word in ["שלום", "שָׁלוֹם"] {
+            let text = format!("abc {word} xyz");
+            for (offset, _) in word.char_indices() {
+                assert_eq!(
+                    super::word_range_at(&text, 4 + offset),
+                    Some(4..4 + word.len())
+                );
+            }
+        }
+        assert_eq!(super::word_range_at("abc שלום xyz", 1), Some(0..3));
+    }
