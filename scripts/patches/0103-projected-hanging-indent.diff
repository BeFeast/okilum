+/// A projected line whose soft-wrapped continuation rows start under the
+/// first byte after `prefix`: a list, task or quote prefix forms a gutter,
+/// and wrapped rows of the item align with its text (#1641). The prefix must
+/// not be concealed by a reveal, so entering or leaving the line keeps the
+/// rows where they are.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct LineIndent {
+    /// Line index in the projected text.
+    pub line: usize,
+    /// Projected bytes at the start of the line before its text.
+    pub prefix: usize,
+}
+
+/// The continuation indent prefix of projected `line`, in bytes; 0 for none.
+pub fn line_indent(indents: &[LineIndent], line: usize) -> usize {
+    indents.binary_search_by_key(&line, |i| i.line).map_or(0, |ix| indents[ix].prefix)
+}
