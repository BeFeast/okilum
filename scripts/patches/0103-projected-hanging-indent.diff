+    /// #1641: wrapped rows of a list item or quote start under the item's
+    /// text, caret movement and clicks follow them, and every wrapped quote
+    /// row carries its bar in the gutter. Without indents (the control) rows
+    /// start at the line start and carry no bar.
+    #[gpui::test]
+    fn hanging_indent_aligns_wrapped_item_rows_under_their_text(cx: &mut TestAppContext) {
+        cx.update(crate::init);
+        let words = "wrapped words in a long item line ".repeat(12);
+        let text = format!("- {words}\n> {words}\nend");
+        for indent in [true, false] {
+            let view = InputView::build_editor(cx, |state| {
+                state
+                    .folding(false)
+                    .searchable(false)
+                    .wrapping_indent(super::super::WrappingIndent::None)
+                    .line_number(false)
+            });
+            let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+            let value = text.clone();
+            v.update(|window, cx| {
+                view.input.update(cx, |state, cx| {
+                    state.set_value(value, window, cx);
+                    state.set_projection_provider(Some(Arc::new(IndentProvider { indent })), cx);
+                    window.activate_window();
+                    state.focus(window, cx);
+                })
+            });
+            v.run_until_parked();
+            v.update(|window, cx| {
+                view.input.update(cx, |state, cx| {
+                    let layout = state.last_layout.as_ref().unwrap();
+                    assert!(layout.projection.is_some());
+                    let near = |a: Pixels, b: Pixels| (f32::from(a) - f32::from(b)).abs() < 0.5;
+                    let width = layout.wrap_width.expect("soft wrap");
+                    for line in &layout.lines[..2] {
+                        // Positive control: the item really wraps.
+                        assert!(line.wrapped_lines.len() > 2, "{}", line.wrapped_lines.len());
+                        let text_x = line.wrapped_lines[0].x_for_index(2);
+                        assert!(text_x > px(1.));
+                        let row_start = line.wrapped_lines[0].len();
+                        let first = line.position_for_index(2, layout, false).unwrap();
+                        let second = line.position_for_index(row_start, layout, false).unwrap();
+                        if indent {
+                            assert!(near(line.wrap_indent, text_x), "{:?} {text_x:?}", line.wrap_indent);
+                            assert!(near(second.x, first.x), "{second:?} {first:?}");
+                            for row in &line.wrapped_lines[1..] {
+                                assert!(row.width + line.wrap_indent <= width + px(0.5), "{:?}", row.width);
+                            }
+                            // A click at the text column of a wrapped row hits its start.
+                            let lh = layout.rows.row_height(0);
+                            let (hit, _) = line
+                                .closest_index_for_position(point(text_x + px(0.5), lh * 1.5), layout)
+                                .unwrap();
+                            assert_eq!(hit, row_start);
+                        } else {
+                            assert_eq!(line.wrap_indent, px(0.));
+                            assert!(near(second.x, px(0.)), "{second:?}");
+                        }
+                    }
+                    // Vertical movement from the start of the item's text keeps
+                    // its column: the start of the wrapped row below.
+                    let row_start = layout.lines[0].wrapped_lines[0].len();
+                    state.move_to(2, None, cx);
+                    state.move_vertical(1, window, cx);
+                    if indent {
+                        assert_eq!(state.cursor(), row_start);
+                    } else {
+                        // Control: the wrapped row starts under the marker, so
+                        // the text column lands inside that row.
+                        assert!(state.cursor() > row_start, "{} {row_start}", state.cursor());
+                    }
+                    // The quote bar repeats on every wrapped row of the quote line.
+                    let layout = state.last_layout.as_ref().unwrap();
+                    let cache = std::cell::RefCell::new(None);
+                    let source = crate::input::marker_paint::source_for_markers(
+                        layout.projection.as_ref(),
+                        super::super::projection::LayoutStamp {
+                            source: layout.source_stamp,
+                            presentation: layout.presentation_epoch,
+                        },
+                        state.source_stamp(),
+                        true,
+                        &cache,
+                        |text| state.text == text,
+                    )
+                    .expect("markers");
+                    let active = ActiveSource::default();
+                    let rows = crate::input::marker_paint::prepare(layout, &source, &active);
+                    let quote_rows = &rows[1];
+                    assert!(quote_rows[0].is_some(), "positive control: the first row draws its bar");
+                    for row in &quote_rows[1..] {
+                        let gutters = row.as_ref().map(|row| row.quote_gutters()).unwrap_or_default();
+                        if indent {
+                            assert_eq!(gutters.len(), 1);
+                            assert!(gutters[0] < px(0.), "the bar sits left of the row's text");
+                        } else {
+                            assert!(gutters.is_empty());
+                        }
+                    }
+                })
+            });
+        }
+    }
