+    fn rtl_marker_span_is_one_run_of_whole_cells() {
+        // `- [ ] אב` in an RTL paragraph: the marker sits on the right.
+        let cell = |source: Range<usize>, left: f32, right: f32, rtl: bool| super::Cell {
+            source,
+            left: px(left),
+            right: px(right),
+            rtl,
+        };
+        let geometry = Geometry {
+            cells: vec![
+                cell(8..10, 0., 8., true),
+                cell(6..8, 8., 16., true),
+                cell(5..6, 16., 20., false),
+                cell(0..1, 20., 24., false),
+                cell(1..2, 24., 28., false),
+                cell(2..3, 28., 32., false),
+                cell(3..4, 32., 36., false),
+                cell(4..5, 36., 40., false),
+            ],
+        };
+        assert_eq!(rtl_span(&geometry, &(0..6)), Some(px(16.)..px(40.)));
+        // A range split across cells, or not visually contiguous, stays raw.
+        assert_eq!(rtl_span(&geometry, &(7..8)), None);
+        assert_eq!(rtl_span(&geometry, &(4..9)), None);
+        assert_eq!(rtl_span(&geometry, &(4..8)), None, "two visual runs");
+    }
 }
