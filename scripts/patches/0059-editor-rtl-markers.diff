+/// The visual span of `range` on a right-to-left row, if it is one contiguous
+/// run of whole cells that no other cell overlaps; otherwise the marker stays raw.
+fn rtl_span(geometry: &Geometry, range: &Range<usize>) -> Option<Range<Pixels>> {
+    let cells = &geometry.cells;
+    if !cells.iter().any(|cell| cell.source.start == range.start)
+        || !cells.iter().any(|cell| cell.source.end == range.end)
+        || cells.iter().any(|cell| {
+            (cell.source.start < range.start && cell.source.end > range.start)
+                || (cell.source.start < range.end && cell.source.end > range.end)
+        })
+    {
+        return None;
+    }
+    let [span] = &geometry.selection(range.clone())[..] else {
+        return None;
+    };
+    let span = span.clone();
+    let inside = |cell: &&Cell| range.start <= cell.source.start && cell.source.end <= range.end;
+    cells
+        .iter()
+        .filter(|cell| !inside(cell))
+        .all(|cell| cell.right <= span.start || cell.left >= span.end)
+        .then_some(span)
+}
