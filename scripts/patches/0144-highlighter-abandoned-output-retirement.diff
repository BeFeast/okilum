+type ParsedSyntax = (Tree, Vec<super::highlighter::InjectionLayer>, Vec<FoldRange>);
+
+/// A completed background Task can lose its foreground awaiter before its next
+/// poll. Dropping that Task destroys its stored output on the dropping executor,
+/// so the output itself must hand abandoned syntax to background retirement.
+struct BackgroundParseResult {
+    value: Option<ParsedSyntax>,
+    executor: gpui::BackgroundExecutor,
+}
+
+impl BackgroundParseResult {
+    fn new(value: ParsedSyntax, executor: gpui::BackgroundExecutor) -> Self {
+        #[cfg(test)]
+        COMPLETED_PARSE_OUTPUT.with(|count| count.set((count.get().0 + 1, value.1.len())));
+        Self { value: Some(value), executor }
+    }
+
+    fn into_inner(mut self) -> ParsedSyntax {
+        self.value.take().expect("parse output is consumed once")
+    }
+}
+
+impl Drop for BackgroundParseResult {
+    fn drop(&mut self) {
+        if let Some(value) = self.value.take() {
+            #[cfg(test)]
+            ABANDONED_PARSE_OUTPUTS.with(|count| count.set(count.get() + 1));
+            // No Tree clone, source snapshot, UI entity or publication callback.
+            // Detach cleanup so cancelling the awaiter cannot cancel retirement.
+            self.executor.spawn(async move { drop(value) }).detach();
+        }
+    }
+}
+
