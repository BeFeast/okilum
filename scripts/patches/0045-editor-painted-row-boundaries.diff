+    /// Resolve a Home/End target from the painted row, not a separately wrapped
+    /// display map or its leftmost glyph (which can be the logical end in bidi).
+    fn painted_row_boundary(&self, end: bool) -> Option<(usize, bool, super::bidi_geometry::Affinity)> {
+        // Mask bullets have different UTF-8 lengths from the underlying value.
+        if self.masked { return None; }
+        let last = self.last_layout.as_ref()?;
+        if last.source_stamp != self.source_stamp() { return None; }
+        let displayed = last.project(self.cursor(), ConcealBias::Right)?;
+        for (line, &start) in last.lines.iter().zip(&last.visible_line_byte_offsets) {
+            if displayed >= start && displayed <= start + line.len() {
+                let pos = line.position_for_caret(displayed - start, last,
+                    self.cursor_line_end_affinity, self.cursor_bidi_affinity)?;
+                let (index, wrap, affinity) = line.logical_row_boundary(pos, last, end)?;
+                let bias = if end { ConcealBias::Right } else { ConcealBias::Left };
+                return Some((last.source(start + index, bias)?, wrap, affinity));
+            }
+        }
+        None
+    }
