+    /// Logical bounds of the exact shaped row under the caret. A row beginning
+    /// inside an RTL run may have its source start on the right, not the left.
+    /// Keep both affinities: Before owns the first grapheme; After owns the last,
+    /// while wrap affinity keeps a shared end offset on this row.
+    pub(crate) fn logical_row_boundary(&self, pos: Point<Pixels>, last: &LastLayout,
+        end: bool) -> Option<(usize, bool, Affinity)> {
+        let (row, start, _) = self.wrapped_line_at(pos, last)?;
+        let line = &self.wrapped_lines[row];
+        Some(if end {
+            (start + line.len, row + 1 < self.wrapped_lines.len(), Affinity::After)
+        } else {
+            (start, false, Affinity::Before)
+        })
+    }
