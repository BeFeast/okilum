+    #[test]
+    fn long_ascii_caret_lookups_bisect_to_gpui_answers() {
+        // Uneven advances, a two-byte ligature cluster and a trailing space.
+        let mut line = ShapedLine::default();
+        line.text = "a!=b ".repeat(16 * 1024).into();
+        let mut x = 0f32;
+        let mut glyphs = Vec::new();
+        let bytes = line.text.as_bytes();
+        let mut index = 0;
+        while index < bytes.len() {
+            let ligature = bytes[index] == b'!';
+            glyphs.push(gpui::ShapedGlyph {
+                index,
+                id: gpui::GlyphId(bytes[index] as u32),
+                position: point(px(x), px(0.)),
+                is_emoji: false,
+            });
+            x += if ligature { 15.25 } else { 7.625 };
+            index += if ligature { 2 } else { 1 };
+        }
+        *line = std::sync::Arc::new(gpui::LineLayout {
+            len: line.text.len(),
+            width: px(x),
+            runs: vec![gpui::ShapedRun { font_id: gpui::FontId(0), glyphs }],
+            ..Default::default()
+        });
+        assert!(long_ascii_glyphs(&line).is_some(), "positive control: bisection applies");
+        let len = line.len;
+        for index in [0, 1, 2, 3, 4, 5, len / 2, len / 2 + 2, len - 3, len - 1, len, len + 1] {
+            assert_eq!(row_x_for_index(&line, index), line.x_for_index(index), "x for {index}");
+        }
+        let width = line.width;
+        for x in [px(-3.), px(0.), px(3.8), px(7.625), px(11.), px(22.875), width / 2.,
+            width / 2. + px(0.3), width - px(1.), width, width + px(5.)] {
+            assert_eq!(row_closest_index_for_x(&line, x), line.closest_index_for_x(x), "closest at {x:?}");
+            assert_eq!(row_index_for_x(&line, x), line.index_for_x(x), "index at {x:?}");
+        }
+        // Short or non-ASCII rows keep GPUI's own scans.
+        line.text = format!("{}ש", line.text).into();
+        assert!(long_ascii_glyphs(&line).is_none());
+    }
+
