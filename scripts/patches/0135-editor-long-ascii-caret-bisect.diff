+/// GPUI's caret lookups visit glyphs from the start of the row: milliseconds
+/// per call far into a multi-MB minified line, several calls per keystroke
+/// (#2803). An ASCII row is left to right, its glyph indices and positions
+/// never decrease, so bisection gives the same answers.
+fn long_ascii_glyphs(line: &ShapedLine) -> Option<&[gpui::ShapedGlyph]> {
+    (line.len >= 64 * 1024 && line.runs.len() == 1 && line.text.is_ascii())
+        .then(|| line.runs[0].glyphs.as_slice())
+}
+
+/// `ShapedLine::x_for_index`, bisecting long ASCII rows.
+fn row_x_for_index(line: &ShapedLine, index: usize) -> Pixels {
+    match long_ascii_glyphs(line) {
+        Some(glyphs) => glyphs
+            .get(glyphs.partition_point(|g| g.index < index))
+            .map_or(line.width, |g| g.position.x),
+        None => line.x_for_index(index),
+    }
+}
+
+/// `ShapedLine::closest_index_for_x`, bisecting long ASCII rows.
+fn row_closest_index_for_x(line: &ShapedLine, x: Pixels) -> usize {
+    let Some(glyphs) = long_ascii_glyphs(line) else {
+        return line.closest_index_for_x(x);
+    };
+    let at = glyphs.partition_point(|g| g.position.x < x);
+    let Some(glyph) = glyphs.get(at) else {
+        return line.len;
+    };
+    let (prev_index, prev_x) = at
+        .checked_sub(1)
+        .map_or((0, px(0.)), |prev| (glyphs[prev].index, glyphs[prev].position.x));
+    if glyph.position.x - x < x - prev_x { glyph.index } else { prev_index }
+}
+
+/// `ShapedLine::index_for_x`, bisecting long ASCII rows.
+fn row_index_for_x(line: &ShapedLine, x: Pixels) -> Option<usize> {
+    let Some(glyphs) = long_ascii_glyphs(line) else {
+        return line.index_for_x(x);
+    };
+    if x >= line.width {
+        return None;
+    }
+    let at = glyphs.partition_point(|g| g.position.x <= x);
+    Some(at.checked_sub(1).map_or(0, |at| glyphs[at].index))
+}
