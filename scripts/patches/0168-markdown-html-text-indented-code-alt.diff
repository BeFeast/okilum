+/// The alt text of an image whose description holds another image
+/// (`![foo ![bar](/url)](/url2)` has the alt `foo bar`).
+///
+/// mdast flattens an image description to plain text, where a nested image
+/// contributes nothing. The description is parsed again as a link, from the
+/// image's source span, and its text taken with every nested image's alt.
+fn restore_nested_image_alt(node: &mut Node, source: &str, options: &markdown::ParseOptions) {
+    if let Node::Image(image) = node {
+        if let Some(alt) = nested_image_alt(source, image, options) {
+            image.alt = alt;
+        }
+        return;
+    }
+    if let Some(children) = node.children_mut() {
+        for child in children {
+            restore_nested_image_alt(child, source, options);
+        }
+    }
+}
+
+fn nested_image_alt(
+    source: &str,
+    image: &mdast::Image,
+    options: &markdown::ParseOptions,
+) -> Option<String> {
+    let position = image.position.as_ref()?;
+    let raw = source.get(position.start.offset..position.end.offset)?;
+    let link = raw.strip_prefix('!')?;
+    if !link.contains("![") {
+        return None;
+    }
+    let options = markdown::ParseOptions {
+        constructs: options.constructs.clone(),
+        gfm_strikethrough_single_tilde: options.gfm_strikethrough_single_tilde,
+        math_text_single_dollar: options.math_text_single_dollar,
+        mdx_expression_parse: None,
+        mdx_esm_parse: None,
+    };
+    let mut tree = markdown::to_mdast(link, &options).ok()?;
+    restore_nested_image_alt(&mut tree, link, &options);
+    let Node::Root(root) = tree else {
+        return None;
+    };
+    let [Node::Paragraph(paragraph)] = root.children.as_slice() else {
+        return None;
+    };
+    let [Node::Link(link)] = paragraph.children.as_slice() else {
+        return None;
+    };
+    fn plain_text(nodes: &[Node], out: &mut String) {
+        for node in nodes {
+            match node {
+                Node::Image(image) => out.push_str(&image.alt),
+                Node::ImageReference(image) => out.push_str(&image.alt),
+                node => match node.children() {
+                    Some(children) => plain_text(children, out),
+                    None => out.push_str(&node.to_string()),
+                },
+            }
+        }
+    }
+    let mut alt = String::new();
+    plain_text(&link.children, &mut alt);
+    Some(alt)
+}
