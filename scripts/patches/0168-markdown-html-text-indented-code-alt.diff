+/// Width of `text` in columns, with tab stops every 4 columns.
+fn tab_columns(text: &str) -> usize {
+    text.chars().fold(0, |column, c| match c {
+        '\t' => column + 4 - column % 4,
+        _ => column + 1,
+    })
+}
+
+/// Restore the columns of a tab that an indented code block's indentation
+/// only partly used (CommonMark 0.31.2, tabs: `>\t\tfoo` is `  foo`).
+///
+/// markdown-rs splits such a tab into virtual spaces, and its HTML output
+/// keeps the ones left over as content, but its mdast `Code.value` drops them.
+/// The code's start column (which counts virtual spaces) gives the content
+/// column; a line whose content follows a tab crossing it gets the columns
+/// that tab has past it back as spaces.
+///
+/// It also joins an indented code block that markdown-rs split into one
+/// `Code` node per line (it does so inside a block quote: `>     a\n>     b`
+/// is one block of two lines, not two blocks). CommonMark never puts two
+/// indented code blocks next to each other, so adjacent ones are one block;
+/// the blank lines between them are kept.
+fn restore_indented_code_columns(node: &mut Node, source: &str) {
+    if let Node::Code(code) = node {
+        if let Some(value) = indented_code_value(source, code) {
+            code.value = value;
+        }
+        return;
+    }
+    let Some(children) = node.children_mut() else {
+        return;
+    };
+    for child in children.iter_mut() {
+        restore_indented_code_columns(child, source);
+    }
+    let mut ix = 1;
+    while ix < children.len() {
+        let joined = match (&children[ix - 1], &children[ix]) {
+            (Node::Code(prev), Node::Code(next))
+                if is_indented_code(source, prev) && is_indented_code(source, next) =>
+            {
+                match (&prev.position, &next.position) {
+                    (Some(a), Some(b)) if b.start.line > a.end.line => {
+                        let breaks = b.start.line - a.end.line;
+                        let mut value = prev.value.clone();
+                        value.extend(std::iter::repeat_n('\n', breaks));
+                        value.push_str(&next.value);
+                        Some(mdast::Code {
+                            value,
+                            position: Some(markdown::unist::Position {
+                                start: a.start.clone(),
+                                end: b.end.clone(),
+                            }),
+                            lang: None,
+                            meta: None,
+                        })
+                    }
+                    _ => None,
+                }
+            }
+            _ => None,
+        };
+        match joined {
+            Some(code) => {
+                children[ix - 1] = Node::Code(code);
+                children.remove(ix);
+            }
+            None => ix += 1,
+        }
+    }
+}
+
+/// A code block made by indentation, not by a fence.
+fn is_indented_code(source: &str, code: &mdast::Code) -> bool {
+    let Some(raw) = code
+        .position
+        .as_ref()
+        .and_then(|p| source.get(p.start.offset..p.end.offset))
+    else {
+        return false;
+    };
+    let first = raw.trim_start_matches(' ');
+    !(raw.len() - first.len() < 4 && (first.starts_with("```") || first.starts_with("~~~")))
+}
+
+fn indented_code_value(source: &str, code: &mdast::Code) -> Option<String> {
+    if !is_indented_code(source, code) {
+        return None;
+    }
+    let position = code.position.as_ref()?;
+    let content_column = position.start.column.checked_sub(1)? + 4;
+    let line_start = source[..position.start.offset]
+        .rfind('\n')
+        .map_or(0, |at| at + 1);
+    let mut source_lines = source[line_start..].split('\n');
+    let mut value = String::with_capacity(code.value.len());
+    let mut changed = false;
+    for (ix, line) in code.value.split('\n').enumerate() {
+        if ix > 0 {
+            value.push('\n');
+        }
+        let source_line = source_lines.next()?;
+        if !line.is_empty() && source_line.ends_with(line) {
+            let prefix = &source_line[..source_line.len() - line.len()];
+            if let Some(before_tab) = prefix.strip_suffix('\t') {
+                let (from, to) = (tab_columns(before_tab), tab_columns(prefix));
+                if from < content_column && to > content_column {
+                    value.extend(std::iter::repeat_n(' ', to - content_column));
+                    changed = true;
+                }
+            }
+        }
+        value.push_str(line);
+    }
+    changed.then_some(value)
+}
