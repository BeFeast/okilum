+        let (root, cx) = cx.add_window_view(|_, cx| TableSelectionTestRoot {
+            text_view: cx
+                .new(|cx| TextViewState::markdown(source, cx).retain_selection_on_layout(true)),
+        });
+        let cx: &mut VisualTestContext = cx;
+        cx.run_until_parked();
+        let start = point(px(10.), px(10.));
+        let finish = point(px(90.), px(10.));
+        cx.simulate_mouse_down(start, MouseButton::Left, Modifiers::default());
+        cx.simulate_mouse_move(finish, MouseButton::Left, Modifiers::default());
+        cx.simulate_mouse_up(finish, MouseButton::Left, Modifiers::default());
+        let expected = root.read_with(cx, |root, cx| root.text_view.read(cx).selected_text());
+        assert!(!expected.is_empty() && expected.trim().len() < source.len());
+        assert_eq!(source.matches(expected.trim()).count(), 1);
+        for first_fast_drag in [false, true] {
+            cx.simulate_click(point(px(400.), px(10.)), Modifiers::default());
+            if !first_fast_drag {
+                cx.simulate_mouse_down(start, MouseButton::Left, Modifiers::default());
+                cx.simulate_mouse_move(
+                    point(px(40.), px(10.)),
+                    MouseButton::Left,
+                    Modifiers::default(),
