+    fn marker_inventory_gates_source_access_and_reuses_exact_snapshot() {
+        let cache = RefCell::new(None);
+        let stamp = SourceStamp {
+            document: 1,
+            generation: 2,
+        };
+        let layout = LayoutStamp {
+            source: stamp,
+            presentation: 3,
+        };
+        let source = SourceSnapshot {
+            stamp,
+            text: Arc::from("- item\n"),
+        };
+        let pin = |markers| PinnedProjection {
+            stamp: layout,
+            projection: Arc::new(Fixture {
+                source: source.clone(),
+                markers,
+            }),
+        };
+        let absent = pin(vec![]);
+        let present = pin(vec![ProjectionMarker {
+            range: SourceByte(0)..SourceByte(1),
+            scope: SourceByte(0)..SourceByte(6),
+            kind: MarkerKind::Bullet { depth: 1 },
+        }]);
+        for candidate in [None, Some(&absent)] {
+            assert!(
+                source_for_markers(candidate, layout, stamp, true, &cache, |_| panic!(
+                    "empty inventory must not read source"
+                ))
+                .is_none()
+            );
+        }
+        let stale = SourceStamp {
+            generation: 4,
+            ..stamp
+        };
+        assert!(
+            source_for_markers(Some(&present), layout, stale, true, &cache, |_| panic!(
+                "stale pin must not read source"
+            ))
+            .is_none()
+        );
+        assert!(
+            source_for_markers(Some(&present), layout, stamp, false, &cache, |_| panic!(
+                "unsupported alignment must not read source"
+            ))
+            .is_none()
+        );
+        let calls = Cell::new(0);
+        let captured = source_for_markers(Some(&present), layout, stamp, true, &cache, |text| {
+            calls.set(calls.get() + 1);
+            text == "- item\n"
+        })
+        .unwrap();
+        let reused = source_for_markers(Some(&present), layout, stamp, true, &cache, |_| {
+            panic!("unchanged snapshot must not scan source")
+        })
+        .unwrap();
+        assert!(
+            Arc::ptr_eq(&captured, &reused),
+            "reuse grapheme boundaries too"
+        );
+        assert_eq!(calls.get(), 1, "positive control must check exact bytes");
+        let foreign = PinnedProjection {
+            stamp: layout,
+            projection: Arc::new(Fixture {
+                source: SourceSnapshot {
+                    stamp,
+                    text: Arc::from("- wrong bytes"),
+                },
+                markers: present.projection.markers().to_vec(),
