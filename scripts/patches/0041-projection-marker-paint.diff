+//! Paint-only consumer of one prepaint's immutable projection and visual rows.
+use super::layout::LastLayout;
+use crate::input::projection::{
+    ActiveSource, ConcealBias, LayoutStamp, MarkerKind, PinnedProjection, SourceSnapshot,
+    SourceStamp,
+};
+use gpui::{
+    App, BorderStyle, Bounds, Edges, Hsla, Pixels, Point, ShapedLine, TextAlign, Window, fill,
+    point, px, quad, size, transparent_black,
+};
+use std::{cell::RefCell, ops::Range, sync::Arc};
+use unicode_segmentation::UnicodeSegmentation;
+
+pub(super) struct RowPaint {
+    pieces: Vec<ForegroundPiece>,
+    shapes: Vec<Shape>,
+}
+struct Shape {
+    x: Pixels,
+    width: Pixels,
+    kind: MarkerKind,
+}
+
+pub(super) struct MarkerSource {
+    pub(super) snapshot: SourceSnapshot,
+    boundaries: Vec<usize>,
+}
+
+/// Check cheap inventory/identity guards before touching canonical bytes. Reuse
+/// the exact immutable source already owned by this prepaint's pin.
+pub(super) fn source_for_markers(
+    pin: Option<&PinnedProjection>,
+    layout: LayoutStamp,
+    current: SourceStamp,
+    aligned: bool,
+    cache: &RefCell<Option<Arc<MarkerSource>>>,
+    matches_source: impl FnOnce(&str) -> bool,
+) -> Option<Arc<MarkerSource>> {
+    let pin = pin?;
+    if !aligned
+        || pin.stamp != layout
+        || layout.source != current
+        || pin.projection.markers().is_empty()
+    {
+        return None;
+    }
+    let source = pin.projection.source();
+    if source.stamp != current {
+        return None;
+    }
+    if let Some(cached) = cache.borrow().as_ref() {
+        // The session verifies provider bytes on compose; retain a separate
+        // exact-byte check here before admitting a new immutable source Arc.
+        if cached.snapshot.stamp == current && Arc::ptr_eq(&cached.snapshot.text, &source.text) {
+            return Some(cached.clone());
+        }
+    }
+    if !matches_source(&source.text) {
+        return None;
+    }
+    let validated = Arc::new(MarkerSource {
+        snapshot: source.clone(),
+        boundaries: source
+            .text
+            .grapheme_indices(true)
+            .map(|(i, _)| i)
+            .chain(std::iter::once(source.text.len()))
+            .collect(),
+    });
+    *cache.borrow_mut() = Some(validated.clone());
+    Some(validated)
+}
+
+pub(super) fn prepare(
+    layout: &LastLayout,
+    validated: &MarkerSource,
+    safety: &ActiveSource,
+) -> Vec<Vec<Option<RowPaint>>> {
+    let Some(pin) = &layout.projection else {
+        return vec![];
+    };
+    if layout.text_align != TextAlign::Left || pin.projection.markers().is_empty() {
+        return vec![];
+    }
+    let stamp = LayoutStamp {
+        source: layout.source_stamp,
+        presentation: layout.presentation_epoch,
+    };
+    let current = &validated.snapshot;
+    let boundaries = &validated.boundaries;
+    let mut markers = Vec::new();
+    for marker in pin.projection.markers() {
+        if marker.range.start.0 >= marker.range.end.0
+            || marker.scope.start.0 > marker.range.start.0
+            || marker.range.end.0 > marker.scope.end.0
+            || [
+                marker.range.start.0,
+                marker.range.end.0,
+                marker.scope.start.0,
+                marker.scope.end.0,
+            ]
+            .iter()
+            .any(|i| boundaries.binary_search(i).is_err())
+        {
+            return vec![];
+        }
+        if pin.marker_scope_is_raw(stamp, current, &marker.scope, safety) {
+            continue;
+        }
+        let Some(start) = pin
+            .projection
+            .to_projected(marker.range.start, ConcealBias::Left)
+        else {
+            return vec![];
+        };
+        let Some(end) = pin
+            .projection
+            .to_projected(marker.range.end, ConcealBias::Right)
+        else {
+            return vec![];
+        };
+        if end.0.checked_sub(start.0) != Some(marker.range.end.0 - marker.range.start.0) {
+            return vec![];
+        }
+        let Some(scope_end) = pin
+            .projection
+            .to_projected(marker.scope.end, ConcealBias::Right)
+        else {
+            return vec![];
+        };
+        markers.push((start.0..end.0, marker.kind.clone(), scope_end.0));
+    }
+    layout
+        .lines
+        .iter()
+        .enumerate()
+        .map(|(li, line)| {
+            let mut offset = layout.visible_line_byte_offsets[li];
+            let mut quote_gutters: Vec<(Pixels, Pixels, MarkerKind, usize)> = Vec::new();
+            line.wrapped_lines
+                .iter()
+                .enumerate()
+                .map(|(row_index, row)| {
+                    let start = offset;
+                    offset += row.len();
+                    // Whitespace visualizers keep their established rendering unchanged.
+                    if line.whitespace_indicators.is_some() {
+                        return None;
+                    }
+                    let mut ranges = Vec::new();
+                    let mut shapes = Vec::new();
+                    for (range, kind, scope_end) in &markers {
+                        if range.end <= start || range.start >= offset {
+                            continue;
+                        }
+                        // A marker spanning visual rows cannot be replaced partially.
+                        if range.start < start || range.end > offset {
+                            return None;
+                        }
+                        let local = range.start - start..range.end - start;
+                        let x = row.x_for_index(local.start);
+                        let width = row.x_for_index(local.end) - x;
+                        if width <= px(0.) {
+                            return None;
+                        }
+                        ranges.push(local);
+                        shapes.push(Shape {
+                            x,
+                            width,
+                            kind: kind.clone(),
+                        });
+                        if row_index == 0 && matches!(kind, MarkerKind::Quote { .. }) {
+                            quote_gutters.push((x, width, kind.clone(), *scope_end));
+                        }
+                    }
+                    if row_index > 0 {
+                        for (x, width, kind, scope_end) in &quote_gutters {
+                            // Reuse only existing continuation indentation; never cover body glyphs.
+                            if start < *scope_end && line.wrap_indent >= *x + *width {
+                                shapes.push(Shape {
+                                    x: *x - line.wrap_indent,
+                                    width: *width,
+                                    kind: kind.clone(),
+                                });
+                            }
+                        }
+                    }
+                    if shapes.is_empty() {
+                        return None;
+                    }
+                    let pieces = foreground_pieces(row, &ranges)?;
+                    Some(RowPaint { pieces, shapes })
+                })
+                .collect()
+        })
+        .collect()
+}
+
+impl RowPaint {
+    pub(super) fn paint(
+        &self,
+        origin: Point<Pixels>,
+        height: Pixels,
+        content_width: Pixels,
+        color: Hsla,
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        for piece in &self.pieces {
+            let _ = piece.shaped.paint(
+                origin + point(piece.x, px(0.)),
+                height,
+                TextAlign::Left,
+                None,
+                window,
+                cx,
+            );
+        }
+        for shape in &self.shapes {
+            let bounds = Bounds::new(origin + point(shape.x, px(0.)), size(shape.width, height));
+            window.with_content_mask(Some(gpui::ContentMask { bounds }), |window| {
+                match shape.kind {
+                    MarkerKind::Bullet { depth } => {
+                        let diameter = px(4.).min(shape.width);
+                        let b = Bounds::new(
+                            origin
+                                + point(
+                                    shape.x + (shape.width - diameter) / 2.,
+                                    (height - diameter) / 2.,
+                                ),
+                            size(diameter, diameter),
+                        );
+                        match depth.saturating_sub(1) % 3 {
+                            0 => window.paint_quad(quad(
+                                b,
+                                diameter / 2.,
+                                color,
+                                Edges::default(),
+                                transparent_black(),
+                                BorderStyle::default(),
+                            )),
+                            1 => window.paint_quad(quad(
+                                b,
+                                diameter / 2.,
+                                transparent_black(),
+                                Edges::all(px(1.)),
+                                color,
+                                BorderStyle::default(),
+                            )),
+                            _ => window.paint_quad(fill(b, color)),
+                        }
+                    }
+                    MarkerKind::Quote { .. } => window.paint_quad(fill(
+                        Bounds::new(
+                            origin + point(shape.x + shape.width / 2., px(0.)),
+                            size(px(2.).min(shape.width), height),
+                        ),
+                        color.opacity(0.45),
+                    )),
+                    MarkerKind::Rule => {}
+                }
+            });
+            if matches!(shape.kind, MarkerKind::Rule) {
+                let bounds = Bounds::new(
+                    origin + point(shape.x, px(0.)),
+                    size((content_width - shape.x).max(px(0.)), height),
+                );
+                window.with_content_mask(Some(gpui::ContentMask { bounds }), |window| {
+                    window.paint_quad(fill(
+                        Bounds::new(
+                            origin + point(shape.x, height / 2.),
+                            size(bounds.size.width, px(1.)),
+                        ),
+                        color.opacity(0.45),
+                    ));
+                });
+            }
+        }
+    }
+}
+
+pub(super) struct ForegroundPiece {
+    pub x: Pixels,
+
+    pub shaped: ShapedLine,
+}
+
+/// Paint-only candidate: split existing glyph runs; never call shape_line.
+/// Call only AFTER exact snapshot, same-prepaint LayoutStamp, policy and mapping
+/// validation. None means retain original foreground. Background/selection paint
+/// is untouched. Replacement paint is a separate step, clipped to marker bounds.
+///
+/// Conservative initial seam: reject non-monotone glyph indices (e.g. bidi) and
+/// splits inside a glyph cluster. Do not infer cluster safety from UTF-8 alone.
+/// Renderer must paint pieces with TextAlign::Left at original_origin + piece.x;
+/// it must not align each piece independently or use piece widths for layout.
+fn foreground_pieces(line: &ShapedLine, hidden: &[Range<usize>]) -> Option<Vec<ForegroundPiece>> {
+    if unicode_bidi::BidiInfo::new(&line.text, None).has_rtl() {
+        return None;
+    }
+    let glyphs: Vec<_> = line.runs.iter().flat_map(|run| &run.glyphs).collect();
+    if glyphs.windows(2).any(|pair| pair[0].index > pair[1].index) {
+        return None;
+    }
+    let boundaries: Vec<_> = line
+        .text
+        .grapheme_indices(true)
+        .map(|(i, _)| i)
+        .chain(std::iter::once(line.text.len()))
+        .collect();
+    let boundary = |index: usize| {
+        boundaries.binary_search(&index).is_ok()
+            && (index == line.len() || glyphs.iter().any(|glyph| glyph.index == index))
+    };
+    let mut end = 0;
+    for range in hidden {
+        if range.start < end
+            || range.start >= range.end
+            || range.end > line.len()
+            || !boundary(range.start)
+            || !boundary(range.end)
+        {
+            return None;
+        }
+        end = range.end;
+    }
+    let mut pieces = Vec::new();
+    let mut cursor = 0;
+    for range in hidden {
+        if cursor < range.start {
+            let (_, suffix) = line.split_at(cursor);
+            let (part, _) = suffix.split_at(range.start - cursor);
+            pieces.push(ForegroundPiece {
+                x: line.x_for_index(cursor),
+
+                shaped: part,
+            });
+        }
+        cursor = range.end;
+    }
+    if cursor < line.len() {
+        let (_, part) = line.split_at(cursor);
+        pieces.push(ForegroundPiece {
+            x: line.x_for_index(cursor),
+
+            shaped: part,
+        });
+    }
+    Some(pieces)
+}
