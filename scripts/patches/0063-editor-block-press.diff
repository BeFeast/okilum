+    /// The source offset a plain left press inside a painted block lands on,
+    /// or None when the press is not on a block.
+    fn block_press_target(&self, event: &MouseDownEvent, offset: usize) -> Option<usize> {
+        let pressed = self.block_press.lock().ok().and_then(|mut slot| slot.take());
+        if !self.projection.enabled
+            || event.button != MouseButton::Left
+            || event.modifiers.shift
+        {
+            return None;
+        }
+        let current = self.source_stamp();
+        let painted = self.painted_blocks.borrow();
+        let (_, blocks) = painted.as_ref().filter(|(stamp, _)| *stamp == current)?;
+        let (source, _) = blocks.iter().find(|(_, bounds)| bounds.contains(&event.position))?;
+        let inside = |at: usize| source.start <= at && at <= source.end;
+        Some(
+            pressed
+                .filter(|press| press.position == event.position)
+                .map(|press| press.offset.0)
+                .filter(|&at| inside(at))
+                .or(Some(offset).filter(|&at| inside(at)))
+                .unwrap_or(source.start),
+        )
+    }
