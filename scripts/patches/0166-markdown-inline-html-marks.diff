+    /// markdown-rs hands `<b>` and `</b>` over as separate `Html` nodes; the
+    /// text between them takes the element's mark.
+    #[test]
+    fn test_inline_html_tags_mark_the_text_between_them() {
+        let paragraph = first_paragraph(
+            "a <b>bold</b> <strong>strong</strong> <i>it</i> <u>under</u> \
+             <kbd>Ctrl</kbd> <s>gone</s> <strike>former</strike> <sup>2</sup> \
+             <mark>hi</mark> <a href=\"https://example.com\" title=\"T\">site</a> z",
+        );
+        assert_eq!(
+            paragraph.text(),
+            "a bold strong it under Ctrl gone former 2 hi site z"
+        );
+        assert!(mark_at(&paragraph, "bold").bold);
+        assert!(mark_at(&paragraph, "strong").bold);
+        assert!(mark_at(&paragraph, "it").italic);
+        assert!(mark_at(&paragraph, "under").underline);
+        assert!(mark_at(&paragraph, "Ctrl").code);
+        assert!(mark_at(&paragraph, "gone").strikethrough);
+        assert!(mark_at(&paragraph, "former").strikethrough);
+        assert_eq!(mark_at(&paragraph, "2"), TextMark::default());
+        assert_eq!(
+            mark_at(&paragraph, "hi").highlight,
+            Some(node::default_highlight())
+        );
+        let link = mark_at(&paragraph, "site").link.expect("link mark");
+        assert_eq!(link.url.as_ref(), "https://example.com");
+        assert_eq!(link.title.as_deref(), Some("T"));
+        assert_eq!(mark_at(&paragraph, "z"), TextMark::default());
+        assert_eq!(mark_at(&paragraph, "a "), TextMark::default());
+    }
