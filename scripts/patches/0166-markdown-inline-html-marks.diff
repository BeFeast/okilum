+/// One inline raw HTML tag that markdown-rs hands over as its own `Html` node.
+///
+/// markdown-rs splits `a <b>bold</b> c` into `Text`, `Html("<b>")`, `Text`,
+/// `Html("</b>")`, `Text`. Parsed alone, a lone open tag yields nothing, so
+/// the formatting was lost; [`parse_inline_children`] keeps these tags on a
+/// stack instead.
+enum InlineHtmlTag {
+    Open { name: String, mark: TextMark },
+    Close { name: String },
+}
+
+/// Inline elements whose open and close tags are tracked across siblings.
+/// Elements without a [`TextMark`] equivalent (`sub`, `sup`, `span`, ...) are
+/// tracked too, so their tags are consumed and their text kept plain.
+const INLINE_HTML_ELEMENTS: &[&str] = &[
+    "a", "abbr", "b", "cite", "code", "del", "dfn", "em", "font", "i", "ins", "kbd", "mark", "q",
+    "s", "samp", "small", "span", "strike", "strong", "sub", "sup", "time", "u", "var",
+];
+
+fn inline_html_tag(value: &str, cx: &mut NodeContext) -> Option<InlineHtmlTag> {
+    let tag = value.trim();
+    let inner = tag.strip_prefix('<')?.strip_suffix('>')?;
+    let (closing, inner) = match inner.strip_prefix('/') {
+        Some(rest) => (true, rest),
+        None => (false, inner),
+    };
+    let name_len = inner
+        .find(|c: char| !c.is_ascii_alphanumeric())
+        .unwrap_or(inner.len());
+    let name = inner[..name_len].to_ascii_lowercase();
+    if !INLINE_HTML_ELEMENTS.contains(&name.as_str()) {
+        return None;
+    }
+    let rest = &inner[name_len..];
+    if closing {
+        return rest
+            .trim()
+            .is_empty()
+            .then_some(InlineHtmlTag::Close { name });
+    }
+    if !(rest.is_empty() || rest.starts_with(char::is_whitespace)) || rest.ends_with('/') {
+        return None;
+    }
+    // Let the HTML parser map the element and its attributes (`href`, a
+    // `<mark>` colour) to a mark, on a placeholder character it wraps.
+    const PROBE: char = '\u{E000}';
+    let fragment = format!("{tag}{PROBE}</{name}>");
+    let blocks = super::html::parse(&fragment, cx).ok()?.blocks;
+    let mut probe = Paragraph::default();
+    append_inline_html_blocks(&mut probe, Arc::unwrap_or_clone(blocks))?;
+    let mut mark = TextMark::default();
+    for node in &probe.children {
+        if let Some(at) = node.text.find(PROBE) {
+            for (range, node_mark) in &node.marks {
+                if range.start <= at && at < range.end {
+                    mark.merge(node_mark.clone());
+                }
+            }
+            break;
+        }
+    }
+    Some(InlineHtmlTag::Open { name, mark })
+}
+
+/// Parse the inline `children` of one container (paragraph, heading, table
+/// cell, emphasis, link) into `paragraph`, applying inline raw HTML tags
+/// among them to the siblings they enclose. A tag left open ends with its
+/// container, as in HTML; an unmatched close tag is dropped.
+fn parse_inline_children(
+    paragraph: &mut Paragraph,
+    children: &[mdast::Node],
+    cx: &mut NodeContext,
+) -> String {
+    let mut text = String::new();
+    let mut open: Vec<(String, TextMark)> = Vec::new();
+    for child in children {
+        if let Node::Html(html) = child
+            && let Some(tag) = inline_html_tag(&html.value, cx)
+        {
+            if let Some(span) = new_span(html.position.clone(), cx) {
+                paragraph.set_span(span);
+            }
+            match tag {
+                InlineHtmlTag::Open { name, mark } => open.push((name, mark)),
+                InlineHtmlTag::Close { name } => {
+                    if let Some(at) = open.iter().rposition(|(open, _)| *open == name) {
+                        open.remove(at);
+                    }
+                }
+            }
+            continue;
+        }
+        let mark = open
+            .iter()
+            .fold(TextMark::default(), |mut acc, (_, mark)| {
+                acc.merge(mark.clone());
+                acc
+            });
+        if mark == TextMark::default() {
+            text.push_str(&parse_paragraph(paragraph, child, cx));
+        } else {
+            text.push_str(&merge_children_with_mark(
+                paragraph,
+                std::slice::from_ref(child),
+                mark,
+                cx,
+            ));
+        }
+    }
+    text
+}
