+    /// An unclosed tag ends with its paragraph; a stray close tag is dropped.
+    #[test]
+    fn test_inline_html_unbalanced_tags() {
+        let paragraph = first_paragraph("a </i>b <b>c");
+        assert_eq!(paragraph.text(), "a b c");
+        assert!(!mark_at(&paragraph, "b").italic);
+        assert!(mark_at(&paragraph, "c").bold);
+
+        let next = first_paragraph("x <b>y\n\nz");
+        assert!(mark_at(&next, "y").bold);
+        let mut cx = NodeContext::default();
+        let document = parse("x <b>y\n\nz", &mut cx).unwrap();
+        let BlockNode::Paragraph(second) = &document.blocks[1] else {
+            panic!("expected second paragraph");
+        };
+        assert!(!mark_at(second, "z").bold);
+    }
