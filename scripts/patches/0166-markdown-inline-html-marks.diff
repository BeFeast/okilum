+    /// The merged mark over the first occurrence of `needle` in a paragraph.
+    fn mark_at(paragraph: &Paragraph, needle: &str) -> TextMark {
+        let text = paragraph.text();
+        let at = text
+            .find(needle)
+            .unwrap_or_else(|| panic!("{needle:?} not in {text:?}"));
+        let mut offset = 0;
+        let mut mark = TextMark::default();
+        for node in &paragraph.children {
+            let len = node.text.len();
+            if (offset..offset + len).contains(&at) {
+                for (range, node_mark) in &node.marks {
+                    if range.contains(&(at - offset)) {
+                        mark.merge(node_mark.clone());
+                    }
+                }
+                break;
+            }
+            offset += len;
+        }
+        mark
+    }
