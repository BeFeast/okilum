+/// Byte offsets where a long document can be parsed independently; the first
+/// is always 0. Fewer than two offsets means "parse it whole".
+///
+/// A cut is made only before an ATX heading that starts in column 0 after a
+/// blank line. In CommonMark/GFM such a line ends every open container (a
+/// list item needs indentation, a block quote needs `>`, and laziness only
+/// continues a paragraph, which the blank line has closed) and every leaf
+/// except a fenced code block or an HTML block of kinds 1-5. Fences are
+/// tracked exactly from the start of the document; this is only sound when
+/// every fence-like line is itself in column 0 (a fence inside a list item or
+/// block quote could otherwise hide a top-level fence), so any other
+/// fence-like line disables chunking. HTML blocks that can span blank lines,
+/// document-wide definitions (link references and footnotes, `]:`) and
+/// non-GFM constructs also disable it, so they keep the single-parse result.
+fn chunk_starts(source: &str, options: &markdown::ParseOptions) -> Vec<usize> {
+    let mut starts = vec![0];
+    if source.len() < 2 * PARSE_CHUNK_BYTES {
+        return starts;
+    }
+    let constructs = &options.constructs;
+    if !constructs.html_flow
+        || options.mdx_expression_parse.is_some()
+        || options.mdx_esm_parse.is_some()
+        || constructs.mdx_jsx_flow
+        || constructs.mdx_expression_flow
+        || constructs.mdx_esm
+        || constructs.math_flow
+        || constructs.frontmatter
+    {
+        return starts;
+    }
+    if source.contains("]:") || source.contains("<!") || source.contains("<?") {
+        return starts;
+    }
+    let lower = source.to_ascii_lowercase();
+    if ["<script", "<pre", "<style", "<textarea"]
+        .iter()
+        .any(|tag| lower.contains(tag))
+    {
+        return starts;
+    }
+
+    let mut fence: Option<(u8, usize)> = None;
+    let mut previous_blank = true;
+    let mut line_start = 0;
+    let bytes = source.as_bytes();
+    while line_start < bytes.len() {
+        let mut line_end = line_start;
+        while line_end < bytes.len() && bytes[line_end] != b'\n' && bytes[line_end] != b'\r' {
+            line_end += 1;
+        }
+        let line = &source[line_start..line_end];
+        let blank = line.bytes().all(|b| b == b' ' || b == b'\t');
+
+        let marker = fence_marker(line);
+        if marker.is_none() && fence_marker(strip_container_prefix(line)).is_some() {
+            // A fence that is indented or inside a container.
+            return vec![0];
+        }
+        match (fence, marker) {
+            (Some((ch, len)), Some((mch, mlen, info))) => {
+                if mch == ch && mlen >= len && info.trim().is_empty() {
+                    fence = None;
+                }
+            }
+            (None, Some((mch, mlen, info))) => {
+                if mch == b'~' || !info.contains('`') {
+                    fence = Some((mch, mlen));
+                }
+            }
+            _ => {}
+        }
+
+        if fence.is_none()
+            && previous_blank
+            && is_atx_heading(line)
+            && line_start - starts.last().copied().unwrap_or(0) >= PARSE_CHUNK_BYTES
+            && source.len() - line_start >= PARSE_CHUNK_BYTES / 2
+        {
+            starts.push(line_start);
+        }
+        previous_blank = blank;
+
+        line_start = line_end;
+        if bytes.get(line_start) == Some(&b'\r') {
+            line_start += 1;
+        }
+        if bytes.get(line_start) == Some(&b'\n') {
+            line_start += 1;
+        }
+    }
+    starts
+}
+
+/// A run of three or more backticks or tildes starting in column 0: the fence
+/// character, the run length and the rest of the line.
+fn fence_marker(line: &str) -> Option<(u8, usize, &str)> {
+    let ch = *line.as_bytes().first()?;
+    if ch != b'`' && ch != b'~' {
+        return None;
+    }
+    let len = line.bytes().take_while(|&b| b == ch).count();
+    (len >= 3).then(|| (ch, len, &line[len..]))
+}
+
+/// The line without leading whitespace and block quote or list markers.
+fn strip_container_prefix(line: &str) -> &str {
+    let mut rest = line;
+    loop {
+        let trimmed = rest.trim_start_matches([' ', '\t']);
+        let after_marker = trimmed
+            .strip_prefix('>')
+            .or_else(|| trimmed.strip_prefix(['-', '*', '+']))
+            .or_else(|| {
+                let digits = trimmed.bytes().take_while(u8::is_ascii_digit).count();
+                (digits > 0)
+                    .then(|| trimmed[digits..].strip_prefix(['.', ')']))
+                    .flatten()
+            });
+        match after_marker {
+            Some(after) => rest = after,
+            None => return trimmed,
+        }
+    }
+}
+
+/// An ATX heading opening in column 0: one to six `#` then a space, a tab or
+/// the end of the line.
+fn is_atx_heading(line: &str) -> bool {
+    let hashes = line.bytes().take_while(|&b| b == b'#').count();
+    (1..=6).contains(&hashes)
+        && matches!(line.as_bytes().get(hashes), None | Some(b' ') | Some(b'\t'))
+}
