+/// Source bytes per independently parsed chunk of a long document.
+const PARSE_CHUNK_BYTES: usize = 16 * 1024;
+
+/// `markdown::to_mdast`, in chunks for long documents.
+///
+/// markdown-rs parse time grows faster than linearly with document size (a
+/// 10,000-line note takes several times longer than four quarters of it), so
+/// a long document is parsed as consecutive chunks, in parallel, whose trees
+/// are joined with their positions shifted back into the whole source. The
+/// result is the tree a single parse produces: see [`chunk_starts`] for why
+/// each cut is safe.
+fn to_mdast(source: &str, options: &markdown::ParseOptions) -> Result<Node, markdown::message::Message> {
+    let starts = chunk_starts(source, options);
+    if starts.len() < 2 {
+        return markdown::to_mdast(source, options);
+    }
+    let mut chunks = Vec::with_capacity(starts.len());
+    let mut lines = 0;
+    for (ix, &start) in starts.iter().enumerate() {
+        let end = starts.get(ix + 1).copied().unwrap_or(source.len());
+        chunks.push((start, lines, &source[start..end]));
+        lines += line_endings(&source[start..end]);
+    }
+    let threads = std::thread::available_parallelism()
+        .map_or(1, |n| n.get())
+        .clamp(1, 4)
+        .min(chunks.len());
+    let per_thread = chunks.len().div_ceil(threads);
+    // MDX parse callbacks are not `Sync`; chunked documents never use MDX
+    // (see `chunk_starts`), so every thread gets the same plain options.
+    let constructs = &options.constructs;
+    let single_tilde = options.gfm_strikethrough_single_tilde;
+    let single_dollar = options.math_text_single_dollar;
+    let parse = move |group: &[(usize, usize, &str)]| {
+        let options = markdown::ParseOptions {
+            constructs: constructs.clone(),
+            gfm_strikethrough_single_tilde: single_tilde,
+            math_text_single_dollar: single_dollar,
+            mdx_expression_parse: None,
+            mdx_esm_parse: None,
+        };
+        group
+            .iter()
+            .map(|&(start, lines, chunk)| {
+                let mut node = markdown::to_mdast(chunk, &options)?;
+                shift_positions(&mut node, start, lines);
+                Ok(node)
+            })
+            .collect::<Result<Vec<_>, markdown::message::Message>>()
+    };
+    let groups: Vec<_> = std::thread::scope(|scope| {
+        let mut groups = chunks.chunks(per_thread);
+        let first = groups.next().unwrap_or_default();
+        let handles: Vec<_> = groups.map(|group| scope.spawn(move || parse(group))).collect();
+        std::iter::once(parse(first))
+            .chain(handles.into_iter().map(|handle| {
+                handle
+                    .join()
+                    .unwrap_or_else(|panic| std::panic::resume_unwind(panic))
+            }))
+            .collect()
+    });
+
+    let mut children = Vec::new();
+    let mut first = None;
+    let mut last = None;
+    for node in groups.into_iter().collect::<Result<Vec<_>, _>>()?.into_iter().flatten() {
+        let Node::Root(root) = node else {
+            unreachable!("to_mdast returns a root");
+        };
+        if let Some(position) = root.position {
+            first.get_or_insert(position.start);
+            last = Some(position.end);
+        }
+        children.extend(root.children);
+    }
+    Ok(Node::Root(mdast::Root {
+        children,
+        position: first.zip(last).map(|(start, end)| markdown::unist::Position { start, end }),
+    }))
+}
