+/// Line endings as markdown-rs counts them: `\n`, `\r\n` and a lone `\r`.
+fn line_endings(text: &str) -> usize {
+    let bytes = text.as_bytes();
+    bytes
+        .iter()
+        .enumerate()
+        .filter(|&(i, &b)| b == b'\n' || (b == b'\r' && bytes.get(i + 1) != Some(&b'\n')))
+        .count()
+}
+
+fn shift_positions(node: &mut Node, offset: usize, lines: usize) {
+    if let Some(position) = node.position_mut() {
+        for point in [&mut position.start, &mut position.end] {
+            point.offset += offset;
+            point.line += lines;
+        }
+    }
+    if let Some(children) = node.children_mut() {
+        for child in children {
+            shift_positions(child, offset, lines);
+        }
+    }
+}
