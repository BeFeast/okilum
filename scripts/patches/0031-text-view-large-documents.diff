+/// A height hint for unmeasured blocks of a long document. It only sizes the
+/// scrollbar thumb until blocks are measured; positions are item-based, so
+/// heading jumps and restored positions do not depend on it.
+fn estimated_block_height(document: &ParsedDocument) -> Pixels {
+    const LINE: f32 = 26.;
+    const BLOCK_GAP: f32 = 16.;
+    const CHARS_PER_LINE: f32 = 80.;
+    let blocks = document.blocks.len().max(1) as f32;
+    let lines = (document.source.len() as f32 / blocks / CHARS_PER_LINE).clamp(1., 12.);
+    px(lines * LINE + BLOCK_GAP)
+}
