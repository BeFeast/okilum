+            text.push_str(&format!("Paragraph {i} with [[Link {i}]] and `code`.\n#hashtag {i}\n\n"));
+            match i % 8 {
+                0 => text.push_str("```md\nfenced\n\n# not a heading\n\n```\n\n"),
+                1 => text.push_str("~~~~\n\n# still code\n~~~\n\n## also code\n~~~~~\n\n"),
+                2 => text.push_str("- item\n\n  continued\n- second\n  # nested heading\n\n"),
+                3 => text.push_str("> quote\n>\n> # quoted heading\nlazy line\n\n"),
+                4 => text.push_str("| a | b |\n| - | - |\n| 1 | 2 |\n\n"),
+                5 => text.push_str("    indented code\n\n    # indented\n\n"),
+                6 => text.push_str("Setext\n======\n\n<div>\nhtml\n</div>\n\n"),
