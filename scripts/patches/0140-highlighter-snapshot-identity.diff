     #[test]
+    fn large2804_background_snapshot_publication_does_not_compare_the_document() {
+        let source = Rope::from_str(&format!(
+            "[{}null]\r\n",
+            "{\"name\":\"שלום🙂 e\u{301}\",\"value\":42},\r\n".repeat(60_000)
+        ));
+        assert!(source.len() > 2 * 1024 * 1024);
+        let mut parsed = SyntaxHighlighter::new("json");
+        assert!(parsed.update(None, &source, None));
+        let candidate = parsed.tree().expect("positive control: actual JSON parse").clone();
+        let snapshot = source.clone();
+        let mut current = SyntaxHighlighter::new("json");
+        current.edit_tree(None, &source);
+        assert!(current.tree().is_none());
+
+        FULL_SOURCE_COMPARISONS.with(|count| count.set(0));
+        current.apply_background_tree(candidate.clone(), &snapshot, Vec::new());
+        assert_eq!(current.tree().unwrap().root_node().id(), candidate.root_node().id());
+        assert_eq!(FULL_SOURCE_COMPARISONS.with(|count| count.get()), 0,
+            "background publication compared the whole source");
+        assert!(current.update(None, &snapshot, None));
+        assert_eq!(FULL_SOURCE_COMPARISONS.with(|count| count.get()), 0,
+            "unchanged cloned source compared the whole source");
+
+        // Positive control: a distinct equal rope must take the real content
+        // comparison and still publish. Rejecting all non-identical snapshots
+        // would change the highlighter's existing equality semantics.
+        let independent = Rope::from_str(&source.to_string());
+        assert!(!ropey::extra::esoterica::ropes_are_instances(&source, &independent));
+        current.tree = None;
+        current.apply_background_tree(candidate.clone(), &independent, Vec::new());
+        assert!(current.tree().is_some(), "equal independent source still publishes");
+        assert_eq!(FULL_SOURCE_COMPARISONS.with(|count| count.get()), 1,
+            "unfired full-comparison control");
+
+        // A same-length mutation breaks clone identity and must retain the
+        // existing stale-result guard, including multi-byte source boundaries.
+        let mut changed = source.clone();
+        let at = source.to_string().find("value").unwrap();
+        changed.remove(at..at + 5);
+        changed.insert(at, "other");
+        current.edit_tree(None, &changed);
+        current.tree = None;
+        current.apply_background_tree(candidate, &snapshot, Vec::new());
+        assert!(current.tree().is_none(), "stale source cannot publish");
+        assert_eq!(current.text(), &changed);
+        assert_eq!(FULL_SOURCE_COMPARISONS.with(|count| count.get()), 2);
+    }
