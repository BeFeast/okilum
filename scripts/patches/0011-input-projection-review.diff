+                state.preferred_column = Some((px(10.), 0));
+                state.move_vertical(1, window, cx);
+                assert_eq!(state.cursor(), 0);
+                assert_eq!(state.deferred_scroll_offset.unwrap().y, px(-20.));
+                state.move_vertical(2, window, cx);
+                assert_eq!(state.cursor(), 0);
+                assert_eq!(state.deferred_scroll_offset.unwrap().y, px(-40.));
+                // A reflow frame can still exclude the target. Keep the queued
+                // move and recompute scrolling instead of silently dropping it.
+                state.resolve_pending_vertical(cx);
+                assert!(state.projection_pending_vertical.is_some());
+                assert_eq!(state.cursor(), 0);
+                // Model the next painted Source row using a bold run. Resolution
+                // must consume its actual geometry, retaining the queued x.
+                let mut run = gpui::TextStyle::default().to_run(3);
+                run.font = font;
+                run.font.weight = gpui::FontWeight::BOLD;
+                let shaped = window
+                    .text_system()
+                    .shape_line("ddd".into(), px(16.), &[run], None);
+                let expected = 12 + shaped.closest_index_for_x(px(10.));
+                let last = state.last_layout.as_mut().unwrap();
+                last.visible_range = 3..4;
+                last.visible_buffer_lines = vec![3];
+                last.visible_line_byte_offsets = vec![12];
+                last.lines = std::rc::Rc::new(vec![
+                    super::super::display_map::LineLayout::new().lines(smallvec::smallvec![shaped]),
+                ]);
+                state.resolve_pending_vertical(cx);
+                assert_eq!(state.cursor(), expected);
+                assert!(state.projection_pending_vertical.is_none());
+                assert_eq!(state.preferred_column, Some((px(10.), 0)));
+                state.move_to(0, None, cx);
+                state.preferred_column = Some((px(10.), 0));
+                state.move_vertical(1, window, cx);
+                assert!(state.projection_pending_vertical.is_some());
+                state.move_to(1, None, cx);
+                state.move_to(0, None, cx);
+                assert!(state.projection_pending_vertical.is_none());
+                state.resolve_pending_vertical(cx);
+                assert_eq!(state.cursor(), 0);
+            });
+        });
+    }
