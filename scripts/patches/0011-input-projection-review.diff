+    /// Exact source API endpoints can be inside a grapheme and outside the old
+    /// projection's domain. Drop that derived map synchronously before keyboard
+    /// or scroll consumers can observe the new canonical selection.
+    pub(crate) fn restore_for_exact_offsets(
+        &mut self,
+        offsets: &[usize],
+        source: &Rope,
+        cx: &mut App,
+    ) -> bool {
+        let incompatible = self.projection.as_ref().is_some_and(|p| {
+            offsets.iter().any(|&offset| {
+                p.projection
+                    .to_projected(SourceByte(offset), ConcealBias::Right)
+                    .is_none()
+            })
+        });
+        if incompatible {
+            self.source_text = source.clone();
+            self.projection = None;
+            self.wrap_map.restore_source(source, cx);
+            self.rebuild_fold_projection();
+        }
+        incompatible
+    }
