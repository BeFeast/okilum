+                    scale_factor: 1.,
+                    visible_range: 0..1,
+                    visible_buffer_lines: vec![0],
+                    visible_line_byte_offsets: vec![0],
+                    visible_top: px(0.),
+                    visible_range_offset: 0..3,
+                    lines: std::rc::Rc::new(vec![]),
+                    line_height: px(20.),
+                    wrap_width: Some(px(100.)),
+                    wrapping_indent: super::super::WrappingIndent::None,
