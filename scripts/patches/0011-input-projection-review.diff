+#[cfg(test)]
+mod projection_run_tests {
+    use super::*;
+    use crate::input::projection::*;
+    use std::sync::Arc;
+
+    struct StyledFixture {
+        source: SourceSnapshot,
+        styles: Vec<ProjectionStyle>,
+    }
+    impl SourceProjection for StyledFixture {
+        fn source(&self) -> &SourceSnapshot {
+            &self.source
+        }
+        fn text(&self) -> &str {
+            &self.source.text
+        }
+        fn styles(&self) -> &[ProjectionStyle] {
+            &self.styles
+        }
+        fn to_projected(&self, source: SourceByte, _: ConcealBias) -> Option<ProjectedByte> {
+            Some(ProjectedByte(source.0))
+        }
+        fn to_source(&self, projected: ProjectedByte, _: ConcealBias) -> Option<SourceByte> {
+            Some(SourceByte(projected.0))
+        }
+    }
+
+    #[test]
+    fn projection_multiline_run_coverage_and_marked_fonts() {
+        let text = "a\n\nbc\r\nd";
+        let fixture = StyledFixture {
+            source: SourceSnapshot {
+                stamp: SourceStamp {
+                    document: 1,
+                    generation: 0,
+                },
+                text: Arc::from(text),
+            },
+            styles: vec![ProjectionStyle {
+                range: ProjectedByte(3)..ProjectedByte(5),
+                font_family: Some("monospace".into()),
+                bold: true,
+                italic: false,
+                strikethrough: false,
+            }],
+        };
+        let font = gpui::font("sans-serif");
+        let underline = Some(UnderlineStyle {
+            thickness: px(1.),
+            color: None,
+            wavy: false,
+        });
+        let runs = visible_buffer_lines_for_runs(
+            &[0, 1, 2, 3],
+            &Rope::from(text),
+            &fixture,
+            &font,
+            gpui::black(),
+            Some(4..5),
+            underline,
+        );
+        assert_eq!(runs.iter().map(|r| r.len).sum::<usize>(), text.len());
+        let first = runs_for_range(&runs, 0, &(0..1));
+        assert_eq!(first.iter().map(|r| r.len).sum::<usize>(), 1);
+        let code = runs_for_range(&runs, 3, &(0..2));
+        assert_eq!(code.iter().map(|r| r.len).sum::<usize>(), 2);
+        assert!(
+            code.iter().all(|r| r.font.family.as_ref() == "monospace"
+                && r.font.weight == gpui::FontWeight::BOLD)
+        );
+        assert!(code[0].underline.is_none());
+        assert!(code[1].underline.is_some());
+        let last = runs_for_range(&runs, 7, &(0..1));
+        assert_eq!(last.iter().map(|r| r.len).sum::<usize>(), 1);
+        assert_eq!(last[0].font, font);
+        // A viewport beginning after the empty line uses absolute marked offsets
+        // but local run accounting, without borrowing the preceding row's font.
+        let tail = visible_buffer_lines_for_runs(
+            &[2, 3],
+            &Rope::from(text),
+            &fixture,
+            &font,
+            gpui::black(),
+            Some(4..5),
+            underline,
+        );
+        assert_eq!(tail.iter().map(|r| r.len).sum::<usize>(), text.len() - 3);
+        assert_eq!(runs_for_range(&tail, 4, &(0..1))[0].font, font);
+    }
+}
