+#[gpui::test]
+fn large2803_row_subranges_keep_bytes_styles_and_geometry(cx: &mut gpui::TestAppContext) {
+    cx.update(crate::init);
+    let visual = cx.add_empty_window();
+    let text = "prefix שלום🙂 e\u{301} русский suffix";
+    let at = text.find('ש').unwrap();
+    // Full source, nonzero UTF-8 subrange, a wrapped full range, and small text.
+    for (range, whole) in [(0..text.len(), true), (at..text.len() - 7, true),
+        (0..text.len(), false), (at..at + "שלום".len(), false), (0..6, true)] {
+        let actual = source_row_text(text, &range, whole);
+        let original: SharedString = text[range.clone()].to_string().into();
+        assert_eq!(actual, original);
+        visual.update(|window, _| {
+            let runs = [TextRun { len: actual.len(), font: gpui::font("test-font"),
+                color: gpui::red(), background_color: Some(gpui::blue()),
+                ..Default::default() }];
+            let next = window.text_system().shape_line(actual.clone(), px(16.), &runs, None);
+            let old = window.text_system().shape_line(original, px(16.), &runs, None);
+            assert_eq!(next.width, old.width);
+            assert_eq!(next.runs.len(), old.runs.len());
+            for (next_run, old_run) in next.runs.iter().zip(&old.runs) {
+                assert_eq!(next_run.glyphs.len(), old_run.glyphs.len());
+                for (next_glyph, old_glyph) in next_run.glyphs.iter().zip(&old_run.glyphs) {
+                    assert_eq!((next_glyph.id, next_glyph.index, next_glyph.position, next_glyph.is_emoji),
+                        (old_glyph.id, old_glyph.index, old_glyph.position, old_glyph.is_emoji));
+                }
+            }
+            for index in actual.char_indices().map(|(ix, _)| ix).chain([actual.len()]) {
+                assert_eq!(next.x_for_index(index), old.x_for_index(index));
+                let x = old.x_for_index(index);
+                assert_eq!(next.closest_index_for_x(x), old.closest_index_for_x(x));
+                assert_eq!(next.index_for_x(x), old.index_for_x(x));
+            }
+            assert_eq!(next.runs.iter().map(|r| r.font_id).collect::<Vec<_>>(),
+                old.runs.iter().map(|r| r.font_id).collect::<Vec<_>>());
+        });
+    }
+    take();
+    let large = "nonzero שלום🙂 ".repeat(140_000);
+    // Wrapped and nonzero subranges retain the original allocation path too.
+    for (range, whole) in [(0..large.len(), false), (1..large.len(), true)] {
+        let shaped = source_row_text(&large, &range, whole);
+        assert_eq!(shaped.as_str(), &large[range]);
+        assert_eq!(take()[0].source_sized_allocations, 2);
+    }
+}
