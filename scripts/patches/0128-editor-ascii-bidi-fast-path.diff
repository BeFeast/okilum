+#[cfg(test)]
+mod edit2803_tests {
+    use super::*;
+
+    #[test]
+    fn large_ascii_layout_does_not_allocate_full_bidi_levels() {
+        for text in ["abc 123", "a\t!= ->", "עברית", "abc مرحبا", "a\u{202e}123\u{202c}"] {
+            assert_eq!(needs_bidi_geometry(text), unicode_bidi::BidiInfo::new(text, None).has_rtl());
+        }
+        let text = "{\"key\":\"value\"} ".repeat(256 * 1024);
+        let started = std::time::Instant::now();
+        for _ in 0..8 {
+            assert!(!needs_bidi_geometry(std::hint::black_box(&text)));
+        }
+        assert!(started.elapsed() < std::time::Duration::from_millis(250),
+            "ASCII layout must skip full Unicode bidi analysis: {:?}", started.elapsed());
+    }
