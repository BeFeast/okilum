+    fn paste_exact(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        if !self.is_editable()
+            || !self.focus_handle.is_focused(window)
+            || !window.is_window_active()
+        {
+            cx.emit(ClipboardPasteEvent::Failed(ClipboardReadError::Cancelled));
+            return;
+        }
+        let Some(provider) = self.exact_clipboard.provider.clone() else {
+            cx.emit(ClipboardPasteEvent::Failed(ClipboardReadError::Unsupported));
+            return;
+        };
+        self.sync_projection_active();
+        let (nonce, revision, request) = match self.exact_clipboard.begin() {
+            Ok(request) => request,
+            Err(error) => {
+                cx.emit(ClipboardPasteEvent::Failed(error));
+                return;
+            }
+        };
+        let source = self.source_stamp();
+        let active = self.projection.active.clone();
+        let task = provider.read_text(request, cx);
+        cx.spawn_in(window, async move |this, cx| {
+            let result = task.await;
+            let _ = this.update_in(cx, |state, window, cx| {
+                let valid = state.exact_clipboard.complete(nonce, revision)
+                    && source == state.source_stamp()
+                    && active == state.projection.active
+                    && state.is_editable()
+                    && state.focus_handle.is_focused(window)
+                    && window.is_window_active();
+                if !valid {
+                    cx.emit(ClipboardPasteEvent::Failed(ClipboardReadError::Cancelled));
+                    return;
+                }
+                match result {
+                    Ok(Some(text)) => {
+                        state.undo_manager.pending_intent = Some(EditIntent::Atomic);
+                        state.replace_text_in_range_silent(None, &text, window, cx);
+                        state.scroll_to(state.cursor(), None, cx);
+                        cx.emit(ClipboardPasteEvent::Applied {
+                            request: nonce,
+                            bytes: text.len(),
+                        });
+                    }
+                    Ok(None) => {
+                        cx.emit(ClipboardPasteEvent::Failed(ClipboardReadError::Unavailable))
+                    }
+                    Err(error) => cx.emit(ClipboardPasteEvent::Failed(error)),
+                }
+            });
+        })
+        .detach();
+    }
