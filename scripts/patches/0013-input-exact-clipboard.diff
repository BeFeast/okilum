--- /dev/null
+++ b/crates/base/src/input/clipboard.rs
@@ -0,0 +1,102 @@
+//! Optional exact-text clipboard input for the native projection candidate.
+use gpui::{App, Task};
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ClipboardReadError {
+    Unsupported,
+    Unavailable,
+    Busy,
+    Cancelled,
+    Timeout,
+    TooLarge,
+    InvalidUtf8,
+    ChangedOffer,
+    AmbiguousSeat,
+    Io,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ClipboardPasteEvent {
+    Applied { request: u64, bytes: usize },
+    Failed(ClipboardReadError),
+}
+
+/// Cooperative cancellation; providers must also enforce their own finite deadline.
+#[derive(Clone, Default)]
+pub struct ClipboardReadRequest(Arc<AtomicBool>);
+impl ClipboardReadRequest {
+    pub fn is_cancelled(&self) -> bool {
+        self.0.load(Ordering::Acquire)
+    }
+    pub(super) fn cancel(&self) {
+        self.0.store(true, Ordering::Release);
+    }
+}
+
+pub trait ExactClipboardProvider: Send + Sync {
+    /// Construct a task immediately. All transport work belongs on a background
+    /// executor. Some("") is valid text; None means no available selection.
+    fn read_text(
+        &self,
+        request: ClipboardReadRequest,
+        cx: &App,
+    ) -> Task<Result<Option<String>, ClipboardReadError>>;
+}
+
+#[derive(Default)]
+pub(super) struct ClipboardSession {
+    pub enabled: bool,
+    pub provider: Option<Arc<dyn ExactClipboardProvider>>,
+    revision: u64,
+    nonce: u64,
+    pending: Option<(u64, ClipboardReadRequest)>,
+}
+impl ClipboardSession {
+    pub(super) fn invalidate(&mut self) {
+        self.revision = self.revision.wrapping_add(1);
+        // Keep the slot occupied while the cancelled physical read drains.
+        // Providers must poll cancellation and finish within their deadline.
+        if let Some((_, request)) = &self.pending {
+            request.cancel();
+        }
+    }
+    pub(super) fn begin(&mut self) -> Result<(u64, u64, ClipboardReadRequest), ClipboardReadError> {
+        if self.pending.is_some() {
+            return Err(ClipboardReadError::Busy);
+        }
+        self.nonce = self.nonce.wrapping_add(1);
+        let request = ClipboardReadRequest::default();
+        self.pending = Some((self.nonce, request.clone()));
+        Ok((self.nonce, self.revision, request))
+    }
+    pub(super) fn complete(&mut self, nonce: u64, revision: u64) -> bool {
+        if self.pending.as_ref().is_none_or(|(id, _)| *id != nonce) {
+            return false;
+        }
+        let (_, request) = self.pending.take().unwrap();
+        revision == self.revision && !request.is_cancelled()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn projection_clipboard_busy_preserves_first_and_aba_cancels() {
+        let mut session = ClipboardSession::default();
+        let (id, revision, request) = session.begin().unwrap();
+        assert!(matches!(session.begin(), Err(ClipboardReadError::Busy)));
+        assert!(!request.is_cancelled());
+        assert!(session.complete(id, revision));
+        let (id, revision, request) = session.begin().unwrap();
+        session.invalidate();
+        session.invalidate();
+        assert!(request.is_cancelled());
+        assert!(!session.complete(id, revision));
+        assert!(session.begin().is_ok());
+    }
+}
