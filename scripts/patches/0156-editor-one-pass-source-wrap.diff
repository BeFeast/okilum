+/// The rows of a slice that starts at a row start, split at LF exactly as
+/// `slice_line` splits them (a CR stays in its row), in one walk over the
+/// chunks. The slice ends where its last row ends, so it yields one row per
+/// LF plus the last row.
+struct SourceRows<'a, I: Iterator<Item = &'a str>> {
+    chunks: I,
+    /// What is left of the current chunk.
+    chunk: &'a str,
+    /// The start of a row that spans chunks.
+    pending: String,
+    spanning: bool,
+    finished: bool,
+}
+
+impl<'a, I: Iterator<Item = &'a str>> SourceRows<'a, I> {
+    fn new(chunks: I) -> Self {
+        Self { chunks, chunk: "", pending: String::new(), spanning: false, finished: false }
+    }
+
+    fn finish_row(&mut self, piece: &'a str) -> Cow<'a, str> {
+        if self.spanning {
+            self.spanning = false;
+            self.pending.push_str(piece);
+            Cow::Owned(std::mem::take(&mut self.pending))
+        } else {
+            Cow::Borrowed(piece)
+        }
+    }
+}
+
+impl<'a, I: Iterator<Item = &'a str>> Iterator for SourceRows<'a, I> {
+    type Item = Cow<'a, str>;
+
+    fn next(&mut self) -> Option<Cow<'a, str>> {
+        if self.finished {
+            return None;
+        }
+        loop {
+            let chunk = self.chunk;
+            if let Some(at) = chunk.find('\n') {
+                self.chunk = &chunk[at + 1..];
+                return Some(self.finish_row(&chunk[..at]));
+            }
+            match self.chunks.next() {
+                Some(next) => {
+                    if !chunk.is_empty() {
+                        self.pending.push_str(chunk);
+                        self.spanning = true;
+                    }
+                    self.chunk = next;
+                }
+                None => {
+                    self.finished = true;
+                    self.chunk = "";
+                    return Some(self.finish_row(chunk));
+                }
+            }
+        }
+    }
+}
