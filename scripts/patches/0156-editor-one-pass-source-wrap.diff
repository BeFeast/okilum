+/// `gpui::LineWrapper::wrap_line` for a line of ASCII text (one text fragment),
+/// step for step and with the same character widths, so it gives the same
+/// boundaries and indents. It reads bytes from a table instead of a chain of
+/// decoded-char iterators: opening a 10 MiB note in Source wraps every row on
+/// the UI thread (#3073). Okilum's
+/// `issue3073_ascii_wrap_matches_the_line_wrapper` pins the equivalence.
+pub(crate) struct AsciiWrap {
+    widths: [Option<Pixels>; 128],
+}
+
+impl Default for AsciiWrap {
+    fn default() -> Self {
+        Self { widths: [None; 128] }
+    }
+}
+
+impl AsciiWrap {
+    /// `gpui::LineWrapper::is_word_char` restricted to ASCII.
+    #[inline]
+    fn is_word_char(c: u8) -> bool {
+        c.is_ascii_alphanumeric()
+            || matches!(
+                c,
+                b'-' | b'_' | b'.' | b'\'' | b'$' | b'%' | b'@' | b'#' | b'^' | b'~' | b','
+                    | b'=' | b':' | b';' | b'!' | b')' | b']' | b'}' | b'"'
+            )
+    }
+
+    #[inline]
+    fn width(&mut self, c: u8, width_of: &mut impl FnMut(char) -> Pixels) -> Pixels {
+        *self.widths[c as usize].get_or_insert_with(|| width_of(c as char))
+    }
+
+    /// The wrap boundaries of `line`, which must be ASCII. `width_of` gives a
+    /// character's width as the line wrapper measures it.
+    pub(crate) fn wrap(
+        &mut self,
+        line: &[u8],
+        wrap_width: Pixels,
+        width_of: &mut impl FnMut(char) -> Pixels,
+    ) -> Vec<gpui::Boundary> {
+        debug_assert!(line.is_ascii());
+        let mut boundaries = Vec::new();
+        let mut width = px(0.);
+        let mut first_non_whitespace_ix = None;
+        let mut indent: Option<u32> = None;
+        let mut last_candidate_ix = 0;
+        let mut last_candidate_width = px(0.);
+        let mut last_wrap_ix = 0;
+        let mut prev_c = 0u8;
+        for (ix, &c) in line.iter().enumerate() {
+            if c == b'\n' {
+                continue;
+            }
+            if Self::is_word_char(c) {
+                if prev_c == b' ' && c != b' ' && first_non_whitespace_ix.is_some() {
+                    last_candidate_ix = ix;
+                    last_candidate_width = width;
+                }
+            } else if c != b' ' && first_non_whitespace_ix.is_some() {
+                last_candidate_ix = ix;
+                last_candidate_width = width;
+            }
+            if c != b' ' && first_non_whitespace_ix.is_none() {
+                first_non_whitespace_ix = Some(ix);
+            }
+
+            let item_width = self.width(c, width_of);
+            width += item_width;
+            if width > wrap_width && ix > last_wrap_ix {
+                if let (None, Some(first_non_whitespace_ix)) = (indent, first_non_whitespace_ix) {
+                    indent = Some(
+                        gpui::LineWrapper::MAX_INDENT
+                            .min((first_non_whitespace_ix - last_wrap_ix) as u32),
+                    );
+                }
+                if last_candidate_ix > 0 {
+                    last_wrap_ix = last_candidate_ix;
+                    width -= last_candidate_width;
+                    last_candidate_ix = 0;
+                } else {
+                    last_wrap_ix = ix;
+                    width = item_width;
+                }
+                if let Some(indent) = indent {
+                    width += self.width(b' ', width_of) * indent as f32;
+                }
+                boundaries.push(gpui::Boundary { ix: last_wrap_ix, next_indent: indent.unwrap_or(0) });
+                // The line wrapper returns this boundary before it records
+                // the character as the previous one.
+                continue;
+            }
+            prev_c = c;
+        }
+        boundaries
+    }
+}
