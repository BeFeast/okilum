+/// Use the negotiated mode, not a desktop/session-name heuristic. The
+/// compositor's own controls must be the only ones when it grants SSD.
+#[cfg(any(target_os = "linux", test))]
+fn draw_client_window_controls(decorations: Decorations) -> bool {
+    matches!(decorations, Decorations::Client { .. })
