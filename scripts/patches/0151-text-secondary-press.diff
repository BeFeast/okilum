+/// A secondary (right) press on rendered text outside a link: the text of the
+/// inline element that was hit and the UTF-8 offset of the press in it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TextSecondaryPress {
+    text: SharedString,
+    offset: usize,
+}
+
+impl TextSecondaryPress {
+    pub(crate) fn new(text: SharedString, offset: usize) -> Self {
+        Self { text, offset }
+    }
+
+    /// The displayed text of the pressed inline element (one paragraph,
+    /// heading or table cell), not the Markdown source.
+    pub fn text(&self) -> &SharedString {
+        &self.text
+    }
+
+    /// The UTF-8 byte offset of the press in [`Self::text`].
+    pub fn offset(&self) -> usize {
+        self.offset
+    }
+}
+
+pub(crate) type TextSecondaryPressFn =
+    dyn Fn(&TextSecondaryPress, &gpui::MouseDownEvent, &mut Window, &mut App) + Send + Sync;
+
