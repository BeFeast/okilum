+    fn read_tile(
+        device: &ID3D11Device,
+        context: &ID3D11DeviceContext,
+        texture: &DirectXAtlasTexture,
+        bounds: Bounds<DevicePixels>,
+    ) -> Vec<u8> {
+        let mut desc = D3D11_TEXTURE2D_DESC::default();
+        unsafe { texture.texture.GetDesc(&mut desc) };
+        desc.Width = bounds.size.width.0 as u32;
+        desc.Height = bounds.size.height.0 as u32;
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.BindFlags = 0;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ.0 as u32;
+        let mut readback = None;
+        unsafe { device.CreateTexture2D(&desc, None, Some(&mut readback)) }.unwrap();
+        let readback = readback.unwrap();
+        let region = D3D11_BOX {
+            left: bounds.left().0 as u32,
+            top: bounds.top().0 as u32,
+            front: 0,
+            right: bounds.right().0 as u32,
+            bottom: bounds.bottom().0 as u32,
+            back: 1,
+        };
+        unsafe {
+            context.CopySubresourceRegion(&readback, 0, 0, 0, 0, &texture.texture, 0, Some(&region))
+        };
+        let mut mapped = D3D11_MAPPED_SUBRESOURCE::default();
+        unsafe { context.Map(&readback, 0, D3D11_MAP_READ, 0, Some(&mut mapped)) }.unwrap();
+        let width = bounds.size.width.0 as usize * texture.bytes_per_pixel as usize;
+        let mut result = Vec::new();
+        for row in 0..bounds.size.height.0 as usize {
+            // The mapped readback owns RowPitch * Height bytes until Unmap.
+            result.extend_from_slice(unsafe {
+                std::slice::from_raw_parts(
+                    mapped
+                        .pData
+                        .cast::<u8>()
+                        .add(row * mapped.RowPitch as usize),
+                    width,
+                )
+            });
+        }
+        unsafe { context.Unmap(&readback, 0) };
+        result
+    }
+
+    #[test]
+    fn atlas_upload_copies_padded_rows_at_nonzero_offsets_and_keeps_existing_pixels() {
+        let atlas = create_atlas().expect("native WARP device is required; never silently skip");
+        let mut state = atlas.0.lock();
+        let device = state.device.clone();
+        let context = state.device_context.clone();
+        for kind in [
+            AtlasTextureKind::Monochrome,
+            AtlasTextureKind::Polychrome,
+            AtlasTextureKind::Subpixel,
+        ] {
+            let texture = state
+                .push_texture(
+                    Size {
+                        width: DevicePixels(3),
+                        height: DevicePixels(5),
+                    },
+                    kind,
+                )
+                .unwrap();
+            let keeper = texture
+                .allocate(Size {
+                    width: DevicePixels(1),
+                    height: DevicePixels(1),
+                })
+                .unwrap();
+            let first = vec![73; texture.bytes_per_pixel as usize];
+            texture
+                .upload(&device, &context, keeper.bounds, &first)
+                .unwrap();
+            let tile = texture
+                .allocate(Size {
+                    width: DevicePixels(3),
+                    height: DevicePixels(5),
+                })
+                .unwrap();
+            assert_ne!(
+                tile.bounds.origin,
+                Point {
+                    x: DevicePixels(0),
+                    y: DevicePixels(0)
+                }
+            );
+            let bytes: Vec<_> = (0..3 * 5 * texture.bytes_per_pixel)
+                .map(|i| (i * 13 + 7) as u8)
+                .collect();
+            let before = STAGING_UPLOADS.with(|count| count.get());
+            texture
+                .upload(&device, &context, tile.bounds, &bytes)
+                .unwrap();
+            assert_eq!(
+                STAGING_UPLOADS.with(|count| count.get()),
+                before + 1,
+                "real upload must use staging/copy, not UpdateSubresource"
+            );
+            assert_eq!(read_tile(&device, &context, texture, tile.bounds), bytes);
+            assert_eq!(read_tile(&device, &context, texture, keeper.bounds), first);
+        }
+    }
+
+    #[test]
+    fn atlas_upload_failure_releases_allocation_and_does_not_cache_missing_pixels() {
+        let atlas = create_atlas().expect("native WARP device is required; never silently skip");
+        let key = make_image_key(93);
+        let size = Size {
+            width: DevicePixels(3),
+            height: DevicePixels(5),
+        };
+        let result = atlas.get_or_insert_with(&key, &mut || Ok(Some((size, Cow::Owned(vec![1])))));
+        assert!(result.is_err(), "truncated upload must not claim success");
+        {
+            let state = atlas.0.lock();
+            assert!(state.tiles_by_key.is_empty());
+            assert!(
+                state
+                    .polychrome_textures
+                    .textures
+                    .iter()
+                    .all(Option::is_none),
+                "failed upload must release its tile and texture reference"
+            );
+        }
+        let mut rebuilt = false;
+        let tile = atlas
+            .get_or_insert_with(&key, &mut || {
+                rebuilt = true;
+                Ok(Some((size, Cow::Owned(vec![41; 60]))))
+            })
+            .unwrap()
+            .unwrap();
+        assert!(
+            rebuilt,
+            "positive retry must rerun the builder, never reuse an uninitialized cached tile"
+        );
+        let state = atlas.0.lock();
+        assert_eq!(
+            read_tile(
+                &state.device,
+                &state.device_context,
+                state.texture(tile.texture_id),
+                tile.bounds
+            ),
+            vec![41; 60]
+        );
+    }
