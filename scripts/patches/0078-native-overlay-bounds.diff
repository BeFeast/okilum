 impl GlobalState {
     fn new() -> Self {
         Self {
+            native_overlays: HashMap::new(),
             app_menus: Vec::new(),
             deferred_popovers: Vec::new(),
             suppress_text_selection: false,
             text_view_state_stack: Vec::new(),
             selection_document_order: 1,
         }
+    }
+
+    /// Begin the current window's prepaint pass. Entries never survive a frame.
+    /// Native children read the complete list during paint, after deferred prepaint.
+    pub fn begin_native_overlays(window: &Window, cx: &mut App) {
+        Self::init(cx);
+        Self::global_mut(cx)
+            .native_overlays
+            .entry(window.window_handle().window_id())
+            .or_default()
+            .clear();
+    }
+
+    /// Record the resolved, clipped bounds of an actual overlay surface.
+    pub fn record_native_overlay(bounds: Bounds<Pixels>, window: &Window, cx: &mut App) {
+        Self::init(cx);
+        let bounds = bounds.intersect(&window.content_mask().bounds);
+        if bounds.size.width > gpui::px(0.) && bounds.size.height > gpui::px(0.) {
+            Self::global_mut(cx)
+                .native_overlays
+                .entry(window.window_handle().window_id())
+                .or_default()
+                .push(bounds);
+        }
+    }
+
+    pub fn native_overlays<'a>(window: &Window, cx: &'a App) -> &'a [Bounds<Pixels>] {
+        cx.try_global::<Self>()
+            .and_then(|state| {
+                state
+                    .native_overlays
+                    .get(&window.window_handle().window_id())
+            })
+            .map(Vec::as_slice)
+            .unwrap_or(&[])
     }
 
