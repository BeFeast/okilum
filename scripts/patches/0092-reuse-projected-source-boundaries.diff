+    struct IndexedFixture {
+        fixture: Fixture,
+        indexed: SourceSnapshot,
+        boundaries: Vec<usize>,
+        queries: std::sync::atomic::AtomicUsize,
+    }
+    impl SourceProjection for IndexedFixture {
+        fn source(&self) -> &SourceSnapshot { &self.fixture.source }
+        fn text(&self) -> &str { &self.fixture.source.text }
+        fn styles(&self) -> &[ProjectionStyle] { &[] }
+        fn markers(&self) -> &[ProjectionMarker] { &self.fixture.markers }
+        fn source_boundary(&self, current: &SourceSnapshot, offset: SourceByte) -> Option<bool> {
+            if self.indexed.stamp != current.stamp || self.indexed.text != current.text {
+                return None;
+            }
+            self.queries.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            Some(self.boundaries.binary_search(&offset.0).is_ok())
+        }
+        fn to_projected(&self, b: SourceByte, _: ConcealBias) -> Option<ProjectedByte> {
+            Some(ProjectedByte(b.0))
+        }
+        fn to_source(&self, b: ProjectedByte, _: ConcealBias) -> Option<SourceByte> {
+            Some(SourceByte(b.0))
+        }
+    }
