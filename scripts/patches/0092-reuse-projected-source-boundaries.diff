+    #[test]
+    fn marker_boundary_queries_reuse_exact_mapping_with_canonical_fallback() {
+        let source = SourceSnapshot {
+            stamp: SourceStamp { document: 73, generation: 5 },
+            text: Arc::from("- e\u{301} 🧠\r\n"),
+        };
+        let markers = vec![ProjectionMarker {
+            range: SourceByte(0)..SourceByte(1),
+            scope: SourceByte(0)..SourceByte(source.text.len()),
+            kind: MarkerKind::Bullet { depth: 1 },
+        }];
+        // The oracle is independent of either the cached or fallback code path.
+        let expected: Vec<_> = source.text.grapheme_indices(true).map(|(i, _)| i)
+            .chain(std::iter::once(source.text.len())).collect();
+        let fixture = |indexed: SourceSnapshot| Arc::new(IndexedFixture {
+            fixture: Fixture { source: source.clone(), markers: markers.clone() },
+            boundaries: indexed.text.grapheme_indices(true).map(|(i, _)| i)
+                .chain(std::iter::once(indexed.text.len())).collect(),
+            indexed, queries: std::sync::atomic::AtomicUsize::new(0),
+        });
+        let mapping = fixture(source.clone());
+        let pin = PinnedProjection {
+            stamp: LayoutStamp { source: source.stamp, presentation: 7 },
+            projection: mapping.clone(),
+        };
+        SOURCE_INDEX_BUILDS.with(|count| count.set(0));
+        let validated = source_for_markers(Some(&pin), pin.stamp, source.stamp, true,
+            &RefCell::new(None), |text| text == source.text.as_ref()).unwrap();
+        for offset in 0..=source.text.len() + 1 {
+            assert_eq!(validated.is_boundary(&pin, offset), expected.contains(&offset));
+        }
+        assert!(mapping.queries.load(std::sync::atomic::Ordering::Relaxed) > 0,
+            "positive control: the validated mapping answered real queries");
+        SOURCE_INDEX_BUILDS.with(|count| assert_eq!(count.get(), 0,
+            "a validated mapping must not rebuild the full source boundary index"));
+
+        // An old or foreign lease cannot authorize current-source boundaries.
+        for indexed in [
+            SourceSnapshot { stamp: SourceStamp { document: 74, ..source.stamp }, ..source.clone() },
+            SourceSnapshot { stamp: SourceStamp { generation: 6, ..source.stamp }, ..source.clone() },
+            SourceSnapshot { text: Arc::from("- different bytes"), ..source.clone() },
+        ] {
+            let stale = PinnedProjection { projection: fixture(indexed), ..pin.clone() };
+            SOURCE_INDEX_BUILDS.with(|count| count.set(0));
+            let validated = source_for_markers(Some(&stale), stale.stamp, source.stamp, true,
+                &RefCell::new(None), |text| text == source.text.as_ref()).unwrap();
+            for offset in 0..=source.text.len() + 1 {
+                assert_eq!(validated.is_boundary(&stale, offset), expected.contains(&offset));
+            }
+            SOURCE_INDEX_BUILDS.with(|count| assert_eq!(count.get(), 1,
+                "unsupported identity must segment canonical source exactly once"));
+        }
+        // Existing providers need not implement the optional query.
+        let plain = PinnedProjection { projection: Arc::new(Fixture {
+            source: source.clone(), markers,
+        }), ..pin.clone() };
+        SOURCE_INDEX_BUILDS.with(|count| count.set(0));
+        let fallback = source_for_markers(Some(&plain), plain.stamp, source.stamp, true,
+            &RefCell::new(None), |_| true).unwrap();
+        for offset in 0..=source.text.len() + 1 {
+            assert_eq!(fallback.is_boundary(&plain, offset), expected.contains(&offset));
+        }
+        SOURCE_INDEX_BUILDS.with(|count| assert_eq!(count.get(), 1));
+    }
