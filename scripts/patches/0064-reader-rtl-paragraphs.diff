 //! Per-paint lookup of GPUI's existing geometry, without repeated glyph-prefix scans.
-use gpui::{Pixels, Point, TextLayout, WrappedLineLayout, point};
+use gpui::{Bounds, Pixels, Point, TextAlign, TextLayout, WrappedLineLayout, point};
+
+/// A laid-out Inline's text with the alignment it is painted with. gpui paints
+/// each wrapped row at its alignment offset but hit-tests every row as if it
+/// were left aligned; this applies the same per-row offset both ways, so a
+/// right-aligned (RTL) paragraph selects and clicks where it is drawn (#1053).
+#[derive(Clone)]
+pub(crate) struct AlignedLayout {
+    layout: TextLayout,
+    align: TextAlign,
+}
+
+impl AlignedLayout {
+    pub(crate) fn new(layout: TextLayout, align: TextAlign) -> Self {
+        Self { layout, align }
+    }
+
+    pub(crate) fn line_height(&self) -> Pixels {
+        self.layout.line_height()
+    }
+
+    pub(crate) fn bounds(&self) -> Bounds<Pixels> {
+        self.layout.bounds()
+    }
+
+    /// `(row top, x offset)` of every wrapped row, top to bottom, as gpui's
+    /// paint computes it: the row's width is from its first glyph to the next
+    /// wrap boundary (or the line's end), aligned within the bounds' width.
+    pub(crate) fn row_offsets(&self) -> Vec<(Pixels, Pixels)> {
+        if self.align == TextAlign::Left {
+            return Vec::new();
+        }
+        let bounds = self.layout.bounds();
+        let line_height = self.layout.line_height();
+        let mut out = Vec::new();
+        let mut y = bounds.origin.y;
+        for line in self.layout.line_layouts() {
+            let layout = &line.unwrapped_layout;
+            let x_at = |b: &gpui::WrapBoundary| layout.runs[b.run_ix].glyphs[b.glyph_ix].position.x;
+            let mut start = gpui::px(0.);
+            let ends = line.wrap_boundaries.iter().map(x_at).chain([layout.width]);
+            for (row, end) in ends.enumerate() {
+                let width = end - start;
+                let offset = match self.align {
+                    TextAlign::Right => bounds.size.width - width,
+                    TextAlign::Center => (bounds.size.width - width) / 2.,
+                    TextAlign::Left => gpui::px(0.),
+                };
+                out.push((y + line_height * row, offset));
+                start = end;
+            }
+            y += line.size(line_height).height;
+        }
+        out
+    }
+
+    fn offset_at(offsets: &[(Pixels, Pixels)], y: Pixels) -> Pixels {
+        let at = offsets.partition_point(|(top, _)| *top <= y);
+        at.checked_sub(1).map_or(gpui::px(0.), |i| offsets[i].1)
+    }
+
+    pub(crate) fn index_for_position(&self, position: Point<Pixels>) -> Result<usize, usize> {
+        let offset = Self::offset_at(&self.row_offsets(), position.y);
+        self.layout
+            .index_for_position(point(position.x - offset, position.y))
+    }
+
+    pub(crate) fn position_for_index(&self, index: usize) -> Option<Point<Pixels>> {
+        let position = self.layout.position_for_index(index)?;
+        Some(point(position.x + Self::offset_at(&self.row_offsets(), position.y), position.y))
+    }
+}
 
