+    fn typewriter_scroll_centres_the_caret_row_within_the_extent() {
+        let y = |top: f32, viewport: f32, content: f32| {
+            f32::from(super::typewriter_scroll_y(px(top), px(20.), px(viewport), px(content)))
+        };
+        // Mid-note: the row's middle sits at the viewport's middle.
+        assert_eq!(y(10_000., 400., 1_000_000.), 200. - 10_000. - 10.);
+        // Near the start there is nothing above to scroll to.
+        assert_eq!(y(100., 400., 1_000_000.), 0.);
+        // Near the end it stops at the scrollable extent.
+        assert_eq!(y(990_000., 400., 990_100.), -(990_100. - 400.));
+        // A note shorter than the view never scrolls.
+        assert_eq!(y(40., 400., 200.), 0.);
+    }
