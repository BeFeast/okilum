+    /// Typewriter mode (#1643): from the next frame on, every caret move and
+    /// every edit (Undo too) puts the caret row at the middle of the
+    /// viewport. Scrolling by hand is free until the caret moves again. Room
+    /// below the last line comes from [`Self::set_scroll_beyond_last_line`].
+    pub fn set_typewriter(&mut self, on: bool, cx: &mut Context<Self>) {
+        if self.typewriter == on {
+            return;
+        }
+        self.typewriter = on;
+        // Centre at once instead of on the next key.
+        self.last_selected_range = None;
+        cx.notify();
+    }
+
+    pub fn is_typewriter(&self) -> bool {
+        self.typewriter
+    }
+
+    /// Focus mode (#1643): `None` turns it off.
+    pub fn set_focus_mode(&mut self, mode: Option<FocusMode>, cx: &mut Context<Self>) {
+        if mode.is_none() {
+            self.focus_lines.clear();
+        }
+        self.focus_mode = mode;
+        cx.notify();
+    }
+
+    /// The wash of the current focus mode; `None` when it is off.
+    pub fn focus_wash(&self) -> Option<gpui::Hsla> {
+        self.focus_mode.as_ref().map(FocusMode::wash)
+    }
+
+    /// The buffer lines focus mode kept bright in the last frame; empty when
+    /// it is off or before the first frame.
+    pub fn focus_lines(&self) -> &[Range<usize>] {
+        &self.focus_lines
+    }
