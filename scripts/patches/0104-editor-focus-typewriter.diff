+/// Which lines focus mode keeps bright (#1643): called once per frame with
+/// the text and the caret's byte offset, it returns buffer-line ranges. It
+/// runs on every frame, so it must not do work that grows with the text.
+pub type FocusLines = Rc<dyn Fn(&Rope, usize) -> Vec<Range<usize>>>;
+
+/// Focus mode (#1643): every line but the ones [`FocusLines`] keeps is
+/// covered with `wash`, the surface colour at partial opacity, so a dimmed
+/// line reads as the text at reduced opacity on that surface.
+#[derive(Clone)]
+pub struct FocusMode {
+    lines: FocusLines,
+    wash: gpui::Hsla,
+}
+
+impl FocusMode {
+    pub fn new(wash: gpui::Hsla, lines: impl Fn(&Rope, usize) -> Vec<Range<usize>> + 'static) -> Self {
+        Self { lines: Rc::new(lines), wash }
+    }
+
+    pub fn wash(&self) -> gpui::Hsla {
+        self.wash
+    }
+
+    pub(super) fn lines(&self, text: &Rope, cursor: usize) -> Vec<Range<usize>> {
+        (self.lines)(text, cursor)
+    }
+}
