+    /// #1051: a task box toggles on release over the same box; a release
+    /// elsewhere, or after the source changed, cancels.
+    #[gpui::test]
+    fn task_box_toggles_on_release_over_the_same_box(cx: &mut TestAppContext) {
+        use std::{cell::Cell, rc::Rc};
+        cx.update(crate::init);
+        let view = InputView::build_editor(cx, |state| state.folding(false).searchable(false)
+            .wrapping_indent(super::super::WrappingIndent::None));
+        let mut v = VisualTestContext::from_window(view.window_handle.into(), cx);
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            state.set_value("- [ ] task\nnext\n", window, cx);
+            state.set_projection_provider(Some(Arc::new(PrefixRevealProvider)), cx);
+            window.activate_window();
+            state.focus(window, cx);
+        }));
+        v.run_until_parked();
+        let clicks = Rc::new(Cell::new(0));
+        let _watch = v.update(|_, cx| {
+            let clicks = clicks.clone();
+            cx.subscribe(&view.input, move |_, _: &crate::input::projection::MarkerClick, _| {
+                clicks.set(clicks.get() + 1)
+            })
+        });
+        let box_bounds = Bounds::new(point(px(20.), px(20.)), size(px(12.), px(12.)));
+        let inside = box_bounds.center();
+        let away = point(px(300.), px(200.));
+        let down = |position| MouseDownEvent {
+            button: MouseButton::Left,
+            position,
+            modifiers: Default::default(),
+            click_count: 1,
+            first_mouse: false,
+        };
+        let up = |position| MouseUpEvent {
+            button: MouseButton::Left,
+            position,
+            modifiers: Default::default(),
+            click_count: 1,
+        };
+        let paint_box = |state: &mut InputBaseState<EditorMode>| {
+            *state.painted_tasks.borrow_mut() =
+                Some((state.source_stamp(), vec![(2..5, false, box_bounds)]));
+        };
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            paint_box(state);
+            // Press arms, nothing toggles yet; release on the box commits.
+            state.on_mouse_down(&down(inside), window, cx);
+            assert!(state.armed_task.is_some(), "positive control: the press hit the box");
+            state.on_mouse_up(&up(inside), window, cx);
+        }));
+        assert_eq!(clicks.get(), 1, "release over the box toggles");
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            paint_box(state);
+            state.on_mouse_down(&down(inside), window, cx);
+            state.on_mouse_up(&up(away), window, cx);
+            assert!(state.armed_task.is_none());
+        }));
+        assert_eq!(clicks.get(), 1, "release elsewhere cancels");
+        v.update(|window, cx| view.input.update(cx, |state, cx| {
+            paint_box(state);
+            state.on_mouse_down(&down(inside), window, cx);
+            state.set_value("- [x] task\nnext\n", window, cx);
+            state.on_mouse_up(&up(inside), window, cx);
+        }));
+        assert_eq!(clicks.get(), 1, "a source change since the press cancels");
+    }
