+/// The last classified layout painted before Live Preview drew the note raw
+/// while a classification was pending (#1304), and the scroll the raw frames'
+/// own anchors and block compensation applied since. The frame that is
+/// classified again anchors from this layout at the scroll without that
+/// compensation, never from the raw rows in between.
+pub(super) struct FallbackAnchor {
+    pub(super) layout: LastLayout,
+    pub(super) compensation: Pixels,
+}
