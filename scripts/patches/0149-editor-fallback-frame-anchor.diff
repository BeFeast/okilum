+/// The source position `state` holds across a frame, and its content y in
+/// `last`, drawn at scroll `scroll_y`: the start of the edit since `last`, the
+/// caret, or the first visible row, whichever is on screen first.
+fn source_anchor_in<M: InputModeKind>(
+    state: &InputBaseState<M>,
+    last: &LastLayout,
+    scroll_y: Pixels,
+    viewport: Pixels,
+) -> Option<(usize, Pixels, bool, &'static str)> {
+    if last.source_stamp == state.source_stamp()
+        && last.presentation_epoch == state.presentation_epoch() {
+        return None;
+    }
+    if last.source_stamp.document != state.source_stamp().document { return None; }
+    let current = state.source_snapshot();
+    let edit = current.text.edit_steps(current.stamp.generation.checked_sub(last.source_stamp.generation)?)?;
+    // S1: hold the edit's old source row. S2 maps the caret or first
+    // visible source row with the same revision-bound receipt.
+    if !edit.old.is_empty() || edit.inserted != 0 {
+        let start = edit.old.start;
+        if let Some(offset) = last.project(start, ConcealBias::Left) {
+            let mut y = last.visible_top;
+            for (line, line_start) in last.lines.iter().zip(&last.visible_line_byte_offsets) {
+                if offset >= *line_start {
+                    if let Some(pos) = line.position_for_index(offset - line_start, last, false) {
+                        let content_y = y + pos.y;
+                        let screen_y = content_y + scroll_y;
+                        if screen_y >= px(0.) && screen_y < viewport {
+                            return Some((start, content_y, false, "edit"));
+                        }
+                        break;
+                    }
+                }
+                y += line.size(&last.rows).height;
+            }
+        }
+    }
+    let current_offset = state.cursor();
+    let old_offset = edit.backward(current_offset);
+    let offset = last.project(old_offset, ConcealBias::Right)?;
+    let mut y = last.visible_top;
+    for (line, start) in last.lines.iter().zip(&last.visible_line_byte_offsets) {
+        if offset >= *start {
+            if let Some(pos) = line.position_for_index(offset - start, last, state.cursor_line_end_affinity) {
+                let content_y = y + pos.y;
+                let screen_y = content_y + scroll_y;
+                if screen_y >= px(0.) && screen_y < viewport {
+                    return Some((current_offset, content_y, state.cursor_line_end_affinity, "caret"));
+                }
+                break;
+            }
+        }
+        y += line.size(&last.rows).height;
+    }
+    // With the caret outside the viewport, retain the first visible
+    // shaped row's source anchor instead. This also works inside one
+    // very long wrapped source line.
+    let mut y = last.visible_top;
+    for (line, start) in last.lines.iter().zip(&last.visible_line_byte_offsets) {
+        let mut projected = *start;
+        let line_rows = line.rows(&last.rows);
+        for (row_index, row) in line.wrapped_lines.iter().enumerate() {
+            let screen_y = y + scroll_y;
+            if screen_y >= px(0.) && screen_y < viewport {
+                let old = last.source(projected, ConcealBias::Right)?;
+                let current = edit.forward(old);
+                return Some((current, y, false, "row"));
+            }
+            projected += row.len;
+            y += line_rows.row_height(row_index);
+        }
+    }
+    None
+}
