+    /// Set how long after an IME commit Enter and Tab still belong to the
+    /// composition. Some input methods deliver the key that confirmed a
+    /// candidate after the commit itself; within this window it inserts a
+    /// plain newline or tab and never accepts a completion. Default is zero:
+    /// only an active composition is guarded.
+    pub fn set_ime_settle(&mut self, settle: Duration) {
+        self.ime_settle = settle;
+    }
+
+    /// True while an IME composition (marked text) is active.
+    pub fn ime_composing(&self) -> bool {
+        self.ime_marked_range.is_some()
+    }
+
+    /// True while composing and for the settle window after a commit
+    /// (see [`Self::set_ime_settle`]).
+    pub fn ime_settling(&self, cx: &App) -> bool {
+        self.ime_composing()
+            || self.ime_committed_at.is_some_and(|at| {
+                cx.background_executor().now().saturating_duration_since(at) < self.ime_settle
+            })
+    }
+
+    fn note_ime_commit(&mut self, cx: &App) {
+        self.ime_committed_at = Some(cx.background_executor().now());
+    }
