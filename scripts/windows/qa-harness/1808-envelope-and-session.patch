+function Check($value,$label){if(!$value){throw "FAIL $label"};$script:n++}
+function Reject([scriptblock]$Action){$bad=$false;try{& $Action|Out-Null}catch{$bad=$true};Check $bad 'expected rejection'}
+# Registry/process adapters only: state machine and real on-disk snapshot are production code.
+$script:values=@{ToastEnabled=1;NOC_GLOBAL_SETTING_TOASTS_ENABLED=$null}
+$script:running=$true;$script:session=1;$script:events=@();$script:failSet=$false
+function GetQuietSessionId {$script:session}
+function GetQuietRegistry($Path,$Name){[pscustomobject]@{path=$Path;name=$Name;key_existed=($Name -eq 'ToastEnabled');present=($null -ne $script:values[$Name]);value=$script:values[$Name];kind='DWord'}}
+function SetQuietRegistry($Record){$script:events+=@('set-'+$Record.name);$script:values[$Record.name]=0;if($script:failSet){throw 'injected set failure'}}
+function RestoreQuietRegistry($Record){$script:events+=@('restore-'+$Record.name);$script:values[$Record.name]=$Record.value}
+function GetQuietOneDrive {if($script:running){'C:\Program Files\Microsoft OneDrive\OneDrive.exe'}}
+function StopQuietOneDrive($Path){$script:events+=@('stop');$script:running=$false}
+function StartQuietOneDrive($Path){$script:events+=@('start');$script:running=$true}
+try{
+ $out=EnterQuietSession $root
+ Check ($out -ceq 'QUIET_SESSION_READY' -and !$script:running -and $script:values.ToastEnabled -eq 0) 'quiet positive control'
+ Check ((Get-Content "$root/session-quiet-before.json" -Raw|ConvertFrom-Json).registry[0].value -eq 1) 'original value saved before mutation'
+ Reject {EnterQuietSession $root}
+ $out=ExitQuietSession $root
+ Check ($out -ceq 'QUIET_SESSION_RESTORED' -and $script:running -and $script:values.ToastEnabled -eq 1 -and $null -eq $script:values.NOC_GLOBAL_SETTING_TOASTS_ENABLED) 'exact value and missing baseline restored'
+ $other=Join-Path $root 'partial';New-Item -ItemType Directory $other|Out-Null
+ $startsBefore=@($script:events|Where-Object {$_ -eq 'start'}).Count
+ $script:failSet=$true;Reject {EnterQuietSession $other};$script:failSet=$false
+ $out=ExitQuietSession $other
+ Check ($script:values.ToastEnabled -eq 1) 'partial preparation restores baseline'
+ Check (@($script:events|Where-Object {$_ -eq 'start'}).Count -eq $startsBefore) 'failed shutdown does not duplicate running OneDrive'
+ $script:session=0;Reject {EnterQuietSession (Join-Path $root 'wrong-session')}
+ Reject {ExitQuietSession $root}
+}finally{Remove-Item $root -Recurse -Force}
+"PASS $n session quiet lifecycle assertions; mock registry/process, no guest mutation"
