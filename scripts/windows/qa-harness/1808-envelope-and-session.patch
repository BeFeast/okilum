diff --git a/autosave-gate/boot_readback.py b/autosave-gate/boot_readback.py
new file mode 100644
index 0000000..a132280
--- /dev/null
+++ b/autosave-gate/boot_readback.py
@@ -0,0 +1,68 @@
+"""Bounded read-only post-rollback boot observation, never a gate/SSH repair."""
+import json
+from pathlib import Path
+import re
+import os
+import signal
+import subprocess
+import sys
+import time
+
+SCRIPT = """$ErrorActionPreference='Stop'
+if(!(Get-Process explorer -ErrorAction SilentlyContinue|Where-Object {$_.SessionId -eq 1})){Write-Output 'BOOT_DESKTOP_NOT_READY'; exit 75}
+'postcleanApps='+@(Get-Process okilum -ErrorAction SilentlyContinue).Count
+'postcleanTasks='+@(Get-ScheduledTask okilumqa-run -ErrorAction SilentlyContinue).Count
+exit 0
+"""
+
+
+def run_read(command, capture_output, text, timeout):
+    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=text, start_new_session=True)
+    try:
+        stdout, stderr = process.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        os.killpg(process.pid, signal.SIGKILL)
+        process.communicate(timeout=5)
+        raise
+    return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)
+
+
+def observe(vm, evidence, release, runner=run_read, clock=time.time, pause=time.sleep):
+    deadline = min(clock() + 120, release - 5)
+    attempts = []
+    state = 'deadline'
+    while deadline - clock() >= 1 and len(attempts) < 24:
+        limit = min(15, deadline - clock())
+        try:
+            result = runner([str(vm), 'ps', SCRIPT], capture_output=True, text=True, timeout=limit)
+            code, stdout, stderr = result.returncode, result.stdout, result.stderr
+            # vm.sh keeps SSH stderr in its existing separate file.
+            remote = vm.parent / 'last-ps.stderr'
+            if remote.exists():
+                stderr += remote.read_text(errors='replace')
+        except subprocess.TimeoutExpired:
+            code, stdout, stderr = 124, '', 'Post-rollback read timed out during boot'
+        attempt = dict(exit_code=code, stdout=stdout, stderr=stderr, observed_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(clock())))
+        attempts.append(attempt)
+        (evidence / 'postclean-boot-attempts.json').write_text(json.dumps(attempts, indent=2) + '\n')
+        if code == 0:
+            apps = re.findall(r'^postcleanApps=([0-9]+)$', stdout, re.M)
+            tasks = re.findall(r'^postcleanTasks=([0-9]+)$', stdout, re.M)
+            if apps == ['0'] and tasks == ['0']:
+                state = 'ready'; break
+            state = 'invalid-or-nonzero-counts'; break
+        text = stdout + stderr
+        transient = (code == 124 or (code == 255 and re.search(r'Connection timed out|Connection refused|Connection reset|No route to host|Connection closed', text, re.I)) or (code == 75 and stdout.strip() == 'BOOT_DESKTOP_NOT_READY'))
+        if not transient:
+            state = 'non-boot-error'; break
+        remaining = deadline - clock()
+        if remaining > 0:
+            pause(min(5, remaining))
+    receipt = dict(state=state, attempts=len(attempts), read_only=True, infrastructure_repair=False, guest_counts='zero' if state == 'ready' else 'UNKNOWN')
+    (evidence / 'postclean-boot.json').write_text(json.dumps(receipt, indent=2) + '\n')
+    print(json.dumps(receipt), flush=True)
+    return 0 if state == 'ready' else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(observe(Path(sys.argv[1]), Path(sys.argv[2]), int(sys.argv[3])))
