diff --git a/autosave-gate/session-quiet.ps1 b/autosave-gate/session-quiet.ps1
new file mode 100644
index 0000000..aba61cb
--- /dev/null
+++ b/autosave-gate/session-quiet.ps1
@@ -0,0 +1,73 @@
+# Per-attempt QA guest session only; snapshot clean is never modified.
+function GetQuietSessionId {(Get-Process -Id $PID).SessionId}
+function GetQuietRegistry($Path,$Name){
+ $exists=Test-Path $Path;$present=$false;$value=$null;$kind=$null
+ if($exists){$key=Get-Item $Path;$present=$key.GetValueNames() -contains $Name;if($present){$kind=[string]$key.GetValueKind($Name);$value=$key.GetValue($Name)}}
+ if($present -and $kind -cne 'DWord'){throw 'Unexpected toast registry value type'}
+ [pscustomobject]@{path=$Path;name=$Name;key_existed=$exists;present=$present;value=$value;kind=$kind}
+}
+function SetQuietRegistry($Record){
+ if(!(Test-Path $Record.path)){New-Item -Path $Record.path -Force|Out-Null}
+ New-ItemProperty -Path $Record.path -Name $Record.name -PropertyType DWord -Value 0 -Force|Out-Null
+ $actual=GetQuietRegistry $Record.path $Record.name
+ if(!$actual.present -or $actual.value -ne 0){throw 'Toast suppression readback failed'}
+}
+function RestoreQuietRegistry($Record){
+ if($Record.present){New-ItemProperty -Path $Record.path -Name $Record.name -PropertyType DWord -Value $Record.value -Force|Out-Null}
+ elseif(Test-Path $Record.path){Remove-ItemProperty -Path $Record.path -Name $Record.name -ErrorAction SilentlyContinue}
+ $actual=GetQuietRegistry $Record.path $Record.name
+ if($actual.present -ne $Record.present -or ($Record.present -and $actual.value -ne $Record.value)){throw 'Toast baseline restoration failed'}
+ if(!$Record.key_existed -and (Test-Path $Record.path)){
+  $key=Get-Item $Record.path
+  if(!$key.GetValueNames().Count -and !$key.GetSubKeyNames().Count){Remove-Item $Record.path}
+ }
+}
+function GetQuietOneDrive {
+ $allowed=@((Join-Path $env:LOCALAPPDATA 'Microsoft\OneDrive\OneDrive.exe'),(Join-Path $env:ProgramFiles 'Microsoft OneDrive\OneDrive.exe'))
+ if(${env:ProgramFiles(x86)}){$allowed+=Join-Path ${env:ProgramFiles(x86)} 'Microsoft OneDrive\OneDrive.exe'}
+ $paths=@()
+ foreach($process in @(Get-Process OneDrive -ErrorAction SilentlyContinue)){
+  if($process.SessionId -ne (GetQuietSessionId)){throw 'Foreign OneDrive session; no suppression'}
+  $path=$process.MainModule.FileName
+  if($allowed -notcontains $path){throw 'Unknown OneDrive executable; no suppression'}
+  $paths+=@($path)
+ }
+ @($paths|Select-Object -Unique)
+}
+function StopQuietOneDrive([string]$Path){
+ $command=Start-Process -FilePath $Path -ArgumentList '/shutdown' -PassThru
+ if(!$command.WaitForExit(20000)){throw 'OneDrive shutdown command deadline'}
+ $clock=[Diagnostics.Stopwatch]::StartNew()
+ while(@(Get-Process OneDrive -ErrorAction SilentlyContinue).Count -and $clock.Elapsed.TotalSeconds -lt 20){Start-Sleep -Milliseconds 250}
+ if(@(Get-Process OneDrive -ErrorAction SilentlyContinue).Count){throw 'OneDrive remained active; STOP, no kill fallback'}
+}
+function StartQuietOneDrive([string]$Path){Start-Process -FilePath $Path -ArgumentList '/background'|Out-Null}
+function EnterQuietSession([string]$Directory){
+ if((GetQuietSessionId) -ne 1){throw 'Quiet preparation requires own QA session1'}
+ $snapshot=Join-Path $Directory 'session-quiet-before.json'
+ if(Test-Path $snapshot){throw 'Quiet session already prepared; no repeat'}
+ $records=@(
+  (GetQuietRegistry 'HKCU:\Software\Microsoft\Windows\CurrentVersion\PushNotifications' 'ToastEnabled'),
+  (GetQuietRegistry 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Notifications\Settings' 'NOC_GLOBAL_SETTING_TOASTS_ENABLED')
+ )
+ # Validate all process identities before any mutation. Save baseline first.
+ $paths=@(GetQuietOneDrive)
+ $before=[ordered]@{session=1;registry=$records;onedrive=$paths}
+ $before|ConvertTo-Json -Depth 8|Set-Content $snapshot -Encoding UTF8
+ foreach($record in $records){SetQuietRegistry $record}
+ foreach($path in $paths){StopQuietOneDrive $path}
+ if(@(GetQuietOneDrive).Count){throw 'OneDrive suppression incomplete'}
+ @{session=1;toast_values_zero=$true;onedrive_processes=0;scope='until cleanup or canonical rollback'}|ConvertTo-Json|Set-Content (Join-Path $Directory 'session-quiet-active.json')
+ 'QUIET_SESSION_READY'
+}
+function ExitQuietSession([string]$Directory){
+ $snapshot=Join-Path $Directory 'session-quiet-before.json'
+ if(!(Test-Path $snapshot)){'QUIET_SESSION_NOT_PREPARED';return}
+ $before=Get-Content $snapshot -Raw -Encoding UTF8|ConvertFrom-Json
+ if($before.session -ne (GetQuietSessionId) -or $before.session -ne 1){throw 'Quiet restoration session mismatch'}
+ foreach($record in @($before.registry)){RestoreQuietRegistry $record}
+ $active=@(GetQuietOneDrive);$restarted=0
+ foreach($path in @($before.onedrive)){if($active -notcontains $path){StartQuietOneDrive $path;$restarted++}}
+ @{session=1;registry_restored=$true;onedrive_restart_requested=$restarted}|ConvertTo-Json|Set-Content (Join-Path $Directory 'session-quiet-restored.json')
+ 'QUIET_SESSION_RESTORED'
+}
