+++ b/autosave-gate/test_boot_readback.py
@@ -0,0 +1,42 @@
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from boot_readback import observe
+
+class Boot(unittest.TestCase):
+    def run_case(self, responses, release=1000):
+        with tempfile.TemporaryDirectory() as directory:
+            p=Path(directory);now=[0];calls=[]
+            def runner(command, **kwargs):
+                calls.append(command);now[0]+=1
+                code,out,err=responses[min(len(calls)-1,len(responses)-1)]
