// Version resource for the sync helper (#1037): Task Manager and file
// properties show «Okilum Sync» with the app's version. the first line is the
// app icon when the Windows build provides one.
@ICON_LINE@
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 1
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OK Labs\0"
            VALUE "FileDescription", "Okilum Sync\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "okilum-sync-supervisor\0"
            VALUE "OriginalFilename", "okilum-sync-supervisor.exe\0"
            VALUE "ProductName", "Okilum\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
