// Portable diagnostic resources; GPUI supplies the PerMonitorV2 manifest.
1 ICON "@ICON@"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS 0x40004L
FILETYPE 1
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OK Labs\0"
            VALUE "FileDescription", "Okilum Windows diagnostic\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "okilum\0"
            VALUE "OriginalFilename", "okilum.exe\0"
            VALUE "ProductName", "Okilum\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
