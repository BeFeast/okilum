{
  "schema": "okilum-theme/v1",
  "version": "1.0.0",
  "id": "obsidianite",
  "name": "Obsidianite",
  "basis": "Dark mode after the Obsidianite theme for Obsidian (github.com/bennyxguo/Obsidian-Obsidianite, MIT, (c) 2020 Guo Xiang): its .theme-dark canvas, text, cyan accent and H1, Dracula-style code and status colours, pink highlight. Obsidianite ships no light mode; the light variant here is derived, keeping the accent and heading hues. Links use Obsidianite's periwinkle so they never share the heading's cyan. Tuned to WCAG AA.",
  "modes": {
    "light": {
      "canvas": "#fbfafd",
      "surface": "#fbfafd",
      "surfaceRaised": "#f2f0f7",
      "sidebar": "#f1eff6",
      "text": "#24212e",
      "textMuted": "#55516a",
      "border": "#c6c1d4",
      "borderSubtle": "#e2dfea",
      "selected": "#dcecf2",
      "accent": "#087a91",
      "onAccent": "#ffffff",
      "focus": "#0b8ba5",
      "link": "#3d5fc2",
      "tile": "#e6f3f6",
      "warningTint": "#f5ebdc",
      "textFaint": "#787389",
      "heading": "#06768c",
      "hover": "#eeecf4",
      "missingLink": "#9a5300",
      "codeBg": "#f2f0f7",
      "codeBorder": "#e2dfea",
      "calloutQuestion": "#b4532a",
      "calloutImportant": "#7a4cc4",
      "notice": "#e6f3f6",
      "highlight": "#f4569d33",
      "scrim": "#24212e33",
      "findMatch": "#fbe0ec",
      "findCurrent": "#f5b3d0",
      "onStatus": "#ffffff",
      "success": "#2b7a3e",
      "warning": "#875600",
      "danger": "#bf2f4c",
      "info": "#086d84",
      "findMarkTrack": "#f1eff6",
      "findMark": "#8a5600",
      "findMarkCurrent": "#0b57d0"
    },
    "dark": {
      "canvas": "#100e17",
      "surface": "#100e17",
      "surfaceRaised": "#191621",
      "sidebar": "#191621",
      "text": "#bebebe",
      "textMuted": "#9b98a8",
      "border": "#3a3550",
      "borderSubtle": "#221e2e",
      "selected": "#2a2640",
      "accent": "#0fb6d6",
      "onAccent": "#100e17",
      "focus": "#0fb6d6",
      "link": "#7aa2f7",
      "tile": "#191621",
      "warningTint": "#2a2119",
      "textFaint": "#7b7790",
      "heading": "#0fb6d6",
      "hover": "#1d1a28",
      "missingLink": "#ebc47a",
      "codeBg": "#1f1d2b",
      "codeBorder": "#2c2940",
      "calloutQuestion": "#ffb86c",
      "calloutImportant": "#bd93f9",
      "notice": "#191621",
      "highlight": "#f4569d40",
      "scrim": "#05040a99",
      "findMatch": "#3d2f4f",
      "findCurrent": "#6b3a5c",
      "onStatus": "#100e17",
      "success": "#50fa7b",
      "warning": "#ffb86c",
      "danger": "#ff5555",
      "info": "#8be9fd",
      "findMarkTrack": "#191621",
      "findMark": "#f1fa8c",
      "findMarkCurrent": "#f4569d"
    }
  },
  "decorations": {
    "light": {
      "headingRule": {
        "from": "#c2306f",
        "to": "#fbfafd",
        "length": 0.35,
        "thickness": 1
      },
      "hr": {
        "edge": "#087a9100",
        "middle": "#087a91",
        "thickness": 1
      },
      "blockquote": {
        "background": {
          "angle": 135,
          "from": "#ebe8f2",
          "to": "#fbfafd"
        },
        "border": "#087a9180",
        "topBar": {
          "from": "#087a9180",
          "to": "#fbfafd00",
          "length": 0.6,
          "thickness": 2
        },
        "bottomBar": {
          "from": "#087a9180",
          "to": "#fbfafd00",
          "length": 0.25,
          "thickness": 2
        }
      },
      "linkMarker": {
        "from": "#087a9133",
        "to": "#087a9133",
        "height": 0.2,
        "bottom": 0.94
      },
      "bold": {
        "from": "#245fa6",
        "to": "#7140b8"
      }
    },
    "dark": {
      "headingRule": {
        "from": "#f4569d",
        "to": "#100e17",
        "length": 0.35,
        "thickness": 1
      },
      "hr": {
        "edge": "#0fb6d600",
        "middle": "#0fb6d6",
        "thickness": 1
      },
      "blockquote": {
        "background": {
          "angle": 135,
          "from": "#201c2973",
          "to": "#100e17"
        },
        "border": "#0ed2f780",
        "topBar": {
          "from": "#0db9d780",
          "to": "#13111a",
          "length": 0.6,
          "thickness": 2
        },
        "bottomBar": {
          "from": "#0db9d780",
          "to": "#15131c",
          "length": 0.25,
          "thickness": 2
        }
      },
      "linkMarker": {
        "from": "#0ed2f78c",
        "to": "#0ed2f78c",
        "height": 0.2,
        "bottom": 0.94
      },
      "bold": {
        "from": "#87c2fd",
        "to": "#dcb9fc"
      }
    }
  }
}
